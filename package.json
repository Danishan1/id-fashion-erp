{
  "name": "fashion-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,worker -c blue,green \"npm:dev:next\" \"npm:worker\"",
    "dev:next": "next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "worker": "tsx watch src/core/jobs/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@google/genai": "2.21.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.8.1",
    "@vladmandic/face-api": "1.7.15",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.2",
    "geist": "1.5.1",
    "ioredis": "^6.0.0",
    "jsbarcode": "^3.12.3",
    "lru-cache": "^11.5.2",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "openai": "7.10.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}

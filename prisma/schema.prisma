// ─────────────────────────────────────────────────────────────
// Sampling (Phase 4)
// sample_requests is an immutable header (customer/style identity never
// changes); every revision is a new, append-only sample_versions row —
// versions are never edited or overwritten, only superseded. Materials,
// approvals, and comments hang off a specific version so history stays
// intact across revisions. See CLAUDE.md's Sampling workflow section.
// ─────────────────────────────────────────────────────────────

enum SampleStatus {
  DRAFT
  REQUESTED
  TECH_PACK_READY
  IN_DEVELOPMENT
  INTERNAL_QC
  SUBMITTED_TO_CUSTOMER
  CUSTOMER_FEEDBACK_RECEIVED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  ON_HOLD
  CANCELLED
}

enum SampleVersionStatus {
  DRAFT
  IN_DEVELOPMENT
  INTERNAL_QC
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum SampleDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

// Standard garment-export sample classifications. Hardcoded (not a configurable
// master) — this taxonomy rarely changes across the industry, matching the same
// "small closed enum, not a lookup table" choice already made for
// BuyerEnquiryLineStatus/SalesOrderStatus. A PP (Pre-Production) sample's
// approval is the natural future gate for Production-order eligibility once
// Phase 5C exists — the concrete reason this exists now, not just labeling.
enum SampleType {
  FIT
  PROTO
  PP
  TOP
  SHIPMENT
  PHOTOSHOOT
  SMS
  OTHER
}

model SampleRequest {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  branchId             String?       @map("branch_id") @db.Uuid
  requestNumber        String        @map("request_number")
  customerId           String        @map("customer_id") @db.Uuid
  buyerId              String?       @map("buyer_id") @db.Uuid
  productId            String?       @map("product_id") @db.Uuid
  // Nullable at the DB level (existing rows predate this field) but required by
  // the create-form's Zod schema — the display name for the sample even before
  // it has (or ever gets) a linked Product/Style. Prefilled onto the "Convert to
  // Style" form when the sample later graduates into a real Style master.
  styleName            String?       @map("style_name")
  // Nullable at the DB level (existing rows predate this field) but required by
  // the create-form's Zod schema, same precedent as styleName above. Immutable
  // after creation (no edit endpoint) — identity-like, same footing as
  // customer/style; silently relabeling a PP sample after the fact would
  // undermine its future role as a Production-order eligibility gate.
  sampleType           SampleType?
  // Free-text, editable at any stage — a customer may name a color upfront
  // (or only after seeing the physical sample) and revise it later; not an
  // enum/FK since this is a casual descriptive value, not a Color master pick.
  color                String?
  requestedByUserId    String        @map("requested_by_user_id") @db.Uuid
  requestDate          DateTime      @map("request_date") @db.Date
  targetSubmissionDate DateTime?     @map("target_submission_date") @db.Date
  status               SampleStatus  @default(DRAFT)
  statusBeforeHold     SampleStatus? @map("status_before_hold")
  currentVersionNumber Int           @default(0) @map("current_version_number")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  buyer            Buyer?            @relation(fields: [buyerId], references: [id])
  product          Product?          @relation("SampleRequestStyle", fields: [productId], references: [id])
  requestedBy      User              @relation("SampleRequestedBy", fields: [requestedByUserId], references: [id])
  versions         SampleVersion[]
  comments         SampleComment[]
  salesOrderItems  SalesOrderItem[]
  // Virtual back-relation only — no physical column on this table. The
  // single authoritative FK lives on BuyerEnquiryLine.sampleRequestId (see
  // that model); this is purely how a Sample's detail page can show "this
  // originated from Enquiry ENQ-..." without a second, redundant FK here.
  buyerEnquiryLine BuyerEnquiryLine?
  // Same virtual-back-relation shape, for AiGarmentProject.sampleRequestId
  // (@unique), set once by createSampleRequestFromProject().
  aiGarmentProject AiGarmentProject?

  @@unique([companyId, requestNumber])
  @@map("sample_requests")
}

model SampleVersion {
  id                    String              @id @default(uuid()) @db.Uuid
  sampleRequestId       String              @map("sample_request_id") @db.Uuid
  versionNumber         Int                 @map("version_number")
  status                SampleVersionStatus @default(DRAFT)
  techPackNotes         String?             @map("tech_pack_notes")
  // Manual while no priced SampleMaterial/SampleOtherCharge exists for this
  // version (zero behavior change from before costing existed). Once the
  // version has real costing data, every recalculation overwrites this to
  // equal finalTotal and the UI stops accepting manual edits for it — see
  // recalculateSampleVersionCosting() in sample.service.ts.
  estimatedCostPerUnit  Decimal?            @map("estimated_cost_per_unit") @db.Decimal(18, 2)
  submittedToCustomerAt DateTime?           @map("submitted_to_customer_at")
  customerDecisionAt    DateTime?           @map("customer_decision_at")
  createdByUserId       String              @map("created_by_user_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at")

  // Costing rollup — hardcoded formula (materialCost + otherCharges ->
  // subtotal -> +margin% -> +commission% -> +freight -> finalTotal), base
  // currency only. costSubtotal/finalTotal are system-computed and stored
  // (same precedent as SalesOrder.totalAmount), never accepted from a client.
  marginPercent         Decimal?  @map("margin_percent") @db.Decimal(5, 2)
  commissionPercent     Decimal?  @map("commission_percent") @db.Decimal(5, 2)
  freightAmount         Decimal?  @map("freight_amount") @db.Decimal(18, 2)
  costSubtotal          Decimal?  @map("cost_subtotal") @db.Decimal(18, 2)
  finalTotal            Decimal?  @map("final_total") @db.Decimal(18, 2)
  // Reversible lock (the first one in this app) — deliberately carries its
  // own actor/timestamp columns rather than being a bare boolean, matching
  // the existing submittedToCustomerAt/customerDecisionAt precedent on this
  // same model, since a lock->unlock->lock cycle would otherwise lose the
  // who/when story. Gated on the "approve" RBAC action, not "edit" — see
  // lockSampleCosting()/unlockSampleCosting() in sample.service.ts.
  isCostingLocked       Boolean   @default(false) @map("is_costing_locked")
  costingLockedAt       DateTime? @map("costing_locked_at")
  costingLockedByUserId String?   @map("costing_locked_by_user_id") @db.Uuid

  sampleRequest   SampleRequest       @relation(fields: [sampleRequestId], references: [id])
  createdBy       User                @relation("SampleVersionCreatedBy", fields: [createdByUserId], references: [id])
  costingLockedBy User?               @relation("SampleVersionCostingLockedBy", fields: [costingLockedByUserId], references: [id])
  materials       SampleMaterial[]
  approvals       SampleApproval[]
  comments        SampleComment[]
  otherCharges    SampleOtherCharge[]

  @@unique([sampleRequestId, versionNumber])
  @@map("sample_versions")
}

model SampleMaterial {
  id              String   @id @default(uuid()) @db.Uuid
  sampleVersionId String   @map("sample_version_id") @db.Uuid
  materialId      String   @map("material_id") @db.Uuid
  plannedQuantity Decimal  @map("planned_quantity") @db.Decimal(18, 4)
  uomId           String?  @map("uom_id") @db.Uuid
  // Which Colors-master color this material line is for — a raw material
  // like fabric or thread is frequently needed in more than one color on the
  // same sample; distinct colors are distinct lines (see the material merge
  // key in sample.service.ts), not different quantities of one line.
  colorId         String?  @map("color_id") @db.Uuid
  // Optional precise shade/Pantone reference, distinct from the generic
  // Color-master name above — a colorId of "Navy Blue" can span many
  // physical shades; dyeId pins down the exact one when it matters. Added
  // to MATERIAL_MERGE_KEY_FIELDS in sample.service.ts, same as colorId was.
  dyeId           String?  @map("dye_id") @db.Uuid
  notes           String?
  // Recorded after the fact, once known — how much of this planned material
  // was actually damaged/wasted during sampling, and why. Both nullable and
  // independently editable from the line's planned quantity (see the scoped
  // damage-recording endpoint), since damage is discovered later, not at
  // material-planning time.
  damagedQuantity Decimal? @map("damaged_quantity") @db.Decimal(18, 4)
  damageReason    String?  @map("damage_reason")
  // Costing — both nullable, set/cleared only via the scoped
  // PATCH /api/v1/sampling/materials/:materialId/costing endpoint, never
  // through the create/merge path (addSampleMaterial). Deliberately NOT part
  // of MATERIAL_MERGE_KEY_FIELDS in sample.service.ts — rate is a cost
  // attribute, not an identity attribute that should split/merge lines. A row
  // with rate = null contributes 0 to costing, never treated as "priced at
  // zero" (see recalculateSampleVersionCosting()).
  rate            Decimal? @db.Decimal(18, 4)
  gstPercentage   Decimal? @map("gst_percentage") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  sampleVersion SampleVersion  @relation(fields: [sampleVersionId], references: [id])
  material      Product        @relation("SampleMaterialProduct", fields: [materialId], references: [id])
  uom           UnitOfMeasure? @relation(fields: [uomId], references: [id])
  color         Color?         @relation(fields: [colorId], references: [id])
  dye           FabricDye?     @relation(fields: [dyeId], references: [id])

  @@map("sample_materials")
}

enum SampleOtherChargeCostHead {
  PROCESS
  FABRICATION
  OTHER
}

// Non-material costing lines (labor/process/overhead) that don't fit
// SampleMaterial's shape (no materialId, no consumption quantity) — a flat
// lump-sum amount per charge, deliberately simpler than SampleMaterial.
// Plain CRUD, no merge-key logic: a duplicate charge is just user error the
// merchandiser edits/deletes directly, unlike a raw-material line which
// legitimately needs to distinguish/merge by attribute.
model SampleOtherCharge {
  id              String                    @id @default(uuid()) @db.Uuid
  sampleVersionId String                    @map("sample_version_id") @db.Uuid
  costHead        SampleOtherChargeCostHead @map("cost_head")
  description     String
  amount          Decimal                   @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  sampleVersion SampleVersion @relation(fields: [sampleVersionId], references: [id])

  @@map("sample_other_charges")
}

model SampleApproval {
  id                  String         @id @default(uuid()) @db.Uuid
  sampleVersionId     String         @map("sample_version_id") @db.Uuid
  decision            SampleDecision
  decidedByUserId     String         @map("decided_by_user_id") @db.Uuid
  customerContactName String?        @map("customer_contact_name")
  // Free text, not FK'd to Buyer.phone — the request's own linked Buyer is
  // only a default (see the create form), since the person who actually
  // called back with the decision may differ from the Buyer master's own
  // saved contact, same reasoning as customerContactName above.
  customerContactPhone String?       @map("customer_contact_phone")
  decisionNotes       String?        @map("decision_notes")
  decidedAt           DateTime       @default(now()) @map("decided_at")

  sampleVersion SampleVersion @relation(fields: [sampleVersionId], references: [id])
  decidedBy     User          @relation("SampleApprovalDecidedBy", fields: [decidedByUserId], references: [id])

  @@map("sample_approvals")
}

model SampleComment {
  id              String   @id @default(uuid()) @db.Uuid
  sampleRequestId String   @map("sample_request_id") @db.Uuid
  sampleVersionId String?  @map("sample_version_id") @db.Uuid
  authorUserId    String   @map("author_user_id") @db.Uuid
  body            String
  createdAt       DateTime @default(now()) @map("created_at")

  sampleRequest SampleRequest  @relation(fields: [sampleRequestId], references: [id])
  sampleVersion SampleVersion? @relation(fields: [sampleVersionId], references: [id])
  author        User           @relation("SampleCommentAuthor", fields: [authorUserId], references: [id])

  @@map("sample_comments")
}

// ─────────────────────────────────────────────────────────────
// Buyer Enquiry (Phase 4 extension, 2026-08-21) — an OPTIONAL intake layer
// in front of Sampling, not a parent of it. The only link to Sampling is one
// nullable, unique FK on BuyerEnquiryLine pointing forward into
// SampleRequest (mirrors SalesOrderItem.sampleRequestId's own shape) — never
// a required relation, never a shared state machine. Direct SampleRequest
// creation and direct SalesOrder creation are both completely unaffected; a
// merchandiser who never opens this module never has to know it exists.
// ─────────────────────────────────────────────────────────────

enum EnquirySource {
  EMAIL
  PHONE
  TRADE_SHOW
  REFERRAL
  WEBSITE
  OTHER
}

// Always derived from line statuses (recomputeBuyerEnquiryStatus() in
// buyer-enquiry.service.ts) — never set directly by a generic status PATCH,
// the same discipline that closed the GoodsReceipt-status-label and Sample
// Hold/Resume bugs elsewhere in this project. CANCELLED is the one manual
// exception (cancelBuyerEnquiry()), and once set nothing recomputes over it.
enum BuyerEnquiryStatus {
  OPEN
  PARTIALLY_CONVERTED
  CLOSED
  CANCELLED
}

enum BuyerEnquiryLineStatus {
  PENDING_REVIEW
  APPROVED_FOR_SAMPLING
  ON_HOLD
  REJECTED
  // Reachable ONLY through convertEnquiryLineToSampleRequest() — deliberately
  // excluded from the generic line-status-change endpoint's Zod schema, the
  // same discipline already used for SampleStatus.TECH_PACK_READY /
  // REVISION_REQUESTED so a line can't be forged into "converted" without a
  // real SampleRequest actually being created.
  CONVERTED
}

model BuyerEnquiry {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  branchId              String?            @map("branch_id") @db.Uuid
  enquiryNumber         String             @map("enquiry_number")
  // Both nullable — an enquiry may be logged against an existing Customer
  // (and optionally one of its Buyers), OR against a not-yet-onboarded
  // prospect using the fields below. Never both null and never auto-created:
  // conversion to a Sample Request hard-requires a real customerId.
  customerId            String?            @map("customer_id") @db.Uuid
  buyerId               String?            @map("buyer_id") @db.Uuid
  // Quick-capture lead fields, relevant only while customerId is null. This
  // is deliberately NOT a Prospect/Lead master table — no lifecycle, no
  // promotion workflow, no reminders. An enquiry that never converts simply
  // sits here indefinitely; formalizing a real relationship means someone
  // creates a real Customer separately in Masters, same as today.
  prospectName          String?            @map("prospect_name")
  prospectContactPerson String?            @map("prospect_contact_person")
  prospectEmail         String?            @map("prospect_email")
  prospectPhone         String?            @map("prospect_phone")
  prospectCountry       String?            @map("prospect_country")
  enquiryDate           DateTime           @map("enquiry_date") @db.Date
  source                EnquirySource      @default(OTHER)
  status                BuyerEnquiryStatus @default(OPEN)
  remarks               String?
  requestedByUserId     String             @map("requested_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company         Company            @relation(fields: [companyId], references: [id])
  branch          Branch?            @relation(fields: [branchId], references: [id])
  customer        Customer?          @relation(fields: [customerId], references: [id])
  buyer           Buyer?             @relation(fields: [buyerId], references: [id])
  requestedBy     User               @relation("BuyerEnquiryRequestedBy", fields: [requestedByUserId], references: [id])
  lines           BuyerEnquiryLine[]
  // Virtual back-relation only — the one real column lives on Lead
  // (Lead.buyerEnquiryId), same "single authoritative FK" shape as
  // BuyerEnquiryLine.sampleRequestId above.
  originatingLead Lead?

  @@unique([companyId, enquiryNumber])
  @@map("buyer_enquiries")
}

model BuyerEnquiryLine {
  id                 String                 @id @default(uuid()) @db.Uuid
  buyerEnquiryId     String                 @map("buyer_enquiry_id") @db.Uuid
  // An existing Style, if picked from the catalog — nullable, the same
  // "may not exist as a Style yet" precedent as SampleRequest.productId.
  productId          String?                @map("product_id") @db.Uuid
  styleNameFreeText  String?                @map("style_name_free_text")
  description        String?
  colorRemarks       String?                @map("color_remarks")
  targetQuantity     Decimal?               @map("target_quantity") @db.Decimal(18, 2)
  targetUnitPrice    Decimal?               @map("target_unit_price") @db.Decimal(18, 2)
  targetDeliveryDate DateTime?              @map("target_delivery_date") @db.Date
  remarks            String?
  lineStatus         BuyerEnquiryLineStatus @default(PENDING_REVIEW) @map("line_status")
  rejectionReason    String?                @map("rejection_reason")
  // The single authoritative FK for the whole Enquiry<->Sample relationship —
  // set exactly once, only by convertEnquiryLineToSampleRequest(), never
  // cleared. @unique enforces "a SampleRequest can originate from at most one
  // line" as a real DB constraint (via the back-relation on SampleRequest),
  // not just an application-layer promise — a concurrent double-convert
  // attempt fails on this constraint even if the service-layer check races.
  sampleRequestId    String?                @unique @map("sample_request_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  buyerEnquiry  BuyerEnquiry   @relation(fields: [buyerEnquiryId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  sampleRequest SampleRequest? @relation(fields: [sampleRequestId], references: [id])

  @@map("buyer_enquiry_lines")
}

// ─────────────────────────────────────────────────────────────
// CRM — Lead & Deal (migrated from WordPress "EQ CRM"; see
// CRM_SALES_MARKETING_HRMS_MIGRATION_REPORT.md for the full source analysis
// and the mapping decisions this schema follows)
// ─────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// Deliberately NOT a stored column on Lead — computed from leadScore at read
// time (>=80 hot, >=50 warm, else normal, matching the source's own
// thresholds exactly). The source stores this as a column that can drift
// from the score that produced it; this project's own established
// "derive, don't duplicate" discipline (Material Request's status,
// JobOrder's status, etc.) applies here identically.
enum LeadPriority {
  NORMAL
  WARM
  HOT
}

model Lead {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  branchId          String?       @map("branch_id") @db.Uuid
  leadNumber        String        @map("lead_number")
  name              String
  email             String?
  phone             String?
  companyName       String?       @map("company_name")
  source            EnquirySource @default(OTHER)
  // A real FK now that Campaign exists (Marketing pass) — campaignText
  // remains as the free-text fallback for a lead sourced from a channel
  // with no tracked Campaign record (e.g. an informal referral), the same
  // "existing record OR free text" dual-field shape already used by
  // BuyerEnquiryLine.productId/styleNameFreeText.
  campaignId        String?       @map("campaign_id") @db.Uuid
  campaignText      String?       @map("campaign_text")
  leadScore         Decimal       @default(0) @map("lead_score") @db.Decimal(6, 2)
  status            LeadStatus    @default(NEW)
  value             Decimal       @default(0) @db.Decimal(15, 2)
  expectedCloseDate DateTime?     @map("expected_close_date") @db.Date
  assignedToUserId  String?       @map("assigned_to_user_id") @db.Uuid
  // Forward-only traceability into the existing Buyer Enquiry -> Sample ->
  // Style pipeline, for when a generic sales lead turns into a real garment
  // style enquiry. @unique enforces "a BuyerEnquiry originates from at most
  // one Lead" at the DB level — same single-authoritative-FK shape already
  // proven by BuyerEnquiryLine.sampleRequestId. Deliberately NOT a merge of
  // Lead into BuyerEnquiry itself (see the migration report's decision log)
  // — BuyerEnquiry's own shape is style-centric and would distort a generic
  // CRM lead that has no product discussed yet.
  buyerEnquiryId    String?       @unique @map("buyer_enquiry_id") @db.Uuid
  lastActivityAt    DateTime?     @map("last_activity_at")
  notes             String?
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id])
  branch       Branch?               @relation(fields: [branchId], references: [id])
  assignedTo   User?                 @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy    User                  @relation("LeadCreatedBy", fields: [createdByUserId], references: [id])
  buyerEnquiry BuyerEnquiry?         @relation(fields: [buyerEnquiryId], references: [id])
  campaign     Campaign?             @relation(fields: [campaignId], references: [id])
  deals        Deal[]
  attributions CampaignAttribution[]

  @@unique([companyId, leadNumber])
  @@index([companyId, status])
  @@index([companyId, assignedToUserId])
  @@index([companyId, campaignId])
  @@map("crm_leads")
}

// A real transition guard, unlike the source (which allows a Deal to jump
// between any of its 5 stage strings with zero validation) — a deliberate,
// flagged improvement (see migration report §7), not scope creep: this
// project adds an ALLOWED_TRANSITIONS guard to every other status-driven
// document, and Deal is no exception.
enum DealStage {
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  branchId           String?   @map("branch_id") @db.Uuid
  dealNumber         String    @map("deal_number")
  title              String
  leadId             String?   @map("lead_id") @db.Uuid
  customerId         String?   @map("customer_id") @db.Uuid
  stage              DealStage @default(QUALIFIED)
  value              Decimal   @default(0) @db.Decimal(15, 2)
  probabilityPercent Decimal   @default(0) @map("probability_percent") @db.Decimal(5, 2)
  // Two distinct concepts kept independent, both optional: the day-to-day
  // owner (any User, matching the source's wp_user-based assignment) and
  // the commission-tracked salesperson (SalesAgent, Fashion ERP's own
  // existing domestic-channel concept) — a deal can have either, both, or
  // neither, per the migration report's §9 decision.
  assignedToUserId   String?   @map("assigned_to_user_id") @db.Uuid
  salesAgentId       String?   @map("sales_agent_id") @db.Uuid
  expectedCloseDate  DateTime? @map("expected_close_date") @db.Date
  lostReason         String?   @map("lost_reason")
  notes              String?
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company              Company      @relation(fields: [companyId], references: [id])
  branch               Branch?      @relation(fields: [branchId], references: [id])
  lead                 Lead?        @relation(fields: [leadId], references: [id])
  customer             Customer?    @relation(fields: [customerId], references: [id])
  assignedTo           User?        @relation("DealAssignedTo", fields: [assignedToUserId], references: [id])
  salesAgent           SalesAgent?  @relation(fields: [salesAgentId], references: [id])
  createdBy            User         @relation("DealCreatedBy", fields: [createdByUserId], references: [id])
  resultingSalesOrders SalesOrder[]

  @@unique([companyId, dealNumber])
  @@index([companyId, stage])
  @@map("crm_deals")
}

enum CrmInteractionType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE
}

// Polymorphic via the existing RelatedModule discriminator (LEAD | DEAL |
// CUSTOMER) — the same convention already used by Attachment/AuditLog/
// InventoryTransaction, rather than inventing a parallel polymorphic scheme
// just for CRM.
model CrmActivity {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  relatedModule     RelatedModule      @map("related_module")
  relatedRecordId   String             @map("related_record_id") @db.Uuid
  activityType      CrmInteractionType @map("activity_type")
  subject           String?
  body              String?
  activityAt        DateTime           @default(now()) @map("activity_at")
  performedByUserId String             @map("performed_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")

  company     Company @relation(fields: [companyId], references: [id])
  performedBy User    @relation("CrmActivityPerformedBy", fields: [performedByUserId], references: [id])

  @@index([companyId, relatedModule, relatedRecordId])
  @@map("crm_activities")
}

enum CrmFollowupStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CrmFollowupPriority {
  LOW
  MEDIUM
  HIGH
}

model CrmFollowup {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  relatedModule    RelatedModule       @map("related_module")
  relatedRecordId  String              @map("related_record_id") @db.Uuid
  assignedToUserId String?             @map("assigned_to_user_id") @db.Uuid
  followupDate     DateTime            @map("followup_date")
  type             CrmInteractionType  @default(CALL)
  status           CrmFollowupStatus   @default(PENDING)
  priority         CrmFollowupPriority @default(MEDIUM)
  notes            String?
  completedAt      DateTime?           @map("completed_at")
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")

  company    Company @relation(fields: [companyId], references: [id])
  assignedTo User?   @relation("CrmFollowupAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy  User    @relation("CrmFollowupCreatedBy", fields: [createdByUserId], references: [id])

  // isOverdue is deliberately NOT a stored column — computed at read time as
  // status='PENDING' AND followupDate < now(), exactly matching both the
  // source's own behavior and this project's derive-don't-duplicate rule.
  @@index([companyId, relatedModule, relatedRecordId])
  @@index([companyId, status, followupDate])
  @@map("crm_followups")
}

// Fixes a real fragility in the source: WordPress re-derives "who's next"
// by looking up the last-assigned lead's own assignee every time, which
// silently breaks if that lead's assignment is later changed. A real
// stored rotation pointer, atomically advanced, replaces that guesswork.
model CrmRoundRobinState {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @unique @map("company_id") @db.Uuid
  lastAssignedUserId String?  @map("last_assigned_user_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("crm_round_robin_state")
}

// Replaces the hardcoded 80/50 literals `computeLeadPriority()` used to have
// baked in — one row per company, lazily created on first edit (a company
// that never touches this keeps the same 80/50 defaults with no row at all,
// same "create on first real use" precedent as this project's document
// sequences). `warmThreshold` doubles as Marketing's own "qualified lead"
// cutoff (`computeCampaignMetricsMap()`) — the source's own `lead_quality`
// count was already documented as the identical score>=50 definition under a
// different label, so both now read the one configurable value instead of
// two separately hardcoded copies of the same number.
model CrmSettings {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @unique @map("company_id") @db.Uuid
  hotThreshold    Decimal  @default(80) @map("hot_threshold") @db.Decimal(5, 2)
  warmThreshold   Decimal  @default(50) @map("warm_threshold") @db.Decimal(5, 2)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  updatedBy User?   @relation(fields: [updatedByUserId], references: [id])

  @@map("crm_settings")
}

// ─────────────────────────────────────────────────────────────
// Marketing — Campaigns, attribution, alerts (migrated from WordPress
// "EQ Marketing"; see CRM_SALES_MARKETING_HRMS_MIGRATION_REPORT.md).
//
// Deliberately NOT ported: the source's own `eq_mkt_lead_map` table (one
// row per lead caching "lead_quality"/"conversion_status") — those fields
// are redundant with Lead.priority (already computed from leadScore) and
// Lead.status, exactly the "second source of truth" this project has fixed
// more than once (Material Request's old status column, JobOrder's status).
// Campaign's own spend/leads/qualifiedLeads/customers/revenue are likewise
// NOT stored columns — computed live in campaign.service.ts from
// CampaignDailyMetric and from Lead/Deal joined through campaignId, the
// same discipline applied consistently rather than only to the one table
// the migration report happened to flag.
// ─────────────────────────────────────────────────────────────

enum CampaignChannel {
  META_ADS
  GOOGLE_ADS
  LINKEDIN
  YOUTUBE
  EMAIL
  WHATSAPP
  SEO
  ORGANIC
  REFERRAL
  OFFLINE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Campaign {
  id               String                 @id @default(uuid()) @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  branchId         String?                @map("branch_id") @db.Uuid
  campaignNumber   String                 @map("campaign_number")
  name             String
  objective        String?
  channel          CampaignChannel
  startDate        DateTime?              @map("start_date") @db.Date
  endDate          DateTime?              @map("end_date") @db.Date
  budget           Decimal                @default(0) @db.Decimal(15, 2)
  ownerUserId      String?                @map("owner_user_id") @db.Uuid
  status           CampaignStatus         @default(DRAFT)
  approvalStatus   CampaignApprovalStatus @default(PENDING) @map("approval_status")
  // Approval metadata — who/when/why, mirroring the same "who/when" shape
  // already used for SampleVersion's costing lock rather than a bare
  // boolean. rejectionReason is cleared on a later approval, and vice versa
  // (approvedBy/approvedAt cleared on a later rejection) — the three fields
  // together always describe exactly one decision, never a stale mix of both.
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?              @map("approved_at")
  rejectionReason  String?                @map("rejection_reason")
  notes            String?
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  company         Company               @relation(fields: [companyId], references: [id])
  branch          Branch?               @relation(fields: [branchId], references: [id])
  owner           User?                 @relation("CampaignOwner", fields: [ownerUserId], references: [id])
  createdBy       User                  @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy      User?                 @relation("CampaignApprovedBy", fields: [approvedByUserId], references: [id])
  dailyMetrics    CampaignDailyMetric[]
  attributions    CampaignAttribution[]
  alerts          CampaignAlert[]
  leads           Lead[]
  adCampaignLinks AdCampaignLink[]

  @@unique([companyId, campaignNumber])
  @@index([companyId, status])
  @@index([companyId, channel])
  @@map("mkt_campaigns")
}

// Manually recorded (or, later, ad-platform-synced — not built in this
// pass, see the migration report) daily spend/impressions/clicks. Campaign
// spend is always SUM(these), never a separately-editable column.
model CampaignDailyMetric {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  metricDate       DateTime @map("metric_date") @db.Date
  spend            Decimal  @default(0) @db.Decimal(15, 2)
  // Int, not BigInt — NextResponse.json() can't serialize a native BigInt
  // (hit live: this crashed with "Do not know how to serialize a BigInt" on
  // every read of a recorded metric), and no real campaign at this
  // business's scale will exceed ~2 billion impressions.
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  notes            String?
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  campaign   Campaign @relation(fields: [campaignId], references: [id])
  recordedBy User     @relation(fields: [recordedByUserId], references: [id])

  @@unique([campaignId, metricDate])
  @@map("mkt_campaign_daily_metrics")
}

enum AdPlatform {
  META
  GOOGLE
}

enum AdConnectionStatus {
  CONNECTED
  // Set only by a deliberate user action (Disconnect) — never inferred from
  // an expired token, since that's a recoverable ERROR state, not a decision
  // to stop syncing.
  DISCONNECTED
  // A sync attempt failed (expired/revoked token, API error) — surfaced with
  // lastSyncError so the connection page can point at "reconnect" rather
  // than silently retrying forever with no explanation.
  ERROR
}

// One row per connected external ad account (a company can connect more than
// one Meta ad account or Google Ads customer ID). Tokens are encrypted at
// rest (src/core/security/encryption.ts) — these are live credentials with
// real ad-spend-account access, not app-internal data, so plaintext storage
// would be a real, easily avoidable vulnerability.
model AdAccountConnection {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  platform              AdPlatform
  externalAccountId     String             @map("external_account_id")
  accountName           String             @map("account_name")
  accessTokenEncrypted  String             @map("access_token_encrypted")
  refreshTokenEncrypted String?            @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?          @map("token_expires_at")
  status                AdConnectionStatus @default(CONNECTED)
  lastSyncedAt          DateTime?          @map("last_synced_at")
  lastSyncError         String?            @map("last_sync_error")
  connectedByUserId     String             @map("connected_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company       Company          @relation(fields: [companyId], references: [id])
  connectedBy   User             @relation(fields: [connectedByUserId], references: [id])
  campaignLinks AdCampaignLink[]

  @@unique([companyId, platform, externalAccountId])
  @@index([companyId, platform])
  @@map("ad_account_connections")
}

// Maps one external ad-platform campaign to (at most) one local Campaign
// record. Deliberately a separate mapping table, not a field on Campaign
// itself — one local Campaign has no reason to know about ad-platform
// wiring, and a connection can see many external campaigns the user hasn't
// (or won't) map to anything local yet; those stay listed with
// localCampaignId = null rather than auto-creating a local Campaign per
// external one (would flood the Campaigns list with entries nobody asked
// for and bypass this project's own approval-workflow gate on new
// campaigns).
model AdCampaignLink {
  id                   String   @id @default(uuid()) @db.Uuid
  connectionId         String   @map("connection_id") @db.Uuid
  externalCampaignId   String   @map("external_campaign_id")
  externalCampaignName String   @map("external_campaign_name")
  localCampaignId      String?  @map("local_campaign_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  connection    AdAccountConnection @relation(fields: [connectionId], references: [id])
  localCampaign Campaign?           @relation(fields: [localCampaignId], references: [id])

  @@unique([connectionId, externalCampaignId])
  @@index([localCampaignId])
  @@map("ad_campaign_links")
}

// Multi-touch attribution record — a distinct concept from Lead itself
// (one Lead can have several touches on the way in), unlike the source's
// eq_mkt_lead_map which conflated "attribution" with "current lead state."
model CampaignAttribution {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  campaignId        String?  @map("campaign_id") @db.Uuid
  leadId            String?  @map("lead_id") @db.Uuid
  // Free-text fallback for a touch that never became a real Lead record —
  // mirrors the source's own customer_name column on this same table.
  prospectName      String?  @map("prospect_name")
  source            String?
  medium            String?
  content           String?
  term              String?
  utmCampaign       String?  @map("utm_campaign")
  landingPage       String?  @map("landing_page")
  isFirstTouch      Boolean  @default(false) @map("is_first_touch")
  isLastTouch       Boolean  @default(false) @map("is_last_touch")
  attributedRevenue Decimal  @default(0) @map("attributed_revenue") @db.Decimal(15, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])

  @@index([companyId, campaignId])
  @@index([companyId, leadId])
  @@map("mkt_campaign_attributions")
}

// The 4 threshold rules ported exactly from the source's eq_mkt_run_automation()
// (budget overspend/80%, low ROAS, high CPL vs channel benchmark, low
// conversion — see the migration report §3.5 for the precise formulas).
enum CampaignAlertType {
  BUDGET_OVERSPEND
  BUDGET_80_PERCENT
  LOW_ROAS
  ROAS_WATCH
  HIGH_CPL
  LOW_CONVERSION
}

enum CampaignAlertPriority {
  MEDIUM
  HIGH
}

enum CampaignAlertStatus {
  OPEN
  RESOLVED
}

model CampaignAlert {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  campaignId     String?               @map("campaign_id") @db.Uuid
  alertType      CampaignAlertType     @map("alert_type")
  priority       CampaignAlertPriority
  title          String
  message        String
  metricValue    Decimal?              @map("metric_value") @db.Decimal(15, 4)
  thresholdValue Decimal?              @map("threshold_value") @db.Decimal(15, 4)
  status         CampaignAlertStatus   @default(OPEN)
  resolvedAt     DateTime?             @map("resolved_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId, status])
  @@index([companyId, campaignId])
  @@map("mkt_campaign_alerts")
}

// ─────────────────────────────────────────────────────────────
// HRMS — Attendance & Leave (migrated from WordPress "EQ HRMS"; see
// CRM_SALES_MARKETING_HRMS_MIGRATION_REPORT.md). Payroll and
// KPI/Performance are explicitly out of scope for this pass — the source's
// own versions are thin flat-entry ports with no real calculation engine
// behind either, per the confirmed scope decision.
// ─────────────────────────────────────────────────────────────

// Late-flag is deliberately NOT a stored column — computed at read time
// against the employee's own Shift.startTime (a real improvement over the
// source, which hardcodes one 10:15 cutoff for every employee company-wide;
// Fashion ERP already had a real Shift concept, just never wired to
// Employee until now).
model AttendanceRecord {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  attendanceDate   DateTime  @map("attendance_date") @db.Date
  punchIn          DateTime? @map("punch_in")
  punchOut         DateTime? @map("punch_out")
  remarks          String?
  recordedByUserId String    @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company    Company  @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
  recordedBy User     @relation(fields: [recordedByUserId], references: [id])

  // A correction request may reference the record it ultimately amended —
  // nullable both ways (a request can pre-date any record existing yet for
  // that day, e.g. a forgotten punch-in) and one-to-many (a record can be
  // corrected more than once over its life).
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([employeeId, attendanceDate])
  @@index([companyId, attendanceDate])
  @@map("hrms_attendance_records")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * HRMS gap-analysis Priority 2 item — attendance edits were previously only
 * possible via a direct, unguarded upsert (recordAttendance), with no
 * request/approval trail. This is the same submit -> approve/reject shape
 * as LeaveRequest, applied to punch-time corrections instead of leave days.
 * Approval writes the requested punch times onto the real AttendanceRecord
 * (creating it via the same upsert recordAttendance already uses if none
 * exists yet for that date) — see attendance-correction.service.ts.
 */
model AttendanceCorrectionRequest {
  id                 String                     @id @default(uuid()) @db.Uuid
  companyId          String                     @map("company_id") @db.Uuid
  employeeId         String                     @map("employee_id") @db.Uuid
  attendanceRecordId String?                    @map("attendance_record_id") @db.Uuid
  attendanceDate     DateTime                   @map("attendance_date") @db.Date
  requestedPunchIn   DateTime?                  @map("requested_punch_in")
  requestedPunchOut  DateTime?                  @map("requested_punch_out")
  reason             String
  status             AttendanceCorrectionStatus @default(PENDING)
  rejectionReason    String?                    @map("rejection_reason")
  approvedByUserId   String?                    @map("approved_by_user_id") @db.Uuid
  decidedAt          DateTime?                  @map("decided_at")
  createdByUserId    String                     @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at")

  company          Company           @relation(fields: [companyId], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])
  approvedBy       User?             @relation("AttendanceCorrectionApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy        User              @relation("AttendanceCorrectionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("hrms_attendance_correction_requests")
}

model LeaveType {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String
  annualDays Decimal  @default(0) @map("annual_days") @db.Decimal(6, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company       Company                    @relation(fields: [companyId], references: [id])
  requests      LeaveRequest[]
  carryForwards LeaveBalanceCarryForward[]

  @@unique([companyId, name])
  @@map("hrms_leave_types")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  employeeId       String             @map("employee_id") @db.Uuid
  leaveTypeId      String             @map("leave_type_id") @db.Uuid
  startDate        DateTime           @map("start_date") @db.Date
  endDate          DateTime           @map("end_date") @db.Date
  reason           String?
  status           LeaveRequestStatus @default(PENDING)
  rejectionReason  String?            @map("rejection_reason")
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  decidedAt        DateTime?          @map("decided_at")
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")

  company    Company   @relation(fields: [companyId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id])
  approvedBy User?     @relation("LeaveRequestApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy  User      @relation("LeaveRequestCreatedBy", fields: [createdByUserId], references: [id])

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("hrms_leave_requests")
}

/**
 * HRMS gap-analysis Priority 2 item: leave carry-forward automation. This
 * project has no job runner/cron infrastructure at all (confirmed — see
 * customer-segments.service.ts's own "no job runner" note), so this is a
 * manually-triggered batch computation, not a true scheduled job — the same
 * shape as CRM's generateFollowupNotifications(). One row per
 * employee+leaveType+target-year, uncapped (no per-leave-type max-carry-
 * forward policy exists in this schema to enforce — carries the full unused
 * balance, a deliberate simplification, not an oversight).
 */
model LeaveBalanceCarryForward {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  leaveTypeId     String   @map("leave_type_id") @db.Uuid
  fromYear        Int      @map("from_year")
  toYear          Int      @map("to_year")
  carriedDays     Decimal  @map("carried_days") @db.Decimal(6, 2)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  createdBy User      @relation(fields: [createdByUserId], references: [id])

  // The idempotency guard the batch run relies on — re-running for the same
  // target year is a safe no-op per employee+leaveType, not a double-credit.
  @@unique([companyId, employeeId, leaveTypeId, toYear])
  @@map("hrms_leave_balance_carry_forwards")
}

// ─────────────────────────────────────────────────────────────
// Sales Orders (Phase 5A)
// ─────────────────────────────────────────────────────────────

// Full lifecycle defined now (matches the roadmap's state machine), but only
// DRAFT/CONFIRMED/ON_HOLD/CANCELLED are reachable through this phase's own
// code — PARTIALLY_DISPATCHED/DISPATCHED/INVOICED/CLOSED are reserved for
// Phase 7/8 to wire up later, same discipline as SampleStatus.DRAFT existing
// unused until something actually transitions into it.
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_DISPATCHED
  DISPATCHED
  INVOICED
  CLOSED
  ON_HOLD
  CANCELLED
}

model SalesOrder {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  branchId          String?           @map("branch_id") @db.Uuid
  orderNumber       String            @map("order_number")
  customerId        String            @map("customer_id") @db.Uuid
  buyerId           String?           @map("buyer_id") @db.Uuid
  // Nullable traceability into the CRM pipeline this order originated from,
  // if any — a direct/repeat order (the common case) has none. Header-level
  // (not per-item) since a Deal has no line items of its own, matching its
  // flat, pre-sale shape in the source system.
  originatingDealId String?           @map("originating_deal_id") @db.Uuid
  orderDate         DateTime          @map("order_date") @db.Date
  requiredShipDate  DateTime?         @map("required_ship_date") @db.Date
  status            SalesOrderStatus  @default(DRAFT)
  statusBeforeHold  SalesOrderStatus? @map("status_before_hold")
  // Frozen at creation (no live FX picker — multi-currency UI is deferred
  // project-wide); base amounts are stored, not computed live, so historical
  // totals never drift if a rate source changes later.
  currencyCode      String            @map("currency_code") @db.Char(3)
  exchangeRate      Decimal           @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode  String            @map("base_currency_code") @db.Char(3)
  totalAmount       Decimal           @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount   Decimal           @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  requestedByUserId String            @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  buyer            Buyer?            @relation(fields: [buyerId], references: [id])
  originatingDeal  Deal?             @relation(fields: [originatingDealId], references: [id])
  requestedBy      User              @relation("SalesOrderRequestedBy", fields: [requestedByUserId], references: [id])
  items            SalesOrderItem[]
  materialRequests MaterialRequest[]
  salesInvoices    SalesInvoice[]
  dispatches       Dispatch[]
  // Reserved, unused this phase — AiGarmentProject.salesOrderId is a nullable
  // FK not yet written by any code path (no Sales Order linkage exists yet
  // for AI Garment Flow); documented placeholder, same precedent as
  // ProductionOrderStatus.MATERIAL_ALLOCATED.
  aiGarmentProject AiGarmentProject?

  @@unique([companyId, orderNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                 String   @id @default(uuid()) @db.Uuid
  salesOrderId       String   @map("sales_order_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  // Nullable, per-item (not per-header) — one order can carry several style
  // lines, each optionally tracing back to a different approved sample; a
  // repeat/direct order line needs no sample link at all.
  sampleRequestId    String?  @map("sample_request_id") @db.Uuid
  unitPrice          Decimal  @map("unit_price") @db.Decimal(18, 2)
  notes              String?
  // Guarded accumulator (Phase 8), same idiom as PurchaseOrderItem's
  // receivedQuantity/invoicedQuantity — capped by sum(breakdown.orderedQuantity),
  // incremented only at Confirm-Dispatch time, never at Draft creation. One
  // SalesOrderItem can be dispatched across multiple separate Dispatch
  // documents over time (partial dispatch), hence an accumulator here rather
  // than a one-shot flag.
  dispatchedQuantity Int      @default(0) @map("dispatched_quantity")
  createdAt          DateTime @default(now()) @map("created_at")

  salesOrder        SalesOrder                @relation(fields: [salesOrderId], references: [id])
  product           Product                   @relation(fields: [productId], references: [id])
  sampleRequest     SampleRequest?            @relation(fields: [sampleRequestId], references: [id])
  breakdown         SalesOrderItemBreakdown[]
  productionOrders  ProductionOrder[]
  salesInvoiceItems SalesInvoiceItem[]
  dispatchItems     DispatchItem[]

  @@map("sales_order_items")
}

model SalesOrderItemBreakdown {
  id               String   @id @default(uuid()) @db.Uuid
  salesOrderItemId String   @map("sales_order_item_id") @db.Uuid
  // FK's to the existing style×color×size join rather than duplicating raw
  // colorId+sizeId — ProductVariant exists specifically so every stock/
  // production/dispatch line has one concrete SKU FK.
  productVariantId String   @map("product_variant_id") @db.Uuid
  orderedQuantity  Int      @map("ordered_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([salesOrderItemId, productVariantId])
  @@map("sales_order_item_breakdown")
}

// ─────────────────────────────────────────────────────────────
// BOM & MRP (Phase 5B)
// ─────────────────────────────────────────────────────────────

// Deliberately NOT a numbered document (no DocumentType/document_number) — a
// header attached 1:1 to a Style. Versioned like SampleVersion (see
// BomVersion below): a BOM is edited freely while its current version is
// still DRAFT, but once a version is APPROVED it is locked — the next edit
// mints a new DRAFT version rather than silently rewriting approved history.
// MRP/Production consume `approvedVersionId` specifically, never whatever
// is merely "latest" — an unapproved edit-in-progress can never silently
// change what material planning already relies on.
model Bom {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  productId            String   @unique @map("product_id") @db.Uuid
  // The highest version number ever minted for this BOM — not necessarily
  // the approved one. 0 means no version has been created yet.
  currentVersionNumber Int      @default(0) @map("current_version_number")
  // The version MRP/Production should read. Null until the first approval —
  // deliberately a separate pointer from "latest version" so an in-progress
  // edit can never be mistaken for what's actually approved for use.
  approvedVersionId    String?  @unique @map("approved_version_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  versions         BomVersion[]      @relation("BomVersions")
  approvedVersion  BomVersion?       @relation("BomApprovedVersion", fields: [approvedVersionId], references: [id])
  materialRequests MaterialRequest[]
  productionOrders ProductionOrder[]

  @@map("boms")
}

enum BomVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

// Append-only, mirroring SampleVersion's proven shape: the prior APPROVED
// version flips to SUPERSEDED the moment a new one is approved, so
// "which version was approved and used at a given time" is always
// answerable — the exact traceability BOM never had before this model
// existed (see docs/PRACTICAL_BUSINESS_READY_AUDIT.md Section 4).
model BomVersion {
  id               String           @id @default(uuid()) @db.Uuid
  bomId            String           @map("bom_id") @db.Uuid
  versionNumber    Int              @map("version_number")
  status           BomVersionStatus @default(DRAFT)
  notes            String?
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?        @map("approved_at")

  bom            Bom       @relation("BomVersions", fields: [bomId], references: [id])
  approvedForBom Bom?      @relation("BomApprovedVersion")
  createdBy      User      @relation("BomVersionCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy     User?     @relation("BomVersionApprovedBy", fields: [approvedByUserId], references: [id])
  items          BomItem[]

  @@unique([bomId, versionNumber])
  @@map("bom_versions")
}

model BomItem {
  id                String   @id @default(uuid()) @db.Uuid
  bomVersionId      String   @map("bom_version_id") @db.Uuid
  materialId        String   @map("material_id") @db.Uuid
  // Optional per-color consumption line (e.g. thread color matching the
  // garment's own color) — null means "applies to every color" on this
  // style. Duplicate/overlap combinations (same material twice, or a null
  // line coexisting with a specific-color line for the same material) are
  // rejected at the service layer, not by a DB constraint (Postgres treats
  // NULL as distinct in a unique index, which wouldn't catch the overlap).
  colorId           String?  @map("color_id") @db.Uuid
  // Consumption per ONE finished garment piece, denominated in `uomId`.
  quantityPerUnit   Decimal  @map("quantity_per_unit") @db.Decimal(18, 4)
  // Effective qty = quantityPerUnit * (1 + wastagePercentage/100).
  wastagePercentage Decimal  @default(0) @map("wastage_percentage") @db.Decimal(5, 2)
  uomId             String   @map("uom_id") @db.Uuid
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  bomVersion BomVersion    @relation(fields: [bomVersionId], references: [id])
  material   Product       @relation("BomItemMaterial", fields: [materialId], references: [id])
  color      Color?        @relation(fields: [colorId], references: [id])
  uom        UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@index([bomVersionId])
  @@map("bom_items")
}

// ─────────────────────────────────────────────────────────────
// Purchasing (pulled forward from Phase 6 — Purchase Order + Goods Receipt,
// with fabric roll-level tracking on receipt)
// ─────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT_TO_SUPPLIER
  // Only reachable as an automatic side effect of createGoodsReceipt() —
  // never via the generic status-change endpoint, same discipline as
  // SalesOrderStatus.IN_PRODUCTION being reserved for a real business action.
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  ON_HOLD
  CANCELLED
}

model PurchaseOrder {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @map("company_id") @db.Uuid
  branchId             String?              @map("branch_id") @db.Uuid
  orderNumber          String               @map("order_number")
  supplierId           String               @map("supplier_id") @db.Uuid
  orderDate            DateTime             @map("order_date") @db.Date
  expectedDeliveryDate DateTime?            @map("expected_delivery_date") @db.Date
  status               PurchaseOrderStatus  @default(DRAFT)
  statusBeforeHold     PurchaseOrderStatus? @map("status_before_hold")
  // Always company.baseCurrencyCode, never supplier.defaultCurrencyCode —
  // applying the Sales Order currency-defaulting lesson (CLAUDE.md, 2026-08-20)
  // proactively instead of repeating the same mistake here.
  currencyCode         String               @map("currency_code") @db.Char(3)
  exchangeRate         Decimal              @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode     String               @map("base_currency_code") @db.Char(3)
  totalAmount          Decimal              @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount      Decimal              @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  requestedByUserId    String               @map("requested_by_user_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  company          Company             @relation(fields: [companyId], references: [id])
  branch           Branch?             @relation(fields: [branchId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  requestedBy      User                @relation("PurchaseOrderRequestedBy", fields: [requestedByUserId], references: [id])
  items            PurchaseOrderItem[]
  receipts         GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, supplierId])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                    String   @id @default(uuid()) @db.Uuid
  purchaseOrderId       String   @map("purchase_order_id") @db.Uuid
  // RAW_MATERIAL only — enforced at the service layer (query filter), not a
  // DB constraint, matching how the Products STYLE/RAW_MATERIAL split already
  // works everywhere else in this schema.
  productId             String   @map("product_id") @db.Uuid
  uomId                 String   @map("uom_id") @db.Uuid
  orderedQuantity       Decimal  @map("ordered_quantity") @db.Decimal(18, 4)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(18, 2)
  // Cumulative accumulator, incremented atomically per receipt via a guarded
  // updateMany (see purchase-order.service.ts) — never a plain read-then-write.
  receivedQuantity      Decimal  @default(0) @map("received_quantity") @db.Decimal(18, 4)
  // Cumulative accumulator, incremented only at Purchase Invoice POST time
  // (never at DRAFT-creation) via a raw-SQL guarded update comparing against
  // the LIVE receivedQuantity column (see PurchaseOrderItemRepository —
  // Prisma's updateMany cannot express a column-to-column comparison, so the
  // usual guarded-updateMany idiom doesn't apply here). receivedQuantity's
  // own decrement (goods-receipt reversal) is guarded symmetrically against
  // this column, so it can never drop below what's already been invoiced.
  invoicedQuantity      Decimal  @default(0) @map("invoiced_quantity") @db.Decimal(18, 4)
  notes                 String?
  // Which Colors-master color this line is for, and (optionally) the exact
  // physical shade/Pantone within it — same two-column shape already proven
  // on SampleMaterial.colorId/dyeId, captured at request/creation time and
  // then just plain columns for the rest of this PO's own lifecycle (no
  // per-status logic needed for it to keep showing through Approved and
  // Sent to Supplier). Direct user ask (2026-09-05), scoped to Purchase
  // Order only — not threaded through Material Request/BOM-generated POs.
  colorId               String?  @map("color_id") @db.Uuid
  dyeId                 String?  @map("dye_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  // The authoritative FK for the optional Material Request -> Purchase Order
  // link (mirrors BuyerEnquiryLine.sampleRequestId's shape) — set only by
  // generatePurchaseOrdersForShortfall(), never by direct PO creation.
  // Deliberately NOT @unique — a single MaterialRequestItem can legitimately
  // spawn more than one PurchaseOrderItem over its lifetime (a first PO for
  // part of a shortfall, a later one for the rest, since PO quantity is
  // user-edited and never forced to equal the full remaining shortfall).
  materialRequestItemId String?  @map("material_request_item_id") @db.Uuid

  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  product              Product               @relation(fields: [productId], references: [id])
  uom                  UnitOfMeasure         @relation(fields: [uomId], references: [id])
  color                Color?                @relation(fields: [colorId], references: [id])
  dye                  FabricDye?            @relation(fields: [dyeId], references: [id])
  goodsReceiptItems    GoodsReceiptItem[]
  materialRequestItem  MaterialRequestItem?  @relation(fields: [materialRequestItemId], references: [id])
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([purchaseOrderId])
  @@index([materialRequestItemId])
  @@map("purchase_order_items")
}

// Internal-only: "which department/production needs which material" — owned
// by Inventory, deliberately carries no supplier/pricing/commercial fields at
// all (that's what makes it different from a Purchase Requisition/Purchase
// Order). Lines are simply fulfilled from stock (Material Issue) or, when
// stock falls short, optionally escalated to Purchasing as a real Purchase
// Order — escalation is never automatic and never gates on any approval step.
enum MaterialRequestStatus {
  OPEN
  // Reachable only as a derived side effect of issuing/escalating lines —
  // never hand-set via a generic status-change endpoint, same discipline as
  // BuyerEnquiry.status/PurchaseOrderStatus.PARTIALLY_RECEIVED.
  PARTIALLY_FULFILLED
  FULFILLED
  // Manual, only reachable from OPEN/PARTIALLY_FULFILLED.
  CLOSED
  ON_HOLD
  CANCELLED
}

enum MaterialRequestType {
  // The normal BOM-driven requirement, whether created manually or via
  // "Generate Material Request" from BOM/MRP shortfall.
  PRODUCTION_REQUIREMENT
  // An additional requirement caused by real production-floor damage —
  // never modifies the original request/BOM, always a new document that
  // references it via originalMaterialRequestId.
  DAMAGE_REPLACEMENT
}

model MaterialRequest {
  id                        String                 @id @default(uuid()) @db.Uuid
  companyId                 String                 @map("company_id") @db.Uuid
  branchId                  String?                @map("branch_id") @db.Uuid
  requestNumber             String                 @map("request_number")
  requestType               MaterialRequestType    @default(PRODUCTION_REQUIREMENT) @map("request_type")
  departmentId              String?                @map("department_id") @db.Uuid
  // Where the material should be issued from — required, unlike Purchase
  // Order's optional "Receive At", since Material Issue must decrement a
  // specific warehouse's real StockBalance.
  warehouseId               String                 @map("warehouse_id") @db.Uuid
  requiredDate              DateTime?              @map("required_date") @db.Date
  // Free-text "why" (e.g. "cutting shortage for Lot 42") — deliberately not a
  // structured reason-code table, matches the project's existing preference
  // for a single free-text reference field over several rigid ones.
  purpose                   String?
  // Nullable traceability only — a manually-raised request simply leaves
  // this null.
  salesOrderId              String?                @map("sales_order_id") @db.Uuid
  // Nullable traceability to the Production Order this requirement was
  // generated for (Phase 5C) — a request raised directly from BOM/MRP
  // against a Sales Order, with no Production Order yet, simply leaves this
  // null; both fields can be set together once a Production Order exists.
  productionOrderId         String?                @map("production_order_id") @db.Uuid
  // Populated only when every line traces to exactly one style's BOM (a
  // multi-style-aggregated request leaves this null — salesOrderId remains
  // the primary traceability field; see material-request.service.ts).
  bomId                     String?                @map("bom_id") @db.Uuid
  // Set only when requestType = DAMAGE_REPLACEMENT — the original
  // requirement this damage relates to. Self-referencing rather than a
  // ProductionOrder FK, since no Production module exists yet (same
  // reasoning already applied above to salesOrderId).
  originalMaterialRequestId String?                @map("original_material_request_id") @db.Uuid
  remarks                   String?
  // Derived from lines except the manual ON_HOLD/CANCELLED/CLOSED
  // transitions — never hand-set to PARTIALLY_FULFILLED/FULFILLED.
  status                    MaterialRequestStatus  @default(OPEN)
  statusBeforeHold          MaterialRequestStatus? @map("status_before_hold")
  requestedByUserId         String                 @map("requested_by_user_id") @db.Uuid
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  company                 Company               @relation(fields: [companyId], references: [id])
  branch                  Branch?               @relation(fields: [branchId], references: [id])
  department              Department?           @relation(fields: [departmentId], references: [id])
  warehouse               Warehouse             @relation(fields: [warehouseId], references: [id])
  salesOrder              SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  productionOrder         ProductionOrder?      @relation(fields: [productionOrderId], references: [id])
  bom                     Bom?                  @relation(fields: [bomId], references: [id])
  originalMaterialRequest MaterialRequest?      @relation("MaterialRequestReplacementOrigin", fields: [originalMaterialRequestId], references: [id])
  replacementRequests     MaterialRequest[]     @relation("MaterialRequestReplacementOrigin")
  requestedBy             User                  @relation("MaterialRequestRequestedBy", fields: [requestedByUserId], references: [id])
  lines                   MaterialRequestItem[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@index([companyId, requestType])
  @@index([productionOrderId])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                       String   @id @default(uuid()) @db.Uuid
  materialRequestId        String   @map("material_request_id") @db.Uuid
  materialId               String   @map("material_id") @db.Uuid
  // Reuse the existing Color/FabricDye masters for shade precision — the
  // same shape already proven on SampleMaterial/PurchaseRequestItem before it.
  colorId                  String?  @map("color_id") @db.Uuid
  dyeId                    String?  @map("dye_id") @db.Uuid
  uomId                    String   @map("uom_id") @db.Uuid
  requestedQuantity        Decimal  @map("requested_quantity") @db.Decimal(18, 4)
  // Cumulative accumulator, incremented atomically per issue via a guarded
  // updateMany (see material-request.service.ts) — never a plain
  // read-then-write. No `rate`/pricing field at all — this line never becomes
  // a commercial document; deliberately no `lineStatus` column either, since
  // "pending/partially issued/fully issued/escalated" is fully derivable from
  // issuedQuantity + whether a purchaseOrderItem exists, and storing it too
  // would just be a second source of truth to drift out of sync.
  issuedQuantity           Decimal  @default(0) @map("issued_quantity") @db.Decimal(18, 4)
  // Guarded accumulator (same idiom as issuedQuantity) — incremented inside
  // createGoodsReceipt()'s existing transaction when a linked
  // PurchaseOrderItem is received, decremented inside
  // reverseGoodsReceiptLine()'s. Informational only — deliberately does NOT
  // reduce the line's remainingQuantity (a computed value); receiving goods
  // against a linked PO adds to general warehouse stock, it does not by
  // itself fulfill this request line — that still requires an explicit
  // Material Issue action.
  purchaseReceivedQuantity Decimal  @default(0) @map("purchase_received_quantity") @db.Decimal(18, 4)
  // Only meaningful when the owning request's requestType is
  // DAMAGE_REPLACEMENT — free text, same "no rigid reason-code table"
  // convention as MaterialRequest.purpose.
  damageReason             String?  @map("damage_reason")
  remarks                  String?
  // Which room/section within the request's own warehouse this line should
  // be issued from — traceability only, same reasoning as
  // StockMovementItem.warehouseLocationId above (passed through to the
  // ledger's existing warehouseLocationId; StockBalance has no location
  // dimension, so getAvailableQuantity() stays warehouse-level).
  warehouseLocationId      String?  @map("warehouse_location_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  materialRequest    MaterialRequest     @relation(fields: [materialRequestId], references: [id])
  material           Product             @relation("MaterialRequestItemMaterial", fields: [materialId], references: [id])
  color              Color?              @relation(fields: [colorId], references: [id])
  dye                FabricDye?          @relation(fields: [dyeId], references: [id])
  uom                UnitOfMeasure       @relation(fields: [uomId], references: [id])
  warehouseLocation  WarehouseLocation?  @relation(fields: [warehouseLocationId], references: [id])
  // Virtual back-relation only — the authoritative FK lives on
  // PurchaseOrderItem.materialRequestItemId (see that model). A line can
  // legitimately have more than one linked PurchaseOrderItem over its
  // lifetime (repeat/partial escalation) — see that model's own comment.
  purchaseOrderItems PurchaseOrderItem[]

  @@index([materialRequestId])
  @@map("material_request_items")
}

// CANCELLED means "every line fully reversed" — derived/cached, recomputed in
// the same transaction as every reversal, never hand-set by a caller.
enum GoodsReceiptStatus {
  COMPLETED
  PARTIALLY_REVERSED
  CANCELLED
}

model GoodsReceipt {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  branchId         String?            @map("branch_id") @db.Uuid
  receiptNumber    String             @map("receipt_number")
  purchaseOrderId  String             @map("purchase_order_id") @db.Uuid
  receivedDate     DateTime           @map("received_date") @db.Date
  receivedByUserId String             @map("received_by_user_id") @db.Uuid
  status           GoodsReceiptStatus @default(COMPLETED)
  // Client-generated, one per real create attempt (retried on a network
  // failure with the SAME key) — see CF-5 in the independent hardening
  // audit: without this, a lost response + a resubmitted identical POST both
  // succeed and double-post a real InventoryTransaction, since a fresh
  // document number is drawn on every call and nothing else identifies "this
  // is the same physical event, not a second one." Nullable because it's
  // opt-in per caller (a direct API caller that never supplies one simply
  // gets no idempotency protection — an accepted, documented gap, not a
  // silent one); @@unique is what turns a replayed request into "return the
  // original," not a second row.
  idempotencyKey   String?            @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyId], references: [id])
  branch        Branch?            @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User               @relation("GoodsReceiptReceivedBy", fields: [receivedByUserId], references: [id])
  items         GoodsReceiptItem[]

  @@unique([companyId, receiptNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String   @id @default(uuid()) @db.Uuid
  goodsReceiptId      String   @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String   @map("purchase_order_item_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  uomId               String   @map("uom_id") @db.Uuid
  receivedQuantity    Decimal  @map("received_quantity") @db.Decimal(18, 4)
  // "Already-reversed" cap accumulator — see reverseGoodsReceiptLine().
  reversedQuantity    Decimal  @default(0) @map("reversed_quantity") @db.Decimal(18, 4)
  warehouseId         String   @map("warehouse_id") @db.Uuid
  warehouseLocationId String?  @map("warehouse_location_id") @db.Uuid
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  uom               UnitOfMeasure      @relation(fields: [uomId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  rolls             FabricRoll[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

// PARTIALLY_USED/CONSUMED are reserved for Phase 5C's cutting-issuance — not
// reachable by this module, same "enum value nothing reaches yet" discipline
// as SampleStatus.DRAFT / SalesOrderStatus.IN_PRODUCTION.
enum FabricRollStatus {
  IN_STOCK
  PARTIALLY_USED
  CONSUMED
  DAMAGED
  CANCELLED
}

model FabricRoll {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  goodsReceiptItemId  String           @map("goods_receipt_item_id") @db.Uuid
  // Not unique company-wide — different suppliers routinely reuse roll
  // numbering ("R-001"). Just indexed for lookup; this row's own id (rendered
  // via the shared Barcode component) is the real identity.
  rollNumber          String           @map("roll_number")
  // The roll's own meterage/weight at receipt. Named distinctly from
  // GoodsReceiptItem.receivedQuantity / PurchaseOrderItem.receivedQuantity to
  // avoid the "same field name, three different meanings" ambiguity.
  rollQuantity        Decimal          @map("roll_quantity") @db.Decimal(18, 4)
  // Decremented by future reversals AND by Phase 5C cutting-issuance — one
  // field, one meaning: "still-available quantity on this physical roll."
  remainingQuantity   Decimal          @map("remaining_quantity") @db.Decimal(18, 4)
  batchNo             String?          @map("batch_no")
  // First real wiring of the standalone fabric masters built in Phase 3.
  // Single dominant composition for MVP — blends are a documented future
  // refinement, not built now.
  gsmId               String?          @map("gsm_id") @db.Uuid
  dyeId               String?          @map("dye_id") @db.Uuid
  weaveTypeId         String?          @map("weave_type_id") @db.Uuid
  widthId             String?          @map("width_id") @db.Uuid
  compositionId       String?          @map("composition_id") @db.Uuid
  warehouseLocationId String?          @map("warehouse_location_id") @db.Uuid
  status              FabricRollStatus @default(IN_STOCK)
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  goodsReceiptItem      GoodsReceiptItem       @relation(fields: [goodsReceiptItemId], references: [id])
  gsm                   FabricGsm?             @relation(fields: [gsmId], references: [id])
  dye                   FabricDye?             @relation(fields: [dyeId], references: [id])
  weaveType             FabricWeaveType?       @relation(fields: [weaveTypeId], references: [id])
  width                 FabricWidth?           @relation(fields: [widthId], references: [id])
  composition           FabricComposition?     @relation(fields: [compositionId], references: [id])
  warehouseLocation     WarehouseLocation?     @relation(fields: [warehouseLocationId], references: [id])
  inventoryTransactions InventoryTransaction[]
  jobWorkOrderMaterials JobWorkOrderMaterial[]

  @@index([companyId, rollNumber])
  @@index([goodsReceiptItemId])
  @@map("fabric_rolls")
}

// ─────────────────────────────────────────────────────────────
// Production (Phase 5C) — see PRODUCTION_MODULE_DESIGN.md for the full
// reviewed design. Core discipline: NO stage is ever named in schema or
// code — everything is generic over ProductionStage.id, validated only by
// its sequence/isActive/allowRework columns. ProductionStageTransaction is
// the single append-only ledger; JobOrder/JobOrderAssignment/
// JobOrderProgressEntry are the only work-tracking tables (no
// CuttingPlan/SewingProduction/FinishingRecord-style per-stage tables).
// ─────────────────────────────────────────────────────────────

enum ProductionOrderStatus {
  PLANNED
  MATERIAL_ALLOCATED
  IN_PROGRESS
  ON_HOLD
  CANCELLED
  CLOSED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ProductionOrder {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @map("company_id") @db.Uuid
  branchId          String?                @map("branch_id") @db.Uuid
  orderNumber       String                 @map("order_number")
  // Nullable — null means Make-to-Stock (no customer sale behind this run).
  salesOrderItemId  String?                @map("sales_order_item_id") @db.Uuid
  productId         String                 @map("product_id") @db.Uuid
  // Snapshot pointer for audit purposes — Bom itself has no versioning yet,
  // but this still records "the BOM as it existed" at order-creation time.
  bomId             String?                @map("bom_id") @db.Uuid
  plannedQuantity   Decimal                @map("planned_quantity") @db.Decimal(18, 4)
  status            ProductionOrderStatus  @default(PLANNED)
  statusBeforeHold  ProductionOrderStatus? @map("status_before_hold")
  priority          ProductionPriority     @default(NORMAL)
  plannedStartDate  DateTime?              @map("planned_start_date") @db.Date
  plannedEndDate    DateTime?              @map("planned_end_date") @db.Date
  actualStartDate   DateTime?              @map("actual_start_date") @db.Date
  actualEndDate     DateTime?              @map("actual_end_date") @db.Date
  // Internal counter for generating this order's own Lot-number suffixes
  // (PROD-2026-00001-L01, -L02, ...) — a sub-sequence per order, deliberately
  // not routed through the shared DocumentNumberingService (a different
  // concern: a per-company/fiscal-year document number vs. a per-order line
  // counter).
  nextLotSequence   Int                    @default(1) @map("next_lot_sequence")
  remarks           String?
  requestedByUserId String                 @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  company           Company                      @relation(fields: [companyId], references: [id])
  branch            Branch?                      @relation(fields: [branchId], references: [id])
  salesOrderItem    SalesOrderItem?              @relation(fields: [salesOrderItemId], references: [id])
  product           Product                      @relation(fields: [productId], references: [id])
  bom               Bom?                         @relation(fields: [bomId], references: [id])
  requestedBy       User                         @relation("ProductionOrderRequestedBy", fields: [requestedByUserId], references: [id])
  lots              Lot[]
  jobOrders         JobOrder[]
  stageTransactions ProductionStageTransaction[]
  qcInspections     QcInspection[]
  materialRequests  MaterialRequest[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([salesOrderItemId])
  @@index([productId])
  @@map("production_orders")
}

enum LotStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  // Terminal — this lot's full quantity was consumed by a SPLIT/MERGE
  // LotRelation. Never re-activated; genealogy is what remains traceable.
  SPLIT
  MERGED
  CANCELLED
}

// A Lot is first-class, not a string on another table — it has its own
// lifecycle, and (via LotRelation below) its own genealogy.
model Lot {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  productionOrderId String    @map("production_order_id") @db.Uuid
  lotNumber         String    @map("lot_number")
  // Immutable after creation except via a recorded split/merge event, which
  // closes this lot (status -> SPLIT/MERGED) rather than mutating it.
  quantity          Decimal   @map("quantity") @db.Decimal(18, 4)
  uomId             String    @map("uom_id") @db.Uuid
  status            LotStatus @default(PLANNED)
  // CACHE ONLY, refreshed whenever a ProductionStageTransaction posts for
  // this lot — never the source of truth for correctness-critical logic
  // (that's always "which JobOrders for this lot have no onward transaction
  // yet"). This is deliberate: it's what lets a future multi-position
  // (parallel-stage) upgrade be additive rather than a breaking migration —
  // see PRODUCTION_MODULE_DESIGN.md §6.
  currentStageId    String?   @map("current_stage_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company           Company                      @relation(fields: [companyId], references: [id])
  branch            Branch?                      @relation(fields: [branchId], references: [id])
  productionOrder   ProductionOrder              @relation(fields: [productionOrderId], references: [id])
  uom               UnitOfMeasure                @relation(fields: [uomId], references: [id])
  currentStage      ProductionStage?             @relation("LotCurrentStage", fields: [currentStageId], references: [id])
  createdBy         User                         @relation("LotCreatedBy", fields: [createdByUserId], references: [id])
  asParentRelations LotRelation[]                @relation("LotRelationParent")
  asChildRelations  LotRelation[]                @relation("LotRelationChild")
  jobOrders         JobOrder[]
  stageTransactions ProductionStageTransaction[]
  qcInspections     QcInspection[]

  @@unique([companyId, lotNumber])
  @@index([productionOrderId])
  @@index([companyId, status])
  @@map("lots")
}

enum LotRelationType {
  SPLIT
  MERGE
}

// Genealogy as a join table, not a single parentLotId column — a single FK
// can't represent MERGE (many parents -> one child). Full ancestry/descent
// in either direction is a plain recursive walk over this table; no separate
// materialized genealogy table needed.
model LotRelation {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  parentLotId       String          @map("parent_lot_id") @db.Uuid
  childLotId        String          @map("child_lot_id") @db.Uuid
  relationType      LotRelationType @map("relation_type")
  // The slice of the parent that went into this specific child. Split:
  // sum(children) must equal the parent's quantity exactly, in one
  // transaction (all-or-nothing — no partial split in V1). Merge: every
  // named parent is fully consumed; sum(parents) must equal the new child's
  // quantity exactly.
  quantity          Decimal         @map("quantity") @db.Decimal(18, 4)
  reason            String?
  performedByUserId String          @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime        @default(now()) @map("performed_at")

  company     Company @relation(fields: [companyId], references: [id])
  parentLot   Lot     @relation("LotRelationParent", fields: [parentLotId], references: [id])
  childLot    Lot     @relation("LotRelationChild", fields: [childLotId], references: [id])
  performedBy User    @relation("LotRelationPerformedBy", fields: [performedByUserId], references: [id])

  @@index([parentLotId])
  @@index([childLotId])
  @@map("lot_relations")
}

enum JobOrderStatus {
  PENDING
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  ON_HOLD
  CANCELLED
}

// Generic by construction: Lot x whatever ProductionStage a company has
// configured. Replaces every stage-named table (no CuttingPlan/
// SewingProduction/FinishingRecord) — this is the ONLY work-tracking header,
// for any stage, at any company. Auto-created (never hand-created) by the
// service layer whenever a ProductionStageTransaction posts a quantity into
// a stage — including the very first stage, a rework return, and a
// QC-driven revert, all through the same mechanism.
model JobOrder {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  productionOrderId String             @map("production_order_id") @db.Uuid
  lotId             String             @map("lot_id") @db.Uuid
  productionStageId String             @map("production_stage_id") @db.Uuid
  // Deterministic display code ({lotNumber}-{stageCode}-{n}), not a
  // fiscal-year document sequence.
  jobNumber         String             @map("job_number")
  // The JobOrder this one's input came from — null only for a lot's very
  // first stage entry.
  sourceJobOrderId  String?            @map("source_job_order_id") @db.Uuid
  productionLineId  String?            @map("production_line_id") @db.Uuid
  plannedQuantity   Decimal            @map("planned_quantity") @db.Decimal(18, 4)
  // Guarded accumulators — completed+rejected+damaged <= planned, enforced
  // by a service-layer read-verify-write inside one transaction AND a
  // Postgres CHECK constraint as a hard backstop (see migration SQL; this
  // 3-column constraint can't be expressed as the single-column guarded
  // updateMany idiom used everywhere else in this codebase).
  completedQuantity Decimal            @default(0) @map("completed_quantity") @db.Decimal(18, 4)
  rejectedQuantity  Decimal            @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity   Decimal            @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  // How much of completedQuantity has already been pushed to the next stage
  // — forwarding is an explicit action, never automatic on every progress
  // entry (this is what makes partial, continuous hand-off between stages
  // representable). Guarded: forwarded <= completed.
  forwardedQuantity Decimal            @default(0) @map("forwarded_quantity") @db.Decimal(18, 4)
  // Guarded: qcPassed <= completed — prevents double-QC-ing the same units.
  qcPassedQuantity  Decimal            @default(0) @map("qc_passed_quantity") @db.Decimal(18, 4)
  status            JobOrderStatus     @default(PENDING)
  priority          ProductionPriority @default(NORMAL)
  plannedStartAt    DateTime?          @map("planned_start_at")
  plannedEndAt      DateTime?          @map("planned_end_at")
  actualStartAt     DateTime?          @map("actual_start_at")
  actualEndAt       DateTime?          @map("actual_end_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  company              Company                      @relation(fields: [companyId], references: [id])
  productionOrder      ProductionOrder              @relation(fields: [productionOrderId], references: [id])
  lot                  Lot                          @relation(fields: [lotId], references: [id])
  productionStage      ProductionStage              @relation(fields: [productionStageId], references: [id])
  sourceJobOrder       JobOrder?                    @relation("JobOrderChain", fields: [sourceJobOrderId], references: [id])
  nextJobOrders        JobOrder[]                   @relation("JobOrderChain")
  productionLine       ProductionLine?              @relation(fields: [productionLineId], references: [id])
  assignments          JobOrderAssignment[]
  progressEntries      JobOrderProgressEntry[]
  incomingTransactions ProductionStageTransaction[] @relation("StageTransactionTo")
  outgoingTransactions ProductionStageTransaction[] @relation("StageTransactionFrom")
  qcInspections        QcInspection[]
  jobWorkOrders        JobWorkOrder[]

  // Not unique on (lotId, productionStageId) — a lot can legitimately
  // revisit the same stage after rework; each revisit is a NEW row, never an
  // update to an old one (history is never overwritten).
  @@index([lotId, productionStageId])
  @@index([productionOrderId])
  @@index([companyId, status])
  @@index([productionStageId])
  @@map("job_orders")
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REASSIGNED
  CANCELLED
}

// Multiple workers per JobOrder falls out of this directly — "multiple
// Cutting Masters on one lot" is just multiple rows here against the same
// Cutting-stage JobOrder. No separate "CuttingMaster" concept anywhere.
model JobOrderAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  jobOrderId       String           @map("job_order_id") @db.Uuid
  // Reuses the existing Employee master — NOT User. Tracking who did the
  // work never requires that person to have a login (see
  // PRODUCTION_MODULE_DESIGN.md §7).
  employeeId       String           @map("employee_id") @db.Uuid
  // Soft-validated (sum across a JobOrder's assignments should not exceed
  // plannedQuantity) at assignment time — not DB-enforced, since assignments
  // can be freely rebalanced before work actually starts.
  assignedQuantity Decimal          @map("assigned_quantity") @db.Decimal(18, 4)
  status           AssignmentStatus @default(ASSIGNED)
  assignedByUserId String           @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime         @default(now()) @map("assigned_at")
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")

  jobOrder        JobOrder                @relation(fields: [jobOrderId], references: [id])
  employee        Employee                @relation("JobOrderAssignmentEmployee", fields: [employeeId], references: [id])
  assignedBy      User                    @relation("JobOrderAssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  progressEntries JobOrderProgressEntry[]

  @@index([jobOrderId])
  @@index([employeeId])
  @@map("job_order_assignments")
}

// Append-only worker-level logging — never edited or deleted. A genuine
// data-entry mistake is corrected with a NEW isAdjustment=true row (the only
// kind allowed to carry a negative quantity), mirroring
// InventoryTransaction's own signed-reversal convention, rather than ever
// touching an existing row.
model JobOrderProgressEntry {
  id                   String                      @id @default(uuid()) @db.Uuid
  jobOrderId           String                      @map("job_order_id") @db.Uuid
  jobOrderAssignmentId String?                     @map("job_order_assignment_id") @db.Uuid
  // Nullable specifically for isAdjustment=true rows: a correction entry has
  // no real "worker" to attribute it to (recordAdjustmentEntry resolves the
  // acting User's own linked Employee via User.employeeId, which most
  // non-floor accounts — e.g. Super Admin — legitimately have none of).
  // Every non-adjustment row still always carries a real Employee.
  employeeId           String?                     @map("employee_id") @db.Uuid
  // Who is logged in and clicked save — may differ from employeeId (the
  // supervisor-entry model recommended for V1; see
  // PRODUCTION_MODULE_DESIGN.md §7).
  recordedByUserId     String                      @map("recorded_by_user_id") @db.Uuid
  completedQuantity    Decimal                     @default(0) @map("completed_quantity") @db.Decimal(18, 4)
  rejectedQuantity     Decimal                     @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity      Decimal                     @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  isAdjustment         Boolean                     @default(false) @map("is_adjustment")
  remarks              String?
  startedAt            DateTime?                   @map("started_at")
  endedAt              DateTime?                   @map("ended_at")
  // Discriminates the existing supervisor-direct path (recordProgressEntry,
  // applied immediately, no approval) from the new worker self-entry path
  // (submitSelfProgressEntry, held PENDING until a Supervisor decides).
  // Every pre-existing row and every future supervisor-entered row is
  // SUPERVISOR/NOT_REQUIRED — this table's original append-only, always-
  // final behavior is completely unchanged for that path.
  enteredBy            ProgressEntrySource         @default(SUPERVISOR) @map("entered_by")
  approvalStatus       ProgressEntryApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  approvalRemark       String?                     @map("approval_remark")
  approvedByUserId     String?                     @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?                   @map("approved_at")
  createdAt            DateTime                    @default(now()) @map("created_at")
  // New — the table was purely append-only before; a PENDING self-entry can
  // now be edited once by a Supervisor prior to their approve/reject decision.
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  jobOrder           JobOrder            @relation(fields: [jobOrderId], references: [id])
  jobOrderAssignment JobOrderAssignment? @relation(fields: [jobOrderAssignmentId], references: [id])
  employee           Employee?           @relation("JobOrderProgressEntryEmployee", fields: [employeeId], references: [id])
  recordedBy         User                @relation("JobOrderProgressEntryRecordedBy", fields: [recordedByUserId], references: [id])
  approvedBy         User?               @relation("JobOrderProgressEntryApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([jobOrderId])
  @@index([employeeId])
  @@index([approvalStatus])
  @@map("job_order_progress_entries")
}

enum ProgressEntrySource {
  SUPERVISOR
  SELF
}

enum ProgressEntryApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum StageTransactionType {
  FORWARD
  REWORK
  ADJUSTMENT
}

// The single append-only ledger — never edited, never deleted. Everything
// else (a lot's current position, a JobOrder's existence) is derived from
// this table; it is the actual source of truth in this module, the same
// role InventoryTransaction plays for stock.
model ProductionStageTransaction {
  id                    String               @id @default(uuid()) @db.Uuid
  companyId             String               @map("company_id") @db.Uuid
  productionOrderId     String               @map("production_order_id") @db.Uuid
  lotId                 String               @map("lot_id") @db.Uuid
  fromJobOrderId        String?              @map("from_job_order_id") @db.Uuid
  toJobOrderId          String               @map("to_job_order_id") @db.Uuid
  // Denormalized directly onto the transaction for fast reporting — same
  // rationale already used for FabricRoll.rollNumber-style denormalization
  // elsewhere in this schema.
  fromProductionStageId String?              @map("from_production_stage_id") @db.Uuid
  toProductionStageId   String               @map("to_production_stage_id") @db.Uuid
  transactionType       StageTransactionType @map("transaction_type")
  // Always positive — direction is expressed by from/to, not sign.
  quantity              Decimal              @map("quantity") @db.Decimal(18, 4)
  // Precomputed at insert (toStage.sequence < fromStage.sequence) for fast
  // querying/reporting.
  isBackward            Boolean              @default(false) @map("is_backward")
  // Required by the service layer whenever isBackward=true — not DB-enforced
  // (a conditionally-required field isn't expressible as a plain NOT NULL).
  revertReason          String?              @map("revert_reason")
  performedByUserId     String               @map("performed_by_user_id") @db.Uuid
  performedAt           DateTime             @default(now()) @map("performed_at")
  notes                 String?

  company                  Company          @relation(fields: [companyId], references: [id])
  productionOrder          ProductionOrder  @relation(fields: [productionOrderId], references: [id])
  lot                      Lot              @relation(fields: [lotId], references: [id])
  fromJobOrder             JobOrder?        @relation("StageTransactionFrom", fields: [fromJobOrderId], references: [id])
  toJobOrder               JobOrder         @relation("StageTransactionTo", fields: [toJobOrderId], references: [id])
  fromProductionStage      ProductionStage? @relation("StageTransactionFromStage", fields: [fromProductionStageId], references: [id])
  toProductionStage        ProductionStage  @relation("StageTransactionToStage", fields: [toProductionStageId], references: [id])
  performedBy              User             @relation("ProductionStageTransactionPerformedBy", fields: [performedByUserId], references: [id])
  qcInspectionsCausingThis QcInspection[]   @relation("QcInspectionReworkTransaction")

  @@index([lotId, performedAt])
  @@index([toProductionStageId])
  @@index([productionOrderId])
  @@map("production_stage_transactions")
}

enum QcResult {
  PASS
  PARTIAL_PASS
  FAIL
}

// Generic by construction: keyed on jobOrderId, never a stage name. No
// SewingQC/FinishingQC-style tables. A Fail or Partial-Pass creates a new
// ProductionStageTransaction (REWORK) using the exact same target-stage
// validation function as a manual revert — one mechanism, not two.
model QcInspection {
  id                       String   @id @default(uuid()) @db.Uuid
  companyId                String   @map("company_id") @db.Uuid
  productionOrderId        String   @map("production_order_id") @db.Uuid
  lotId                    String   @map("lot_id") @db.Uuid
  jobOrderId               String   @map("job_order_id") @db.Uuid
  inspectedQuantity        Decimal  @map("inspected_quantity") @db.Decimal(18, 4)
  acceptedQuantity         Decimal  @map("accepted_quantity") @db.Decimal(18, 4)
  rejectedQuantity         Decimal  @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity          Decimal  @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  result                   QcResult
  reworkStageTransactionId String?  @map("rework_stage_transaction_id") @db.Uuid
  inspectorUserId          String   @map("inspector_user_id") @db.Uuid
  inspectedAt              DateTime @default(now()) @map("inspected_at")
  remarks                  String?

  company                Company                     @relation(fields: [companyId], references: [id])
  productionOrder        ProductionOrder             @relation(fields: [productionOrderId], references: [id])
  lot                    Lot                         @relation(fields: [lotId], references: [id])
  jobOrder               JobOrder                    @relation(fields: [jobOrderId], references: [id])
  reworkStageTransaction ProductionStageTransaction? @relation("QcInspectionReworkTransaction", fields: [reworkStageTransactionId], references: [id])
  inspector              User                        @relation("QcInspectionInspector", fields: [inspectorUserId], references: [id])
  defects                QcDefect[]

  @@index([jobOrderId])
  @@index([lotId])
  @@map("qc_inspections")
}

model QcDefect {
  id             String  @id @default(uuid()) @db.Uuid
  qcInspectionId String  @map("qc_inspection_id") @db.Uuid
  defectTypeId   String  @map("defect_type_id") @db.Uuid
  quantity       Decimal @map("quantity") @db.Decimal(18, 4)
  severity       String?
  remarks        String?

  qcInspection QcInspection @relation(fields: [qcInspectionId], references: [id])
  defectType   DefectType   @relation(fields: [defectTypeId], references: [id])

  @@index([qcInspectionId])
  @@map("qc_defects")
}

// Company-configurable defect catalogue — same shape as ProductionStage/
// Color/Size etc.
model DefectType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  qcDefects QcDefect[]

  @@unique([companyId, code])
  @@map("defect_types")
}

enum JobWorkOrderStatus {
  ISSUED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum JobWorkReceiptStatus {
  COMPLETED
  PARTIALLY_REVERSED
  CANCELLED
}

// External job-work: an alternative fulfillment path for an existing
// JobOrder's completed/rejected/damaged accumulators — the same three
// columns internal JobOrderProgressEntry recording already drives, guarded
// by the same applyJobOrderQuantityDelta() in job-order.service.ts. This is
// deliberately NOT a parallel production system: once a JobWorkReceipt
// applies its delta onto the parent JobOrder, the already-built
// forwardJobOrder()/recordQcInspection() become usable on that quantity for
// free, with zero changes to either. issuedQuantity draws down the parent
// JobOrder's "remaining/unprocessed" pool (plannedQuantity - completed -
// rejected - damaged), the exact same pool internal Assign+Progress draws
// from — job-work-out is an external alternative to that, not a different
// concept.
model JobWorkOrder {
  id                     String              @id @default(uuid()) @db.Uuid
  companyId              String              @map("company_id") @db.Uuid
  branchId               String?             @map("branch_id") @db.Uuid
  jobWorkNumber          String              @map("job_work_number")
  supplierId             String              @map("supplier_id") @db.Uuid
  jobOrderId             String              @map("job_order_id") @db.Uuid
  issuedQuantity         Decimal             @map("issued_quantity") @db.Decimal(18, 4)
  uomId                  String              @map("uom_id") @db.Uuid
  issueDate              DateTime            @map("issue_date") @db.Date
  expectedCompletionDate DateTime?           @map("expected_completion_date") @db.Date
  status                 JobWorkOrderStatus  @default(ISSUED)
  statusBeforeHold       JobWorkOrderStatus? @map("status_before_hold")
  // Guarded accumulators — the exact PurchaseOrderItem.receivedQuantity
  // idiom, capped at issuedQuantity via a guarded updateMany, never a
  // plain read-then-write.
  receivedQuantity       Decimal             @default(0) @map("received_quantity") @db.Decimal(18, 4)
  rejectedQuantity       Decimal             @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity        Decimal             @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  remarks                String?
  requestedByUserId      String              @map("requested_by_user_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  company     Company                @relation(fields: [companyId], references: [id])
  branch      Branch?                @relation(fields: [branchId], references: [id])
  supplier    Supplier               @relation(fields: [supplierId], references: [id])
  jobOrder    JobOrder               @relation(fields: [jobOrderId], references: [id])
  uom         UnitOfMeasure          @relation(fields: [uomId], references: [id])
  requestedBy User                   @relation(fields: [requestedByUserId], references: [id])
  materials   JobWorkOrderMaterial[]
  receipts    JobWorkReceipt[]

  @@unique([companyId, jobWorkNumber])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([jobOrderId])
  @@map("job_work_orders")
}

// Optional raw-material lines accompanying the WIP goods sent to the
// contractor (e.g. trims/extra fabric) — a genuinely separate concern from
// the WIP quantity itself, since these DO have a real StockBalance row to
// decrement. Each line posts one JOB_WORK_ISSUE ledger transaction; no
// return-of-unused-material flow in this pass (see the enum comment).
model JobWorkOrderMaterial {
  id             String  @id @default(uuid()) @db.Uuid
  jobWorkOrderId String  @map("job_work_order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Decimal @db.Decimal(18, 4)
  uomId          String  @map("uom_id") @db.Uuid
  warehouseId    String  @map("warehouse_id") @db.Uuid
  fabricRollId   String? @map("fabric_roll_id") @db.Uuid
  notes          String?

  jobWorkOrder JobWorkOrder  @relation(fields: [jobWorkOrderId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  uom          UnitOfMeasure @relation(fields: [uomId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  fabricRoll   FabricRoll?   @relation(fields: [fabricRollId], references: [id])

  @@map("job_work_order_materials")
}

// Mirrors GoodsReceipt's shape exactly: one JobWorkOrder can have several
// receipts (partial/multi-shipment return from the contractor). receiptNumber
// is a simple "<jobWorkNumber>-R<n>" computed at create time, not a global
// atomic document-number sequence — mirrors SampleVersion's own
// scoped-to-parent numbering, since this is sub-document numbering, not a
// standalone business document.
model JobWorkReceipt {
  id               String               @id @default(uuid()) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  jobWorkOrderId   String               @map("job_work_order_id") @db.Uuid
  receiptNumber    String               @map("receipt_number")
  receivedDate     DateTime             @map("received_date") @db.Date
  receivedQuantity Decimal              @map("received_quantity") @db.Decimal(18, 4)
  rejectedQuantity Decimal              @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity  Decimal              @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  status           JobWorkReceiptStatus @default(COMPLETED)
  remarks          String?
  receivedByUserId String               @map("received_by_user_id") @db.Uuid
  // CF-5: no branchId field exists on this model at all, so this is
  // naturally company-only already — see StockMovement.idempotencyKey for
  // why company-only (not branch-inclusive) is the deliberate choice anyway.
  idempotencyKey   String?              @map("idempotency_key")
  createdAt        DateTime             @default(now()) @map("created_at")

  company      Company      @relation(fields: [companyId], references: [id])
  jobWorkOrder JobWorkOrder @relation(fields: [jobWorkOrderId], references: [id])
  receivedBy   User         @relation(fields: [receivedByUserId], references: [id])

  @@unique([companyId, jobWorkOrderId, receiptNumber])
  @@unique([companyId, idempotencyKey])
  @@index([jobWorkOrderId])
  @@map("job_work_receipts")
}

// Only GOODS_RECEIPT and GOODS_RECEIPT_REVERSAL are reachable by Purchasing —
// PRODUCTION_RECEIPT/DAMAGE are Phase 5C's own, ADJUSTMENT/STOCK_TRANSFER/
// RETURN_TO_SUPPLIER are StockMovement's (Phase 6), DISPATCH is Phase 8's own.
// OPENING_BALANCE's manual entry point is explicitly deferred (see CLAUDE.md).
enum InventoryTransactionType {
  OPENING_BALANCE
  GOODS_RECEIPT
  GOODS_RECEIPT_REVERSAL
  MATERIAL_ISSUE
  PRODUCTION_RECEIPT
  // Fully-damaged production quantity posted into a REJECT-type warehouse —
  // repairable damage never touches inventory at all, it's purely a backward
  // ProductionStageTransaction (see PRODUCTION_MODULE_DESIGN.md §6).
  DAMAGE
  ADJUSTMENT
  STOCK_TRANSFER
  // Stock leaving a warehouse back to a supplier — the physical/stock side
  // only; a supplier credit note is a Phase 7 (Accounts) concept that
  // doesn't exist yet, deliberately not modeled here.
  RETURN_TO_SUPPLIER
  // Finished-Goods stock leaving the warehouse against a confirmed Dispatch
  // (Phase 8) — always a negative quantity, posted only at Confirm Dispatch
  // time (never at Draft/Packed), matching every other module's "post-time,
  // not draft-time" ledger discipline.
  DISPATCH
  // Raw-material lines handed to an external job-work contractor alongside
  // a JobOrder's WIP quantity (see JobWorkOrder) — the WIP quantity itself
  // never posts here, since it has no StockBalance row to decrement (its
  // location is tracked structurally via the JobOrder/stage graph, not the
  // inventory ledger).
  JOB_WORK_ISSUE
  // Posted when a Job Work Order with zero receipts against it is cancelled
  // — returns its issued raw-material lines to stock. Deliberately a
  // dedicated reversal type (matching GOODS_RECEIPT_REVERSAL's precedent)
  // rather than reusing JOB_WORK_ISSUE with a flipped sign, so the ledger
  // itself makes the cancellation-driven return legible.
  JOB_WORK_ISSUE_REVERSAL
}

// Append-only, source of truth — no delete column, no edit path, ever.
// Corrections are always a new compensating row, never an update to an
// existing one (the project's established ledger discipline).
model InventoryTransaction {
  id                  String                   @id @default(uuid()) @db.Uuid
  companyId           String                   @map("company_id") @db.Uuid
  branchId            String?                  @map("branch_id") @db.Uuid
  productId           String                   @map("product_id") @db.Uuid
  warehouseId         String                   @map("warehouse_id") @db.Uuid
  warehouseLocationId String?                  @map("warehouse_location_id") @db.Uuid
  transactionType     InventoryTransactionType @map("transaction_type")
  // Signed: positive for a receipt, negative for a reversal/issue.
  quantity            Decimal                  @map("quantity") @db.Decimal(18, 4)
  // Polymorphic discriminator — reuses the existing RelatedModule enum
  // instead of inventing a parallel one, matching the Attachment/AuditLog
  // convention already established for this class of table.
  referenceModule     RelatedModule            @map("reference_module")
  referenceRecordId   String                   @map("reference_record_id") @db.Uuid
  fabricRollId        String?                  @map("fabric_roll_id") @db.Uuid
  performedByUserId   String                   @map("performed_by_user_id") @db.Uuid
  performedAt         DateTime                 @default(now()) @map("performed_at")
  notes               String?

  company           Company            @relation(fields: [companyId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  fabricRoll        FabricRoll?        @relation(fields: [fabricRollId], references: [id])
  performedBy       User               @relation("InventoryTransactionPerformedBy", fields: [performedByUserId], references: [id])

  @@index([companyId, productId, warehouseId])
  @@index([referenceModule, referenceRecordId])
  @@index([fabricRollId])
  @@map("inventory_transactions")
}

// Derived cache — upserted in the SAME transaction as every InventoryTransaction
// insert that justifies it, never computed by summing the ledger at read time.
model StockBalance {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@map("stock_balances")
}

// A single unified header for the three remaining Phase 6 stock-movement
// documents (Consolidation decision from Phase 1's architecture doc:
// "material issues/returns/transfers merged into one stock_movements table
// via a movement_type discriminator" — Material Request's own ISSUE already
// has its own dedicated flow and is NOT part of this table). Immutable once
// created, matching every other inventory/financial transactional table in
// this project — no delete/edit column; a mistake is corrected with a new,
// opposite-direction StockMovement, never an update to an existing one.
enum StockMovementType {
  TRANSFER
  ADJUSTMENT
  RETURN_TO_SUPPLIER
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  branchId          String?           @map("branch_id") @db.Uuid
  movementNumber    String            @map("movement_number")
  movementType      StockMovementType @map("movement_type")
  // TRANSFER: the source warehouse. ADJUSTMENT / RETURN_TO_SUPPLIER: the
  // only warehouse involved.
  warehouseId       String            @map("warehouse_id") @db.Uuid
  // TRANSFER only — the destination warehouse.
  toWarehouseId     String?           @map("to_warehouse_id") @db.Uuid
  // RETURN_TO_SUPPLIER only.
  supplierId        String?           @map("supplier_id") @db.Uuid
  // Required for ADJUSTMENT (a stock discrepancy correction should always
  // explain why); optional context for TRANSFER/RETURN_TO_SUPPLIER.
  reason            String?
  remarks           String?
  performedByUserId String            @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime          @default(now()) @map("performed_at")
  // CF-5: see GoodsReceipt.idempotencyKey for the full rationale. Company-only
  // (not branch-inclusive) deliberately — a nullable branchId in a composite
  // unique would let Postgres treat every null-branch row as non-conflicting
  // with every other, silently defeating the protection for exactly the
  // common case (no branch set) this is meant to cover.
  idempotencyKey    String?           @map("idempotency_key")
  createdAt         DateTime          @default(now()) @map("created_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  warehouse   Warehouse           @relation("StockMovementSourceWarehouse", fields: [warehouseId], references: [id])
  toWarehouse Warehouse?          @relation("StockMovementDestinationWarehouse", fields: [toWarehouseId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  performedBy User                @relation("StockMovementPerformedBy", fields: [performedByUserId], references: [id])
  items       StockMovementItem[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, movementType])
  @@index([companyId, warehouseId])
  @@map("stock_movements")
}

model StockMovementItem {
  id                  String  @id @default(uuid()) @db.Uuid
  stockMovementId     String  @map("stock_movement_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  uomId               String  @map("uom_id") @db.Uuid
  // TRANSFER / RETURN_TO_SUPPLIER: always positive (the quantity moved or
  // returned). ADJUSTMENT: signed — positive means stock found on a
  // physical count, negative means shrinkage/write-off.
  quantity            Decimal @db.Decimal(18, 4)
  remarks             String?
  // Which room/section within the SOURCE warehouse this line's stock is
  // coming from — traceability only (passed straight through to the ledger's
  // own existing warehouseLocationId, exactly like GoodsReceiptItem already
  // does), not a stock-availability dimension: StockBalance has no location
  // column, so getAvailableQuantity() stays warehouse-level. The destination
  // side of a TRANSFER has no location field — out of scope for this pass.
  warehouseLocationId String? @map("warehouse_location_id") @db.Uuid

  stockMovement     StockMovement      @relation(fields: [stockMovementId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  uom               UnitOfMeasure      @relation(fields: [uomId], references: [id])
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])

  @@index([stockMovementId])
  @@map("stock_movement_items")
}

// ─────────────────────────────────────────────────────────────
// Dispatch (Phase 8) — the shipping workflow that fulfills a confirmed Sales
// Order: pick which style lines/quantities to ship, pack them into Cartons,
// confirm the shipment (which decrements Finished-Goods stock), and record
// delivery. Deliberately consolidated — no separate PickingList/PackingList
// tables (picking/packing are status states on this one document, matching
// the project's own Material-Request/Stock-Movement consolidation
// precedent) — and deliberately product-level only for the real stock
// check/decrement (the FG ledger has no productVariantId dimension at all,
// same as Production's Lot/JobOrder; CartonItem's own productVariantId is
// informational/for packing-list labeling only, never enforced against
// per-variant stock — see CLAUDE.md for the full reasoning).
// ─────────────────────────────────────────────────────────────

enum DispatchStatus {
  DRAFT
  PACKED
  DISPATCHED
  DELIVERED
  ON_HOLD
  CANCELLED
}

model Dispatch {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  branchId          String?         @map("branch_id") @db.Uuid
  dispatchNumber    String          @map("dispatch_number")
  // Required — Dispatch always fulfills a real Sales Order; a make-to-stock
  // shipment with no formal order (e.g. straight to a distributor) has no
  // Dispatch path this slice — use a plain StockMovement (STOCK_TRANSFER)
  // if that's ever actually needed. Revisit only if requested.
  salesOrderId      String          @map("sales_order_id") @db.Uuid
  // Denormalized from the order — this table is itself the shipping
  // document of record, same justification as SalesInvoice.customerId.
  customerId        String          @map("customer_id") @db.Uuid
  // The source Finished-Goods warehouse this shipment is issued from.
  warehouseId       String          @map("warehouse_id") @db.Uuid
  dispatchDate      DateTime        @map("dispatch_date") @db.Date
  status            DispatchStatus  @default(DRAFT)
  statusBeforeHold  DispatchStatus? @map("status_before_hold")
  deliveryAddress   String          @map("delivery_address")
  transporterName   String?         @map("transporter_name")
  vehicleNumber     String?         @map("vehicle_number")
  trackingNumber    String?         @map("tracking_number")
  // Stamped only inside confirmDispatch()'s own transaction, the moment the
  // ledger is actually touched — a hard fact, not a status label, that
  // cancelDispatch() checks directly and unconditionally (see
  // dispatch.service.ts) rather than trusting the current status alone,
  // the same lesson this project already learned twice (Sampling's Hold/
  // Resume bug, Purchasing's cancel-from-ON_HOLD bug).
  dispatchedAt      DateTime?       @map("dispatched_at")
  deliveredAt       DateTime?       @map("delivered_at")
  receivedByName    String?         @map("received_by_name")
  requestedByUserId String          @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  company     Company        @relation(fields: [companyId], references: [id])
  branch      Branch?        @relation(fields: [branchId], references: [id])
  salesOrder  SalesOrder     @relation(fields: [salesOrderId], references: [id])
  customer    Customer       @relation(fields: [customerId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  requestedBy User           @relation("DispatchRequestedBy", fields: [requestedByUserId], references: [id])
  items       DispatchItem[]
  cartons     Carton[]

  @@unique([companyId, branchId, dispatchNumber])
  @@map("dispatches")
}

model DispatchItem {
  id                 String   @id @default(uuid()) @db.Uuid
  dispatchId         String   @map("dispatch_id") @db.Uuid
  salesOrderItemId   String   @map("sales_order_item_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  dispatchedQuantity Int      @map("dispatched_quantity")
  createdAt          DateTime @default(now()) @map("created_at")

  dispatch       Dispatch       @relation(fields: [dispatchId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  cartonItems    CartonItem[]

  @@index([dispatchId])
  @@map("dispatch_items")
}

model Carton {
  id            String   @id @default(uuid()) @db.Uuid
  dispatchId    String   @map("dispatch_id") @db.Uuid
  cartonNumber  Int      @map("carton_number")
  // Rollup of its own CartonItems — stored for display convenience, same
  // "stored rollup, not always-live-computed" pattern used elsewhere
  // (SalesOrder.totalAmount, PurchaseOrderItem.receivedQuantity).
  totalQuantity Int      @default(0) @map("total_quantity")
  createdAt     DateTime @default(now()) @map("created_at")

  dispatch Dispatch     @relation(fields: [dispatchId], references: [id])
  items    CartonItem[]

  @@unique([dispatchId, cartonNumber])
  @@map("cartons")
}

model CartonItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartonId         String   @map("carton_id") @db.Uuid
  dispatchItemId   String   @map("dispatch_item_id") @db.Uuid
  // Nullable — only set when the style has generated variants. This is the
  // real color/size packing detail (informational/for packing-list labeling
  // only — never enforced against per-variant stock, see the section
  // comment above).
  productVariantId String?  @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at")

  carton         Carton          @relation(fields: [cartonId], references: [id])
  dispatchItem   DispatchItem    @relation(fields: [dispatchItemId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([cartonId])
  @@index([dispatchItemId])
  @@map("carton_items")
}

// ─────────────────────────────────────────────────────────────
// Accounts (Phase 7A — Chart of Accounts, Tax Config, Journal Engine)
//
// First slice of Phase 7. Sales/Purchase Invoices, Payments+Allocations, and
// Expenses are NOT part of this slice — they're later slices that will post
// through the Journal engine built here. Multi-currency is deliberately out
// of scope (JournalLine amounts are base-currency-only), matching the
// project-wide multi-currency-UI deferral already applied to SalesOrder/
// PurchaseOrder.
// ─────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model ChartOfAccount {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  code            String
  name            String
  accountType     AccountType @map("account_type")
  // Self-relation, schema-only for now — no hierarchy UI yet, matching the
  // ProductionStage.parentStageId precedent (column exists, exposed later
  // when actually needed). NOT YET DECIDED: nothing here distinguishes a
  // postable "leaf" account from a rollup "group" account (e.g. a future
  // isGroup/postable flag) — deliberately deferred, not solved, so whichever
  // slice builds the hierarchy UI doesn't rediscover this as a surprise.
  parentAccountId String?     @map("parent_account_id") @db.Uuid
  // Protects control accounts (AR/AP/GST) seeded by prisma/seed.ts from
  // deactivation — checked alongside the JournalLine-reference guard, not a
  // replacement for it.
  isSystemAccount Boolean     @default(false) @map("is_system_account")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company                       Company                     @relation(fields: [companyId], references: [id])
  parentAccount                 ChartOfAccount?             @relation("ChartOfAccountParent", fields: [parentAccountId], references: [id])
  childAccounts                 ChartOfAccount[]            @relation("ChartOfAccountParent")
  journalLines                  JournalLine[]
  expenses                      Expense[]
  customInvoicesAsIncomeAccount CustomInvoice[]
  employeeAdvanceSettlements    EmployeeAdvanceSettlement[]
  purchaseInvoiceDirectLines    PurchaseInvoiceItem[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

model TaxType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company   @relation(fields: [companyId], references: [id])
  rates   TaxRate[]

  @@unique([companyId, code])
  @@map("tax_types")
}

model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  taxTypeId      String    @map("tax_type_id") @db.Uuid
  name           String
  // Matches the existing SampleMaterial.gstPercentage precision precedent —
  // not inventing a new one.
  ratePercentage Decimal   @map("rate_percentage") @db.Decimal(5, 2)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  // Nullable = still the current rate. Service layer rejects a new rate whose
  // [effectiveFrom, effectiveTo) window overlaps an existing active rate for
  // the same taxTypeId — cheap to enforce now, avoids ambiguous data a later
  // slice's "find the effective rate as of date X" logic would mishandle.
  effectiveTo    DateTime? @map("effective_to") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company                    Company                     @relation(fields: [companyId], references: [id])
  taxType                    TaxType                     @relation(fields: [taxTypeId], references: [id])
  salesInvoiceItems          SalesInvoiceItem[]
  purchaseInvoiceItems       PurchaseInvoiceItem[]
  expenses                   Expense[]
  employeeAdvanceSettlements EmployeeAdvanceSettlement[]

  @@index([taxTypeId])
  @@map("tax_rates")
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Journal {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  branchId            String?        @map("branch_id") @db.Uuid
  journalNumber       String         @map("journal_number")
  journalDate         DateTime       @map("journal_date") @db.Date
  status              JournalStatus  @default(DRAFT)
  narration           String?
  // Polymorphic "what caused this journal" discriminator, reusing the
  // existing RelatedModule enum rather than inventing a parallel one — null
  // for a manually-created journal (no source document). No enum value is
  // added this slice; later slices (Sales/Purchase Invoice) will populate
  // these with their own RelatedModule value + id when they auto-create a
  // journal on posting.
  sourceModule        RelatedModule? @map("source_module")
  sourceRecordId      String?        @map("source_record_id") @db.Uuid
  // Written only at post time, recomputed from a fresh read of JournalLine
  // rows inside the same transaction as the status flip — never trusted from
  // a client-submitted total.
  totalDebit          Decimal        @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit         Decimal        @default(0) @map("total_credit") @db.Decimal(18, 2)
  postedAt            DateTime?      @map("posted_at")
  postedByUserId      String?        @map("posted_by_user_id") @db.Uuid
  createdByUserId     String         @map("created_by_user_id") @db.Uuid
  // At most one reversal per original journal. The ORIGINAL journal's own
  // status never changes when reversed — it stays POSTED forever, since a
  // posted journal is an immutable historical accounting fact, not something
  // that "un-happens." Only the read model (via this back-relation) shows
  // that a reversal exists.
  reversalOfJournalId String?        @unique @map("reversal_of_journal_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  company                   Company                    @relation(fields: [companyId], references: [id])
  branch                    Branch?                    @relation(fields: [branchId], references: [id])
  postedBy                  User?                      @relation("JournalPostedBy", fields: [postedByUserId], references: [id])
  createdBy                 User                       @relation("JournalCreatedBy", fields: [createdByUserId], references: [id])
  reversalOf                Journal?                   @relation("JournalReversal", fields: [reversalOfJournalId], references: [id])
  reversedByJournal         Journal?                   @relation("JournalReversal")
  lines                     JournalLine[]
  salesInvoice              SalesInvoice?
  purchaseInvoice           PurchaseInvoice?
  payment                   Payment?
  expense                   Expense?
  internalTransfer          InternalTransfer?
  employeeAdvance           EmployeeAdvance?
  employeeAdvanceSettlement EmployeeAdvanceSettlement?

  @@unique([companyId, journalNumber])
  @@map("journals")
}

model JournalLine {
  id           String   @id @default(uuid()) @db.Uuid
  journalId    String   @map("journal_id") @db.Uuid
  lineNumber   Int      @map("line_number")
  accountId    String   @map("account_id") @db.Uuid
  debitAmount  Decimal  @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount Decimal  @default(0) @map("credit_amount") @db.Decimal(18, 2)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  journal Journal        @relation(fields: [journalId], references: [id])
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

// ─────────────────────────────────────────────────────────────
// Sales Invoices (Phase 7B) — the first real consumer of the Journal engine.
// Posting an invoice auto-creates+auto-posts a Journal (Dr Accounts
// Receivable / Cr Sales Revenue / Cr GST Payable) and flips the originating
// SalesOrder to INVOICED.
// ─────────────────────────────────────────────────────────────

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  // Reserved for the Payments slice — not reachable by any code yet, same
  // "enum has values nothing reaches yet" discipline as SalesOrderStatus.
  PARTIALLY_PAID
  PAID
  CLOSED
  CANCELLED
}

model SalesInvoice {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  branchId         String?            @map("branch_id") @db.Uuid
  invoiceNumber    String             @map("invoice_number")
  salesOrderId     String             @map("sales_order_id") @db.Uuid
  // Denormalized from the order — justified here (unlike e.g. GoodsReceipt
  // not denormalizing supplierId) because this table IS the AR ledger's own
  // document of record, not a downstream operational record.
  customerId       String             @map("customer_id") @db.Uuid
  invoiceDate      DateTime           @map("invoice_date") @db.Date
  dueDate          DateTime           @map("due_date") @db.Date
  status           SalesInvoiceStatus @default(DRAFT)
  // Copied from the SalesOrder at creation time, never re-derived — same
  // frozen-currency convention as SalesOrder/PurchaseOrder.
  currencyCode     String             @map("currency_code") @db.Char(3)
  exchangeRate     Decimal            @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode String             @map("base_currency_code") @db.Char(3)
  subtotalAmount   Decimal            @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  taxAmount        Decimal            @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount  Decimal            @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  // Accumulator, incremented only at Payment-post time (Phase 7D) via a
  // guarded conditional update capped against the frozen totalAmount (safe
  // with the plain Prisma updateMany idiom — totalAmount never changes once
  // POSTED). Drives the PARTIALLY_PAID/PAID status derivation.
  paidAmount       Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 2)
  // Set only at post time — the settlement Journal this invoice generated.
  journalId        String?            @unique @map("journal_id") @db.Uuid
  postedAt         DateTime?          @map("posted_at")
  postedByUserId   String?            @map("posted_by_user_id") @db.Uuid
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  // A distinct constraint from the existing one_active_per_order partial
  // index below (a real, non-null-per-row column comparing companyId+
  // idempotencyKey only) — createSalesInvoice's P2002 handler must branch on
  // error.meta.target to tell the two apart.
  idempotencyKey   String?            @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  salesOrder  SalesOrder          @relation(fields: [salesOrderId], references: [id])
  customer    Customer            @relation(fields: [customerId], references: [id])
  journal     Journal?            @relation(fields: [journalId], references: [id])
  postedBy    User?               @relation("SalesInvoicePostedBy", fields: [postedByUserId], references: [id])
  createdBy   User                @relation("SalesInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  items       SalesInvoiceItem[]
  allocations PaymentAllocation[]

  @@unique([companyId, branchId, invoiceNumber])
  @@unique([companyId, idempotencyKey])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id               String   @id @default(uuid()) @db.Uuid
  salesInvoiceId   String   @map("sales_invoice_id") @db.Uuid
  // Traces back to the originating line — the Sales Order remains the source
  // of truth for size/color breakdown; this table aggregates to one line per
  // style since SalesOrderItem.unitPrice is already per-style, not per-variant.
  salesOrderItemId String   @map("sales_order_item_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 2)
  // Deliberate deviation from CLAUDE.md's 13-table Accounts plan (a shared
  // tax_transactions table): freezes the tax rate/amount directly on the
  // item since this is the first consumer. Revisit if Purchase Invoices
  // (7C) or a third consumer make the shared shape worth building — not
  // speculatively generalizing before a second real caller exists.
  taxRateId        String?  @map("tax_rate_id") @db.Uuid
  taxPercentage    Decimal? @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  salesInvoice   SalesInvoice   @relation(fields: [salesInvoiceId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  taxRate        TaxRate?       @relation(fields: [taxRateId], references: [id])

  @@index([salesInvoiceId])
  @@map("sales_invoice_items")
}

// ─────────────────────────────────────────────────────────────
// Purchase Invoices (Phase 7C) — deliberately diverges from Sales Invoice's
// one-shot-per-order shape: partial, repeatable invoicing against a Purchase
// Order (multiple Goods Receipts against one PO are already a live pattern,
// so multiple invoices are too). PurchaseOrderItem.invoicedQuantity (added
// above) tracks progress; PurchaseOrder.status is never changed by invoicing
// (no invoiced-adjacent status value exists, and a single flip wouldn't be
// semantically correct for a partial document) — "how much has been
// invoiced" is derived by comparing invoicedQuantity to receivedQuantity.
// ─────────────────────────────────────────────────────────────

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  // Reserved for the Payments slice — not reachable by any code yet, same
  // discipline as SalesInvoiceStatus's own reserved values.
  PARTIALLY_PAID
  PAID
  CLOSED
  CANCELLED
}

model PurchaseInvoice {
  id                    String                @id @default(uuid()) @db.Uuid
  companyId             String                @map("company_id") @db.Uuid
  branchId              String?               @map("branch_id") @db.Uuid
  invoiceNumber         String                @map("invoice_number")
  // Nullable — null means a standalone "party/direct bill" with no backing
  // Purchase Order at all (a service/expense bill from a supplier, e.g.
  // freight, consulting, rent — nothing to receive against). When set, the
  // invoice may still mix PO-linked lines with direct lines on the SAME
  // document (e.g. goods against the PO plus an ad hoc freight charge) —
  // see PurchaseInvoiceItem's own per-line discriminator below.
  purchaseOrderId       String?               @map("purchase_order_id") @db.Uuid
  // Denormalized from the order when linked; a real, directly-supplied
  // input when there is no order — this table IS the AP ledger's own
  // document of record either way, same justification as SalesInvoice.customerId.
  supplierId            String                @map("supplier_id") @db.Uuid
  // The supplier's own bill/reference number — free text, since we don't
  // control it (unlike invoiceNumber, which we generate). Guarded against
  // double-entry via a hand-added partial unique index (see migration) since
  // this slice has no other "at most one" constraint to lean on.
  supplierInvoiceNumber String?               @map("supplier_invoice_number")
  invoiceDate           DateTime              @map("invoice_date") @db.Date
  dueDate               DateTime              @map("due_date") @db.Date
  status                PurchaseInvoiceStatus @default(DRAFT)
  // Copied from the PurchaseOrder at creation time, never re-derived — same
  // frozen-currency convention used throughout this project.
  currencyCode          String                @map("currency_code") @db.Char(3)
  exchangeRate          Decimal               @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode      String                @map("base_currency_code") @db.Char(3)
  subtotalAmount        Decimal               @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  taxAmount             Decimal               @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount           Decimal               @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount       Decimal               @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  // Accumulator, incremented only at Payment-post time (Phase 7D) — same
  // shape/reasoning as SalesInvoice.paidAmount above.
  paidAmount            Decimal               @default(0) @map("paid_amount") @db.Decimal(18, 2)
  // Set only at post time — the settlement Journal this invoice generated.
  journalId             String?               @unique @map("journal_id") @db.Uuid
  postedAt              DateTime?             @map("posted_at")
  postedByUserId        String?               @map("posted_by_user_id") @db.Uuid
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  // A distinct constraint from the existing supplierInvoiceNumber partial
  // unique below — createPurchaseInvoice's P2002 handler must branch on
  // error.meta.target to tell the two apart.
  idempotencyKey        String?               @map("idempotency_key")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  company       Company               @relation(fields: [companyId], references: [id])
  branch        Branch?               @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  journal       Journal?              @relation(fields: [journalId], references: [id])
  postedBy      User?                 @relation("PurchaseInvoicePostedBy", fields: [postedByUserId], references: [id])
  createdBy     User                  @relation("PurchaseInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  items         PurchaseInvoiceItem[]
  allocations   PaymentAllocation[]

  @@unique([companyId, branchId, invoiceNumber])
  @@unique([companyId, idempotencyKey])
  @@map("purchase_invoices")
}

// Every line is EXACTLY one of two shapes, discriminated per-line (not just
// per-header — an invoice can mix both, e.g. goods against a PO plus an ad
// hoc freight line): a PO-linked line (purchaseOrderItemId + productId set,
// bounded by receivedQuantity - invoicedQuantity, debits COGS automatically
// at post time — unchanged from before this line ever supported a second
// shape) or a direct/"party bill" line (description + expenseAccountId set,
// no PO backing at all, debits the chosen account directly). Enforced by a
// hand-added CHECK constraint (see migration), the same two-nullable-field-
// XOR shape already proven by PaymentAllocation's
// (sales_invoice_id IS NOT NULL) != (purchase_invoice_id IS NOT NULL).
model PurchaseInvoiceItem {
  id                  String   @id @default(uuid()) @db.Uuid
  purchaseInvoiceId   String   @map("purchase_invoice_id") @db.Uuid
  purchaseOrderItemId String?  @map("purchase_order_item_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  // Direct-line only: what this line is for (e.g. "Legal consulting — August").
  description         String?  @map("description")
  // Direct-line only: which GL account to debit — a PO-linked line always
  // debits COGS automatically instead, same as before this field existed.
  expenseAccountId    String?  @map("expense_account_id") @db.Uuid
  // Both user-entered, bounded by (receivedQuantity - invoicedQuantity) as a
  // friendly check plus a real atomic guard at post time — NOT auto-derived
  // like Sales Invoice, since a supplier invoice can cover a subset of a PO's
  // lines and routinely bills at a different price than the PO (rate
  // revision, negotiated discount). A direct line has no such backing figure
  // to bound against — its quantity/unitPrice are simply what was entered.
  quantity            Decimal  @map("quantity") @db.Decimal(18, 4)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(18, 2)
  // Same deliberate tax_transactions-table deviation as SalesInvoiceItem.
  taxRateId           String?  @map("tax_rate_id") @db.Uuid
  taxPercentage       Decimal? @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount           Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotal           Decimal  @map("line_total") @db.Decimal(18, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  purchaseInvoice   PurchaseInvoice    @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  expenseAccount    ChartOfAccount?    @relation(fields: [expenseAccountId], references: [id])
  taxRate           TaxRate?           @relation(fields: [taxRateId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([purchaseOrderItemId])
  @@index([expenseAccountId])
  @@map("purchase_invoice_items")
}

// ─────────────────────────────────────────────────────────────
// Custom Invoice — a standalone, ad-hoc billing document, deliberately
// separate from SalesInvoice. SalesInvoice is always order-linked (quantity/
// price derived server-side from a confirmed SalesOrder — see that model's
// own comments); a Custom Invoice has no such backing order at all — the
// customer, items, pricing, and discount are all entered directly on the
// document itself. Modeled after a reference billing tool the user pointed
// at (D:\office-data\claude-projects\hrms's own Invoice/InvoiceSeries), not
// the SalesInvoice pattern — this is intentionally the "quick invoice /
// petty billing" tool, not a second AR ledger. It does NOT post a Journal
// and does NOT touch Chart of Accounts/paidAmount/AR — same "not every
// financial-looking document needs to flow through the ledger engine"
// reasoning already applied to Expense's own scope decisions, applied here
// because unlike Expense (a real cost) or SalesInvoice (a real AR claim
// against a confirmed order), a Custom Invoice has no requirement backing it
// that the rest of this system can verify — wiring it into the ledger would
// let anyone post arbitrary revenue with zero traceability. Revisit only if
// asked to post these for real.
// ─────────────────────────────────────────────────────────────

enum CustomInvoiceType {
  TAX_INVOICE
  PROFORMA_INVOICE
}

enum CustomInvoiceStatus {
  DRAFT
  CANCELLED
}

// A company can define several independently-numbered series (e.g. "Retail
// Series" -> RET/2025-2026/1, "Export Series" -> EXP/2025-2026/1) — a
// deliberate departure from this project's usual single atomic
// DocumentSequence-per-(company,branch,type,year) numbering (see
// DocumentNumberingService), which has no concept of more than one named
// series per document type. Reusing that engine here would have meant either
// forcing every Custom Invoice through one shared counter (losing the
// multi-series requirement entirely) or bolting a "series name" dimension
// onto DocumentSequence for a feature nothing else needs — a new, narrowly-
// scoped counter table is the smaller, more honest change.
model InvoiceSeries {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  prefix          String
  // Plain text, not derived from Company.fiscalYearStartMonth — a user-typed
  // label ("2025-2026") that becomes part of the printed invoice number, not
  // a real date-bounded fiscal period the system enforces.
  fiscalYearLabel String   @map("fiscal_year_label")
  // Atomically incremented (guarded updateMany) inside the same transaction
  // as CustomInvoice creation — never SELECT MAX()+1, same discipline as
  // every other counter in this project.
  nextNumber      Int      @default(1) @map("next_number")
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  customInvoices CustomInvoice[]

  @@unique([companyId, name])
  @@unique([companyId, prefix])
  @@map("invoice_series")
}

model CustomInvoice {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  branchId             String?             @map("branch_id") @db.Uuid
  invoiceDate          DateTime            @map("invoice_date") @db.Date
  invoiceType          CustomInvoiceType   @default(TAX_INVOICE) @map("invoice_type")
  hasDueDate           Boolean             @default(false) @map("has_due_date")
  dueDate              DateTime?           @map("due_date") @db.Date
  invoiceSeriesId      String              @map("invoice_series_id") @db.Uuid
  // Pre-filled from the series' own nextNumber at create time but always
  // user-editable (the reference tool's "Edit" button) — uniqueness is
  // enforced by the DB constraint below, not by the series counter itself,
  // matching this project's own established "external numbering" precedent
  // (Phase 3's Customer/Supplier/... sequential codes: the system suggests,
  // the field stays editable, the unique constraint is the real guard).
  invoiceNumber        String              @map("invoice_number")
  customerId           String              @map("customer_id") @db.Uuid
  // Optional classification of this invoice's revenue against the existing
  // Chart of Accounts (an INCOME-type account) — deliberately reuses this
  // project's own, more rigorous accounting master instead of adding a
  // parallel flat "Category" master the reference tool has for the same
  // purpose (its own Category/Transaction tables are that app's *entire*
  // bookkeeping ledger; this app already has a real one). Informational
  // only — does not itself post a Journal entry (see the module-level
  // comment above on why Custom Invoice stays outside the ledger).
  incomeAccountId      String?             @map("income_account_id") @db.Uuid
  // Applied per line at calculation time (discountedPrice = unitPrice * (1 -
  // discount%)), not as a flat subtotal deduction — matches the reference
  // tool's own calculation exactly, confirmed by reading its live calc code
  // rather than guessing from the screenshot alone.
  discountPercentage   Decimal             @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  // When true, no line's GST is charged at all (the buyer self-assesses) —
  // matches the reference tool's isRCM behavior exactly (GST forced to 0 on
  // every line, not just hidden from the printed total).
  isReverseCharge      Boolean             @default(false) @map("is_reverse_charge")
  subtotalAmount       Decimal             @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  discountAmount       Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 2)
  grandTotal           Decimal             @default(0) @map("grand_total") @db.Decimal(18, 2)
  advancePaymentTitle  String?             @map("advance_payment_title")
  advancePaymentAmount Decimal?            @map("advance_payment_amount") @db.Decimal(18, 2)
  payableAmountTitle   String?             @map("payable_amount_title")
  payableAmountValue   Decimal?            @map("payable_amount_value") @db.Decimal(18, 2)
  // grandTotal - advancePaymentAmount - payableAmountValue — stored (not
  // computed on read) purely so the list page can sort/filter on it without
  // a per-row calc, matching PurchaseRequest.estimatedTotalAmount's own
  // stored-rollup precedent; always recomputed server-side, never trusted
  // from the client.
  // Recomputed at every relevant mutation (create/update items, record/cancel
  // a payment, issue/cancel a credit note) to
  // grandTotal - advancePaymentAmount - payableAmountValue - paidAmount -
  // creditedAmount — a genuinely real-time running balance, not a
  // creation-time snapshot, so it never goes stale as payments/credit notes
  // are recorded later. Stored (not computed on read) purely so the list
  // page can sort/filter on it without a per-row calc, matching
  // PurchaseRequest.estimatedTotalAmount's own stored-rollup precedent;
  // always recomputed server-side, never trusted from the client.
  balanceDue           Decimal             @default(0) @map("balance_due") @db.Decimal(18, 2)
  // Guarded accumulators (same idiom as SalesInvoice.paidAmount /
  // PurchaseOrderItem.receivedQuantity) — paidAmount capped at
  // (grandTotal - creditedAmount), creditedAmount capped at grandTotal.
  paidAmount           Decimal             @default(0) @map("paid_amount") @db.Decimal(18, 2)
  creditedAmount       Decimal             @default(0) @map("credited_amount") @db.Decimal(18, 2)
  // Free-form list, not a single field — matches the reference tool's own
  // "+ Add Note" repeatable list (see CustomInvoiceNote below), same
  // reasoning as SampleComment being its own table rather than one big text
  // blob.
  termsAndConditions   String?             @map("terms_and_conditions")
  status               CustomInvoiceStatus @default(DRAFT)
  createdByUserId      String              @map("created_by_user_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company       Company                   @relation(fields: [companyId], references: [id])
  branch        Branch?                   @relation(fields: [branchId], references: [id])
  invoiceSeries InvoiceSeries             @relation(fields: [invoiceSeriesId], references: [id])
  customer      Customer                  @relation(fields: [customerId], references: [id])
  incomeAccount ChartOfAccount?           @relation(fields: [incomeAccountId], references: [id])
  createdBy     User                      @relation(fields: [createdByUserId], references: [id])
  items         CustomInvoiceItem[]
  notes         CustomInvoiceNote[]
  payments      CustomInvoicePayment[]
  creditNotes   CustomInvoiceCreditNote[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([customerId])
  @@map("custom_invoices")
}

model CustomInvoiceItem {
  id              String  @id @default(uuid()) @db.Uuid
  customInvoiceId String  @map("custom_invoice_id") @db.Uuid
  // Optional — picking an existing Product/Material auto-fills
  // name/HSN/price/GST client-side (matching the reference tool's own
  // auto-fill-then-editable behavior) but every field below stays a real,
  // independently-stored, user-editable value. Unlike SalesInvoiceItem
  // (always productId-backed, quantity/price always derived), a Custom
  // Invoice line can be entirely free text with no master link at all —
  // that flexibility is this feature's whole reason for existing.
  productId       String? @map("product_id") @db.Uuid
  itemName        String  @map("item_name")
  hsnCode         String? @map("hsn_code")
  quantity        Decimal @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  gstPercentage   Decimal @default(0) @map("gst_percentage") @db.Decimal(5, 2)
  // All three always recomputed server-side from
  // quantity/unitPrice/gstPercentage/the header's discount%/reverse-charge
  // flag — never trusted from the client, same discipline as every other
  // invoice line in this project.
  lineAmount      Decimal @default(0) @map("line_amount") @db.Decimal(18, 2)
  lineTaxAmount   Decimal @default(0) @map("line_tax_amount") @db.Decimal(18, 2)
  lineTotal       Decimal @default(0) @map("line_total") @db.Decimal(18, 2)
  // Guarded accumulator, capped at lineTotal — written only by a
  // PRODUCT_WISE or PRODUCT_RETURN credit note targeting this specific
  // line (OVERALL_DISCOUNT credit notes never touch item-level rows).
  creditedAmount  Decimal @default(0) @map("credited_amount") @db.Decimal(18, 2)

  customInvoice   CustomInvoice                 @relation(fields: [customInvoiceId], references: [id])
  product         Product?                      @relation(fields: [productId], references: [id])
  creditNoteLines CustomInvoiceCreditNoteItem[]

  @@index([customInvoiceId])
  @@map("custom_invoice_items")
}

model CustomInvoiceNote {
  id              String   @id @default(uuid()) @db.Uuid
  customInvoiceId String   @map("custom_invoice_id") @db.Uuid
  note            String
  createdAt       DateTime @default(now()) @map("created_at")

  customInvoice CustomInvoice @relation(fields: [customInvoiceId], references: [id])

  @@index([customInvoiceId])
  @@map("custom_invoice_notes")
}

// A self-contained "record a receipt against this bill" tool — deliberately
// NOT the same Payment/PaymentAllocation model Sales/Purchase Invoice use
// (Phase 7D below). That engine auto-posts a settlement Journal crediting
// Accounts Receivable — correct there because the originating invoice
// already debited AR at post time. Custom Invoice never posts anything to
// the ledger at all (see the module comment above), so a real Payment
// crediting AR here would silently corrupt the trial balance by reducing a
// balance that was never increased for this specific invoice. This model
// only ever touches CustomInvoice's own paidAmount accumulator — it has no
// ledger effect, matching Custom Invoice's own deliberately-standalone
// scope.
enum CustomInvoicePaymentStatus {
  RECORDED
  CANCELLED
}

model CustomInvoicePayment {
  id               String                     @id @default(uuid()) @db.Uuid
  companyId        String                     @map("company_id") @db.Uuid
  customInvoiceId  String                     @map("custom_invoice_id") @db.Uuid
  paymentDate      DateTime                   @map("payment_date") @db.Date
  amount           Decimal                    @db.Decimal(18, 2)
  // Reuses the existing PaymentType master (CASH/BANK/CHEQUE/CARD/UPI/OTHER)
  // rather than a new enum — same master Payment/Expense already use.
  paymentTypeId    String?                    @map("payment_type_id") @db.Uuid
  referenceNote    String?                    @map("reference_note")
  status           CustomInvoicePaymentStatus @default(RECORDED)
  receivedByUserId String                     @map("received_by_user_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id])
  customInvoice CustomInvoice @relation(fields: [customInvoiceId], references: [id])
  paymentType   PaymentType?  @relation(fields: [paymentTypeId], references: [id])
  receivedBy    User          @relation(fields: [receivedByUserId], references: [id])

  @@index([customInvoiceId])
  @@map("custom_invoice_payments")
}

// Adapts the reference tool's own 3 real credit-note types (confirmed by
// reading its schema, not guessed): OVERALL_DISCOUNT (one flat amount
// against the whole invoice, no item targeting), PRODUCT_WISE (a manual
// amount reduction against one specific line), PRODUCT_RETURN (a returned
// quantity against one specific line, amount derived from that line's own
// effective per-unit rate). Same "no ledger effect" scope as
// CustomInvoicePayment above — a credit note here only ever reduces
// CustomInvoice/CustomInvoiceItem's own creditedAmount accumulators.
enum CustomInvoiceCreditNoteType {
  OVERALL_DISCOUNT
  PRODUCT_WISE
  PRODUCT_RETURN
}

enum CustomInvoiceCreditNoteStatus {
  ISSUED
  CANCELLED
}

model CustomInvoiceCreditNote {
  id               String                        @id @default(uuid()) @db.Uuid
  companyId        String                        @map("company_id") @db.Uuid
  customInvoiceId  String                        @map("custom_invoice_id") @db.Uuid
  creditNoteNumber String                        @map("credit_note_number")
  creditNoteDate   DateTime                      @map("credit_note_date") @db.Date
  type             CustomInvoiceCreditNoteType
  reason           String?
  // Total reduction this credit note applies — for OVERALL_DISCOUNT this is
  // the whole story; for PRODUCT_WISE/PRODUCT_RETURN it's the sum of its own
  // CustomInvoiceCreditNoteItem rows (denormalized here purely for list/sort
  // display, same stored-rollup precedent as CustomInvoice.balanceDue).
  totalAmount      Decimal                       @map("total_amount") @db.Decimal(18, 2)
  status           CustomInvoiceCreditNoteStatus @default(ISSUED)
  createdByUserId  String                        @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                      @default(now()) @map("created_at")

  company       Company                       @relation(fields: [companyId], references: [id])
  customInvoice CustomInvoice                 @relation(fields: [customInvoiceId], references: [id])
  createdBy     User                          @relation(fields: [createdByUserId], references: [id])
  items         CustomInvoiceCreditNoteItem[]

  @@unique([companyId, creditNoteNumber])
  @@index([customInvoiceId])
  @@map("custom_invoice_credit_notes")
}

// Only populated for PRODUCT_WISE/PRODUCT_RETURN credit notes — an
// OVERALL_DISCOUNT credit note has zero rows here, its whole effect living
// on the header's own totalAmount.
model CustomInvoiceCreditNoteItem {
  id                  String   @id @default(uuid()) @db.Uuid
  creditNoteId        String   @map("credit_note_id") @db.Uuid
  customInvoiceItemId String   @map("custom_invoice_item_id") @db.Uuid
  // Set only for PRODUCT_RETURN — the quantity being returned.
  quantity            Decimal? @db.Decimal(18, 4)
  // Net reduction this line contributes — for PRODUCT_RETURN this is
  // computed server-side (quantity * the line's own effective per-unit
  // rate, i.e. lineTotal / quantity), for PRODUCT_WISE it's the amount the
  // caller directly specified.
  amount              Decimal  @db.Decimal(18, 2)

  creditNote        CustomInvoiceCreditNote @relation(fields: [creditNoteId], references: [id])
  customInvoiceItem CustomInvoiceItem       @relation(fields: [customInvoiceItemId], references: [id])

  @@index([creditNoteId])
  @@map("custom_invoice_credit_note_items")
}

// ─────────────────────────────────────────────────────────────
// Payments + Allocations (Phase 7D) — records money received from a Customer
// (RECEIPT) or paid to a Supplier (PAYMENT_OUT), allocated across one or more
// invoices. Posting increments each allocated invoice's paidAmount (guarded,
// capped by its own frozen totalAmount), derives PARTIALLY_PAID/PAID via a
// fresh in-transaction re-read + unconditional write (same idiom as
// PurchaseOrder's own received-quantity status recompute — NOT a guarded
// conditional transition, since a second/third partial payment has no single
// "expected prior status" to key against), and auto-posts a settlement
// Journal via journal.service.ts's postJournalCore. No updatePayment exists —
// deliberately: RBAC's "payments" module has no "edit" action for any role
// except SUPER_ADMIN's wildcard; the only DRAFT-stage correction is
// cancel-and-recreate.
// ─────────────────────────────────────────────────────────────

enum PaymentDirection {
  RECEIPT
  PAYMENT_OUT
}

enum PaymentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Payment {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  branchId        String?          @map("branch_id") @db.Uuid
  // Single shared "PAY-" series for both directions (DocumentType.PAYMENT) —
  // confirmed with the user rather than splitting RECEIPT/PAYMENT_OUT into
  // two series, matching the single-table design.
  paymentNumber   String           @map("payment_number")
  direction       PaymentDirection
  // Exactly one of customerId/supplierId is set, matching `direction` —
  // service-layer check only (no DB trigger anywhere in this codebase; see
  // PaymentAllocation's own CHECK constraint for the one case that IS
  // DB-enforced, which doesn't need direction awareness).
  customerId      String?          @map("customer_id") @db.Uuid
  supplierId      String?          @map("supplier_id") @db.Uuid
  paymentDate     DateTime         @map("payment_date") @db.Date
  paymentTypeId   String           @map("payment_type_id") @db.Uuid
  bankAccountId   String?          @map("bank_account_id") @db.Uuid
  // Free text — cheque number, bank UTR/reference, etc. We don't control it.
  referenceNumber String?          @map("reference_number")
  amount          Decimal          @map("amount") @db.Decimal(18, 2)
  status          PaymentStatus    @default(DRAFT)
  // Always company.baseCurrencyCode — every Sales/Purchase Order (and thus
  // invoice) this pays against is already forced to base currency, so no
  // exchangeRate/baseAmount split is needed here, unlike Sales/Purchase
  // Order's own multi-currency-ready columns.
  currencyCode    String           @map("currency_code") @db.Char(3)
  // Set only at post time — the settlement Journal this payment generated.
  journalId       String?          @unique @map("journal_id") @db.Uuid
  postedAt        DateTime?        @map("posted_at")
  postedByUserId  String?          @map("posted_by_user_id") @db.Uuid
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  idempotencyKey  String?          @map("idempotency_key")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  paymentType PaymentType         @relation(fields: [paymentTypeId], references: [id])
  bankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id])
  journal     Journal?            @relation(fields: [journalId], references: [id])
  postedBy    User?               @relation("PaymentPostedBy", fields: [postedByUserId], references: [id])
  createdBy   User                @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  allocations PaymentAllocation[]

  @@unique([companyId, branchId, paymentNumber])
  @@unique([companyId, idempotencyKey])
  @@map("payments")
}

model PaymentAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  // Exactly one of these two is set — DB-enforced via a hand-added CHECK
  // constraint (see migration), not just a service-layer convention, since
  // this is the one real "exactly one of two FKs" invariant this table has.
  salesInvoiceId    String?  @map("sales_invoice_id") @db.Uuid
  purchaseInvoiceId String?  @map("purchase_invoice_id") @db.Uuid
  allocatedAmount   Decimal  @map("allocated_amount") @db.Decimal(18, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  payment         Payment          @relation(fields: [paymentId], references: [id])
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@index([paymentId])
  @@index([salesInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("payment_allocations")
}

// ─────────────────────────────────────────────────────────────
// Expenses (Phase 7E) — a direct, day-to-day cost (rent, utilities, salaries,
// misc.) that doesn't flow through Purchase Order → Goods Receipt → Purchase
// Invoice. Deliberately always paid immediately at post time (no unpaid/
// payable lifecycle, no later settlement via Payment — an unpaid vendor bill
// with terms already has a home: Purchase Invoice + Payment) and always a
// single flat row (no child items table) — both confirmed with the user.
// Posting creates one Journal (Dr the chosen Expense account, Dr GST Input
// Tax Credit if any, Cr Cash-or-Bank) via the same postJournalCore engine
// every other Accounts document uses. No reversal/correction path exists
// this slice — see journal.service.ts's reverseJournal() sourceModule guard,
// which blocks EXPENSE alongside PAYMENT/SALES_INVOICE/PURCHASE_INVOICE.
// ─────────────────────────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

// Expense's own richer workflow — distinct from the shared ExpenseStatus
// above (EmployeeAdvanceSettlement still uses that simpler 3-state enum
// for its own single-step post; it does not need an approval gate).
// PENDING_APPROVAL (created, editable) -> APPROVED/REJECTED (Admin
// decision, no cash movement) -> from APPROVED only, PAID (Accountant
// pays, the actual Dr Expense/Cr Cash-Bank journal — same journal-posting
// logic this model already had, just now reachable only post-approval).
// REJECTED is terminal by design (confirmed with the user) — matches every
// other rejection in this app (Sample, Sales Order, Purchase Order, ...):
// rejected stays rejected, a correction is a new Expense, not a reversal.
enum ExpenseApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model Expense {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @map("company_id") @db.Uuid
  branchId         String?               @map("branch_id") @db.Uuid
  expenseNumber    String                @map("expense_number")
  expenseDate      DateTime              @map("expense_date") @db.Date
  // Service-validated as accountType === EXPENSE, code !== "COGS" (COGS is a
  // Purchase-Invoice-only control account, never user-selectable — see
  // postPurchaseInvoice's own hardcoded findByCode lookup), and isActive.
  accountId        String                @map("account_id") @db.Uuid
  // Pure reference field — no business logic gated on it, unlike Payment's
  // customerId/supplierId (which are direction-required).
  supplierId       String?               @map("supplier_id") @db.Uuid
  description      String
  amount           Decimal               @map("amount") @db.Decimal(18, 2)
  taxRateId        String?               @map("tax_rate_id") @db.Uuid
  taxPercentage    Decimal?              @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount        Decimal               @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount      Decimal               @map("total_amount") @db.Decimal(18, 2)
  // TDS (Tax Deducted at Source) — computed on the base `amount`, not the
  // GST-inclusive totalAmount (matches standard Indian TDS practice, and the
  // reference tool's own live calc). Posting debits the full totalAmount to
  // the expense/GST-ITC accounts as before, but now credits TDS Payable for
  // tdsAmount and only the net (totalAmount - tdsAmount) to Cash-or-Bank —
  // the amount actually paid out once TDS is withheld.
  tdsPercentage    Decimal?              @map("tds_percentage") @db.Decimal(5, 2)
  tdsAmount        Decimal               @default(0) @map("tds_amount") @db.Decimal(18, 2)
  paymentTypeId    String                @map("payment_type_id") @db.Uuid
  bankAccountId    String?               @map("bank_account_id") @db.Uuid
  referenceNumber  String?               @map("reference_number")
  // Always company.baseCurrencyCode, no exchangeRate/baseAmount split —
  // matches Payment's own simplification (multi-currency UI deferred
  // project-wide).
  currencyCode     String                @map("currency_code") @db.Char(3)
  status           ExpenseApprovalStatus @default(PENDING_APPROVAL)
  // Admin's decision — no cash movement, just a status flip.
  approvedAt       DateTime?             @map("approved_at")
  approvedByUserId String?               @map("approved_by_user_id") @db.Uuid
  rejectedAt       DateTime?             @map("rejected_at")
  rejectedByUserId String?               @map("rejected_by_user_id") @db.Uuid
  rejectionReason  String?               @map("rejection_reason")
  // Set only at pay time (from APPROVED) — the settlement Journal this expense generated.
  journalId        String?               @unique @map("journal_id") @db.Uuid
  postedAt         DateTime?             @map("posted_at")
  postedByUserId   String?               @map("posted_by_user_id") @db.Uuid
  createdByUserId  String                @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  idempotencyKey   String?               @map("idempotency_key")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  company     Company        @relation(fields: [companyId], references: [id])
  branch      Branch?        @relation(fields: [branchId], references: [id])
  account     ChartOfAccount @relation(fields: [accountId], references: [id])
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  taxRate     TaxRate?       @relation(fields: [taxRateId], references: [id])
  paymentType PaymentType    @relation(fields: [paymentTypeId], references: [id])
  bankAccount BankAccount?   @relation(fields: [bankAccountId], references: [id])
  journal     Journal?       @relation(fields: [journalId], references: [id])
  postedBy    User?          @relation("ExpensePostedBy", fields: [postedByUserId], references: [id])
  createdBy   User           @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy  User?          @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id])
  rejectedBy  User?          @relation("ExpenseRejectedBy", fields: [rejectedByUserId], references: [id])

  @@unique([companyId, branchId, expenseNumber])
  @@unique([companyId, idempotencyKey])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────
// Internal Transfer — moving money between two of the company's own
// Cash/Bank accounts (e.g. cash deposited into the bank). Zero P&L impact,
// deliberately NOT an Expense (an Expense always debits an income-statement
// account; this only ever touches balance-sheet Cash-or-Bank on both sides).
// Cash/Bank resolution reuses the exact PaymentType.type -> ChartOfAccount
// idiom Payment already established (never PaymentType.code, see that
// model's own comment) — a real, accepted limitation of this scheme: this
// Chart of Accounts has exactly one CASH and one BANK control account, not
// one per physical bank account, so a transfer between two BANK-typed
// payment types (e.g. two different real bank accounts) has no real GL
// effect and is rejected — only CASH<->BANK is postable. fromBankAccountId/
// toBankAccountId are informational only (which physical account, for the
// audit trail), never the accounting entry itself.
// ─────────────────────────────────────────────────────────────

enum InternalTransferStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InternalTransfer {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @map("company_id") @db.Uuid
  branchId          String?                @map("branch_id") @db.Uuid
  transferNumber    String                 @map("transfer_number")
  transferDate      DateTime               @map("transfer_date") @db.Date
  fromPaymentTypeId String                 @map("from_payment_type_id") @db.Uuid
  fromBankAccountId String?                @map("from_bank_account_id") @db.Uuid
  toPaymentTypeId   String                 @map("to_payment_type_id") @db.Uuid
  toBankAccountId   String?                @map("to_bank_account_id") @db.Uuid
  amount            Decimal                @db.Decimal(18, 2)
  narration         String?
  status            InternalTransferStatus @default(DRAFT)
  journalId         String?                @unique @map("journal_id") @db.Uuid
  postedAt          DateTime?              @map("posted_at")
  postedByUserId    String?                @map("posted_by_user_id") @db.Uuid
  createdByUserId   String                 @map("created_by_user_id") @db.Uuid
  idempotencyKey    String?                @map("idempotency_key")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  company         Company      @relation(fields: [companyId], references: [id])
  branch          Branch?      @relation(fields: [branchId], references: [id])
  fromPaymentType PaymentType  @relation("InternalTransferFrom", fields: [fromPaymentTypeId], references: [id])
  toPaymentType   PaymentType  @relation("InternalTransferTo", fields: [toPaymentTypeId], references: [id])
  fromBankAccount BankAccount? @relation("InternalTransferFromBank", fields: [fromBankAccountId], references: [id])
  toBankAccount   BankAccount? @relation("InternalTransferToBank", fields: [toBankAccountId], references: [id])
  journal         Journal?     @relation(fields: [journalId], references: [id])
  postedBy        User?        @relation("InternalTransferPostedBy", fields: [postedByUserId], references: [id])
  createdBy       User         @relation("InternalTransferCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, branchId, transferNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@map("internal_transfers")
}

// ─────────────────────────────────────────────────────────────
// Employee Advance (Imprest) — an advance given to an employee to spend,
// settled later against real expense receipts. Two real Journal postings,
// not one: issuing debits an "Employee Advances" asset control account
// (money owed back by the employee) and credits Cash-or-Bank; settling
// debits the actual expense account the spend belongs to (+ GST-ITC if any)
// and credits Employee Advances back down. This is genuinely more correct
// double-entry accounting than the reference tool's own design (a bare
// float column on the user with no ledger trail at all — see the
// investigation this was modeled from) — the two-journal design was chosen
// specifically to fix that gap, not copy it.
// ─────────────────────────────────────────────────────────────

enum EmployeeAdvanceStatus {
  DRAFT
  ISSUED
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

model EmployeeAdvance {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  branchId        String?               @map("branch_id") @db.Uuid
  advanceNumber   String                @map("advance_number")
  advanceDate     DateTime              @map("advance_date") @db.Date
  employeeId      String                @map("employee_id") @db.Uuid
  amount          Decimal               @db.Decimal(18, 2)
  paymentTypeId   String                @map("payment_type_id") @db.Uuid
  bankAccountId   String?               @map("bank_account_id") @db.Uuid
  purpose         String?
  // Guarded accumulator (same idiom as every other running-total in this
  // project), capped at `amount` — incremented only by a POSTED settlement
  // against this advance.
  settledAmount   Decimal               @default(0) @map("settled_amount") @db.Decimal(18, 2)
  status          EmployeeAdvanceStatus @default(DRAFT)
  journalId       String?               @unique @map("journal_id") @db.Uuid
  postedAt        DateTime?             @map("posted_at")
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  idempotencyKey  String?               @map("idempotency_key")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  company     Company                     @relation(fields: [companyId], references: [id])
  branch      Branch?                     @relation(fields: [branchId], references: [id])
  employee    Employee                    @relation(fields: [employeeId], references: [id])
  paymentType PaymentType                 @relation(fields: [paymentTypeId], references: [id])
  bankAccount BankAccount?                @relation(fields: [bankAccountId], references: [id])
  journal     Journal?                    @relation(fields: [journalId], references: [id])
  createdBy   User                        @relation("EmployeeAdvanceCreatedBy", fields: [createdByUserId], references: [id])
  settlements EmployeeAdvanceSettlement[]

  @@unique([companyId, branchId, advanceNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@map("employee_advances")
}

model EmployeeAdvanceSettlement {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  employeeAdvanceId String        @map("employee_advance_id") @db.Uuid
  settlementNumber  String        @map("settlement_number")
  settlementDate    DateTime      @map("settlement_date") @db.Date
  // Which real Expense account this settled spend belongs to (Travel,
  // Office Supplies, ...) — same validation as Expense.accountId
  // (accountType EXPENSE, code != "COGS", isActive).
  expenseAccountId  String        @map("expense_account_id") @db.Uuid
  description       String
  amount            Decimal       @db.Decimal(18, 2)
  taxRateId         String?       @map("tax_rate_id") @db.Uuid
  taxPercentage     Decimal?      @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount         Decimal       @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(18, 2)
  status            ExpenseStatus @default(DRAFT)
  journalId         String?       @unique @map("journal_id") @db.Uuid
  postedAt          DateTime?     @map("posted_at")
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  company         Company         @relation(fields: [companyId], references: [id])
  employeeAdvance EmployeeAdvance @relation(fields: [employeeAdvanceId], references: [id])
  expenseAccount  ChartOfAccount  @relation(fields: [expenseAccountId], references: [id])
  taxRate         TaxRate?        @relation(fields: [taxRateId], references: [id])
  journal         Journal?        @relation(fields: [journalId], references: [id])
  createdBy       User            @relation("EmployeeAdvanceSettlementCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, settlementNumber])
  @@index([employeeAdvanceId])
  @@map("employee_advance_settlements")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow (2026-09-06)
//
// A pre-Style development/ideation workflow -- NOT a second Style Master.
// AiGarmentProject is a resumable header that starts before any real Style
// exists (an uploaded reference photo or fabric swatch, no style code yet)
// and later, deliberately and manually, graduates into a real Product row
// (itemType STYLE) via convertProjectToStyle() -- the exact same shape
// already proven twice in this codebase: BuyerEnquiryLine -> SampleRequest
// (convertEnquiryLineToSampleRequest) and SampleRequest -> Product
// (convertSampleToStyle). BOM and Costing steps require this graduation and
// then reuse the existing BOM/MRP module and Sampling's own costing engine
// -- no parallel BOM/costing schema exists here.
// ─────────────────────────────────────────────────────────────

enum AiGarmentSourceType {
  REFERENCE
  FABRIC
}

enum AiGarmentProjectStatus {
  IDEA
  REFERENCE_ANALYSIS
  DESIGN_DEVELOPMENT
  DESIGN_SELECTED
  TECHNICAL_DEVELOPMENT
  COSTING
  SAMPLING
  BUYER_REVIEW
  APPROVED
  PRODUCTION
  COMPLETED
  REJECTED
  ON_HOLD
  CANCELLED
}

model AiGarmentProject {
  id                                String                  @id @default(uuid()) @db.Uuid
  companyId                         String                  @map("company_id") @db.Uuid
  branchId                          String?                 @map("branch_id") @db.Uuid
  projectNumber                     String                  @map("project_number")
  projectName                       String                  @map("project_name")
  sourceType                        AiGarmentSourceType     @map("source_type")
  customerId                        String?                 @map("customer_id") @db.Uuid
  buyerId                           String?                 @map("buyer_id") @db.Uuid
  brandId                           String?                 @map("brand_id") @db.Uuid
  seasonId                          String?                 @map("season_id") @db.Uuid
  categoryId                        String?                 @map("category_id") @db.Uuid
  // Free text -- no "Market" master exists anywhere in this ERP today; a
  // deliberate foundation-stage simplification, same reasoning already used
  // for SampleRequest.color.
  targetMarket                      String?                 @map("target_market")
  // A descriptive demographic/positioning note, distinct from the real
  // customerId/buyerId FKs above -- no existing master fits this.
  targetCustomerProfile             String?                 @map("target_customer_profile")
  targetSellingPrice                Decimal?                @map("target_selling_price") @db.Decimal(18, 2)
  // Soft-matched against Currency.code, same non-FK convention
  // Customer.defaultCurrencyCode already uses -- not a real @relation.
  currencyCode                      String?                 @map("currency_code") @db.Char(3)
  orderQuantityEstimate             Decimal?                @map("order_quantity_estimate") @db.Decimal(18, 2)
  status                            AiGarmentProjectStatus  @default(IDEA)
  statusBeforeHold                  AiGarmentProjectStatus? @map("status_before_hold")
  // Drives wizard resumability -- e.g. "PROJECT_INFO", "UPLOAD_REFERENCE",
  // "COSTING". Save-and-leave-and-return reads/writes this, not a session.
  currentStepKey                    String                  @map("current_step_key")
  // Native Postgres array -- drives the progress-stepper UI's completed ticks.
  completedStepKeys                 String[]                @map("completed_step_keys")
  // Set once, only by convertProjectToStyle() -- mirrors SampleRequest.productId.
  productId                         String?                 @unique @map("product_id") @db.Uuid
  // Set once, only by createSampleRequestFromProject() -- mirrors
  // BuyerEnquiryLine.sampleRequestId.
  sampleRequestId                   String?                 @unique @map("sample_request_id") @db.Uuid
  // Reserved, unused this phase -- see the schema comment on SalesOrder's own
  // aiGarmentProject back-relation. @unique since the back-relation there is
  // singular (one Sales Order can be reserved-linked from at most one project).
  salesOrderId                      String?                 @unique @map("sales_order_id") @db.Uuid
  // Soft reference to an Attachment.id -- no hard FK, same convention as
  // AiGarmentDesignOption.imageAttachmentId. Points at whichever reference
  // image is CURRENT for this project (a single-image "Replace"/"Delete"
  // model, not a gallery) -- uploading a new one replaces this pointer and
  // the old Attachment row/file are removed.
  referenceImageAttachmentId        String?                 @map("reference_image_attachment_id") @db.Uuid
  notes                             String?
  // Process 5 (Commercial Design Evaluation)'s own "SELECT DESIGN FOR
  // DEVELOPMENT" outcome -- set once, via selectDesignForDevelopment(),
  // never by any other path. This project record IS the pre-Style form of
  // the eventual Style Master (see the foundation phase's own architecture
  // note); recording the selection here rather than only on a real `Product`
  // row is deliberate, since a Product/Style may not exist yet at this stage
  // of the workflow (graduation via convertProjectToStyle() is a later,
  // separate, still-manual step required only once BOM/Costing begin).
  selectedDesignDirectionId         String?                 @map("selected_design_direction_id") @db.Uuid
  selectedDesignAt                  DateTime?               @map("selected_design_at")
  selectedDesignByUserId            String?                 @map("selected_design_by_user_id") @db.Uuid
  // Process 6 (Apply Actual Fabric)'s own "APPROVE DESIGN & FABRIC" outcome --
  // set once, via approveDesignAndFabric(), same "recorded on the project
  // itself, not a real Style Master row yet" reasoning as
  // selectedDesignDirectionId above, and same "mutable, not a guarded
  // set-once graduation write" choice.
  approvedFabricApplicationId       String?                 @map("approved_fabric_application_id") @db.Uuid
  approvedFabricApplicationAt       DateTime?               @map("approved_fabric_application_at")
  approvedFabricApplicationByUserId String?                 @map("approved_fabric_application_by_user_id") @db.Uuid
  // Process 7 (Technical Development)'s own "APPROVE TECHNICAL FLAT" outcome --
  // same "recorded on the project itself, mutable, not a guarded set-once
  // graduation write" reasoning as approvedFabricApplicationId above.
  approvedTechnicalFlatId           String?                 @map("approved_technical_flat_id") @db.Uuid
  approvedTechnicalFlatAt           DateTime?               @map("approved_technical_flat_at")
  approvedTechnicalFlatByUserId     String?                 @map("approved_technical_flat_by_user_id") @db.Uuid
  // Process 9 (Cost Analysis)'s own "Mark Costing Complete" outcome -- a
  // one-time milestone stamp (guarded so only the FIRST review stamps it,
  // via `where: { costingCompletedAt: null }`), but NOT this project's own
  // terminal milestone: Process 10 added real steps after COSTING
  // (SAMPLING_REVIEW, PRODUCTION), so this field now means only "the
  // AI-assisted costing phase was reviewed," never "the whole workflow is
  // done" -- see productionHandoffCompletedAt below for the real terminal
  // milestone.
  costingCompletedAt                DateTime?               @map("costing_completed_at")
  costingCompletedByUserId          String?                 @map("costing_completed_by_user_id") @db.Uuid
  // Process 10's own "Mark Project Complete" outcome -- PRODUCTION is the
  // genuinely last step in both stepsForSourceType() sequences, so this is
  // this project's real terminal milestone. Guarded via a single updateMany
  // keyed on `status != COMPLETED` -- the same "precondition in the WHERE
  // clause" idiom already used by setProductIdGuarded/setSampleRequestIdGuarded/
  // the old markCostingComplete, just guarding against a double-click rather
  // than a race between two different actors.
  productionHandoffCompletedAt       DateTime?               @map("production_handoff_completed_at")
  productionHandoffCompletedByUserId String?                 @map("production_handoff_completed_by_user_id") @db.Uuid
  createdByUserId                   String                  @map("created_by_user_id") @db.Uuid
  createdAt                         DateTime                @default(now()) @map("created_at")
  updatedAt                         DateTime                @updatedAt @map("updated_at")

  company                     Company                            @relation(fields: [companyId], references: [id])
  branch                      Branch?                            @relation(fields: [branchId], references: [id])
  customer                    Customer?                          @relation(fields: [customerId], references: [id])
  buyer                       Buyer?                             @relation(fields: [buyerId], references: [id])
  brand                       Brand?                             @relation(fields: [brandId], references: [id])
  season                      Season?                            @relation(fields: [seasonId], references: [id])
  category                    Category?                          @relation(fields: [categoryId], references: [id])
  product                     Product?                           @relation(fields: [productId], references: [id])
  sampleRequest               SampleRequest?                     @relation(fields: [sampleRequestId], references: [id])
  salesOrder                  SalesOrder?                        @relation(fields: [salesOrderId], references: [id])
  createdBy                   User                               @relation("AiGarmentProjectCreatedBy", fields: [createdByUserId], references: [id])
  selectedDesignDirection     AiGarmentDesignDirection?          @relation("AiGarmentProjectSelectedDesign", fields: [selectedDesignDirectionId], references: [id])
  selectedDesignBy            User?                              @relation("AiGarmentProjectSelectedDesignBy", fields: [selectedDesignByUserId], references: [id])
  approvedFabricApplication   AiGarmentFabricApplication?        @relation("AiGarmentProjectApprovedFabricApplication", fields: [approvedFabricApplicationId], references: [id])
  approvedFabricApplicationBy User?                              @relation("AiGarmentProjectApprovedFabricApplicationBy", fields: [approvedFabricApplicationByUserId], references: [id])
  approvedTechnicalFlat       AiGarmentTechnicalFlat?            @relation("AiGarmentProjectApprovedTechnicalFlat", fields: [approvedTechnicalFlatId], references: [id])
  approvedTechnicalFlatBy     User?                              @relation("AiGarmentProjectApprovedTechnicalFlatBy", fields: [approvedTechnicalFlatByUserId], references: [id])
  costingCompletedBy          User?                              @relation("AiGarmentProjectCostingCompletedBy", fields: [costingCompletedByUserId], references: [id])
  productionHandoffCompletedBy User?                             @relation("AiGarmentProjectProductionHandoffCompletedBy", fields: [productionHandoffCompletedByUserId], references: [id])
  fabricDetail                AiGarmentFabricDetail?
  designOptions               AiGarmentDesignOption[]
  referenceAnalysis           AiGarmentReferenceAnalysis?
  referenceAnalysisRuns       AiGarmentReferenceAnalysisRun[]
  developmentBriefRuns        AiGarmentDevelopmentBriefRun[]
  designDirections            AiGarmentDesignDirection[]
  imageGenerationRuns         AiGarmentImageGenerationRun[]
  generatedImages             AiGarmentGeneratedImage[]
  designVariationRuns         AiGarmentDesignVariationRun[]
  designVariations            AiGarmentDesignVariation[]
  commercialEvaluationRuns    AiGarmentCommercialEvaluationRun[]
  commercialEvaluations       AiGarmentCommercialEvaluation[]
  fabricApplicationRuns       AiGarmentFabricApplicationRun[]
  fabricApplications          AiGarmentFabricApplication[]       @relation("AiGarmentFabricApplicationsOfProject")
  technicalFlatRuns           AiGarmentTechnicalFlatRun[]
  technicalFlats              AiGarmentTechnicalFlat[]           @relation("AiGarmentTechnicalFlatsOfProject")
  bomSuggestionRuns           AiGarmentBomSuggestionRun[]
  bomSuggestions              AiGarmentBomSuggestion[]
  costAnalysisRuns            AiGarmentCostAnalysisRun[]
  costAnalyses                AiGarmentCostAnalysis[]

  @@unique([companyId, projectNumber])
  @@index([companyId, status])
  @@map("ai_garment_projects")
}

// 1:1 child, mirroring Bom.productId's @unique 1:1 pattern -- used by both
// workflows' fabric-related steps ("Fabric Information" in Start From
// Fabric, "Apply Fabric" in Start From Reference). Reuses the existing
// fabric sub-masters (Phase 3) instead of free-text/Decimal fields, the
// same masters already wired into Purchasing's FabricRoll.
model AiGarmentFabricDetail {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @unique @map("project_id") @db.Uuid
  gsmId         String?  @map("gsm_id") @db.Uuid
  dyeId         String?  @map("dye_id") @db.Uuid
  weaveTypeId   String?  @map("weave_type_id") @db.Uuid
  widthId       String?  @map("width_id") @db.Uuid
  compositionId String?  @map("composition_id") @db.Uuid
  colorId       String?  @map("color_id") @db.Uuid
  supplierId    String?  @map("supplier_id") @db.Uuid
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project     AiGarmentProject   @relation(fields: [projectId], references: [id])
  gsm         FabricGsm?         @relation(fields: [gsmId], references: [id])
  dye         FabricDye?         @relation(fields: [dyeId], references: [id])
  weaveType   FabricWeaveType?   @relation(fields: [weaveTypeId], references: [id])
  width       FabricWidth?       @relation(fields: [widthId], references: [id])
  composition FabricComposition? @relation(fields: [compositionId], references: [id])
  color       Color?             @relation(fields: [colorId], references: [id])
  supplier    Supplier?          @relation(fields: [supplierId], references: [id])

  @@map("ai_garment_fabric_details")
}

// Supports "Generate Variations"/"Generate Designs" and "Select Design" --
// one row per design candidate. aiMetadata is a placeholder for a future
// real AI response (prompt/model/confidence); empty/unused this phase, no
// fabricated AI output is ever written here.
model AiGarmentDesignOption {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  label             String?
  notes             String?
  isSelected        Boolean  @default(false) @map("is_selected")
  // Soft reference to an Attachment.id -- no hard FK, deliberately mirroring
  // Attachment.relatedRecordId's own existing "no DB-enforced polymorphic
  // FK, app-layer validated" convention already used throughout this codebase.
  imageAttachmentId String?  @map("image_attachment_id") @db.Uuid
  aiMetadata        Json?    @map("ai_metadata")
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project   AiGarmentProject @relation(fields: [projectId], references: [id])
  createdBy User             @relation("AiGarmentDesignOptionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId])
  @@map("ai_garment_design_options")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 1: Reference Garment Analysis (2026-09-06)
//
// Hierarchy this schema enforces structurally: Reference Image -> AI
// Original Analysis -> Human Review -> Final Approved Analysis -> future
// processes. AiGarmentReferenceObservation keeps `aiObservation` (never
// overwritten) and `approvedObservation` (starts equal to the AI value,
// diverges once a user edits it) as two separate columns for exactly this
// reason -- a later process reads `approvedObservation`, never
// `aiObservation`, so "bypass the approved analysis and silently use the
// uncorrected AI output" is impossible by construction, not just by
// convention.
// ─────────────────────────────────────────────────────────────

enum AiGarmentAnalysisConfidence {
  CONFIRMED_VISUALLY
  LIKELY_INFERRED
  NOT_DETERMINABLE
}

enum AiGarmentConstructionComplexity {
  LOW
  MEDIUM
  HIGH
}

// DRAFT: no successful AI run yet. AI_ANALYSED: a run completed, nothing
// edited yet. UNDER_REVIEW: at least one observation has been user-edited.
// APPROVED: the explicit "Approve Analysis & Continue" action fired. STALE:
// the reference image was replaced after this analysis existed -- the
// analysis row and its observations are kept (audit value) but every
// further edit/approve action is blocked until a fresh AI run replaces them,
// so a replaced image can never leave a stale APPROVED analysis silently
// trusted by a later process.
enum AiGarmentReferenceAnalysisStatus {
  DRAFT
  AI_ANALYSED
  UNDER_REVIEW
  APPROVED
  STALE
}

enum AiGarmentAnalysisRunStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

// The current analysis for a project -- 1:1, always fully replaced (its
// observations deleted and recreated) by the next successful AI run, not
// versioned/append-only like SampleVersion. `rawResponseJson` keeps the
// complete original AI response for audit/debugging, but per explicit
// instruction is never the only usable data structure -- every individual
// observation is also a real row in AiGarmentReferenceObservation.
model AiGarmentReferenceAnalysis {
  id                                 String                           @id @default(uuid()) @db.Uuid
  companyId                          String                           @map("company_id") @db.Uuid
  projectId                          String                           @unique @map("project_id") @db.Uuid
  // Soft reference to the Attachment this analysis was actually run against
  // -- kept even if the project's own current reference image is later
  // replaced, so a STALE analysis still records what it was analysing.
  referenceAttachmentId              String                           @map("reference_attachment_id") @db.Uuid
  status                             AiGarmentReferenceAnalysisStatus @default(DRAFT)
  analysisVersion                    Int                              @default(0) @map("analysis_version")
  promptVersion                      String                           @map("prompt_version")
  provider                           String
  model                              String
  rawResponseJson                    Json                             @map("raw_response_json")
  constructionComplexityLevel        AiGarmentConstructionComplexity? @map("construction_complexity_level")
  constructionComplexityExplanation  String?                          @map("construction_complexity_explanation")
  manufacturingChallenges            String[]                         @map("manufacturing_challenges")
  keyDesignLanguageFeatures          String[]                         @map("key_design_language_features")
  featuresForFurtherDevelopment      String[]                         @map("features_for_further_development")
  featuresToChangeForDifferentiation String[]                         @map("features_to_change_for_differentiation")
  missingInformation                 String[]                         @map("missing_information")
  designDnaSummary                   String?                          @map("design_dna_summary")
  approvedByUserId                   String?                          @map("approved_by_user_id") @db.Uuid
  approvedAt                         DateTime?                        @map("approved_at")
  createdByUserId                    String                           @map("created_by_user_id") @db.Uuid
  createdAt                          DateTime                         @default(now()) @map("created_at")
  updatedAt                          DateTime                         @updatedAt @map("updated_at")

  company              Company                         @relation(fields: [companyId], references: [id])
  project              AiGarmentProject                @relation(fields: [projectId], references: [id])
  approvedBy           User?                           @relation("AiGarmentReferenceAnalysisApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy            User                            @relation("AiGarmentReferenceAnalysisCreatedBy", fields: [createdByUserId], references: [id])
  observations         AiGarmentReferenceObservation[]
  runs                 AiGarmentReferenceAnalysisRun[]
  developmentBriefRuns AiGarmentDevelopmentBriefRun[]

  @@map("ai_garment_reference_analyses")
}

// One row per analysed feature (garmentCategory, silhouette, sleeve.type,
// fabricObservations.weight, ...) -- 36 rows per analysis, matching the AI
// prompt's own 24 top-level + sleeve's 4 + fabricObservations' 6 +
// printPattern's 5 sub-keys. featureKey is the dotted path (e.g.
// "sleeve.type"); its display label/grouping is derived from a shared
// constant map (src/core/ai/reference-analysis/feature-registry.ts), not
// stored here, to avoid duplicating data that never varies per row.
model AiGarmentReferenceObservation {
  id                       String                      @id @default(uuid()) @db.Uuid
  analysisId               String                      @map("analysis_id") @db.Uuid
  featureKey               String                      @map("feature_key")
  aiObservation            String                      @map("ai_observation")
  aiConfidence             AiGarmentAnalysisConfidence @map("ai_confidence")
  aiManufacturingRelevance String                      @map("ai_manufacturing_relevance")
  // Defaults to aiObservation at creation (nothing corrected yet) --
  // "final approved observation" always has a value for a later process to
  // read, even before a human has touched it.
  approvedObservation      String                      @map("approved_observation")
  userEdited               Boolean                     @default(false) @map("user_edited")
  approvedByUserId         String?                     @map("approved_by_user_id") @db.Uuid
  approvedAt               DateTime?                   @map("approved_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")

  analysis   AiGarmentReferenceAnalysis @relation(fields: [analysisId], references: [id])
  approvedBy User?                      @relation("AiGarmentReferenceObservationApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([analysisId, featureKey])
  @@map("ai_garment_reference_observations")
}

// Append-only log of every AI analysis attempt for a project, success or
// failure -- distinct from AiGarmentReferenceAnalysis (the one current,
// mutable "result") since a failed attempt must never overwrite a
// previously successful analysis, and every attempt (including failures)
// needs its own audit trail per explicit instruction.
model AiGarmentReferenceAnalysisRun {
  id                    String                     @id @default(uuid()) @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  projectId             String                     @map("project_id") @db.Uuid
  analysisId            String?                    @map("analysis_id") @db.Uuid
  referenceAttachmentId String                     @map("reference_attachment_id") @db.Uuid
  provider              String
  model                 String
  promptVersion         String                     @map("prompt_version")
  analysisVersion       Int                        @map("analysis_version")
  status                AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory         String?                    @map("error_category")
  errorMessage          String?                    @map("error_message")
  requestedAt           DateTime                   @default(now()) @map("requested_at")
  completedAt           DateTime?                  @map("completed_at")
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid

  company   Company                     @relation(fields: [companyId], references: [id])
  project   AiGarmentProject            @relation(fields: [projectId], references: [id])
  analysis  AiGarmentReferenceAnalysis? @relation(fields: [analysisId], references: [id])
  createdBy User                        @relation("AiGarmentReferenceAnalysisRunCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId, status])
  @@map("ai_garment_reference_analysis_runs")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 2: Commercial Design Development Brief (2026-09-06)
//
// Starts only once AiGarmentReferenceAnalysis.status = APPROVED (enforced in
// saveWorkflowStep). Every design direction is its own row, mutated in place
// on Edit/Regenerate (a `version` counter tracks regenerations, matching the
// brief's own explicit field list) rather than versioned/append-only like
// SampleVersion -- the brief asks for "Version" as a field ON the record,
// not "one row per version". `aiRawJson` keeps the complete original AI
// response per direction for audit, same precedent as AiGarmentReferenceAnalysis
// .rawResponseJson; the scalar columns are the current (possibly
// user-edited) content future processes (Generate Variations onward) read.
// ─────────────────────────────────────────────────────────────

enum AiGarmentDesignBalance {
  COMMERCIAL_LOWER_RISK
  BALANCED
  FASHION_FORWARD
}

enum AiGarmentCommercialClassification {
  SAFE_COMMERCIAL
  BALANCED
  FASHION_FORWARD
}

// Shared 3-tier rating used by Process 2's own Production Complexity /
// Expected Fabric Consumption / Target Price Compatibility fields --
// deliberately a new, generically-named enum rather than reusing Process
// 1's AiGarmentConstructionComplexity (same LOW/MEDIUM/HIGH values, but that
// enum's own name is specific to construction complexity; reusing it here
// would read confusingly on an unrelated column).
enum AiGarmentRatingLevel {
  LOW
  MEDIUM
  HIGH
}

enum AiGarmentDesignDirectionStatus {
  GENERATED
  APPROVED
  REJECTED
  SAVED_FOR_LATER
}

// One row per "Create Development Brief" click (batch of N directions) or
// per single-direction Regenerate -- reuses AiGarmentAnalysisRunStatus
// (IN_PROGRESS/SUCCESS/FAILED) from Process 1 verbatim, same generic
// AI-call-lifecycle concept. contextSnapshotJson captures the short form's
// resolved market/customer/season/category/price/currency/buyer/preferred-
// fabric/factory-capabilities at request time -- the user may override any
// of these for just this one brief without permanently changing the Style
// Master (Screen 1 already owns that), so this is the only place that
// exact input combination is ever recoverable for audit.
model AiGarmentDevelopmentBriefRun {
  id                      String                     @id @default(uuid()) @db.Uuid
  companyId               String                     @map("company_id") @db.Uuid
  projectId               String                     @map("project_id") @db.Uuid
  referenceAnalysisId     String                     @map("reference_analysis_id") @db.Uuid
  provider                String
  model                   String
  promptVersion           String                     @map("prompt_version")
  requestedDirectionCount Int                        @map("requested_direction_count")
  designBalance           AiGarmentDesignBalance     @map("design_balance")
  contextSnapshotJson     Json                       @map("context_snapshot_json")
  status                  AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory           String?                    @map("error_category")
  errorMessage            String?                    @map("error_message")
  requestedAt             DateTime                   @default(now()) @map("requested_at")
  completedAt             DateTime?                  @map("completed_at")
  createdByUserId         String                     @map("created_by_user_id") @db.Uuid

  company           Company                    @relation(fields: [companyId], references: [id])
  project           AiGarmentProject           @relation(fields: [projectId], references: [id])
  referenceAnalysis AiGarmentReferenceAnalysis @relation(fields: [referenceAnalysisId], references: [id])
  createdBy         User                       @relation("AiGarmentDevelopmentBriefRunCreatedBy", fields: [createdByUserId], references: [id])
  directions        AiGarmentDesignDirection[]

  @@index([projectId, status])
  @@map("ai_garment_development_brief_runs")
}

model AiGarmentDesignDirection {
  id                    String                         @id @default(uuid()) @db.Uuid
  companyId             String                         @map("company_id") @db.Uuid
  projectId             String                         @map("project_id") @db.Uuid
  developmentBriefRunId String                         @map("development_brief_run_id") @db.Uuid
  version               Int                            @default(1)
  status                AiGarmentDesignDirectionStatus @default(GENERATED)
  aiGeneratedAt         DateTime                       @default(now()) @map("ai_generated_at")
  userNotes             String?                        @map("user_notes")
  userEdited            Boolean                        @default(false) @map("user_edited")

  designDirectionName           String                            @map("design_direction_name")
  commercialClassification      AiGarmentCommercialClassification @map("commercial_classification")
  targetConsumer                String                            @map("target_consumer")
  silhouette                    String
  garmentLength                 String                            @map("garment_length")
  fit                           String
  neckline                      String
  collar                        String
  sleeve                        String
  shoulderConstruction          String                            @map("shoulder_construction")
  frontConstruction             String                            @map("front_construction")
  backConstruction              String                            @map("back_construction")
  closure                       String
  pocket                        String
  waistTreatment                String                            @map("waist_treatment")
  hem                           String
  keyNewDesignFeature           String                            @map("key_new_design_feature")
  suggestedFabricCharacter      String                            @map("suggested_fabric_character")
  suggestedTrims                String                            @map("suggested_trims")
  productionComplexity          AiGarmentRatingLevel              @map("production_complexity")
  expectedFabricConsumption     AiGarmentRatingLevel              @map("expected_fabric_consumption")
  targetPriceCompatibilityLevel AiGarmentRatingLevel              @map("target_price_compatibility_level")
  commercialRationale           String                            @map("commercial_rationale")
  manufacturingRisk             String                            @map("manufacturing_risk")
  differentiationFromReference  String                            @map("differentiation_from_reference")

  commercialPotentialScore      Int     @map("commercial_potential_score")
  buyerFitScore                 Int     @map("buyer_fit_score")
  manufacturingEaseScore        Int     @map("manufacturing_ease_score")
  targetPriceCompatibilityScore Int     @map("target_price_compatibility_score")
  fabricEfficiencyScore         Int     @map("fabric_efficiency_score")
  designFreshnessScore          Int     @map("design_freshness_score")
  overallScore                  Int     @map("overall_score")
  isRecommendedForVisualisation Boolean @default(false) @map("is_recommended_for_visualisation")

  aiRawJson Json @map("ai_raw_json")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company                   Company                             @relation(fields: [companyId], references: [id])
  project                   AiGarmentProject                    @relation(fields: [projectId], references: [id])
  developmentBriefRun       AiGarmentDevelopmentBriefRun        @relation(fields: [developmentBriefRunId], references: [id])
  createdBy                 User                                @relation("AiGarmentDesignDirectionCreatedBy", fields: [createdByUserId], references: [id])
  imageGenerationRuns       AiGarmentImageGenerationRun[]
  generatedImages           AiGarmentGeneratedImage[]
  designVariationRuns       AiGarmentDesignVariationRun[]
  designVariations          AiGarmentDesignVariation[]
  commercialEvaluationItems AiGarmentCommercialEvaluationItem[]
  selectedByProjects        AiGarmentProject[]                  @relation("AiGarmentProjectSelectedDesign")

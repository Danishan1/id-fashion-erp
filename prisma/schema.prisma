  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  color   Color   @relation(fields: [colorId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])

  salesOrderBreakdown SalesOrderItemBreakdown[]
  cartonItems         CartonItem[]
  lotVariantBreakdown LotVariantBreakdown[]

  @@unique([productId, colorId, sizeId])
  @@map("product_variants")
}

enum WarehouseType {
  RAW_MATERIAL
  FABRIC
  TRIMS
  WIP
  FINISHED_GOODS
  DISPATCH
  REJECT
}

model Warehouse {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  code              String
  name              String
  // Array, not a single value — a physical warehouse routinely stores more
  // than one material kind in different rooms/sections (2026-09-02). Existing
  // single-value rows migrate to a one-element array, never dropped.
  type              WarehouseType[]
  managerEmployeeId String?         @map("manager_employee_id") @db.Uuid
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  branch                Branch                 @relation(fields: [branchId], references: [id])
  locations             WarehouseLocation[]
  goodsReceiptItems     GoodsReceiptItem[]
  inventoryTransactions InventoryTransaction[]
  stockBalances         StockBalance[]
  materialRequests      MaterialRequest[]
  stockMovementsFrom    StockMovement[]        @relation("StockMovementSourceWarehouse")
  stockMovementsTo      StockMovement[]        @relation("StockMovementDestinationWarehouse")
  dispatches            Dispatch[]
  jobWorkOrderMaterials JobWorkOrderMaterial[]

  jobWorkOrdersFgDestination JobWorkOrder[] @relation("JobWorkOrderFgWarehouse")

  @@unique([branchId, code])
  @@map("warehouses")
}

model WarehouseLocation {
  id                    String            @id @default(uuid()) @db.Uuid
  warehouseId           String            @map("warehouse_id") @db.Uuid
  code                  String
  zone                  String?
  rack                  String?
  bin                   String?
  // Which kind of material (or, since 2026-09-04, production stage) this
  // physical room/section is dedicated to (e.g. "Fabric Room" vs "WIP Room"
  // vs "Finished Goods Room" within one Warehouse building) — nullable,
  // since not every location needs one. Reuses Product's own
  // MaterialCategory enum (not a new list) but validated at the Zod layer
  // against the wider LOCATION_MATERIAL_CATEGORIES list (warehouse.schema.ts),
  // which is a superset of Product's own MATERIAL_CATEGORIES plus
  // WIP/FINISHED_GOODS/DISPATCH/REJECT — advisory only: nothing rejects
  // storing a mismatched material here, see the Zod-level warning built for
  // this in the Goods Receipt / Stock Movement / Material Request UIs.
  materialCategory      MaterialCategory? @map("material_category")
  // Free-text note captured only when materialCategory = OTHER (e.g. "Packing
  // Machine Room") — added 2026-09-04 so "Other" isn't a dead-end label.
  // Service layer forces this back to null whenever materialCategory is
  // anything else, so it can never silently go stale after a re-tag.
  materialCategoryOther String?           @map("material_category_other")
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")

  // NOTE: no companyId column of its own — any company-scoped lookup on a
  // warehouseLocationId FK must join through warehouse.companyId, never
  // assume a direct filter (the exact bug class fixed 27 times project-wide).
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  goodsReceiptItems     GoodsReceiptItem[]
  fabricRolls           FabricRoll[]
  inventoryTransactions InventoryTransaction[]
  stockMovementItems    StockMovementItem[]
  materialRequestItems  MaterialRequestItem[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model ProductionStage {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  parentStageId          String?  @map("parent_stage_id") @db.Uuid
  code                   String
  name                   String
  sequence               Int      @default(0)
  // Landing here (forward) is what auto-fires the Finished-Goods receipt —
  // avoids inferring "last stage" from MAX(sequence), which breaks the
  // moment a company appends a stage after their current final one.
  isFinal                Boolean  @default(false) @map("is_final")
  // A stage can be marked "no rework back into this stage" (e.g. a
  // post-Dispatch labeling step) — checked on the TARGET stage of a revert.
  allowRework            Boolean  @default(true) @map("allow_rework")
  // Advisory only — QC remains possible at any stage regardless of this
  // flag; it just pre-selects a sensible default in the UI.
  isQcRecommended        Boolean  @default(false) @map("is_qc_recommended")
  // A stage that can legitimately produce MORE pieces than it was given —
  // Cutting cuts extra from the fabric lay. Only on such a stage may a
  // progress entry carry an explicit extraQuantity (never silently inferred).
  allowsExtraQuantity    Boolean  @default(false) @map("allows_extra_quantity")
  departmentId           String?  @map("department_id") @db.Uuid
  // UI default only ("who's usually responsible here") — never an
  // enforcement gate.
  defaultOwnerEmployeeId String?  @map("default_owner_employee_id") @db.Uuid
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company              Company                      @relation(fields: [companyId], references: [id])
  parentStage          ProductionStage?             @relation("StageHierarchy", fields: [parentStageId], references: [id])
  subStages            ProductionStage[]            @relation("StageHierarchy")
  department           Department?                  @relation(fields: [departmentId], references: [id])
  defaultOwner         Employee?                    @relation("ProductionStageDefaultOwner", fields: [defaultOwnerEmployeeId], references: [id])
  jobOrders            JobOrder[]
  lotsAtStage          Lot[]                        @relation("LotCurrentStage")
  transactionsFromHere ProductionStageTransaction[] @relation("StageTransactionFromStage")
  transactionsToHere   ProductionStageTransaction[] @relation("StageTransactionToStage")
  roleAccess           RoleProductionStageAccess[]
  employeeWorkSkills   EmployeeWorkSkill[]
  productionOperations ProductionOperation[]
  routeStages          ProductionRouteStage[]
  contractorStages     ContractorStage[]
  styleStageCosts      StyleStageCost[]
  designStageCosts     DesignStageCost[]
  jobWorkOrderStages   JobWorkOrderStage[]

  @@unique([companyId, code])
  @@map("production_stages")
}

// -----------------------------------------------------------------------------
// Piece-Rate / Worker-Pricing engine (2026-09-18) — a genuinely new,
// lightweight costing dimension layered ON TOP OF the existing stage-movement
// engine above, never inside it. ProductionOperation NEVER participates in
// stage forward/revert/QC (postStageTransactionInTx, forwardJobOrder,
// revertJobOrder, recordQcInspection all remain untouched) — it exists solely
// so a Rate Card can price "Style X + Sleeve Attach" independently of the
// coarse ProductionStage a lot actually moves through. The optional
// productionStageId below is an organizational tag only ("this operation is
// usually done during Stitching"), read by nothing in the movement engine.
// -----------------------------------------------------------------------------

model ProductionOperation {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  productionStageId String?  @map("production_stage_id") @db.Uuid
  code              String
  name              String
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  productionStage     ProductionStage?     @relation(fields: [productionStageId], references: [id])
  rateCards           PieceRateCard[]
  earnings            PieceRateEarning[]
  jobWorkOrders       JobWorkOrder[]
  jobOrderAssignments JobOrderAssignment[]

  @@unique([companyId, code])
  @@map("production_operations")
}

enum RateCardRateSource {
  WORKER_SPECIFIC
  WORKER_GRADE
  STYLE_OPERATION_DEFAULT
  OPERATION_DEFAULT
  // The External Unit (Contractor) analogue of WORKER_SPECIFIC — resolved via
  // resolveContractorPieceRate(), never resolvePieceRate() (which is
  // Employee-only). Enum value name kept as SUPPLIER_SPECIFIC (2026-09-25
  // Contractor-promotion rename) — renaming a live Postgres enum value needs
  // its own migration and isn't required for the FK-field rename to compile;
  // deliberately deferred as cosmetic-only.
  SUPPLIER_SPECIFIC
}

// One generalized table for every rate-card tier, not several parallel
// tables — a row's "specificity tier" is determined purely by which of
// employeeId/employeeCategoryId/supplierId is non-null, resolved by
// resolvePieceRate() (piece-rate-resolution.service.ts) in strict priority
// order. Exactly one of {employeeId, employeeCategoryId, neither} may be set
// per row, each optionally further scoped by productId (Style). supplierId
// is populated only by the External Job-Work rate path
// (job-work-order.service.ts's createJobWorkOrder) — P1a's own Rate Card
// UI/service rejects any attempt to set it directly. Overlap prevention
// (no two active rows for the identical dimension tuple with overlapping
// [effectiveFrom, effectiveTo) windows) is enforced in
// piece-rate-card.service.ts, reusing tax-config.service.ts's own
// half-open-interval rangesOverlap() pattern verbatim — nullable dimension
// columns can't express this as a DB @@unique constraint.
model PieceRateCard {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  productionOperationId String    @map("production_operation_id") @db.Uuid
  productId             String?   @map("product_id") @db.Uuid
  employeeId            String?   @map("employee_id") @db.Uuid
  employeeCategoryId    String?   @map("employee_category_id") @db.Uuid
  contractorId          String?   @map("contractor_id") @db.Uuid
  rate                  Decimal   @db.Decimal(18, 4)
  effectiveFrom         DateTime  @map("effective_from") @db.Date
  effectiveTo           DateTime? @map("effective_to") @db.Date
  isActive              Boolean   @default(true) @map("is_active")
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?   @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  company                Company              @relation(fields: [companyId], references: [id])
  productionOperation    ProductionOperation  @relation(fields: [productionOperationId], references: [id])
  product                Product?             @relation(fields: [productId], references: [id])
  employee               Employee?            @relation(fields: [employeeId], references: [id])
  employeeCategory       EmployeeCategory?    @relation(fields: [employeeCategoryId], references: [id])
  contractor             Contractor?          @relation(fields: [contractorId], references: [id])
  createdBy              User                 @relation("PieceRateCardCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy              User?                @relation("PieceRateCardUpdatedBy", fields: [updatedByUserId], references: [id])
  resolvedForAssignments JobOrderAssignment[]

  @@index([companyId, productionOperationId])
  @@index([companyId, productId, productionOperationId])
  @@index([companyId, employeeId, productionOperationId])
  @@index([companyId, employeeCategoryId, productionOperationId])
  @@index([companyId, contractorId, productionOperationId])
  @@map("piece_rate_cards")
}

enum PieceRateEarnerType {
  EMPLOYEE
  SUPPLIER
}

enum PieceRateEarningStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  PAYABLE
  PAID
  ADJUSTED
  CANCELLED
}

enum PieceRatePaymentQuantityRule {
  GOOD_COMPLETED_QTY
  QC_ACCEPTED_QTY
}

// The earning ledger — one row per INCREMENTAL payable quantity, never a
// running total, keyed by (jobOrderId, earner, productionOperationId).
// Rework never mutates a JobOrder (postStageTransactionInTx always creates a
// brand-new JobOrder row at the rework destination), so this key is already
// fully isolated per lineage step: generateEarningForJobOrderProgress()
// (piece-rate-earning.service.ts) computes the JobOrder's live eligible
// quantity fresh, subtracts the sum of every prior non-cancelled earning row
// sharing this exact key, and inserts a new row only for the strictly
// positive remainder — a physical piece can never be paid for twice, even
// across a QC-accept/rework/re-accept cycle. Exactly one of
// {employeeId+jobOrderAssignmentId, supplierId+jobWorkOrderId} is populated
// per row, matching earnerType — an EMPLOYEE row is generated from ordinary
// internal progress (recordProgressEntry/approveProgressEntry/
// recordAdjustmentEntry/recordQcInspection in job-order.service.ts); a
// SUPPLIER row is generated from an external Job Work receipt
// (receiveJobWork in job-work-order.service.ts) — same table, same
// no-duplicate-payment algorithm, never a second ledger mechanism.
model PieceRateEarning {
  id                          String                       @id @default(uuid()) @db.Uuid
  companyId                   String                       @map("company_id") @db.Uuid
  jobOrderId                  String                       @map("job_order_id") @db.Uuid
  earnerType                  PieceRateEarnerType          @map("earner_type")
  jobOrderAssignmentId        String?                      @map("job_order_assignment_id") @db.Uuid
  employeeId                  String?                      @map("employee_id") @db.Uuid
  jobWorkOrderId              String?                      @map("job_work_order_id") @db.Uuid
  jobWorkReceiptId            String?                      @map("job_work_receipt_id") @db.Uuid
  contractorId                String?                      @map("contractor_id") @db.Uuid
  productionOperationId       String?                      @map("production_operation_id") @db.Uuid
  qtyBasis                    PieceRatePaymentQuantityRule @map("qty_basis")
  payableQuantity             Decimal                      @map("payable_quantity") @db.Decimal(18, 4)
  rateApplied                 Decimal                      @map("rate_applied") @db.Decimal(18, 4)
  rateSource                  RateCardRateSource?          @map("rate_source")
  amount                      Decimal                      @map("amount") @db.Decimal(18, 2)
  status                      PieceRateEarningStatus       @default(PENDING)
  cumulativeBasisAtGeneration Decimal                      @map("cumulative_basis_at_generation") @db.Decimal(18, 4)
  generatedFromEntryId        String?                      @map("generated_from_entry_id") @db.Uuid
  generatedFromQcInspectionId String?                      @map("generated_from_qc_inspection_id") @db.Uuid
  approvedByUserId            String?                      @map("approved_by_user_id") @db.Uuid
  approvedAt                  DateTime?                    @map("approved_at")
  remarks                     String?
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  jobOrder            JobOrder             @relation(fields: [jobOrderId], references: [id])
  jobOrderAssignment  JobOrderAssignment?  @relation(fields: [jobOrderAssignmentId], references: [id])
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  jobWorkOrder        JobWorkOrder?        @relation(fields: [jobWorkOrderId], references: [id])
  jobWorkReceipt      JobWorkReceipt?      @relation(fields: [jobWorkReceiptId], references: [id])
  contractor          Contractor?          @relation(fields: [contractorId], references: [id])
  productionOperation ProductionOperation? @relation(fields: [productionOperationId], references: [id])
  approvedBy          User?                @relation("PieceRateEarningApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([companyId, employeeId])
  @@index([companyId, contractorId])
  @@index([jobOrderId, jobOrderAssignmentId])
  @@index([jobOrderId, jobWorkOrderId])
  @@index([companyId, status])
  @@map("piece_rate_earnings")
}

// Company-wide Production behavior toggles — flat one-row-per-company,
// exact shape of ActionDisplaySettings (missing row = the defaults below, no
// backfill needed).
model ProductionSettings {
  id                           String                       @id @default(uuid()) @db.Uuid
  companyId                    String                       @unique @map("company_id") @db.Uuid
  // When true, recordProgressEntry() (the ordinary Supervisor-direct path)
  // routes through the same PENDING+approve flow submitSelfProgressEntry
  // already uses, instead of applying immediately.
  supervisorApprovalRequired   Boolean                      @default(false) @map("supervisor_approval_required")
  // Who may submit a Job Work receipt on an external unit's behalf.
  externalEntryBy              ExternalEntrySource          @default(INTERNAL_SUPERVISOR) @map("external_entry_by")
  pieceRateTrackingEnabled     Boolean                      @default(false) @map("piece_rate_tracking_enabled")
  pieceRatePaymentQuantityRule PieceRatePaymentQuantityRule @default(QC_ACCEPTED_QTY) @map("piece_rate_payment_quantity_rule")
  workersCanViewOwnRate        Boolean                      @default(false) @map("workers_can_view_own_rate")
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("production_settings")
}

enum ExternalEntrySource {
  EXTERNAL_UNIT_USER
  INTERNAL_SUPERVISOR
  BOTH
}

// Advisory-only, optionally Style-tagged ordered subset of existing
// ProductionStages — never a hard gate. Ordering is always derived from the
// referenced ProductionStage.sequence, never a second independent ordinal,

// -----------------------------------------------------------------------------
// AI Provider & API Management + Automatic Failover (2026-09-10)
//
// A genuinely new area (confirmed via a dedicated research pass before
// writing this: grep across the whole schema for any Provider/AIConfig/
// ApiKey/Credential/Usage/Failover/Health model name returned zero
// matches). Extends, rather than duplicates, what already exists: reuses
// src/core/security/encryption.ts's encryptSecret/decryptSecret verbatim
// for apiKeyEncrypted (the same NEXTAUTH_SECRET-derived key
// AdAccountConnection's OAuth tokens already use -- no new key to manage),
// reuses the existing ImageGenerationProvider interface/ImageGenErrorCategory
// taxonomy as the runtime contract every provider still implements, and is
// gated behind the existing "administration" RBAC module (matching every
// other admin-only settings tab -- Company Settings, Worker Settings,
// Module Visibility -- none of which got their own RBAC module either).
//
// Scoping decision, made explicitly rather than left implicit: AIProvider
// rows are per-company only (companyId required, not nullable). No genuine
// "global config row + per-company override" pattern exists anywhere in
// this codebase today (SubmoduleVisibility's own "global default" is a
// hardcoded true fallback in code, not a queryable global row -- see
// SubmoduleVisibilityService) -- inventing one here, unproven need, would
// have added exactly the kind of complexity this project's own conventions
// warn against. Every company independently configures its own providers,
// consistent with every other admin-managed entity in this app (Company
// Settings, Branches, Document Sequences, Module Visibility are all
// per-company). A true global-default tier can be added later as a
// proven-needed extension without breaking this shape.
//
// Consolidation decision: the original suggested table list named 6 tables
// (AIProvider, AIProviderCredential, AIProviderModel, AIProviderUsage,
// AIProviderHealth, AIFailoverLog), 3 of which (Credential/Model/Health)
// are genuinely 1:1 with a single AIProvider row, not a real one-to-many
// relationship -- splitting them into separate tables would have meant a
// join for every single read with no real data-modeling benefit. Merged
// into AIProvider itself; AIProviderUsage and AIFailoverLog remain separate
// since they are genuinely one-to-many (many usage/failover events per
// provider over time).

enum AIProviderType {
  OPENAI
  GEMINI
  CLOUDFLARE
  QWEN_LOCAL
}

/**
 * Matches the distinct image-generation operations AI Designer's own pipeline(s) actually distinguish today -- not a speculative larger taxonomy.
 */
enum AIProviderCapability {
  TEXT_TO_IMAGE
  IMAGE_EDIT
  FABRIC_REFERENCE
  // Applies a SECOND fabric image onto specific area(s) of an already-
  // generated design (Multi-Fabric) -- routed to ImageGenerationProvider's
  // own `applyFabric` (a genuine two-image composition), distinct from
  // IMAGE_EDIT's single-image `generateVariation` -- a provider capable of
  // one is not necessarily capable of the other (confirmed: the Cloudflare
  // provider implements generateVariation but deliberately omits
  // applyFabric).
  MULTI_FABRIC
  // Regenerates the current design as a graded technical flat / CAD-style
  // line drawing (AI Designer's own Tech Pack feature) -- routed to
  // `generateTechnicalFlat`, a single-base-image transform distinct in kind
  // from IMAGE_EDIT's "change one named aspect" semantics.
  TECHNICAL_FLAT
  // Replicate Design (2026-09-13) -- regenerates an externally-uploaded
  // reference garment photo using a new fabric/material photo while
  // preserving the reference's own structural design -- routed to
  // `replicateWithNewMaterial`, its own distinct method (never reusing
  // MULTI_FABRIC/applyFabric's capability tag, even though the underlying
  // vendor call may be identical) so provider health/failover stays
  // correctly attributed per feature.
  DESIGN_REPLICATION
  // Draw & Describe (2026-09-24) -- a pencil-drawn mask + a free-text
  // instruction, routed to `inpaint` (OpenAI's images.edit with a real
  // `mask` parameter: only the mask's fully-transparent pixels are eligible
  // to change). Distinct from IMAGE_EDIT's `generateVariation` -- a
  // provider capable of a whole-image edit is not necessarily capable of a
  // pixel-masked one (Gemini/Cloudflare have no mask-editing API at all),
  // so this stays its own capability tag rather than overloading IMAGE_EDIT
  // and risking a wasted failover attempt against a provider that would
  // only ever return UNSUPPORTED_OPERATION for it.
  MASK_EDIT
}

/**
 * Runtime health/quota state, distinct from the static isActive admin toggle -- a provider can be isActive:true but currently QUOTA_EXHAUSTED (in cooldown), or isActive:false (an admin deliberately disabled it, never even attempted).
 */
enum AIProviderHealthStatus {
  HEALTHY
  RATE_LIMITED
  QUOTA_EXHAUSTED
  UNAVAILABLE
  AUTH_ERROR
  DISABLED
}

/**
 * The normalized error taxonomy AIProviderManager classifies every
 * provider failure into -- deliberately a superset of the existing,
 * narrower ImageGenErrorCategory (src/core/ai/image-generation/types.ts),
 * since that one predates and does not distinguish "should this trigger
 * failover" (it has no separate content-policy-vs-auth-failure split).
 * Kept as its own enum rather than widening the existing one, since
 * ImageGenErrorCategory is a provider-SDK-facing contract
 * (UNSUPPORTED_OPERATION, INVALID_IMAGE_RESPONSE describe the SDK response
 * shape, not failover eligibility) -- AIUsageErrorCategory is specifically
 * about "what should the failover engine do next," a different concern at
 * a different layer.
 */
enum AIUsageErrorCategory {
  QUOTA_EXHAUSTED
  RATE_LIMITED
  PROVIDER_UNAVAILABLE
  TIMEOUT
  AUTH_ERROR
  INVALID_REQUEST
  CONTENT_POLICY
  INTERNAL_ERROR
}

model AIProvider {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  name         String
  providerType AIProviderType @map("provider_type")

  // Encrypted via src/core/security/encryption.ts's encryptSecret -- never
  // the plain key. Nullable because QWEN_LOCAL (a self-hosted endpoint) may
  // need no API key at all, only a baseUrl.
  apiKeyEncrypted String? @map("api_key_encrypted")
  model           String
  baseUrl         String? @map("base_url")

  isActive               Boolean @default(true) @map("is_active")
  // Lower number = tried first. Deliberately a plain Int, not a unique
  // constraint -- two providers legitimately sharing a priority is fine
  // (stable-sorted by createdAt as the tiebreaker); forcing strict
  // uniqueness would only add friction for no real benefit.
  priority               Int     @default(100)
  autoFailoverEnabled    Boolean @default(true) @map("auto_failover_enabled")
  dailyGenerationLimit   Int?    @map("daily_generation_limit")
  monthlyGenerationLimit Int?    @map("monthly_generation_limit")
  requestTimeoutMs       Int     @default(120000) @map("request_timeout_ms")
  maxRetryCount          Int     @default(1) @map("max_retry_count")

  capabilities AIProviderCapability[]

  // Runtime health/cooldown state -- mutated by AIProviderManager after
  // every real call, not by any admin action directly (the admin can only
  // force it back to HEALTHY via a manual "Reset" action, or DISABLED via
  // the isActive toggle).
  healthStatus      AIProviderHealthStatus @default(HEALTHY) @map("health_status")
  cooldownUntil     DateTime?              @map("cooldown_until")
  lastHealthCheckAt DateTime?              @map("last_health_check_at")
  lastErrorMessage  String?                @map("last_error_message")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("AIProviderCreatedBy", fields: [createdByUserId], references: [id])

  usageLogs               AIProviderUsage[]
  failoverLogsAsRequested AIFailoverLog[]   @relation("AIFailoverRequestedProvider")
  failoverLogsAsFallback  AIFailoverLog[]   @relation("AIFailoverFallbackProvider")

  @@unique([companyId, name])
  @@map("ai_providers")
}

/**
 * One row per real generation attempt (success or failure) that reached
 * AIProviderManager -- providerId is nullable for the "no compatible
 * provider was even found" case (the request never reached any real API at
 * all, still worth recording so the usage dashboard/failover history is
 * complete). estimatedCost/tokenUsage are populated only when the
 * provider's own real response actually carries that information.
 */
model AIProviderUsage {
  id                       String  @id @default(uuid()) @db.Uuid
  companyId                String  @map("company_id") @db.Uuid
  providerId               String? @map("provider_id") @db.Uuid
  userId                   String? @map("user_id") @db.Uuid
  aiDesignerProjectId      String? @map("ai_designer_project_id") @db.Uuid
  // Replicate Design (2026-09-13) -- a separate, genuinely different project
  // table from AiDesignerProject, so its own usage rows need their own FK
  // rather than overloading aiDesignerProjectId with an id from a different
  // table (which the existing FK constraint would reject outright).
  replicateDesignProjectId String? @map("replicate_design_project_id") @db.Uuid

  generationType AIProviderCapability @map("generation_type")
  requestedAt    DateTime             @default(now()) @map("requested_at")
  durationMs     Int?                 @map("duration_ms")
  success        Boolean

  errorCategory AIUsageErrorCategory? @map("error_category")
  errorMessage  String?               @map("error_message")

  providerRequestId String?  @map("provider_request_id")
  inputImagePresent Boolean  @default(false) @map("input_image_present")
  outputCount       Int      @default(0) @map("output_count")
  tokenUsage        Int?     @map("token_usage")
  estimatedCost     Decimal? @map("estimated_cost") @db.Decimal(10, 4)

  company                Company                 @relation(fields: [companyId], references: [id])
  provider               AIProvider?             @relation(fields: [providerId], references: [id])
  user                   User?                   @relation("AIProviderUsageUser", fields: [userId], references: [id])
  project                AiDesignerProject?      @relation(fields: [aiDesignerProjectId], references: [id])
  replicateDesignProject ReplicateDesignProject? @relation(fields: [replicateDesignProjectId], references: [id])

  @@map("ai_provider_usage")
}

/**
 * One row per automatic failover attempt AIProviderManager makes --
 * "attempt", not just "success": a failed fallback that itself fails over
 * to a third provider produces two rows (OpenAI to Gemini, then Gemini to
 * Qwen), each independently showing its own result. requestedProviderId/
 * fallbackProviderId are both nullable: the former for a genuinely
 * unattributable case, the latter for the terminal "no more candidates
 * left" case (no fallback exists to name).
 */
model AIFailoverLog {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @map("company_id") @db.Uuid
  requestedProviderId String?              @map("requested_provider_id") @db.Uuid
  fallbackProviderId  String?              @map("fallback_provider_id") @db.Uuid
  reason              AIUsageErrorCategory
  generationContext   String               @map("generation_context")
  result              String
  createdAt           DateTime             @default(now()) @map("created_at")

  company           Company     @relation(fields: [companyId], references: [id])
  requestedProvider AIProvider? @relation("AIFailoverRequestedProvider", fields: [requestedProviderId], references: [id])
  fallbackProvider  AIProvider? @relation("AIFailoverFallbackProvider", fields: [fallbackProviderId], references: [id])

  @@map("ai_failover_logs")
}

/// Contractor ↔ Production Stage (which stages an external unit performs),
/// ordered by `sequence`. See Contractor.stages.
model ContractorStage {
  id                String   @id @default(uuid()) @db.Uuid
  contractorId      String   @map("contractor_id") @db.Uuid
  productionStageId String   @map("production_stage_id") @db.Uuid
  sequence          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")

  contractor      Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  productionStage ProductionStage @relation(fields: [productionStageId], references: [id])

  @@unique([contractorId, productionStageId])
  @@index([productionStageId])
  @@map("contractor_stages")
}

/// Master Style → Stage → default job-work cost per piece.
model StyleStageCost {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  productionStageId String   @map("production_stage_id") @db.Uuid
  cost              Decimal  @db.Decimal(18, 4)
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company         Company         @relation(fields: [companyId], references: [id])
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productionStage ProductionStage @relation(fields: [productionStageId], references: [id])

  @@unique([productId, productionStageId])
  @@index([companyId])
  @@map("style_stage_costs")
}

/// Design-specific override of a Style's stage cost. Only overridden stages
/// have a row — every other stage inherits the Style's current default, so a
/// Style cost change never overwrites a customized Design cost.
model DesignStageCost {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  sampleRequestId   String   @map("sample_request_id") @db.Uuid
  productionStageId String   @map("production_stage_id") @db.Uuid
  cost              Decimal  @db.Decimal(18, 4)
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company         Company         @relation(fields: [companyId], references: [id])
  sampleRequest   SampleRequest   @relation(fields: [sampleRequestId], references: [id], onDelete: Cascade)
  productionStage ProductionStage @relation(fields: [productionStageId], references: [id])

  @@unique([sampleRequestId, productionStageId])
  @@index([companyId])
  @@map("design_stage_costs")
}

enum StageCostSource {
  STYLE_DEFAULT
  DESIGN_OVERRIDE
  NOT_CONFIGURED
}

/// One covered stage of a (possibly multi-stage) Job Work Order, with its
/// cost frozen at creation. `defaultRate`/`defaultSource` record what the
/// Style/Design hierarchy suggested; `rate` is what this transaction actually
/// uses (isOverridden when they differ).
model JobWorkOrderStage {
  id                String          @id @default(uuid()) @db.Uuid
  jobWorkOrderId    String          @map("job_work_order_id") @db.Uuid
  productionStageId String          @map("production_stage_id") @db.Uuid
  sequence          Int
  quantity          Decimal         @db.Decimal(18, 4)
  defaultRate       Decimal?        @map("default_rate") @db.Decimal(18, 4)
  defaultSource     StageCostSource @map("default_source")
  rate              Decimal         @db.Decimal(18, 4)
  isOverridden      Boolean         @default(false) @map("is_overridden")
  amount            Decimal         @db.Decimal(18, 2)
  createdAt         DateTime        @default(now()) @map("created_at")

  jobWorkOrder    JobWorkOrder    @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  productionStage ProductionStage @relation(fields: [productionStageId], references: [id])

  @@unique([jobWorkOrderId, productionStageId])
  @@map("job_work_order_stages")
}

/// Additional non-stage charges on a Job Work Order (transport, urgent work,
/// special processing, ...).
model JobWorkOrderExtraCharge {
  id             String   @id @default(uuid()) @db.Uuid
  jobWorkOrderId String   @map("job_work_order_id") @db.Uuid
  costType       String   @map("cost_type")
  description    String?
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  jobWorkOrder JobWorkOrder @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)

  @@index([jobWorkOrderId])
  @@map("job_work_order_extra_charges")
}

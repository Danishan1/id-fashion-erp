  addressJson               Json?     @map("address_json")
  isActive                  Boolean   @default(true) @map("is_active")
  // Platform SaaS Phase 3 (PLAT-016): who suspended the company, when and
  // why. Cleared again when the company is reactivated; the full history
  // stays in audit_logs.
  suspendedAt               DateTime? @map("suspended_at")
  suspensionReason          String?   @map("suspension_reason")
  suspendedByPlatformUserId String?   @map("suspended_by_platform_user_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  baseCurrency                        Currency                             @relation(fields: [baseCurrencyCode], references: [code])
  branches                            Branch[]

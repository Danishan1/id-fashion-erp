// Lets a Super Admin hide, per company, tabbed-masters submodules this
// company doesn't use (starting with Fabric Configuration's GSM/Dye/Weave
// Type/Width/Composition, generic so other tabbed masters can be onboarded
// later). A missing row means "visible" (the default) -- no backfill
// needed. Whether a submodule is *locked* (has real data, so its visibility
// can no longer change) is never stored here -- it's derived live from the
// underlying table's own row count in SubmoduleVisibilityService, matching
// this project's "derive real state, don't store a drifting label"
// discipline (Sampling Hold/Resume, Purchasing cancel-from-ON_HOLD).
model SubmoduleVisibility {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  submoduleKey String   @map("submodule_key")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, submoduleKey])
  @@map("submodule_visibility")
}

// ─────────────────────────────────────────────────────────────
// AI Designer (2026-09-10)
//
// A brand-new, fully isolated module -- NOT the same thing as "AI Garment
// Flow" above, despite doing a similar job (fabric -> guided wizard ->
// generated design image). Confirmed explicitly with the user: genuinely
// separate, ai_-prefixed tables, zero shared business logic, its own API
// route family and sidebar entry. The only two FKs anywhere in this module
// that point into pre-existing ERP tables are AiDesignerProject.fabricProductId
// (-> Product, the real Fabric Master, itemType RAW_MATERIAL) and
// .fabricSupplierId (-> Supplier) -- both read-only references (auto-filled
// once when an existing fabric is picked), never written back to.
//
// Exactly 5 tables, matching the user's own explicit naming: ai_projects,
// ai_prompts, ai_generations, ai_images, ai_versions. Flat columns on the
// project header (not a deep per-observation table) since nothing in this
// module's own spec asked for that granularity -- Product/Composition/GSM
// etc. are a short, fixed field list the user explicitly wants kept minimal.
enum AiDesignerFabricSource {
  EXISTING
  UPLOADED
}

enum AiDesignerTargetCustomer {
  MEN
  WOMEN
  BOYS
  GIRLS
  BABY
  UNISEX
}

enum AiDesignerProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AiDesignerPromptType {
  FABRIC_ANALYSIS
  PRODUCT_SUGGESTIONS
  IMAGE_GENERATE
  IMAGE_EDIT
  GARMENT_ANALYSIS
  COLOR_VARIANT
}

enum AiDesignerRunStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

enum AiDesignerImageDecision {
  PENDING
  SELECTED
  REJECTED
}

/**
 * Edit Design workspace (2026-09-13) — a version's own review/approval state, shown as the "Design Status" badge in the workspace's top toolbar. DRAFT is the initial (never-edited) generation; every version created via an edit starts AI_MODIFIED; UNDER_REVIEW/APPROVED/REJECTED are explicit human actions from the workspace's Approve/Reject controls.
 */
enum AiDesignerVersionApprovalStatus {
  DRAFT
  AI_MODIFIED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/**
 * Sketch / Drawing → Garment workflow (2026-09-20) -- a second intake path on
 * the SAME AiDesignerProject table (not a parallel project type): STANDARD is
 * every existing fabric-first project, SKETCH starts from an uploaded
 * hand-drawn/digital sketch whose structural design is preserved as the
 * authoritative reference (see AiDesignerSketchAnalysis below), fabric is
 * still applied exactly as today. Every other wizard step (Target/Age/
 * Category/Product Design/Model/Environment/Multi-Fabric/Embellishments/Edit
 * Design/Tech Pack/Export) is reused completely unchanged for either mode.
 */
enum AiDesignerCreationMode {
  STANDARD
  SKETCH
}

/**
 * Multi-piece Set support (2026-09-22) — SINGLE (default, unchanged
 * behavior) is one garment per project, exactly as this module has always
 * worked. SET is a coordinated multi-piece outfit (e.g. Kurta + Pant +
 * Dupatta) — see AiDesignerProjectPiece below. A SET project still produces
 * ONE generated design photo per version (the whole outfit worn together,
 * matching real fashion-catalogue photography for a set — not N separate
 * per-piece photos, which would be a much larger change to the whole
 * Generate/Edit/Version review flow). The real per-piece payoff is in the
 * Tech Pack, which tags Fabric & Materials/BOM/Measurement rows by piece —
 * see garmentPiece in tech-pack/schema.ts.
 */
enum AiDesignerProjectMode {
  SINGLE
  SET
}

/**
 * 4-step "New Design" flow (2026-09-27) -- which kind of photo the user
 * started from. Null = a project created through the original 13-step wizard
 * (which keeps working unchanged). FABRIC uses the existing
 * fabricImageAttachmentId; GARMENT/SKETCH use sourceImageAttachmentId and
 * pick a fabric from the Fabric Master (or upload a swatch) before generating.
 */
enum AiDesignerDesignSource {
  FABRIC
  GARMENT
  SKETCH
}

enum AiDesignerNewDesignStep {
  SOURCE
  GARMENT
  GENERATE
  DESIGNS
}

model AiDesignerProject {
  id            String                  @id @default(uuid()) @db.Uuid
  companyId     String                  @map("company_id") @db.Uuid
  projectNumber String                  @map("project_number")
  projectName   String                  @map("project_name")
  status        AiDesignerProjectStatus @default(DRAFT)
  creationMode  AiDesignerCreationMode  @default(STANDARD) @map("creation_mode")
  projectMode   AiDesignerProjectMode   @default(SINGLE) @map("project_mode")

  // Own, wholly separate resumable-wizard position -- mirrors the *shape* of
  // AiGarmentProject's currentStepKey/completedStepKeys, not shared code.
  // For a SKETCH-mode project, currentStep starts at "UPLOAD_SKETCH" instead
  // of "FABRIC_SELECTION" -- see stepsForCreationMode() in the service.
  currentStep    String   @default("FABRIC_SELECTION") @map("current_step")
  completedSteps String[] @map("completed_steps")

  // SKETCH mode only -- the uploaded sketch/drawing photo, same soft-ref
  // convention as fabricImageAttachmentId. Replacing/removing it marks any
  // existing AiDesignerSketchAnalysis STALE (same rule already proven for
  // Reference/Fabric Analysis and Replicate Design's own DNA analysis).
  sketchImageAttachmentId String? @map("sketch_image_attachment_id")

  // Step 1/2 -- fabric. fabricProductId/fabricSupplierId are read-only refs
  // into the real ERP Fabric Master; every other fabric* field is a plain
  // snapshot column -- auto-filled from Product when fabricSource=EXISTING
  // (Name/Code/Supplier/unit cost only -- confirmed the real Product row
  // carries nothing else), left blank/user-editable otherwise (Composition/
  // GSM/Width/Weave/Stretch/Opacity/Texture/PatternType/PrintType/
  // SuitableSeason/RecommendedGarments/Color), same honest-gap handling this
  // codebase already uses for the identical problem in the sibling module.
  fabricSource              AiDesignerFabricSource? @map("fabric_source")
  fabricProductId           String?                 @map("fabric_product_id") @db.Uuid
  fabricImageAttachmentId   String?                 @map("fabric_image_attachment_id")
  fabricName                String?                 @map("fabric_name")
  fabricCode                String?                 @map("fabric_code")
  fabricComposition         String?                 @map("fabric_composition")
  fabricGsm                 String?                 @map("fabric_gsm")
  fabricWidth               String?                 @map("fabric_width")
  fabricWeave               String?                 @map("fabric_weave")
  fabricStretch             String?                 @map("fabric_stretch")
  fabricOpacity             String?                 @map("fabric_opacity")
  fabricTexture             String?                 @map("fabric_texture")
  fabricPatternType         String?                 @map("fabric_pattern_type")
  fabricPrintType           String?                 @map("fabric_print_type")
  fabricSuitableSeason      String?                 @map("fabric_suitable_season")
  fabricRecommendedGarments String?                 @map("fabric_recommended_garments")
  fabricColor               String?                 @map("fabric_color")
  fabricSupplierId          String?                 @map("fabric_supplier_id") @db.Uuid

  // Step 2b -- AI Product Suggestions. Full result JSON replaced whole on
  // each re-run (same "header replaced on re-analysis" pattern already used
  // by Fabric Analysis's own 12 fields above) -- optional/skippable, a user
  // can always fall back to picking Target Customer/Age Group/Product
  // Category/Environment manually below without ever running this.
  productSuggestionsJson Json? @map("product_suggestions_json")

  // Step 3-6 -- customer/product/design
  targetCustomer       AiDesignerTargetCustomer? @map("target_customer")
  ageGroup             String?                   @map("age_group")
  productCategory      String?                   @map("product_category")
  designSelectionsJson Json?                     @map("design_selections_json")

  // Step 7 -- model (hidden from the wizard for now, per explicit user
  // request -- columns kept, unused, reversible later. generateDesign()'s
  // own prompt-building already tolerates all-null model fields.)
  modelGender   String? @map("model_gender")
  modelBodyType String? @map("model_body_type")
  modelPose     String? @map("model_pose")

  // Step 8 -- environment
  environmentKey      String? @map("environment_key")
  environmentLabel    String? @map("environment_label")
  isCustomEnvironment Boolean @default(false) @map("is_custom_environment")

  // Step 9b -- Multi-Fabric (optional, only usable once a design already
  // exists -- applies a second fabric photo onto specific area(s) of the
  // currently generated garment image, e.g. yoke/sleeves/borders/contrast
  // panels). secondFabricApplyAreas is a plain String[] validated in Zod
  // against a small fixed const list (SECOND_FABRIC_APPLY_AREAS), not a DB
  // enum -- this is a UI-facing tag list, not a value anything else in the
  // schema needs to reference or constrain at the database level.
  secondFabricImageAttachmentId String?  @map("second_fabric_image_attachment_id")
  secondFabricApplyAreas        String[] @map("second_fabric_apply_areas")

  // Step 9c -- Embellishments (optional, only usable once a design already
  // exists -- applies a digital applique/embroidery motif onto the currently
  // generated garment image via a free-text description and/or an uploaded
  // motif reference photo). Mirrors secondFabricImageAttachmentId's exact
  // shape (persisted, replaceable, deletable). `embellishmentType` and the
  // free-text instructions are deliberately NOT persisted project columns --
  // same precedent as secondFabricApplyAreas above being schema-only UI tag
  // data, not something anything else needs to reference/constrain -- they
  // travel as plain per-request API input instead, recorded only in the
  // generation's audit log / version designSnapshotJson.
  embellishmentMotifAttachmentId String? @map("embellishment_motif_attachment_id")

  // Step 12b -- Branding (optional). brandName is never defaulted into this
  // column -- it stays null unless the user actually typed something, and
  // the real default (the logged-in company's own name) is resolved at
  // read/render time instead, so a later company-name change is picked up
  // automatically. brandLogoAttachmentId has no default at all -- no
  // company-logo field exists anywhere in this schema, so a logo is purely
  // opt-in per project. logoXPercent/logoYPercent/logoWidthPercent are plain
  // percentages (0-100) of the design image's own width/height -- not the
  // Tech Pack PDF's letterboxed-callout-box percentages, a different
  // problem with a different coordinate space. brandedImageAttachmentId is
  // the real sharp-composited output, regenerated in place (not versioned --
  // this is a deterministic image composite, not an audited AI process).
  brandName                String?  @map("brand_name")
  brandLogoAttachmentId    String?  @map("brand_logo_attachment_id")
  logoXPercent             Decimal? @map("logo_x_percent") @db.Decimal(5, 2)
  logoYPercent             Decimal? @map("logo_y_percent") @db.Decimal(5, 2)
  logoWidthPercent         Decimal? @map("logo_width_percent") @db.Decimal(5, 2)
  brandedImageAttachmentId String?  @map("branded_image_attachment_id")

  // 4-step "New Design" flow (2026-09-27) -- see AiDesignerDesignSource.
  // garmentTemplateKey is a slug into garment-template-catalog.ts (a fixed
  // model photo per garment type under public/ai-designer-templates/);
  // customTemplateAttachmentId is the user's own uploaded template, which
  // wins over the catalog photo when set.
  designSource               AiDesignerDesignSource?  @map("design_source")
  newDesignStep              AiDesignerNewDesignStep? @map("new_design_step")
  sourceImageAttachmentId    String?                  @map("source_image_attachment_id")
  sourceAnalysisJson         Json?                    @map("source_analysis_json")
  garmentSuggestionsJson     Json?                    @map("garment_suggestions_json")
  garmentTemplateKey         String?                  @map("garment_template_key")
  customTemplateAttachmentId String?                  @map("custom_template_attachment_id")

  // Set once version 1 exists (nullable-then-set-later, same precedent as
  // AiGarmentProject.selectedDesignDirectionId elsewhere in this schema).
  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company        Company            @relation(fields: [companyId], references: [id])
  fabricProduct  Product?           @relation(fields: [fabricProductId], references: [id])
  fabricSupplier Supplier?          @relation(fields: [fabricSupplierId], references: [id])
  currentVersion AiDesignerVersion? @relation("AiDesignerProjectCurrentVersion", fields: [currentVersionId], references: [id])
  createdBy      User               @relation("AiDesignerProjectCreatedBy", fields: [createdByUserId], references: [id])

  prompts        AiDesignerPrompt[]
  generations    AiDesignerGeneration[]
  images         AiDesignerImage[]
  versions       AiDesignerVersion[]       @relation("AiDesignerVersionsOfProject")
  providerUsage  AIProviderUsage[]
  techPacks      AiDesignerTechPack[]
  sketchAnalysis AiDesignerSketchAnalysis?
  pieces         AiDesignerProjectPiece[]

  @@unique([companyId, projectNumber])
  @@map("ai_projects")
}

/**
 * One row per garment piece of a SET-mode project (e.g. Kurta, Pant,
 * Dupatta) — see AiDesignerProjectMode above. Deliberately simpler than the
 * project's own Product Category/Product Design steps: a piece gets a label,
 * an optional category (reusing the same PRODUCT_CATEGORIES_BY_CUSTOMER
 * catalog), and a single free-text design-notes field, rather than the full
 * per-attribute clipart/catalog picker duplicated per piece — matches this
 * module's own existing simplification (Product Design's attribute picker is
 * already hidden from the main single-garment wizard too). Full-replace-on-
 * save (replaceProjectPieces in the service) — the same "empty array is a
 * real state" contract already established by RoleProductionStageAccess/
 * SupplierMaterialCategory elsewhere in this schema.
 */
model AiDesignerProjectPiece {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  pieceIndex      Int      @map("piece_index")
  pieceLabel      String   @map("piece_label")
  productCategory String?  @map("product_category")
  designNotes     String?  @map("design_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project AiDesignerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, pieceIndex])
  @@map("ai_project_pieces")
}

// ---------------------------------------------------------------------------
// SKETCH mode -- structural design analysis of the uploaded sketch, mirroring
// ReplicateDesignDnaAnalysis/Observation/AnalysisRun's exact shape (a proven,
// tested pattern in this same schema) rather than inventing a new one.
// aiObservation is the immutable AI-original value; approvedObservation
// (defaults = aiObservation) is the ONLY field generation ever reads; isLocked
// independently controls whether a later Generate call treats it as a hard
// constraint -- toggling it has no re-approval side effect, unlike editing
// approvedObservation itself, which pushes an APPROVED analysis back to
// UNDER_REVIEW.
// ---------------------------------------------------------------------------

enum AiDesignerSketchConfidence {
  CONFIRMED_VISUALLY
  LIKELY_INFERRED
  NOT_DETERMINABLE
}

enum AiDesignerSketchAnalysisStatus {
  DRAFT
  AI_ANALYSED
  UNDER_REVIEW
  APPROVED
  STALE
}

model AiDesignerSketchAnalysis {
  id                    String                         @id @default(uuid()) @db.Uuid
  companyId             String                         @map("company_id") @db.Uuid
  projectId             String                         @unique @map("project_id") @db.Uuid
  sketchAttachmentId    String                         @map("sketch_attachment_id")
  status                AiDesignerSketchAnalysisStatus @default(DRAFT)
  promptVersion         String                         @map("prompt_version")
  provider              String?
  model                 String?
  rawResponseJson       Json?                          @map("raw_response_json")
  sketchAnalysisSummary String?                        @map("sketch_analysis_summary")
  approvedByUserId      String?                        @map("approved_by_user_id") @db.Uuid
  approvedAt            DateTime?                      @map("approved_at")
  createdByUserId       String                         @map("created_by_user_id") @db.Uuid
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")

  project    AiDesignerProject @relation(fields: [projectId], references: [id])
  approvedBy User?             @relation("AiDesignerSketchAnalysisApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy  User              @relation("AiDesignerSketchAnalysisCreatedBy", fields: [createdByUserId], references: [id])

  observations AiDesignerSketchObservation[]
  runs         AiDesignerSketchAnalysisRun[]

  @@map("ai_designer_sketch_analyses")
}

model AiDesignerSketchObservation {
  id                  String                     @id @default(uuid()) @db.Uuid
  analysisId          String                     @map("analysis_id") @db.Uuid
  featureKey          String                     @map("feature_key")
  aiObservation       String                     @map("ai_observation")
  aiConfidence        AiDesignerSketchConfidence @map("ai_confidence")
  approvedObservation String                     @map("approved_observation")
  userEdited          Boolean                    @default(false) @map("user_edited")
  isLocked            Boolean                    @default(true) @map("is_locked")
  approvedByUserId    String?                    @map("approved_by_user_id") @db.Uuid
  approvedAt          DateTime?                  @map("approved_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  analysis   AiDesignerSketchAnalysis @relation(fields: [analysisId], references: [id])
  approvedBy User?                    @relation("AiDesignerSketchObservationApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([analysisId, featureKey])
  @@map("ai_designer_sketch_observations")
}

// Append-only audit log of every analysis attempt, success or failure -- a
// stuck IN_PROGRESS row older than the freshness window is treated as
// abandoned, not a permanent lock (same discipline as every other AI
// Designer/AI Garment Flow run-log table; reuses the existing
// AiDesignerRunStatus enum rather than minting a 4th identical one).
model AiDesignerSketchAnalysisRun {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  projectId          String              @map("project_id") @db.Uuid
  analysisId         String?             @map("analysis_id") @db.Uuid
  sketchAttachmentId String              @map("sketch_attachment_id")
  provider           String
  model              String
  promptVersion      String              @map("prompt_version")
  status             AiDesignerRunStatus @default(IN_PROGRESS)
  errorCategory      String?             @map("error_category")
  errorMessage       String?             @map("error_message")
  requestedAt        DateTime            @default(now()) @map("requested_at")
  completedAt        DateTime?           @map("completed_at")
  createdByUserId    String              @map("created_by_user_id") @db.Uuid

  analysis  AiDesignerSketchAnalysis? @relation(fields: [analysisId], references: [id])
  createdBy User                      @relation("AiDesignerSketchAnalysisRunCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId, status])
  @@map("ai_designer_sketch_analysis_runs")
}

// One row per AI call attempt of ANY kind (fabric analysis, generate, edit) --
// the single unified audit/run log for the whole module. specJson is the
// {fabric,customer,product,design,model,environment} structured JSON built
// server-side from the project's own fields; promptText is what was actually
// sent to the AI. Never surfaced to the end user as something they write.
model AiDesignerPrompt {
  id            String               @id @default(uuid()) @db.Uuid
  companyId     String               @map("company_id") @db.Uuid
  projectId     String               @map("project_id") @db.Uuid
  promptType    AiDesignerPromptType @map("prompt_type")
  promptVersion String               @map("prompt_version")
  specJson      Json                 @map("spec_json")
  promptText    String               @map("prompt_text")
  provider      String
  model         String
  status        AiDesignerRunStatus  @default(IN_PROGRESS)
  errorCategory String?              @map("error_category")
  errorMessage  String?              @map("error_message")
  requestedAt   DateTime             @default(now()) @map("requested_at")
  completedAt   DateTime?            @map("completed_at")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  company    Company               @relation(fields: [companyId], references: [id])
  project    AiDesignerProject     @relation(fields: [projectId], references: [id])
  createdBy  User                  @relation("AiDesignerPromptCreatedBy", fields: [createdByUserId], references: [id])
  generation AiDesignerGeneration?
  versions   AiDesignerVersion[]

  @@map("ai_prompts")
}

// One row per image-producing AI call (initial generate, or an edit/
// regenerate -- parentImageId + editedFeature are set only for an edit).
// 1:1 with the AiDesignerPrompt that produced it.
model AiDesignerGeneration {
  id                  String              @id @default(uuid()) @db.Uuid
  companyId           String              @map("company_id") @db.Uuid
  projectId           String              @map("project_id") @db.Uuid
  promptId            String              @unique @map("prompt_id") @db.Uuid
  parentImageId       String?             @map("parent_image_id") @db.Uuid
  editedFeature       String?             @map("edited_feature")
  requestedImageCount Int                 @default(1) @map("requested_image_count")
  status              AiDesignerRunStatus @default(IN_PROGRESS)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company     Company           @relation(fields: [companyId], references: [id])
  project     AiDesignerProject @relation(fields: [projectId], references: [id])
  prompt      AiDesignerPrompt  @relation(fields: [promptId], references: [id])
  parentImage AiDesignerImage?  @relation("AiDesignerGenerationParentImage", fields: [parentImageId], references: [id])
  createdBy   User              @relation("AiDesignerGenerationCreatedBy", fields: [createdByUserId], references: [id])

  images AiDesignerImage[] @relation("AiDesignerImagesOfGeneration")

  @@map("ai_generations")
}

// One row per actual image file a generation produced (a generation can
// request 1/3/4). imageAttachmentId is a soft reference into the existing,
// generic Attachment table (RelatedModule.AI_DESIGNER_PROJECT -- never the
// sibling module's own AI_GARMENT_PROJECT value, which would wrongly couple
// the two).
model AiDesignerImage {
  id                String                  @id @default(uuid()) @db.Uuid
  companyId         String                  @map("company_id") @db.Uuid
  projectId         String                  @map("project_id") @db.Uuid
  generationId      String                  @map("generation_id") @db.Uuid
  imageAttachmentId String                  @map("image_attachment_id")
  decision          AiDesignerImageDecision @default(PENDING)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company    Company              @relation(fields: [companyId], references: [id])
  project    AiDesignerProject    @relation(fields: [projectId], references: [id])
  generation AiDesignerGeneration @relation("AiDesignerImagesOfGeneration", fields: [generationId], references: [id])
  createdBy  User                 @relation("AiDesignerImageCreatedBy", fields: [createdByUserId], references: [id])

  usedAsParentFor    AiDesignerGeneration[] @relation("AiDesignerGenerationParentImage")
  currentForVersions AiDesignerVersion[]

  @@map("ai_images")
}

// Version history for "Save Project -> Versions/History": version 1 is
// created by the first successful generate; every edit that changes the
// "current" image creates version N+1, with a plain-English changeSummary
// and a full designSnapshotJson so history stays inspectable even if the
// project's own "current" fields move on later.
model AiDesignerVersion {
  id                   String                          @id @default(uuid()) @db.Uuid
  companyId            String                          @map("company_id") @db.Uuid
  projectId            String                          @map("project_id") @db.Uuid
  versionNumber        Int                             @map("version_number")
  currentImageId       String                          @map("current_image_id") @db.Uuid
  changeSummary        String?                         @map("change_summary")
  designSnapshotJson   Json                            @map("design_snapshot_json")
  approvalStatus       AiDesignerVersionApprovalStatus @default(DRAFT) @map("approval_status")
  approvedByUserId     String?                         @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?                       @map("approved_at")
  /**
   * The exact AiDesignerPrompt (prompt text/spec/provider/model) that produced this version's image, when it came from an AI edit — null for the initial generation's own version if created some other way. Lets the Edit Design workspace's version history show "AI Prompt" per version without re-deriving it.
   */
  aiPromptId           String?                         @map("ai_prompt_id") @db.Uuid
  /**
   * Structured Technical Edit Mode fields (e.g. {"Collar Type": "Mandarin", "Finished Height": "3.5 cm"}), kept alongside the free-text changeSummary/AI prompt — the workspace's "reflected in the design specification data" requirement (Technical Edit Mode). Null for a Quick Edit or AI Prompt edit that used no structured fields.
   */
  technicalChangesJson Json?                           @map("technical_changes_json")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company      Company           @relation(fields: [companyId], references: [id])
  project      AiDesignerProject @relation("AiDesignerVersionsOfProject", fields: [projectId], references: [id])
  currentImage AiDesignerImage   @relation(fields: [currentImageId], references: [id])
  createdBy    User              @relation("AiDesignerVersionCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy   User?             @relation("AiDesignerVersionApprovedBy", fields: [approvedByUserId], references: [id])
  aiPrompt     AiDesignerPrompt? @relation(fields: [aiPromptId], references: [id])

  currentForProject AiDesignerProject? @relation("AiDesignerProjectCurrentVersion")

  @@unique([projectId, versionNumber])
  @@map("ai_versions")
}

// Tech Pack (2026-09-11) -- a new, isolated AI Designer feature: one combined
// action producing a graded measurement chart, a draft BOM, and a technical
// flat sketch from the project's current generated design. Genuinely
// isolated from AI Garment Flow's own, much richer equivalent processes
// (Technical Specification/BOM Suggestion/Technical Development) -- same
// reasoning as everywhere else in this module: this reuses only the
// shared, zero-business-logic AI provider infrastructure
// (requestStructuredTextOutput, ImageGenerationProvider.generateTechnicalFlat),
// never AI Garment Flow's own schema, prompts, or service code. Deliberately
// simpler than that module's own version: graded across a small fixed set of
// standard sizes (not the company's real Size master), and the BOM is purely
// advisory free-form JSON -- AI Designer has no Style-graduation mechanic at
// all for a real BOM to attach to. Append-only (one row per attempt, mirrors
// every other AI Designer run-log table) -- only the most recent is shown in
// the UI, older attempts stay in the database for audit.
// Rebuilt 2026-09-13 per the user's own "GARMENT TECH PACK SPEC SHEET
// GENERATOR" system prompt ("ye prompt use kro") -- replaces the original
// single-flat-sketch + separate grading/BOM design entirely. A run now
// produces one comprehensive, structured "Garment Analysis" (categories A-J)
// plus exactly 7 real generated images, one per supplier-ready tech-pack
// page -- see AiDesignerTechPackPage below. Old attempts under the previous
// shape are superseded, not migrated (this feature was only 2 days old and
// carried no real production data), matching this project's own established
// precedent for a clean schema replacement when a feature's scope is
// fundamentally rebuilt (e.g. Purchase Request -> Material Request).
/**
 * v3 (2026-09-14): the AI's own page-image generation was removed entirely --
 * pages 1/2/4 now embed the project's own real, already-generated design
 * photo (imageAttachmentId copied verbatim from the project's currentVersion,
 * never re-uploaded), never a fabricated "AI-drawn flat" -- per the user's
 * own explicit, repeated rule against using AI image generation to build the
 * document. This also added a real approve/revision discipline, mirroring
 * AiDesignerVersion's own approvalStatus/approvedByUserId/approvedAt shape
 * exactly: a tech pack starts DRAFT, and editing an already-APPROVED one
 * forks a brand-new row (parentTechPackId/revisionNumber) rather than
 * silently mutating the approved snapshot -- so a previously-approved,
 * previously-downloaded PDF's data always stays exactly reproducible.
 * `originalGarmentAnalysisJson` is a frozen copy made once at generation
 * time, backing a "Revert to AI-generated" action at the whole-document
 * level (not per-field -- doubling every one of the ~15 leaf fields into an
 * {ai, current} pair for a rarely-used capability wasn't worth it; per-field
 * audit history already exists via the write-audit-log convention on every
 * edit).
 */
enum AiDesignerTechPackApprovalStatus {
  DRAFT
  APPROVED
}

model AiDesignerTechPack {
  id                          String              @id @default(uuid()) @db.Uuid
  companyId                   String              @map("company_id") @db.Uuid
  projectId                   String              @map("project_id") @db.Uuid
  status                      AiDesignerRunStatus @default(IN_PROGRESS)
  /**
   * The full structured Garment Analysis (categories A-J) -- see GarmentAnalysis in tech-pack/schema.ts for its exact shape.
   */
  garmentAnalysisJson         Json?               @map("garment_analysis_json")
  /**
   * Frozen at generation time, never touched by edits -- see the model doc comment above.
   */
  originalGarmentAnalysisJson Json?               @map("original_garment_analysis_json")
  designerNotes               String?             @map("designer_notes")
  suggestedAdditionalViews    String?             @map("suggested_additional_views")
  errorMessage                String?             @map("error_message")

  approvalStatus   AiDesignerTechPackApprovalStatus @default(DRAFT) @map("approval_status")
  approvedByUserId String?                          @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?                        @map("approved_at")

  /**
   * A revision is just another row of this same model -- see the model doc comment above.
   */
  revisionNumber   Int     @default(1) @map("revision_number")
  parentTechPackId String? @map("parent_tech_pack_id") @db.Uuid

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company        Company                  @relation(fields: [companyId], references: [id])
  project        AiDesignerProject        @relation(fields: [projectId], references: [id])
  createdBy      User                     @relation("AiDesignerTechPackCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy     User?                    @relation("AiDesignerTechPackApprovedBy", fields: [approvedByUserId], references: [id])
  parentTechPack AiDesignerTechPack?      @relation("AiDesignerTechPackRevisions", fields: [parentTechPackId], references: [id])
  childRevisions AiDesignerTechPack[]     @relation("AiDesignerTechPackRevisions")
  pages          AiDesignerTechPackPage[]

  @@map("ai_tech_packs")
}

/**
 * One row per tech-pack page (always exactly 7 on a successful run, pages 1-7 per the user's own fixed page structure). `promptText` is nullable -- v3 removed all per-page AI image generation, so nothing populates it for new rows; historical rows keep their real string. `technicalFlatAttachmentId` is reserved for a genuinely future, separate feature (a manually-uploaded CAD/SVG technical flat) -- unpopulated by anything in this codebase today.
 */
model AiDesignerTechPackPage {
  id                        String  @id @default(uuid()) @db.Uuid
  techPackId                String  @map("tech_pack_id") @db.Uuid
  pageNumber                Int     @map("page_number")
  pageTitle                 String  @map("page_title")
  promptText                String? @map("prompt_text")
  imageAttachmentId         String? @map("image_attachment_id")
  technicalFlatAttachmentId String? @map("technical_flat_attachment_id")

  // Master-prompt Tech Pack (2026-09-28): each of the 7 pages is its own AI
  // page image, generated in the background. Null on the older table-based
  // tech packs, which never generate page images.
  imageStatus  AiDesignerRunStatus? @map("image_status")
  imageError   String?              @map("image_error")
  promptEdited Boolean              @default(false) @map("prompt_edited")

  techPack AiDesignerTechPack @relation(fields: [techPackId], references: [id], onDelete: Cascade)

  @@unique([techPackId, pageNumber])
  @@map("ai_tech_pack_pages")
}

// Product Design attribute master (2026-09-11) -- was a hardcoded, code-only
// catalog (design-attribute-catalog.ts); the user asked for it to become a
// real, editable Masters entity (Masters -> AI Design -> Product Design), the
// same way every other lookup in this ERP is company-configurable rather
// than baked into a constant.
//
// Deliberately "DB overrides the static default per category, not a merge":
// getEffectiveDesignAttributesForCategory() returns this company's own real
// rows for a category the moment ANY exist for it (ordered by sortOrder),
// and only falls back to the original static PRODUCT_DESIGN_ATTRIBUTES_BY_
// CATEGORY entry when the company has never customized that category at
// all -- the same "a missing row means the default, no backfill needed"
// precedent as SubmoduleVisibility/AiDesignerSettings elsewhere in this
// schema. This means every existing company keeps working unchanged with
// zero seeding, and an admin who edits/adds even one attribute for a
// category takes full ownership of that category's list from then on --
// simpler and more predictable than a per-attribute merge.
//
// `options` is a plain String[], not a child table -- matches the original
// DesignAttributeDef.options shape exactly (no independent option-level
// metadata like its own sortOrder/isActive was ever needed).
model AiDesignerProductDesignAttribute {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  categoryName   String   @map("category_name")
  attributeKey   String   @map("attribute_key")
  attributeLabel String   @map("attribute_label")
  options        String[]
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("AiDesignerProductDesignAttributeCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, categoryName, attributeKey])
  @@map("ai_product_design_attributes")
}

/**
 * A company-uploaded photo override for one Product Design option VALUE
 * (e.g. "Deep Back Cut-Out") -- deliberately keyed by the option's own
 * string, not by (categoryName, attributeKey): the same value string means
 * the same real garment detail regardless of which attribute it's attached
 * to, so it gets exactly one override, reused everywhere that value
 * appears -- the identical "dedupe by value only" reasoning already used by
 * the AI-generated reference-photo pipeline this augments (see
 * reference-image-prompt.ts). A missing row for a value means "no
 * override" -- DesignOptionImage then falls back to the AI-generated static
 * file, then to the clipart icon, in that order.
 */
model AiDesignerOptionReferenceImage {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  optionValue  String @map("option_value")
  attachmentId String @map("attachment_id")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("AiDesignerOptionReferenceImageCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, optionValue])
  @@map("ai_designer_option_reference_images")
}

enum AiDesignerAttributeDisplayMode {
  CLIPART
  TEXT
}

// Company-wide, Super-Admin-controlled setting: whether the Product Design
// step's attribute pickers (Neckline/Sleeve/Silhouette/...) render as clipart
// icons (the original, default behavior) or plain text buttons. A missing
// row means CLIPART -- no backfill needed. Deliberately a single flat row
// per company (not a per-submodule map like SubmoduleVisibility, since
// there is exactly one thing this toggle controls today) and deliberately
// no lock/has-data logic (unlike SubmoduleVisibility, nothing about this
// choice becomes unsafe once real project data exists).
model AiDesignerSettings {
  id                       String                         @id @default(uuid()) @db.Uuid
  companyId                String                         @unique @map("company_id") @db.Uuid
  productDesignDisplayMode AiDesignerAttributeDisplayMode @default(CLIPART) @map("product_design_display_mode")
  createdAt                DateTime                       @default(now()) @map("created_at")
  updatedAt                DateTime                       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("ai_designer_settings")
}

enum ActionDisplayMode {
  ICON
  TEXT
}

enum ActionTextStyle {
  LINK
  BUTTON
}

// Company-wide, Super-Admin-controlled setting: whether row actions across
// the app's list pages (Edit/View/BOM/Remove/...) render as icon-only
// buttons (the default) or as text labels — and if text, whether that text
// renders as a plain link or a bordered button. A missing row means
// ICON/LINK — no backfill needed. Deliberately a single flat row per
// company (not a per-page/per-action map), matching AiDesignerSettings'
// own exact reasoning: there is exactly one pair of things this toggle
// controls, applied uniformly everywhere via the shared RowAction
// component, not a per-screen override.
model ActionDisplaySettings {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @unique @map("company_id") @db.Uuid
  displayMode ActionDisplayMode @default(ICON) @map("display_mode")
  textStyle   ActionTextStyle   @default(LINK) @map("text_style")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("action_display_settings")
}

// -----------------------------------------------------------------------------
// Replicate Design (2026-09-13, Phase 1) — a NEW, separate page inside the AI
// Designer module (never inside the existing 13-step wizard above): upload a
// photo of an existing garment, AI extracts a structural "Design DNA" that
// becomes a locked baseline, then the company's own real fabric/raw materials
// (never the garment's original ones) are used to regenerate the SAME
// garment. Phase 1 covers reference upload -> DNA analysis -> Design Lock ->
// fabric/material selection -> AI compatibility check -> generate; later
// phases (selective unlock+edit, version compare, approval, rich Tech Pack,
// BOM, costing, Sample Request, Style Master, full traceability) are not
// built yet. Uses a `ReplicateDesign*` prefix throughout (no collision with
// `AiDesigner*`/`AiGarment*`), shares the existing `ai_designer` RBAC module,
// and follows this codebase's own proven conventions: the 3-table
// "header (replaced) + per-observation rows + append-only run log" shape
// already used twice for AI Garment Flow's Reference Analysis and Product
// Suitability, and the `Prompt -> Generation -> Image -> Version` chain
// already proven by AI Designer's own Generate Design step.
// -----------------------------------------------------------------------------

enum ReplicateDesignProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReplicateDesignFabricSource {
  EXISTING
  UPLOADED
}

enum ReplicateDesignDnaStatus {
  DRAFT
  AI_ANALYSED
  UNDER_REVIEW
  APPROVED
  STALE
}

enum ReplicateAnalysisConfidence {
  CONFIRMED_VISUALLY
  LIKELY_INFERRED
  NOT_DETERMINABLE
}

enum ReplicateRunStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

enum ReplicateMaterialRole {
  MAIN_FABRIC
  CONTRAST_FABRIC
  LINING
  INTERLINING
  BUTTON
  ZIPPER
  THREAD
  LABEL
  TRIM_OTHER
  OTHER
}

enum ReplicateCompatibilityRating {
  COMPATIBLE
  MINOR_CONCERN
  INCOMPATIBLE
}

enum ReplicateCompatibilitySubject {
  FABRIC
  MATERIAL_LINE
}

enum ReplicateImageDecision {
  PENDING
  SELECTED
  REJECTED
}

enum ReplicatePromptType {
  DNA_ANALYSIS
  COMPATIBILITY_CHECK
  IMAGE_GENERATE
  IMAGE_EDIT
}

/**
 * Edit Design workspace (mirrors AiDesignerVersionApprovalStatus exactly) — a version's own review/approval state, shown as the "Design Status" badge in the workspace's top toolbar. DRAFT is the initial (never-edited) generation; every version created via an edit starts AI_MODIFIED; UNDER_REVIEW/APPROVED/REJECTED are explicit human actions from the workspace's Approve/Reject controls.
 */
enum ReplicateDesignVersionApprovalStatus {
  DRAFT
  AI_MODIFIED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model ReplicateDesignProject {
  id            String                       @id @default(uuid()) @db.Uuid
  companyId     String                       @map("company_id") @db.Uuid
  projectNumber String                       @map("project_number")
  projectName   String                       @map("project_name")
  status        ReplicateDesignProjectStatus @default(DRAFT)

  // Own, wholly separate resumable-flow position — mirrors the *shape* of
  // AiDesignerProject's own currentStep/completedSteps, never shared code
  // (this is a different route/flow with its own step order).
  currentStep    String   @default("REFERENCE_UPLOAD") @map("current_step")
  completedSteps String[] @map("completed_steps")

  // Reference garment photos — single-slot columns (a cheap "is front
  // uploaded" column check); repeatable "additional" photos are plain
  // Attachment rows tagged contextLabel="REFERENCE_ADDITIONAL" instead, the
  // same header-level multi-photo precedent already used by AI Garment
  // Flow's own project-level attachments.
  referenceFrontImageAttachmentId  String? @map("reference_front_image_attachment_id")
  referenceBackImageAttachmentId   String? @map("reference_back_image_attachment_id")
  referenceSideImageAttachmentId   String? @map("reference_side_image_attachment_id")
  referenceDetailImageAttachmentId String? @map("reference_detail_image_attachment_id")

  // Fabric selection — same shape as AiDesignerProject's own fabric* columns,
  // duplicated (not cross-module-reused) per this module's own established
  // isolation rule.
  fabricSource            ReplicateDesignFabricSource? @map("fabric_source")
  fabricProductId         String?                      @map("fabric_product_id") @db.Uuid
  fabricImageAttachmentId String?                      @map("fabric_image_attachment_id")
  fabricName              String?                      @map("fabric_name")
  fabricCode              String?                      @map("fabric_code")
  fabricSupplierId        String?                      @map("fabric_supplier_id") @db.Uuid

  // Branding — optional brand name + logo overlay, the exact same shape as
  // AiDesignerProject's own equivalent columns (duplicated, not shared, per
  // this module's established isolation rule). brandName has no stored
  // default -- resolved at read time from the company's own name, same
  // reasoning as AiDesignerProject's own field. A logo has no default
  // position until first uploaded. brandedImageAttachmentId is the real
  // sharp()-composited PNG output, replaced (not versioned) on every re-apply.
  brandName                String?  @map("brand_name")
  brandLogoAttachmentId    String?  @map("brand_logo_attachment_id")
  logoXPercent             Decimal? @map("logo_x_percent") @db.Decimal(5, 2)
  logoYPercent             Decimal? @map("logo_y_percent") @db.Decimal(5, 2)
  logoWidthPercent         Decimal? @map("logo_width_percent") @db.Decimal(5, 2)
  brandedImageAttachmentId String?  @map("branded_image_attachment_id")

  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company        Company                 @relation(fields: [companyId], references: [id])
  fabricProduct  Product?                @relation(fields: [fabricProductId], references: [id])
  fabricSupplier Supplier?               @relation(fields: [fabricSupplierId], references: [id])
  currentVersion ReplicateDesignVersion? @relation("ReplicateDesignProjectCurrentVersion", fields: [currentVersionId], references: [id])
  createdBy      User                    @relation("ReplicateDesignProjectCreatedBy", fields: [createdByUserId], references: [id])

  dnaAnalysis        ReplicateDesignDnaAnalysis?
  dnaAnalysisRuns    ReplicateDesignDnaAnalysisRun[]
  materialLines      ReplicateDesignMaterialLine[]
  compatibilityCheck ReplicateDesignCompatibilityCheck?
  compatibilityRuns  ReplicateDesignCompatibilityRun[]
  prompts            ReplicateDesignPrompt[]
  generations        ReplicateDesignGeneration[]
  images             ReplicateDesignImage[]
  versions           ReplicateDesignVersion[]           @relation("ReplicateDesignVersionsOfProject")
  techPacks          ReplicateDesignTechPack[]
  providerUsage      AIProviderUsage[]

  @@unique([companyId, projectNumber])
  @@map("replicate_design_projects")
}

// 1:1 per project, fully replaced on re-analysis — the current, mutable
// "result"; a failed attempt is logged separately (see the Run table below)
// and never overwrites a previously-successful analysis.
model ReplicateDesignDnaAnalysis {
  id                    String                   @id @default(uuid()) @db.Uuid
  companyId             String                   @map("company_id") @db.Uuid
  projectId             String                   @unique @map("project_id") @db.Uuid
  // Soft reference to whichever front photo this actually ran against — kept
  // even if the project's own current reference image is later replaced, so
  // a STALE analysis still records what it was analysing.
  referenceAttachmentId String                   @map("reference_attachment_id")
  status                ReplicateDesignDnaStatus @default(DRAFT)
  promptVersion         String                   @map("prompt_version")
  provider              String
  model                 String
  rawResponseJson       Json                     @map("raw_response_json")
  designDnaSummary      String?                  @map("design_dna_summary")
  approvedByUserId      String?                  @map("approved_by_user_id") @db.Uuid
  approvedAt            DateTime?                @map("approved_at")
  createdByUserId       String                   @map("created_by_user_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  company    Company                @relation(fields: [companyId], references: [id])
  project    ReplicateDesignProject @relation(fields: [projectId], references: [id])
  approvedBy User?                  @relation("ReplicateDesignDnaAnalysisApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy  User                   @relation("ReplicateDesignDnaAnalysisCreatedBy", fields: [createdByUserId], references: [id])

  observations ReplicateDesignDnaObservation[]
  runs         ReplicateDesignDnaAnalysisRun[]

  @@map("replicate_design_dna_analyses")
}

// One row per structural feature (garmentCategory, silhouette, garmentLength,
// fit, neckline, collar, sleeveType, sleeveLength, shoulderConstruction,
// closureType, panelsAndSeams, waistTreatment, hemFinish,
// keyConstructionDetails). isLocked is the Design Lock — default ON per
// attribute; the generation prompt-builder only ever reads a locked row's
// approvedObservation as a hard structural constraint.
model ReplicateDesignDnaObservation {
  id                  String                      @id @default(uuid()) @db.Uuid
  analysisId          String                      @map("analysis_id") @db.Uuid
  featureKey          String                      @map("feature_key")
  aiObservation       String                      @map("ai_observation")
  aiConfidence        ReplicateAnalysisConfidence @map("ai_confidence")
  // Defaults to aiObservation at creation; the ONLY field image generation
  // ever reads — a later process can never bypass the human-approved value.
  approvedObservation String                      @map("approved_observation")
  userEdited          Boolean                     @default(false) @map("user_edited")
  isLocked            Boolean                     @default(true) @map("is_locked")
  approvedByUserId    String?                     @map("approved_by_user_id") @db.Uuid
  approvedAt          DateTime?                   @map("approved_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  analysis   ReplicateDesignDnaAnalysis @relation(fields: [analysisId], references: [id])
  approvedBy User?                      @relation("ReplicateDesignDnaObservationApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([analysisId, featureKey])
  @@map("replicate_design_dna_observations")
}

// Append-only audit log of every DNA analysis attempt, success or failure —
// a failed attempt can never overwrite a previously-successful analysis.
model ReplicateDesignDnaAnalysisRun {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  projectId             String             @map("project_id") @db.Uuid
  analysisId            String?            @map("analysis_id") @db.Uuid
  referenceAttachmentId String             @map("reference_attachment_id")
  provider              String
  model                 String
  promptVersion         String             @map("prompt_version")
  status                ReplicateRunStatus @default(IN_PROGRESS)

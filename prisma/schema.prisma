// The dyeing process/chemistry (Indigo/Reactive/Pigment/Vat/Disperse) —
// deliberately a separate master from FabricDye, which is a specific
// shade/Pantone reference (e.g. "Dark Navy / Indigo Blue"). One dye type
// covers many shades; conflating them into one table would make it
// impossible to represent that fan-out.
model FabricDyeType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  fabricDyes FabricDye[]

  @@unique([companyId, code])
  @@map("fabric_dye_types")
}

model FabricWeaveType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                Company                 @relation(fields: [companyId], references: [id])
  fabricRolls            FabricRoll[]
  aiGarmentFabricDetails AiGarmentFabricDetail[]

  @@unique([companyId, code])
  @@map("fabric_weave_types")
}

model FabricWidth {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  unitId    String?  @map("unit_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                Company                 @relation(fields: [companyId], references: [id])
  unit                   UnitOfMeasure?          @relation(fields: [unitId], references: [id])
  fabricRolls            FabricRoll[]
  aiGarmentFabricDetails AiGarmentFabricDetail[]

  @@unique([companyId, code])
  @@map("fabric_widths")
}

model FabricComposition {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                Company                 @relation(fields: [companyId], references: [id])
  fabricRolls            FabricRoll[]
  aiGarmentFabricDetails AiGarmentFabricDetail[]

  @@unique([companyId, code])
  @@map("fabric_compositions")
}

model Machine {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  productionLineId String?  @map("production_line_id") @db.Uuid
  code             String
  name             String
  machineType      String?  @map("machine_type")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  productionLine ProductionLine? @relation(fields: [productionLineId], references: [id])

  @@unique([companyId, code])
  @@map("machines")
}

// ─────────────────────────────────────────────────────────────
// Masters — HR Configuration
// (imported from HRMS domain gap — HRMS itself only has free-text designation)
// ─────────────────────────────────────────────────────────────

model Designation {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  // Nullable — a designation can belong to one department (e.g. "Cutting
  // Master" under Cutting) or none at all (e.g. "General Manager", usable
  // across every department). Filtering by department is a UI convenience,
  // not a hard requirement, so this stays optional rather than forcing
  // every designation into exactly one department.
  departmentId String?  @map("department_id") @db.Uuid
  code         String
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([companyId, code])
  @@map("designations")
}

model EmployeeCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  employees      Employee[]
  pieceRateCards PieceRateCard[]

  @@unique([companyId, code])
  @@map("employee_categories")
}

model ShiftMaster {

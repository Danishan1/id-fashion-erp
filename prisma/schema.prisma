  internalTransfersTo   InternalTransfer[] @relation("InternalTransferToBank")

  @@unique([companyId, code])
  @@map("bank_accounts")
}

// ─────────────────────────────────────────────────────────────
// Sampling (Phase 4)
// sample_requests is an immutable header (customer/style identity never
// changes); every revision is a new, append-only sample_versions row —
// versions are never edited or overwritten, only superseded. Materials,
// approvals, and comments hang off a specific version so history stays
// intact across revisions. See CLAUDE.md's Sampling workflow section.
// ─────────────────────────────────────────────────────────────

enum SampleStatus {
  DRAFT
  REQUESTED
  TECH_PACK_READY
  IN_DEVELOPMENT
  INTERNAL_QC
  SUBMITTED_TO_CUSTOMER
  CUSTOMER_FEEDBACK_RECEIVED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  ON_HOLD
  CANCELLED
}

enum SampleVersionStatus {
  DRAFT
  IN_DEVELOPMENT
  INTERNAL_QC
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum SampleDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

// Standard garment-export sample classifications. Hardcoded (not a configurable
// master) — this taxonomy rarely changes across the industry, matching the same
// "small closed enum, not a lookup table" choice already made for
// BuyerEnquiryLineStatus/SalesOrderStatus. A PP (Pre-Production) sample's
// approval is the natural future gate for Production-order eligibility once
// Phase 5C exists — the concrete reason this exists now, not just labeling.
enum SampleType {
  FIT
  PROTO
  PP
  TOP
  SHIPMENT
  PHOTOSHOOT
  SMS
  OTHER
}

model SampleRequest {
  id                    String        @id @default(uuid()) @db.Uuid
  companyId             String        @map("company_id") @db.Uuid
  branchId              String?       @map("branch_id") @db.Uuid
  requestNumber         String        @map("request_number")
  customerId            String        @map("customer_id") @db.Uuid
  buyerId               String?       @map("buyer_id") @db.Uuid
  productId             String?       @map("product_id") @db.Uuid
  // Nullable at the DB level (existing rows predate this field) but required by
  // the create-form's Zod schema — the display name for the sample even before
  // it has (or ever gets) a linked Product/Style. Prefilled onto the "Convert to
  // Style" form when the sample later graduates into a real Style master.
  styleName             String?       @map("style_name")
  // Nullable at the DB level (existing rows predate this field) but required by
  // the create-form's Zod schema, same precedent as styleName above. Immutable
  // after creation (no edit endpoint) — identity-like, same footing as
  // customer/style; silently relabeling a PP sample after the fact would
  // undermine its future role as a Production-order eligibility gate.
  sampleType            SampleType?
  // Was a free-text string until 2026-09-15 (a casual descriptive value, not
  // a Color master pick, per the original design note) — converted to a real
  // FK per explicit user request so the same color can drive the Sales
  // Order variant grid default once the sample is approved. Editable at any
  // stage, same reasoning as before (a customer may confirm/change the color
  // only after seeing the physical sample) — null means "not yet decided."
  colorId               String?       @map("color_id") @db.Uuid
  // New 2026-09-15 — SampleRequest never had any size concept before this;
  // paired with colorId to describe "the color+size this sample was made
  // in," which Sales Order's own variant grid defaults to once the sample
  // is linked. Also nullable/editable at any stage, same reasoning as color.
  sizeId                String?       @map("size_id") @db.Uuid
  // Soft reference to Attachment.id — no hard FK, same convention as
  // Product.mainImageAttachmentId/AiGarmentProject.referenceImageAttachmentId
  // — points at whichever uploaded gallery image (relatedModule
  // SAMPLE_REQUEST) is the designated cover/main image.
  mainImageAttachmentId String?       @map("main_image_attachment_id") @db.Uuid
  // Set once, at creation, by duplicateSampleRequest() ("Copy Design") —
  // pure traceability, never a live/synced link: the new request's header,
  // tech pack notes, and materials are copied once and then diverge freely
  // (images/pricing/damage/approvals/comments are deliberately NOT copied —
  // see that function's own comment). Null for every ordinarily-created
  // request.
  copiedFromRequestId   String?       @map("copied_from_request_id") @db.Uuid
  requestedByUserId     String        @map("requested_by_user_id") @db.Uuid
  requestDate           DateTime      @map("request_date") @db.Date
  targetSubmissionDate  DateTime?     @map("target_submission_date") @db.Date
  status                SampleStatus  @default(DRAFT)
  statusBeforeHold      SampleStatus? @map("status_before_hold")
  currentVersionNumber  Int           @default(0) @map("current_version_number")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  buyer            Buyer?            @relation(fields: [buyerId], references: [id])
  product          Product?          @relation("SampleRequestStyle", fields: [productId], references: [id])
  color            Color?            @relation(fields: [colorId], references: [id])
  size             Size?             @relation(fields: [sizeId], references: [id])
  requestedBy      User              @relation("SampleRequestedBy", fields: [requestedByUserId], references: [id])
  copiedFrom       SampleRequest?    @relation("SampleRequestCopiedFrom", fields: [copiedFromRequestId], references: [id])
  copiedInto       SampleRequest[]   @relation("SampleRequestCopiedFrom")
  versions         SampleVersion[]
  comments         SampleComment[]
  salesOrderItems  SalesOrderItem[]
  // Virtual back-relation only — no physical column on this table. The
  // single authoritative FK lives on BuyerEnquiryLine.sampleRequestId (see
  // that model); this is purely how a Sample's detail page can show "this
  // originated from Enquiry ENQ-..." without a second, redundant FK here.
  buyerEnquiryLine BuyerEnquiryLine?
  // Same virtual-back-relation shape, for AiGarmentProject.sampleRequestId
  // (@unique), set once by createSampleRequestFromProject().
  aiGarmentProject AiGarmentProject?

  stageCosts DesignStageCost[]

  @@unique([companyId, requestNumber])
  @@map("sample_requests")
}

model SampleVersion {
  id                    String              @id @default(uuid()) @db.Uuid
  sampleRequestId       String              @map("sample_request_id") @db.Uuid
  versionNumber         Int                 @map("version_number")
  status                SampleVersionStatus @default(DRAFT)
  techPackNotes         String?             @map("tech_pack_notes")
  // Manual while no priced SampleMaterial/SampleOtherCharge exists for this
  // version (zero behavior change from before costing existed). Once the
  // version has real costing data, every recalculation overwrites this to
  // equal finalTotal and the UI stops accepting manual edits for it — see
  // recalculateSampleVersionCosting() in sample.service.ts.
  estimatedCostPerUnit  Decimal?            @map("estimated_cost_per_unit") @db.Decimal(18, 2)
  submittedToCustomerAt DateTime?           @map("submitted_to_customer_at")
  customerDecisionAt    DateTime?           @map("customer_decision_at")
  createdByUserId       String              @map("created_by_user_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at")

  // Costing rollup — hardcoded formula (materialCost + otherCharges ->
  // subtotal -> +margin% -> +commission% -> +freight -> finalTotal), base
  // currency only. costSubtotal/finalTotal are system-computed and stored
  // (same precedent as SalesOrder.totalAmount), never accepted from a client.
  marginPercent         Decimal?  @map("margin_percent") @db.Decimal(5, 2)
  commissionPercent     Decimal?  @map("commission_percent") @db.Decimal(5, 2)
  freightAmount         Decimal?  @map("freight_amount") @db.Decimal(18, 2)
  costSubtotal          Decimal?  @map("cost_subtotal") @db.Decimal(18, 2)
  finalTotal            Decimal?  @map("final_total") @db.Decimal(18, 2)
  // Reversible lock (the first one in this app) — deliberately carries its
  // own actor/timestamp columns rather than being a bare boolean, matching
  // the existing submittedToCustomerAt/customerDecisionAt precedent on this
  // same model, since a lock->unlock->lock cycle would otherwise lose the
  // who/when story. Gated on the "approve" RBAC action, not "edit" — see
  // lockSampleCosting()/unlockSampleCosting() in sample.service.ts.
  isCostingLocked       Boolean   @default(false) @map("is_costing_locked")
  costingLockedAt       DateTime? @map("costing_locked_at")
  costingLockedByUserId String?   @map("costing_locked_by_user_id") @db.Uuid

  sampleRequest    SampleRequest       @relation(fields: [sampleRequestId], references: [id])
  createdBy        User                @relation("SampleVersionCreatedBy", fields: [createdByUserId], references: [id])
  costingLockedBy  User?               @relation("SampleVersionCostingLockedBy", fields: [costingLockedByUserId], references: [id])
  materials        SampleMaterial[]
  approvals        SampleApproval[]
  comments         SampleComment[]
  otherCharges     SampleOtherCharge[]
  // Virtual back-relation only — no column on this table. A version can have
  // more than one over time (a soft duplicate-warning, not a hard cap — see
  // findMaterialRequestsBySampleVersion in material-request.service.ts).
  materialRequests MaterialRequest[]
  salesOrderLines  SalesOrderLine[]

  @@unique([sampleRequestId, versionNumber])
  @@map("sample_versions")
}

model SampleMaterial {
  id              String   @id @default(uuid()) @db.Uuid
  sampleVersionId String   @map("sample_version_id") @db.Uuid
  materialId      String   @map("material_id") @db.Uuid
  plannedQuantity Decimal  @map("planned_quantity") @db.Decimal(18, 4)
  uomId           String?  @map("uom_id") @db.Uuid
  // Which Colors-master color this material line is for — a raw material
  // like fabric or thread is frequently needed in more than one color on the
  // same sample; distinct colors are distinct lines (see the material merge
  // key in sample.service.ts), not different quantities of one line.
  colorId         String?  @map("color_id") @db.Uuid
  // Optional precise shade/Pantone reference, distinct from the generic
  // Color-master name above — a colorId of "Navy Blue" can span many
  // physical shades; dyeId pins down the exact one when it matters. Added
  // to MATERIAL_MERGE_KEY_FIELDS in sample.service.ts, same as colorId was.
  dyeId           String?  @map("dye_id") @db.Uuid
  notes           String?
  // Recorded after the fact, once known — how much of this planned material
  // was actually damaged/wasted during sampling, and why. Both nullable and
  // independently editable from the line's planned quantity (see the scoped
  // damage-recording endpoint), since damage is discovered later, not at
  // material-planning time.
  damagedQuantity Decimal? @map("damaged_quantity") @db.Decimal(18, 4)
  damageReason    String?  @map("damage_reason")
  // Costing — both nullable, set/cleared only via the scoped
  // PATCH /api/v1/sampling/materials/:materialId/costing endpoint, never
  // through the create/merge path (addSampleMaterial). Deliberately NOT part
  // of MATERIAL_MERGE_KEY_FIELDS in sample.service.ts — rate is a cost
  // attribute, not an identity attribute that should split/merge lines. A row
  // with rate = null contributes 0 to costing, never treated as "priced at
  // zero" (see recalculateSampleVersionCosting()).
  rate            Decimal? @db.Decimal(18, 4)
  gstPercentage   Decimal? @map("gst_percentage") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  sampleVersion SampleVersion  @relation(fields: [sampleVersionId], references: [id])
  material      Product        @relation("SampleMaterialProduct", fields: [materialId], references: [id])
  uom           UnitOfMeasure? @relation(fields: [uomId], references: [id])
  color         Color?         @relation(fields: [colorId], references: [id])
  dye           FabricDye?     @relation(fields: [dyeId], references: [id])

  @@map("sample_materials")
}

enum SampleOtherChargeCostHead {
  PROCESS
  FABRICATION
  OTHER
}

// Non-material costing lines (labor/process/overhead) that don't fit
// SampleMaterial's shape (no materialId, no consumption quantity) — a flat
// lump-sum amount per charge, deliberately simpler than SampleMaterial.
// Plain CRUD, no merge-key logic: a duplicate charge is just user error the
// merchandiser edits/deletes directly, unlike a raw-material line which
// legitimately needs to distinguish/merge by attribute.
model SampleOtherCharge {
  id              String                    @id @default(uuid()) @db.Uuid
  sampleVersionId String                    @map("sample_version_id") @db.Uuid
  costHead        SampleOtherChargeCostHead @map("cost_head")
  description     String
  amount          Decimal                   @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  sampleVersion SampleVersion @relation(fields: [sampleVersionId], references: [id])

  @@map("sample_other_charges")
}

model SampleApproval {
  id                   String         @id @default(uuid()) @db.Uuid
  sampleVersionId      String         @map("sample_version_id") @db.Uuid
  decision             SampleDecision
  decidedByUserId      String         @map("decided_by_user_id") @db.Uuid
  customerContactName  String?        @map("customer_contact_name")
  // Free text, not FK'd to Buyer.phone — the request's own linked Buyer is
  // only a default (see the create form), since the person who actually
  // called back with the decision may differ from the Buyer master's own
  // saved contact, same reasoning as customerContactName above.
  customerContactPhone String?        @map("customer_contact_phone")
  decisionNotes        String?        @map("decision_notes")
  decidedAt            DateTime       @default(now()) @map("decided_at")

  sampleVersion SampleVersion @relation(fields: [sampleVersionId], references: [id])
  decidedBy     User          @relation("SampleApprovalDecidedBy", fields: [decidedByUserId], references: [id])

  @@map("sample_approvals")
}

model SampleComment {
  id              String   @id @default(uuid()) @db.Uuid
  sampleRequestId String   @map("sample_request_id") @db.Uuid
  sampleVersionId String?  @map("sample_version_id") @db.Uuid
  authorUserId    String   @map("author_user_id") @db.Uuid
  body            String
  createdAt       DateTime @default(now()) @map("created_at")

  sampleRequest SampleRequest  @relation(fields: [sampleRequestId], references: [id])
  sampleVersion SampleVersion? @relation(fields: [sampleVersionId], references: [id])
  author        User           @relation("SampleCommentAuthor", fields: [authorUserId], references: [id])

  @@map("sample_comments")
}

// ─────────────────────────────────────────────────────────────
// Buyer Enquiry (Phase 4 extension, 2026-08-21) — an OPTIONAL intake layer
// in front of Sampling, not a parent of it. The only link to Sampling is one
// nullable, unique FK on BuyerEnquiryLine pointing forward into
// SampleRequest (mirrors SalesOrderItem.sampleRequestId's own shape) — never
// a required relation, never a shared state machine. Direct SampleRequest
// creation and direct SalesOrder creation are both completely unaffected; a
// merchandiser who never opens this module never has to know it exists.
// ─────────────────────────────────────────────────────────────

enum EnquirySource {
  EMAIL
  PHONE
  TRADE_SHOW
  REFERRAL
  WEBSITE
  OTHER
}

// Always derived from line statuses (recomputeBuyerEnquiryStatus() in
// buyer-enquiry.service.ts) — never set directly by a generic status PATCH,
// the same discipline that closed the GoodsReceipt-status-label and Sample
// Hold/Resume bugs elsewhere in this project. CANCELLED is the one manual
// exception (cancelBuyerEnquiry()), and once set nothing recomputes over it.
enum BuyerEnquiryStatus {
  OPEN
  PARTIALLY_CONVERTED
  CLOSED
  CANCELLED
}

enum BuyerEnquiryLineStatus {
  PENDING_REVIEW
  APPROVED_FOR_SAMPLING
  ON_HOLD
  REJECTED
  // Reachable ONLY through convertEnquiryLineToSampleRequest() — deliberately
  // excluded from the generic line-status-change endpoint's Zod schema, the
  // same discipline already used for SampleStatus.TECH_PACK_READY /
  // REVISION_REQUESTED so a line can't be forged into "converted" without a
  // real SampleRequest actually being created.
  CONVERTED
}

model BuyerEnquiry {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  branchId              String?            @map("branch_id") @db.Uuid
  enquiryNumber         String             @map("enquiry_number")
  // Both nullable — an enquiry may be logged against an existing Customer
  // (and optionally one of its Buyers), OR against a not-yet-onboarded
  // prospect using the fields below. Never both null and never auto-created:
  // conversion to a Sample Request hard-requires a real customerId.
  customerId            String?            @map("customer_id") @db.Uuid
  buyerId               String?            @map("buyer_id") @db.Uuid
  // Quick-capture lead fields, relevant only while customerId is null. This
  // is deliberately NOT a Prospect/Lead master table — no lifecycle, no
  // promotion workflow, no reminders. An enquiry that never converts simply
  // sits here indefinitely; formalizing a real relationship means someone
  // creates a real Customer separately in Masters, same as today.
  prospectName          String?            @map("prospect_name")
  prospectContactPerson String?            @map("prospect_contact_person")
  prospectEmail         String?            @map("prospect_email")
  prospectPhone         String?            @map("prospect_phone")
  prospectCountry       String?            @map("prospect_country")
  enquiryDate           DateTime           @map("enquiry_date") @db.Date
  source                EnquirySource      @default(OTHER)
  status                BuyerEnquiryStatus @default(OPEN)
  remarks               String?
  requestedByUserId     String             @map("requested_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company     Company            @relation(fields: [companyId], references: [id])
  branch      Branch?            @relation(fields: [branchId], references: [id])
  customer    Customer?          @relation(fields: [customerId], references: [id])
  buyer       Buyer?             @relation(fields: [buyerId], references: [id])
  requestedBy User               @relation("BuyerEnquiryRequestedBy", fields: [requestedByUserId], references: [id])
  lines       BuyerEnquiryLine[]

  @@unique([companyId, enquiryNumber])
  @@map("buyer_enquiries")
}

model BuyerEnquiryLine {
  id                 String                 @id @default(uuid()) @db.Uuid
  buyerEnquiryId     String                 @map("buyer_enquiry_id") @db.Uuid
  // An existing Style, if picked from the catalog — nullable, the same
  // "may not exist as a Style yet" precedent as SampleRequest.productId.
  productId          String?                @map("product_id") @db.Uuid
  styleNameFreeText  String?                @map("style_name_free_text")
  description        String?
  colorRemarks       String?                @map("color_remarks")
  // A real Size master FK (2026-09-24, explicit request) — deliberately NOT
  // free text like colorRemarks above, since it needs to reliably carry
  // through into the created SampleRequest's own real sizeId at conversion
  // time (see convertEnquiryLineToSampleRequest()), which a free-text value
  // could never do without a human matching it against the master by hand.
  sizeId             String?                @map("size_id") @db.Uuid
  targetQuantity     Decimal?               @map("target_quantity") @db.Decimal(18, 2)
  targetUnitPrice    Decimal?               @map("target_unit_price") @db.Decimal(18, 2)
  targetDeliveryDate DateTime?              @map("target_delivery_date") @db.Date
  remarks            String?
  lineStatus         BuyerEnquiryLineStatus @default(PENDING_REVIEW) @map("line_status")
  rejectionReason    String?                @map("rejection_reason")
  // The single authoritative FK for the whole Enquiry<->Sample relationship —
  // set exactly once, only by convertEnquiryLineToSampleRequest(), never
  // cleared. @unique enforces "a SampleRequest can originate from at most one
  // line" as a real DB constraint (via the back-relation on SampleRequest),
  // not just an application-layer promise — a concurrent double-convert
  // attempt fails on this constraint even if the service-layer check races.
  sampleRequestId    String?                @unique @map("sample_request_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  buyerEnquiry  BuyerEnquiry   @relation(fields: [buyerEnquiryId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  size          Size?          @relation(fields: [sizeId], references: [id])
  sampleRequest SampleRequest? @relation(fields: [sampleRequestId], references: [id])

  @@map("buyer_enquiry_lines")
}

// ─────────────────────────────────────────────────────────────
// Marketing — Campaigns & Ad Integrations (kept, unchanged in shape, when
// the legacy CRM was replaced by the new CRM module elsewhere in this file;
// see CLAUDE.md's CRM Replacement section for why these survived the
// crm-build-v5 branch's own blanket removal of this block).
// ─────────────────────────────────────────────────────────────

enum CampaignChannel {
  META_ADS
  GOOGLE_ADS
  LINKEDIN
  YOUTUBE
  EMAIL
  WHATSAPP
  SEO
  ORGANIC
  REFERRAL
  OFFLINE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Campaign {
  id               String                 @id @default(uuid()) @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  branchId         String?                @map("branch_id") @db.Uuid
  campaignNumber   String                 @map("campaign_number")
  name             String
  objective        String?
  channel          CampaignChannel
  startDate        DateTime?              @map("start_date") @db.Date
  endDate          DateTime?              @map("end_date") @db.Date
  budget           Decimal                @default(0) @db.Decimal(15, 2)
  ownerUserId      String?                @map("owner_user_id") @db.Uuid
  status           CampaignStatus         @default(DRAFT)
  approvalStatus   CampaignApprovalStatus @default(PENDING) @map("approval_status")
  // Approval metadata — who/when/why, mirroring the same "who/when" shape
  // already used for SampleVersion's costing lock rather than a bare
  // boolean. rejectionReason is cleared on a later approval, and vice versa
  // (approvedBy/approvedAt cleared on a later rejection) — the three fields
  // together always describe exactly one decision, never a stale mix of both.
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?              @map("approved_at")
  rejectionReason  String?                @map("rejection_reason")
  notes            String?
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  company         Company               @relation(fields: [companyId], references: [id])
  branch          Branch?               @relation(fields: [branchId], references: [id])
  owner           User?                 @relation("CampaignOwner", fields: [ownerUserId], references: [id])
  createdBy       User                  @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy      User?                 @relation("CampaignApprovedBy", fields: [approvedByUserId], references: [id])
  dailyMetrics    CampaignDailyMetric[]
  attributions    CampaignAttribution[]
  alerts          CampaignAlert[]
  // Attribution FK added back onto the new CRM's CrmLead (2026-10-09, CRM
  // Replacement) — CrmLead otherwise has no real FK into Campaign, only
  // free-text UTM fields; this mirrors the old Lead.campaignId exactly.
  crmLeads        CrmLead[]
  adCampaignLinks AdCampaignLink[]

  @@unique([companyId, campaignNumber])
  @@index([companyId, status])
  @@index([companyId, channel])
  @@map("mkt_campaigns")
}

// Manually recorded (or, later, ad-platform-synced — not built in this
// pass, see the migration report) daily spend/impressions/clicks. Campaign
// spend is always SUM(these), never a separately-editable column.
model CampaignDailyMetric {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  metricDate       DateTime @map("metric_date") @db.Date
  spend            Decimal  @default(0) @db.Decimal(15, 2)
  // Int, not BigInt — NextResponse.json() can't serialize a native BigInt
  // (hit live: this crashed with "Do not know how to serialize a BigInt" on
  // every read of a recorded metric), and no real campaign at this
  // business's scale will exceed ~2 billion impressions.
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  notes            String?
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  campaign   Campaign @relation(fields: [campaignId], references: [id])
  recordedBy User     @relation(fields: [recordedByUserId], references: [id])

  @@unique([campaignId, metricDate])
  @@map("mkt_campaign_daily_metrics")
}

enum AdPlatform {
  META
  GOOGLE
}

enum AdConnectionStatus {
  CONNECTED
  // Set only by a deliberate user action (Disconnect) — never inferred from
  // an expired token, since that's a recoverable ERROR state, not a decision
  // to stop syncing.
  DISCONNECTED
  // A sync attempt failed (expired/revoked token, API error) — surfaced with
  // lastSyncError so the connection page can point at "reconnect" rather
  // than silently retrying forever with no explanation.
  ERROR
}

// One row per connected external ad account (a company can connect more than
// one Meta ad account or Google Ads customer ID). Tokens are encrypted at
// rest (src/core/security/encryption.ts) — these are live credentials with
// real ad-spend-account access, not app-internal data, so plaintext storage
// would be a real, easily avoidable vulnerability.
model AdAccountConnection {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  platform              AdPlatform
  externalAccountId     String             @map("external_account_id")
  accountName           String             @map("account_name")
  accessTokenEncrypted  String             @map("access_token_encrypted")
  refreshTokenEncrypted String?            @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?          @map("token_expires_at")
  status                AdConnectionStatus @default(CONNECTED)
  lastSyncedAt          DateTime?          @map("last_synced_at")
  lastSyncError         String?            @map("last_sync_error")
  connectedByUserId     String             @map("connected_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company       Company          @relation(fields: [companyId], references: [id])
  connectedBy   User             @relation(fields: [connectedByUserId], references: [id])
  campaignLinks AdCampaignLink[]

  @@unique([companyId, platform, externalAccountId])
  @@index([companyId, platform])
  @@map("ad_account_connections")
}

// Maps one external ad-platform campaign to (at most) one local Campaign
// record. Deliberately a separate mapping table, not a field on Campaign
// itself — one local Campaign has no reason to know about ad-platform
// wiring, and a connection can see many external campaigns the user hasn't
// (or won't) map to anything local yet; those stay listed with
// localCampaignId = null rather than auto-creating a local Campaign per
// external one (would flood the Campaigns list with entries nobody asked
// for and bypass this project's own approval-workflow gate on new
// campaigns).
model AdCampaignLink {
  id                   String   @id @default(uuid()) @db.Uuid
  connectionId         String   @map("connection_id") @db.Uuid
  externalCampaignId   String   @map("external_campaign_id")
  externalCampaignName String   @map("external_campaign_name")
  localCampaignId      String?  @map("local_campaign_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  connection    AdAccountConnection @relation(fields: [connectionId], references: [id])
  localCampaign Campaign?           @relation(fields: [localCampaignId], references: [id])

  @@unique([connectionId, externalCampaignId])
  @@index([localCampaignId])
  @@map("ad_campaign_links")
}

// Multi-touch attribution record — a distinct concept from Lead itself
// (one Lead can have several touches on the way in), unlike the source's
// eq_mkt_lead_map which conflated "attribution" with "current lead state."
model CampaignAttribution {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  campaignId        String?  @map("campaign_id") @db.Uuid
  leadId            String?  @map("lead_id") @db.Uuid
  // Free-text fallback for a touch that never became a real Lead record —
  // mirrors the source's own customer_name column on this same table.
  prospectName      String?  @map("prospect_name")
  source            String?
  medium            String?
  content           String?
  term              String?
  utmCampaign       String?  @map("utm_campaign")
  landingPage       String?  @map("landing_page")
  isFirstTouch      Boolean  @default(false) @map("is_first_touch")
  isLastTouch       Boolean  @default(false) @map("is_last_touch")
  attributedRevenue Decimal  @default(0) @map("attributed_revenue") @db.Decimal(15, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  crmLead  CrmLead?  @relation(fields: [leadId], references: [id])

  @@index([companyId, campaignId])
  @@index([companyId, leadId])
  @@map("mkt_campaign_attributions")
}

// The 4 threshold rules ported exactly from the source's eq_mkt_run_automation()
// (budget overspend/80%, low ROAS, high CPL vs channel benchmark, low
// conversion — see the migration report §3.5 for the precise formulas).
enum CampaignAlertType {
  BUDGET_OVERSPEND
  BUDGET_80_PERCENT
  LOW_ROAS
  ROAS_WATCH
  HIGH_CPL
  LOW_CONVERSION
}

enum CampaignAlertPriority {
  MEDIUM
  HIGH
}

enum CampaignAlertStatus {
  OPEN
  RESOLVED
}

model CampaignAlert {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  campaignId     String?               @map("campaign_id") @db.Uuid
  alertType      CampaignAlertType     @map("alert_type")
  priority       CampaignAlertPriority
  title          String
  message        String
  metricValue    Decimal?              @map("metric_value") @db.Decimal(15, 4)
  thresholdValue Decimal?              @map("threshold_value") @db.Decimal(15, 4)
  status         CampaignAlertStatus   @default(OPEN)
  resolvedAt     DateTime?             @map("resolved_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId, status])
  @@index([companyId, campaignId])
  @@map("mkt_campaign_alerts")
}

// ─────────────────────────────────────────────────────────────
// HRMS — Attendance & Leave (migrated from WordPress "EQ HRMS"; see
// CRM_SALES_MARKETING_HRMS_MIGRATION_REPORT.md). Payroll and
// KPI/Performance are explicitly out of scope for this pass — the source's
// own versions are thin flat-entry ports with no real calculation engine
// behind either, per the confirmed scope decision.
// ─────────────────────────────────────────────────────────────

// Late-flag is deliberately NOT a stored column — computed at read time
// against the employee's own Shift.startTime (a real improvement over the
// source, which hardcodes one 10:15 cutoff for every employee company-wide;
// Fashion ERP already had a real Shift concept, just never wired to
// Employee until now).
model AttendanceRecord {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  attendanceDate   DateTime  @map("attendance_date") @db.Date
  punchIn          DateTime? @map("punch_in")
  punchOut         DateTime? @map("punch_out")
  remarks          String?
  recordedByUserId String    @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company    Company  @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
  recordedBy User     @relation(fields: [recordedByUserId], references: [id])

  // A correction request may reference the record it ultimately amended —
  // nullable both ways (a request can pre-date any record existing yet for
  // that day, e.g. a forgotten punch-in) and one-to-many (a record can be
  // corrected more than once over its life).
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([employeeId, attendanceDate])
  @@index([companyId, attendanceDate])
  @@map("hrms_attendance_records")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * HRMS gap-analysis Priority 2 item — attendance edits were previously only
 * possible via a direct, unguarded upsert (recordAttendance), with no
 * request/approval trail. This is the same submit -> approve/reject shape
 * as LeaveRequest, applied to punch-time corrections instead of leave days.
 * Approval writes the requested punch times onto the real AttendanceRecord
 * (creating it via the same upsert recordAttendance already uses if none
 * exists yet for that date) — see attendance-correction.service.ts.
 */
model AttendanceCorrectionRequest {
  id                 String                     @id @default(uuid()) @db.Uuid
  companyId          String                     @map("company_id") @db.Uuid
  employeeId         String                     @map("employee_id") @db.Uuid
  attendanceRecordId String?                    @map("attendance_record_id") @db.Uuid
  attendanceDate     DateTime                   @map("attendance_date") @db.Date
  requestedPunchIn   DateTime?                  @map("requested_punch_in")
  requestedPunchOut  DateTime?                  @map("requested_punch_out")
  reason             String
  status             AttendanceCorrectionStatus @default(PENDING)
  rejectionReason    String?                    @map("rejection_reason")
  approvedByUserId   String?                    @map("approved_by_user_id") @db.Uuid
  decidedAt          DateTime?                  @map("decided_at")
  createdByUserId    String                     @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at")

  company          Company           @relation(fields: [companyId], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])
  approvedBy       User?             @relation("AttendanceCorrectionApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy        User              @relation("AttendanceCorrectionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("hrms_attendance_correction_requests")
}

model LeaveType {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String
  annualDays Decimal  @default(0) @map("annual_days") @db.Decimal(6, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company       Company                    @relation(fields: [companyId], references: [id])
  requests      LeaveRequest[]
  carryForwards LeaveBalanceCarryForward[]

  @@unique([companyId, name])
  @@map("hrms_leave_types")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  employeeId       String             @map("employee_id") @db.Uuid
  leaveTypeId      String             @map("leave_type_id") @db.Uuid
  startDate        DateTime           @map("start_date") @db.Date
  endDate          DateTime           @map("end_date") @db.Date
  reason           String?
  status           LeaveRequestStatus @default(PENDING)
  rejectionReason  String?            @map("rejection_reason")
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  decidedAt        DateTime?          @map("decided_at")
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")

  company    Company   @relation(fields: [companyId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id])
  approvedBy User?     @relation("LeaveRequestApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy  User      @relation("LeaveRequestCreatedBy", fields: [createdByUserId], references: [id])

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("hrms_leave_requests")
}

/**
 * HRMS gap-analysis Priority 2 item: leave carry-forward automation. This
 * project has no job runner/cron infrastructure at all (confirmed — see
 * customer-segments.service.ts's own "no job runner" note), so this is a
 * manually-triggered batch computation, not a true scheduled job — the same
 * shape as CRM's generateFollowupNotifications(). One row per
 * employee+leaveType+target-year, uncapped (no per-leave-type max-carry-
 * forward policy exists in this schema to enforce — carries the full unused
 * balance, a deliberate simplification, not an oversight).
 */
model LeaveBalanceCarryForward {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  leaveTypeId     String   @map("leave_type_id") @db.Uuid
  fromYear        Int      @map("from_year")
  toYear          Int      @map("to_year")
  carriedDays     Decimal  @map("carried_days") @db.Decimal(6, 2)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  createdBy User      @relation(fields: [createdByUserId], references: [id])

  // The idempotency guard the batch run relies on — re-running for the same
  // target year is a safe no-op per employee+leaveType, not a double-credit.
  @@unique([companyId, employeeId, leaveTypeId, toYear])
  @@map("hrms_leave_balance_carry_forwards")
}

// ─────────────────────────────────────────────────────────────
// Sales Orders (Phase 5A)
// ─────────────────────────────────────────────────────────────

// Full lifecycle defined now (matches the roadmap's state machine), but only
// DRAFT/CONFIRMED/ON_HOLD/CANCELLED are reachable through this phase's own
// code — PARTIALLY_DISPATCHED/DISPATCHED/INVOICED/CLOSED are reserved for
// Phase 7/8 to wire up later, same discipline as SampleStatus.DRAFT existing
// unused until something actually transitions into it.
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_DISPATCHED
  DISPATCHED
  INVOICED
  CLOSED
  ON_HOLD
  CANCELLED
}

model SalesOrder {
  id                       String            @id @default(uuid()) @db.Uuid
  companyId                String            @map("company_id") @db.Uuid
  branchId                 String?           @map("branch_id") @db.Uuid
  orderNumber              String            @map("order_number")
  customerId               String            @map("customer_id") @db.Uuid
  buyerId                  String?           @map("buyer_id") @db.Uuid
  orderDate                DateTime          @map("order_date") @db.Date
  requiredShipDate         DateTime?         @map("required_ship_date") @db.Date
  // The buyer's own PO reference number, free text — this app's real
  // ORD-2026-00001 numbering is unrelated and unaffected; a buyer's PO
  // document (the file itself) attaches via the existing generic Attachment
  // mechanism (RelatedModule.SALES_ORDER), not a dedicated column here.
  customerPoNumber         String?           @map("customer_po_number")
  status                   SalesOrderStatus  @default(DRAFT)
  statusBeforeHold         SalesOrderStatus? @map("status_before_hold")
  // Frozen at creation (no live FX picker — multi-currency UI is deferred
  // project-wide); base amounts are stored, not computed live, so historical
  // totals never drift if a rate source changes later.
  currencyCode             String            @map("currency_code") @db.Char(3)
  exchangeRate             Decimal           @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode         String            @map("base_currency_code") @db.Char(3)
  totalAmount              Decimal           @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount          Decimal           @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  requestedByUserId        String            @map("requested_by_user_id") @db.Uuid
  // CRM traceability (2026-10-09, CRM Replacement) — which Opportunity this
  // order came from, if any; optional, set manually on the New Sales Order
  // form, never auto-populated. Was originatingDealId against the legacy
  // CRM's Deal model before the replacement.
  originatingOpportunityId String?           @map("originating_opportunity_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  company                Company           @relation(fields: [companyId], references: [id])
  branch                 Branch?           @relation(fields: [branchId], references: [id])
  customer               Customer          @relation(fields: [customerId], references: [id])
  buyer                  Buyer?            @relation(fields: [buyerId], references: [id])
  requestedBy            User              @relation("SalesOrderRequestedBy", fields: [requestedByUserId], references: [id])
  originatingOpportunity CrmOpportunity?   @relation(fields: [originatingOpportunityId], references: [id])
  items                  SalesOrderItem[]
  salesOrderLines        SalesOrderLine[]
  materialRequests       MaterialRequest[]
  salesInvoices          SalesInvoice[]
  dispatches             Dispatch[]
  // Reserved, unused this phase — AiGarmentProject.salesOrderId is a nullable
  // FK not yet written by any code path (no Sales Order linkage exists yet
  // for AI Garment Flow); documented placeholder, same precedent as
  // ProductionOrderStatus.MATERIAL_ALLOCATED.
  aiGarmentProject       AiGarmentProject?

  @@unique([companyId, orderNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                        String   @id @default(uuid()) @db.Uuid
  salesOrderId              String   @map("sales_order_id") @db.Uuid
  productId                 String   @map("product_id") @db.Uuid
  // Nullable, per-item (not per-header) — one order can carry several style
  // lines, each optionally tracing back to a different approved sample; a
  // repeat/direct order line needs no sample link at all.
  sampleRequestId           String?  @map("sample_request_id") @db.Uuid
  unitPrice                 Decimal  @map("unit_price") @db.Decimal(18, 2)
  notes                     String?
  // Guarded accumulator (Phase 8) — TOTAL physical quantity ever dispatched
  // against this line, regular + extra combined (Extra Dispatch Quantity,
  // 2026-09-30). Incremented only at Confirm-Dispatch time, never at Draft
  // creation. One SalesOrderItem can be dispatched across multiple separate
  // Dispatch documents over time (partial dispatch), hence an accumulator
  // here rather than a one-shot flag. Deliberately UNCAPPED by
  // sum(breakdown.orderedQuantity) — a customer can legitimately receive
  // more than they ordered (FOC, replacement, promotional, etc.); the real
  // cap against real stock still applies (see confirmDispatch()'s
  // getAvailableQuantity() check). regularDispatchedQuantity below is the
  // one capped at the ordered total and is what Sale Order fulfillment is
  // actually computed from.
  dispatchedQuantity        Int      @default(0) @map("dispatched_quantity")
  // Extra Dispatch Quantity (2026-09-30) — the portion of dispatchedQuantity
  // that counts toward Sale Order fulfillment. Guarded, capped by
  // sum(breakdown.orderedQuantity) exactly the way the unsplit
  // dispatchedQuantity column used to be capped before this feature —
  // see confirmDispatch()'s guarded updateMany. Any quantity beyond this
  // (dispatchedQuantity - regularDispatchedQuantity) is Extra and must never
  // be counted as fulfilling the order.
  regularDispatchedQuantity Int      @default(0) @map("regular_dispatched_quantity")
  // Effective BOM (2026-09-24) — the STABLE line identity this concrete item
  // row belongs to. Deliberately NOT the same as this row's own `id`:
  // updateSalesOrder()'s replaceItems() deletes and recreates every
  // SalesOrderItem on every edit, so `id` itself is not stable across edits.
  // SalesOrderLine is the anchor that survives — the BOM snapshot and any
  // SalesOrderBomOverride rows are keyed to it, not to this row. Nullable
  // only because a row can theoretically be written by test/legacy code
  // paths that predate this column; every real service-layer write sets it.
  salesOrderLineId          String?  @map("sales_order_line_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at")

  salesOrder        SalesOrder                @relation(fields: [salesOrderId], references: [id])
  product           Product                   @relation(fields: [productId], references: [id])
  sampleRequest     SampleRequest?            @relation(fields: [sampleRequestId], references: [id])
  salesOrderLine    SalesOrderLine?           @relation(fields: [salesOrderLineId], references: [id])
  breakdown         SalesOrderItemBreakdown[]
  productionOrders  ProductionOrder[]
  salesInvoiceItems SalesInvoiceItem[]
  dispatchItems     DispatchItem[]

  @@map("sales_order_items")
}

// Effective BOM / Sales Order Override / Material Substitution (2026-09-24)
// ─────────────────────────────────────────────────────────────
//
// The stable identity of one Sales Order line, surviving updateSalesOrder()'s
// full delete-and-recreate of the concrete SalesOrderItem rows on every edit.
// `lineNumber` is assigned once (sequential per order, e.g. 1, 2, 3, ...) and
// never reused — the same style/design can legitimately appear on more than
// one line of the same order (e.g. two different color-ways), and each such
// line must keep its own independent snapshot/overrides, never merged by
// productId alone.
//
// The BOM/Sample snapshot fields below are the frozen "what this line was
// confirmed against" fact — set ONCE, either when the order is first
// confirmed or when a genuinely new line is added to an already-confirmed
// order, and NEVER silently re-taken by an ordinary edit (quantity, dates,
// remarks, ...). Only the explicit refreshSalesOrderLineBomSnapshot() action
// (sales-order-bom.service.ts) updates it, with its own audit trail — moving
// an existing confirmed line onto a newer Master BOM version is a deliberate
// business decision, never a side effect of an unrelated edit.
enum SalesOrderBomSourceType {
  STYLE_BOM
  SAMPLE_MATERIALS
  // No approved Style BOM and no linked Sample existed to snapshot at the
  // moment this line was confirmed — the Effective BOM resolver falls back
  // to whatever the Style's live approved BOM says today, the same honest
  // "nothing to snapshot" degradation MRP already used before this feature
  // existed.
  NONE
}

model SalesOrderLine {
  id                    String                  @id @default(uuid()) @db.Uuid
  companyId             String                  @map("company_id") @db.Uuid
  salesOrderId          String                  @map("sales_order_id") @db.Uuid
  lineNumber            Int                     @map("line_number")
  sourceType            SalesOrderBomSourceType @default(NONE) @map("source_type")
  // Set when sourceType = STYLE_BOM — which exact BomVersion was approved at
  // snapshot time.
  bomVersionId          String?                 @map("bom_version_id") @db.Uuid
  // Set when sourceType = SAMPLE_MATERIALS — which exact (append-only)
  // SampleVersion's materials were captured. Without freezing this too, a
  // later sample revision would silently change what an already-confirmed
  // order thinks it needs — the identical problem this whole feature exists
  // to prevent for the Style-BOM case, applied symmetrically.
  sampleVersionId       String?                 @map("sample_version_id") @db.Uuid
  snapshotTakenAt       DateTime?               @map("snapshot_taken_at")
  snapshotTakenByUserId String?                 @map("snapshot_taken_by_user_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  company         Company                 @relation(fields: [companyId], references: [id])
  salesOrder      SalesOrder              @relation(fields: [salesOrderId], references: [id])
  bomVersion      BomVersion?             @relation(fields: [bomVersionId], references: [id])
  sampleVersion   SampleVersion?          @relation(fields: [sampleVersionId], references: [id])
  snapshotTakenBy User?                   @relation("SalesOrderLineSnapshotTakenBy", fields: [snapshotTakenByUserId], references: [id])
  items           SalesOrderItem[]
  overrides       SalesOrderBomOverride[]

  @@unique([salesOrderId, lineNumber])
  @@map("sales_order_lines")
}

enum SalesOrderBomOverrideReason {
  CUSTOMER_REQUIREMENT
  BUYER_APPROVAL
  SPECIFICATION_CHANGE
  QUALITY_REQUIREMENT
  OTHER
}

// One row per changed BOM line for one Sales Order line — Replace/Add/
// Remove/Quantity-or-wastage-only, all covered by the same nullable-pair
// shape rather than four separate tables:
//   originalMaterialId null              -> pure addition
//   effectiveMaterialId null             -> removal
//   both set, different                  -> replace
//   both set, same                       -> quantity/wastage/uom-only change
// Never destroys the prior row on a further change — isActive/deactivatedBy/
// deactivatedAt retire an override without deleting its audit trail, the
// same "never truly delete, preserve traceability" convention already used
// throughout this codebase (e.g. SampleVersion's own SUPERSEDED, not deleted).
// Applying an ACTIVE override is gated purely by "sales_orders" edit/approve
// permission, not a separate maker/checker workflow — the spec's own field
// list (reason/remarks/changedBy/changedAt) is itself the audit trail;
// unlike Material Substitution (a stock-driven, unplanned event), a BOM
// override is a deliberate, authorized customization decision made once.
model SalesOrderBomOverride {
  id                       String                      @id @default(uuid()) @db.Uuid
  companyId                String                      @map("company_id") @db.Uuid
  salesOrderLineId         String                      @map("sales_order_line_id") @db.Uuid
  originalMaterialId       String?                     @map("original_material_id") @db.Uuid
  effectiveMaterialId      String?                     @map("effective_material_id") @db.Uuid
  originalQuantityPerUnit  Decimal?                    @map("original_quantity_per_unit") @db.Decimal(18, 4)
  effectiveQuantityPerUnit Decimal?                    @map("effective_quantity_per_unit") @db.Decimal(18, 4)
  wastagePercentage        Decimal?                    @map("wastage_percentage") @db.Decimal(5, 2)
  colorId                  String?                     @map("color_id") @db.Uuid
  uomId                    String?                     @map("uom_id") @db.Uuid
  reason                   SalesOrderBomOverrideReason @default(OTHER)
  remarks                  String?
  isActive                 Boolean                     @default(true) @map("is_active")
  changedByUserId          String                      @map("changed_by_user_id") @db.Uuid
  changedAt                DateTime                    @default(now()) @map("changed_at")
  deactivatedByUserId      String?                     @map("deactivated_by_user_id") @db.Uuid
  deactivatedAt            DateTime?                   @map("deactivated_at")

  company           Company        @relation(fields: [companyId], references: [id])
  salesOrderLine    SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])
  originalMaterial  Product?       @relation("SalesOrderBomOverrideOriginalMaterial", fields: [originalMaterialId], references: [id])
  effectiveMaterial Product?       @relation("SalesOrderBomOverrideEffectiveMaterial", fields: [effectiveMaterialId], references: [id])
  color             Color?         @relation(fields: [colorId], references: [id])
  uom               UnitOfMeasure? @relation(fields: [uomId], references: [id])
  changedBy         User           @relation("SalesOrderBomOverrideChangedBy", fields: [changedByUserId], references: [id])
  deactivatedBy     User?          @relation("SalesOrderBomOverrideDeactivatedBy", fields: [deactivatedByUserId], references: [id])

  @@index([salesOrderLineId])
  @@map("sales_order_bom_overrides")
}

model SalesOrderItemBreakdown {
  id               String   @id @default(uuid()) @db.Uuid
  salesOrderItemId String   @map("sales_order_item_id") @db.Uuid
  // FK's to the existing style×color×size join rather than duplicating raw
  // colorId+sizeId — ProductVariant exists specifically so every stock/
  // production/dispatch line has one concrete SKU FK.
  productVariantId String   @map("product_variant_id") @db.Uuid
  orderedQuantity  Int      @map("ordered_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([salesOrderItemId, productVariantId])
  @@map("sales_order_item_breakdown")
}

// ─────────────────────────────────────────────────────────────
// BOM & MRP (Phase 5B)
// ─────────────────────────────────────────────────────────────

// Deliberately NOT a numbered document (no DocumentType/document_number) — a
// header attached 1:1 to a Style. Versioned like SampleVersion (see
// BomVersion below): a BOM is edited freely while its current version is
// still DRAFT, but once a version is APPROVED it is locked — the next edit
// mints a new DRAFT version rather than silently rewriting approved history.
// MRP/Production consume `approvedVersionId` specifically, never whatever
// is merely "latest" — an unapproved edit-in-progress can never silently
// change what material planning already relies on.
model Bom {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  productId            String   @unique @map("product_id") @db.Uuid
  // The highest version number ever minted for this BOM — not necessarily
  // the approved one. 0 means no version has been created yet.
  currentVersionNumber Int      @default(0) @map("current_version_number")
  // The version MRP/Production should read. Null until the first approval —
  // deliberately a separate pointer from "latest version" so an in-progress
  // edit can never be mistaken for what's actually approved for use.
  approvedVersionId    String?  @unique @map("approved_version_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  versions         BomVersion[]      @relation("BomVersions")
  approvedVersion  BomVersion?       @relation("BomApprovedVersion", fields: [approvedVersionId], references: [id])
  materialRequests MaterialRequest[]
  productionOrders ProductionOrder[]

  @@map("boms")
}

enum BomVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

// Append-only, mirroring SampleVersion's proven shape: the prior APPROVED
// version flips to SUPERSEDED the moment a new one is approved, so
// "which version was approved and used at a given time" is always
// answerable — the exact traceability BOM never had before this model
// existed (see docs/PRACTICAL_BUSINESS_READY_AUDIT.md Section 4).
model BomVersion {
  id               String           @id @default(uuid()) @db.Uuid
  bomId            String           @map("bom_id") @db.Uuid
  versionNumber    Int              @map("version_number")
  status           BomVersionStatus @default(DRAFT)
  notes            String?
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?        @map("approved_at")

  bom             Bom              @relation("BomVersions", fields: [bomId], references: [id])
  approvedForBom  Bom?             @relation("BomApprovedVersion")
  createdBy       User             @relation("BomVersionCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy      User?            @relation("BomVersionApprovedBy", fields: [approvedByUserId], references: [id])
  items           BomItem[]
  salesOrderLines SalesOrderLine[]

  @@unique([bomId, versionNumber])
  @@map("bom_versions")
}

model BomItem {
  id                String   @id @default(uuid()) @db.Uuid
  bomVersionId      String   @map("bom_version_id") @db.Uuid
  materialId        String   @map("material_id") @db.Uuid
  // Optional per-color consumption line (e.g. thread color matching the
  // garment's own color) — null means "applies to every color" on this
  // style. Duplicate/overlap combinations (same material twice, or a null
  // line coexisting with a specific-color line for the same material) are
  // rejected at the service layer, not by a DB constraint (Postgres treats
  // NULL as distinct in a unique index, which wouldn't catch the overlap).
  colorId           String?  @map("color_id") @db.Uuid
  // Consumption per ONE finished garment piece, denominated in `uomId`.
  quantityPerUnit   Decimal  @map("quantity_per_unit") @db.Decimal(18, 4)
  // Effective qty = quantityPerUnit * (1 + wastagePercentage/100).
  wastagePercentage Decimal  @default(0) @map("wastage_percentage") @db.Decimal(5, 2)
  uomId             String   @map("uom_id") @db.Uuid
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  bomVersion BomVersion    @relation(fields: [bomVersionId], references: [id])
  material   Product       @relation("BomItemMaterial", fields: [materialId], references: [id])
  color      Color?        @relation(fields: [colorId], references: [id])
  uom        UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@index([bomVersionId])
  @@map("bom_items")
}

// ─────────────────────────────────────────────────────────────
// Purchasing (pulled forward from Phase 6 — Purchase Order + Goods Receipt,
// with fabric roll-level tracking on receipt)
// ─────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT_TO_SUPPLIER
  // Only reachable as an automatic side effect of createGoodsReceipt() —
  // never via the generic status-change endpoint, same discipline as
  // SalesOrderStatus.IN_PRODUCTION being reserved for a real business action.
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  ON_HOLD
  CANCELLED
}

model PurchaseOrder {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @map("company_id") @db.Uuid
  branchId             String?              @map("branch_id") @db.Uuid
  orderNumber          String               @map("order_number")
  supplierId           String               @map("supplier_id") @db.Uuid
  orderDate            DateTime             @map("order_date") @db.Date
  expectedDeliveryDate DateTime?            @map("expected_delivery_date") @db.Date
  status               PurchaseOrderStatus  @default(DRAFT)
  statusBeforeHold     PurchaseOrderStatus? @map("status_before_hold")
  // Always company.baseCurrencyCode, never supplier.defaultCurrencyCode —
  // applying the Sales Order currency-defaulting lesson (CLAUDE.md, 2026-08-20)
  // proactively instead of repeating the same mistake here.
  currencyCode         String               @map("currency_code") @db.Char(3)
  exchangeRate         Decimal              @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode     String               @map("base_currency_code") @db.Char(3)
  totalAmount          Decimal              @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount      Decimal              @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  requestedByUserId    String               @map("requested_by_user_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  company          Company             @relation(fields: [companyId], references: [id])
  branch           Branch?             @relation(fields: [branchId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  requestedBy      User                @relation("PurchaseOrderRequestedBy", fields: [requestedByUserId], references: [id])
  items            PurchaseOrderItem[]
  receipts         GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, supplierId])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                    String   @id @default(uuid()) @db.Uuid
  purchaseOrderId       String   @map("purchase_order_id") @db.Uuid
  // RAW_MATERIAL only — enforced at the service layer (query filter), not a
  // DB constraint, matching how the Products STYLE/RAW_MATERIAL split already
  // works everywhere else in this schema.
  productId             String   @map("product_id") @db.Uuid
  uomId                 String   @map("uom_id") @db.Uuid
  orderedQuantity       Decimal  @map("ordered_quantity") @db.Decimal(18, 4)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(18, 2)
  // Cumulative accumulator, incremented atomically per receipt via a guarded
  // updateMany (see purchase-order.service.ts) — never a plain read-then-write.
  receivedQuantity      Decimal  @default(0) @map("received_quantity") @db.Decimal(18, 4)
  // Cumulative accumulator, incremented only at Purchase Invoice POST time
  // (never at DRAFT-creation) via a raw-SQL guarded update comparing against
  // the LIVE receivedQuantity column (see PurchaseOrderItemRepository —
  // Prisma's updateMany cannot express a column-to-column comparison, so the
  // usual guarded-updateMany idiom doesn't apply here). receivedQuantity's
  // own decrement (goods-receipt reversal) is guarded symmetrically against
  // this column, so it can never drop below what's already been invoiced.
  invoicedQuantity      Decimal  @default(0) @map("invoiced_quantity") @db.Decimal(18, 4)
  notes                 String?
  // Which Colors-master color this line is for, and (optionally) the exact
  // physical shade/Pantone within it — same two-column shape already proven
  // on SampleMaterial.colorId/dyeId, captured at request/creation time and
  // then just plain columns for the rest of this PO's own lifecycle (no
  // per-status logic needed for it to keep showing through Approved and
  // Sent to Supplier). Direct user ask (2026-09-05), scoped to Purchase
  // Order only — not threaded through Material Request/BOM-generated POs.
  colorId               String?  @map("color_id") @db.Uuid
  dyeId                 String?  @map("dye_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  // The authoritative FK for the optional Material Request -> Purchase Order
  // link (mirrors BuyerEnquiryLine.sampleRequestId's shape) — set only by
  // generatePurchaseOrdersForShortfall(), never by direct PO creation.
  // Deliberately NOT @unique — a single MaterialRequestItem can legitimately
  // spawn more than one PurchaseOrderItem over its lifetime (a first PO for
  // part of a shortfall, a later one for the rest, since PO quantity is
  // user-edited and never forced to equal the full remaining shortfall).
  materialRequestItemId String?  @map("material_request_item_id") @db.Uuid

  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  product              Product               @relation(fields: [productId], references: [id])
  uom                  UnitOfMeasure         @relation(fields: [uomId], references: [id])
  color                Color?                @relation(fields: [colorId], references: [id])
  dye                  FabricDye?            @relation(fields: [dyeId], references: [id])
  goodsReceiptItems    GoodsReceiptItem[]
  materialRequestItem  MaterialRequestItem?  @relation(fields: [materialRequestItemId], references: [id])
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([purchaseOrderId])
  @@index([materialRequestItemId])
  @@map("purchase_order_items")
}

// Internal-only: "which department/production needs which material" — owned
// by Inventory, deliberately carries no supplier/pricing/commercial fields at
// all (that's what makes it different from a Purchase Requisition/Purchase
// Order). Lines are simply fulfilled from stock (Material Issue) or, when
// stock falls short, optionally escalated to Purchasing as a real Purchase
// Order — escalation is never automatic and never gates on any approval step.
// Effective BOM / Material Substitution (2026-09-24) — shared by
// MaterialRequest.approvalStatus (the DAMAGE_REPLACEMENT approval gate) and
// MaterialSubstitution.status (propose -> approve/reject a stock-driven
// substitute) rather than two near-identical enums; both reuse the exact
// PENDING/APPROVED/REJECTED vocabulary JobOrderProgressEntry.approvalStatus
// and JobWorkReceipt.approvalStatus already established in this codebase.
enum ApprovalDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  OPEN
  // Reachable only as a derived side effect of issuing/escalating lines —
  // never hand-set via a generic status-change endpoint, same discipline as
  // BuyerEnquiry.status/PurchaseOrderStatus.PARTIALLY_RECEIVED.
  PARTIALLY_FULFILLED
  FULFILLED
  // Manual, only reachable from OPEN/PARTIALLY_FULFILLED.
  CLOSED
  ON_HOLD
  CANCELLED
}

enum MaterialRequestType {
  // The normal BOM-driven requirement, whether created manually or via
  // "Generate Material Request" from BOM/MRP shortfall.
  PRODUCTION_REQUIREMENT
  // An additional requirement caused by real production-floor damage —
  // never modifies the original request/BOM, always a new document that
  // references it via originalMaterialRequestId.
  DAMAGE_REPLACEMENT
  // Raw material genuinely needed for a Sample Request's own development —
  // generated from one SampleVersion's own SampleMaterial rows (see
  // sampleVersionId on MaterialRequest below), issued through the exact same
  // Inventory-checks-stock flow as every other Material Request.
  SAMPLING_REQUIREMENT
}

model MaterialRequest {
  id                        String                  @id @default(uuid()) @db.Uuid
  companyId                 String                  @map("company_id") @db.Uuid
  branchId                  String?                 @map("branch_id") @db.Uuid
  requestNumber             String                  @map("request_number")
  requestType               MaterialRequestType     @default(PRODUCTION_REQUIREMENT) @map("request_type")
  departmentId              String?                 @map("department_id") @db.Uuid
  // Where the material should be issued from — required, unlike Purchase
  // Order's optional "Receive At", since Material Issue must decrement a
  // specific warehouse's real StockBalance.
  warehouseId               String                  @map("warehouse_id") @db.Uuid
  requiredDate              DateTime?               @map("required_date") @db.Date
  // Free-text "why" (e.g. "cutting shortage for Lot 42") — deliberately not a
  // structured reason-code table, matches the project's existing preference
  // for a single free-text reference field over several rigid ones.
  purpose                   String?
  // Nullable traceability only — a manually-raised request simply leaves
  // this null.
  salesOrderId              String?                 @map("sales_order_id") @db.Uuid
  // Nullable traceability to the Production Order this requirement was
  // generated for (Phase 5C) — a request raised directly from BOM/MRP
  // against a Sales Order, with no Production Order yet, simply leaves this
  // null; both fields can be set together once a Production Order exists.
  productionOrderId         String?                 @map("production_order_id") @db.Uuid
  // Populated only when every line traces to exactly one style's BOM (a
  // multi-style-aggregated request leaves this null — salesOrderId remains
  // the primary traceability field; see material-request.service.ts).
  bomId                     String?                 @map("bom_id") @db.Uuid
  // Set only when requestType = DAMAGE_REPLACEMENT — the original
  // requirement this damage relates to. Self-referencing rather than a
  // ProductionOrder FK, since no Production module exists yet (same
  // reasoning already applied above to salesOrderId).
  originalMaterialRequestId String?                 @map("original_material_request_id") @db.Uuid
  // Nullable traceability to the SampleVersion this requirement's raw
  // materials were generated from (requestType = SAMPLING_REQUIREMENT) — the
  // Sampling equivalent of bomId above; a request raised any other way
  // simply leaves this null.
  sampleVersionId           String?                 @map("sample_version_id") @db.Uuid
  // Effective BOM (2026-09-24) — nullable traceability to the specific Lot/
  // JobOrder this requirement was raised for, siblings of productionOrderId
  // above (header-level, not per-line — Lot/JobOrder have zero material
  // awareness of their own, see the schema comment on JobOrder). Mainly
  // populated for requestType = DAMAGE_REPLACEMENT ("Additional Material
  // Request"), which is routinely raised from a specific Lot/stage context,
  // but left available to any request type raised from that context.
  lotId                     String?                 @map("lot_id") @db.Uuid
  jobOrderId                String?                 @map("job_order_id") @db.Uuid
  remarks                   String?
  // Derived from lines except the manual ON_HOLD/CANCELLED/CLOSED
  // transitions — never hand-set to PARTIALLY_FULFILLED/FULFILLED.
  status                    MaterialRequestStatus   @default(OPEN)
  statusBeforeHold          MaterialRequestStatus?  @map("status_before_hold")
  // Effective BOM / Material Substitution (2026-09-24) — an approval gate
  // scoped ONLY to requestType = DAMAGE_REPLACEMENT ("Additional Material
  // Request"); every other request type leaves this null and issuance
  // proceeds exactly as before this feature existed (no behavior change for
  // ordinary PRODUCTION_REQUIREMENT/SAMPLING_REQUIREMENT requests). Reuses
  // the existing "production" RBAC module's "approve" action — no new
  // permission — self-approval-guarded the same way every other maker/
  // checker gate in this codebase already is.
  approvalStatus            ApprovalDecisionStatus? @map("approval_status")
  approvedByUserId          String?                 @map("approved_by_user_id") @db.Uuid
  approvedAt                DateTime?               @map("approved_at")
  approvalRemark            String?                 @map("approval_remark")
  requestedByUserId         String                  @map("requested_by_user_id") @db.Uuid
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  company                 Company               @relation(fields: [companyId], references: [id])
  branch                  Branch?               @relation(fields: [branchId], references: [id])
  department              Department?           @relation(fields: [departmentId], references: [id])
  warehouse               Warehouse             @relation(fields: [warehouseId], references: [id])
  salesOrder              SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  productionOrder         ProductionOrder?      @relation(fields: [productionOrderId], references: [id])
  lot                     Lot?                  @relation(fields: [lotId], references: [id])
  jobOrder                JobOrder?             @relation(fields: [jobOrderId], references: [id])
  bom                     Bom?                  @relation(fields: [bomId], references: [id])
  originalMaterialRequest MaterialRequest?      @relation("MaterialRequestReplacementOrigin", fields: [originalMaterialRequestId], references: [id])
  replacementRequests     MaterialRequest[]     @relation("MaterialRequestReplacementOrigin")
  sampleVersion           SampleVersion?        @relation(fields: [sampleVersionId], references: [id])
  requestedBy             User                  @relation("MaterialRequestRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy              User?                 @relation("MaterialRequestApprovedBy", fields: [approvedByUserId], references: [id])
  lines                   MaterialRequestItem[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@index([companyId, requestType])
  @@index([productionOrderId])
  @@index([sampleVersionId])
  @@index([lotId])
  @@index([jobOrderId])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                       String   @id @default(uuid()) @db.Uuid
  materialRequestId        String   @map("material_request_id") @db.Uuid
  materialId               String   @map("material_id") @db.Uuid
  // Reuse the existing Color/FabricDye masters for shade precision — the
  // same shape already proven on SampleMaterial/PurchaseRequestItem before it.
  colorId                  String?  @map("color_id") @db.Uuid
  dyeId                    String?  @map("dye_id") @db.Uuid
  uomId                    String   @map("uom_id") @db.Uuid
  requestedQuantity        Decimal  @map("requested_quantity") @db.Decimal(18, 4)
  // Cumulative accumulator, incremented atomically per issue via a guarded
  // updateMany (see material-request.service.ts) — never a plain
  // read-then-write. No `rate`/pricing field at all — this line never becomes
  // a commercial document; deliberately no `lineStatus` column either, since
  // "pending/partially issued/fully issued/escalated" is fully derivable from
  // issuedQuantity + whether a purchaseOrderItem exists, and storing it too
  // would just be a second source of truth to drift out of sync.
  issuedQuantity           Decimal  @default(0) @map("issued_quantity") @db.Decimal(18, 4)
  // Guarded accumulator (same idiom as issuedQuantity) — incremented inside
  // createGoodsReceipt()'s existing transaction when a linked
  // PurchaseOrderItem is received, decremented inside
  // reverseGoodsReceiptLine()'s. Informational only — deliberately does NOT
  // reduce the line's remainingQuantity (a computed value); receiving goods
  // against a linked PO adds to general warehouse stock, it does not by
  // itself fulfill this request line — that still requires an explicit
  // Material Issue action.
  purchaseReceivedQuantity Decimal  @default(0) @map("purchase_received_quantity") @db.Decimal(18, 4)
  // Only meaningful when the owning request's requestType is
  // DAMAGE_REPLACEMENT — free text, same "no rigid reason-code table"
  // convention as MaterialRequest.purpose.
  damageReason             String?  @map("damage_reason")
  remarks                  String?
  // Which room/section within the request's own warehouse this line should
  // be issued from — traceability only, same reasoning as
  // StockMovementItem.warehouseLocationId above (passed through to the
  // ledger's existing warehouseLocationId; StockBalance has no location
  // dimension, so getAvailableQuantity() stays warehouse-level).
  warehouseLocationId      String?  @map("warehouse_location_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  materialRequest    MaterialRequest        @relation(fields: [materialRequestId], references: [id])
  material           Product                @relation("MaterialRequestItemMaterial", fields: [materialId], references: [id])
  color              Color?                 @relation(fields: [colorId], references: [id])
  dye                FabricDye?             @relation(fields: [dyeId], references: [id])
  uom                UnitOfMeasure          @relation(fields: [uomId], references: [id])
  warehouseLocation  WarehouseLocation?     @relation(fields: [warehouseLocationId], references: [id])
  // Virtual back-relation only — the authoritative FK lives on
  // PurchaseOrderItem.materialRequestItemId (see that model). A line can
  // legitimately have more than one linked PurchaseOrderItem over its
  // lifetime (repeat/partial escalation) — see that model's own comment.
  purchaseOrderItems PurchaseOrderItem[]
  // Effective BOM / Material Substitution (2026-09-24) — every stock-driven
  // substitution proposed/approved/issued against this line. Deliberately
  // 1:many, not 1:1 — one line's shortfall can be split across several
  // different substitute materials (partial substitution), each its own row.
  substitutions      MaterialSubstitution[]

  @@index([materialRequestId])
  @@map("material_request_items")
}

enum MaterialSubstitutionReason {
  ORIGINAL_MATERIAL_NOT_AVAILABLE
  QUALITY_ISSUE
  OTHER
}

// A stock-driven substitution — the "acceptable alternative issued because
// the Effective BOM's own material is unavailable" case (distinct from
// SalesOrderBomOverride, a deliberate customer-driven BOM change). Never
// modifies MaterialRequestItem.materialId or the Effective BOM in any way —
// the requested material stays exactly what the Effective BOM said; this
// table only records what was actually, physically handed out instead, plus
// the full workflow/audit trail the spec requires. One MaterialRequestItem
// can have many of these (partial/multiple substitution across several
// different substitute materials); the item's own existing `issuedQuantity`
// accumulator remains the single, already-guarded source of truth for "how
// much of this line's requirement has been fulfilled so far," regardless of
// which material(s) fulfilled it — no second accumulator is introduced here.
model MaterialSubstitution {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @map("company_id") @db.Uuid
  materialRequestItemId  String                     @map("material_request_item_id") @db.Uuid
  originalMaterialId     String                     @map("original_material_id") @db.Uuid
  substituteMaterialId   String                     @map("substitute_material_id") @db.Uuid
  quantity               Decimal                    @map("quantity") @db.Decimal(18, 4)
  uomId                  String                     @map("uom_id") @db.Uuid
  reason                 MaterialSubstitutionReason @default(OTHER)
  remarks                String?
  status                 ApprovalDecisionStatus     @default(PENDING)
  requestedByUserId      String                     @map("requested_by_user_id") @db.Uuid
  requestedAt            DateTime                   @default(now()) @map("requested_at")
  approvedByUserId       String?                    @map("approved_by_user_id") @db.Uuid
  approvedAt             DateTime?                  @map("approved_at")
  approvalRemark         String?                    @map("approval_remark")
  // Set only once APPROVED and actually posted to the ledger, in the same
  // transaction as the InventoryTransaction insert — a PENDING or REJECTED
  // row never has one. InventoryTransaction remains the sole physical-stock
  // source of truth; this is a workflow/audit pointer to it, never a second
  // ledger.
  inventoryTransactionId String?                    @map("inventory_transaction_id") @db.Uuid

  company              Company               @relation(fields: [companyId], references: [id])
  materialRequestItem  MaterialRequestItem   @relation(fields: [materialRequestItemId], references: [id])
  originalMaterial     Product               @relation("MaterialSubstitutionOriginalMaterial", fields: [originalMaterialId], references: [id])
  substituteMaterial   Product               @relation("MaterialSubstitutionSubstituteMaterial", fields: [substituteMaterialId], references: [id])
  uom                  UnitOfMeasure         @relation(fields: [uomId], references: [id])
  requestedBy          User                  @relation("MaterialSubstitutionRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy           User?                 @relation("MaterialSubstitutionApprovedBy", fields: [approvedByUserId], references: [id])
  inventoryTransaction InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id])

  @@index([materialRequestItemId])
  @@index([companyId, status])
  @@map("material_substitutions")
}

// CANCELLED means "every line fully reversed" — derived/cached, recomputed in
// the same transaction as every reversal, never hand-set by a caller.
enum GoodsReceiptStatus {
  COMPLETED
  PARTIALLY_REVERSED
  CANCELLED
}

model GoodsReceipt {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  branchId         String?            @map("branch_id") @db.Uuid
  receiptNumber    String             @map("receipt_number")
  purchaseOrderId  String             @map("purchase_order_id") @db.Uuid
  receivedDate     DateTime           @map("received_date") @db.Date
  receivedByUserId String             @map("received_by_user_id") @db.Uuid
  status           GoodsReceiptStatus @default(COMPLETED)
  // Client-generated, one per real create attempt (retried on a network
  // failure with the SAME key) — see CF-5 in the independent hardening
  // audit: without this, a lost response + a resubmitted identical POST both
  // succeed and double-post a real InventoryTransaction, since a fresh
  // document number is drawn on every call and nothing else identifies "this
  // is the same physical event, not a second one." Nullable because it's
  // opt-in per caller (a direct API caller that never supplies one simply
  // gets no idempotency protection — an accepted, documented gap, not a
  // silent one); @@unique is what turns a replayed request into "return the
  // original," not a second row.
  idempotencyKey   String?            @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyId], references: [id])
  branch        Branch?            @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User               @relation("GoodsReceiptReceivedBy", fields: [receivedByUserId], references: [id])
  items         GoodsReceiptItem[]

  @@unique([companyId, receiptNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String   @id @default(uuid()) @db.Uuid
  goodsReceiptId      String   @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String   @map("purchase_order_item_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  uomId               String   @map("uom_id") @db.Uuid
  receivedQuantity    Decimal  @map("received_quantity") @db.Decimal(18, 4)
  // "Already-reversed" cap accumulator — see reverseGoodsReceiptLine().
  reversedQuantity    Decimal  @default(0) @map("reversed_quantity") @db.Decimal(18, 4)
  warehouseId         String   @map("warehouse_id") @db.Uuid
  warehouseLocationId String?  @map("warehouse_location_id") @db.Uuid
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  uom               UnitOfMeasure      @relation(fields: [uomId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  rolls             FabricRoll[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

// PARTIALLY_USED/CONSUMED are reserved for Phase 5C's cutting-issuance — not
// reachable by this module, same "enum value nothing reaches yet" discipline
// as SampleStatus.DRAFT / SalesOrderStatus.IN_PRODUCTION.
enum FabricRollStatus {
  IN_STOCK
  PARTIALLY_USED
  CONSUMED
  DAMAGED
  CANCELLED
}

model FabricRoll {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  goodsReceiptItemId  String           @map("goods_receipt_item_id") @db.Uuid
  // Not unique company-wide — different suppliers routinely reuse roll
  // numbering ("R-001"). Just indexed for lookup; this row's own id (rendered
  // via the shared Barcode component) is the real identity.
  rollNumber          String           @map("roll_number")
  // The roll's own meterage/weight at receipt. Named distinctly from
  // GoodsReceiptItem.receivedQuantity / PurchaseOrderItem.receivedQuantity to
  // avoid the "same field name, three different meanings" ambiguity.
  rollQuantity        Decimal          @map("roll_quantity") @db.Decimal(18, 4)
  // Decremented by future reversals AND by Phase 5C cutting-issuance — one
  // field, one meaning: "still-available quantity on this physical roll."
  remainingQuantity   Decimal          @map("remaining_quantity") @db.Decimal(18, 4)
  batchNo             String?          @map("batch_no")
  // First real wiring of the standalone fabric masters built in Phase 3.
  // Single dominant composition for MVP — blends are a documented future
  // refinement, not built now.
  gsmId               String?          @map("gsm_id") @db.Uuid
  dyeId               String?          @map("dye_id") @db.Uuid
  weaveTypeId         String?          @map("weave_type_id") @db.Uuid
  widthId             String?          @map("width_id") @db.Uuid
  compositionId       String?          @map("composition_id") @db.Uuid
  warehouseLocationId String?          @map("warehouse_location_id") @db.Uuid
  status              FabricRollStatus @default(IN_STOCK)
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  goodsReceiptItem      GoodsReceiptItem       @relation(fields: [goodsReceiptItemId], references: [id])
  gsm                   FabricGsm?             @relation(fields: [gsmId], references: [id])
  dye                   FabricDye?             @relation(fields: [dyeId], references: [id])
  weaveType             FabricWeaveType?       @relation(fields: [weaveTypeId], references: [id])
  width                 FabricWidth?           @relation(fields: [widthId], references: [id])
  composition           FabricComposition?     @relation(fields: [compositionId], references: [id])
  warehouseLocation     WarehouseLocation?     @relation(fields: [warehouseLocationId], references: [id])
  inventoryTransactions InventoryTransaction[]
  jobWorkOrderMaterials JobWorkOrderMaterial[]

  @@index([companyId, rollNumber])
  @@index([goodsReceiptItemId])
  @@map("fabric_rolls")
}

// ─────────────────────────────────────────────────────────────
// Production (Phase 5C) — see PRODUCTION_MODULE_DESIGN.md for the full
// reviewed design. Core discipline: NO stage is ever named in schema or
// code — everything is generic over ProductionStage.id, validated only by
// its sequence/isActive/allowRework columns. ProductionStageTransaction is
// the single append-only ledger; JobOrder/JobOrderAssignment/
// JobOrderProgressEntry are the only work-tracking tables (no
// CuttingPlan/SewingProduction/FinishingRecord-style per-stage tables).
// ─────────────────────────────────────────────────────────────

enum ProductionOrderStatus {
  PLANNED
  MATERIAL_ALLOCATED
  IN_PROGRESS
  ON_HOLD
  CANCELLED
  CLOSED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ProductionOrder {
  id                         String                 @id @default(uuid()) @db.Uuid
  companyId                  String                 @map("company_id") @db.Uuid
  branchId                   String?                @map("branch_id") @db.Uuid
  orderNumber                String                 @map("order_number")
  // Nullable — null means Make-to-Stock (no customer sale behind this run).
  salesOrderItemId           String?                @map("sales_order_item_id") @db.Uuid
  productId                  String                 @map("product_id") @db.Uuid
  // Snapshot pointer for audit purposes — Bom itself has no versioning yet,
  // but this still records "the BOM as it existed" at order-creation time.
  bomId                      String?                @map("bom_id") @db.Uuid
  plannedQuantity            Decimal                @map("planned_quantity") @db.Decimal(18, 4)
  status                     ProductionOrderStatus  @default(PLANNED)
  statusBeforeHold           ProductionOrderStatus? @map("status_before_hold")
  priority                   ProductionPriority     @default(NORMAL)
  plannedStartDate           DateTime?              @map("planned_start_date") @db.Date
  plannedEndDate             DateTime?              @map("planned_end_date") @db.Date
  actualStartDate            DateTime?              @map("actual_start_date") @db.Date
  actualEndDate              DateTime?              @map("actual_end_date") @db.Date
  // Internal counter for generating this order's own Lot-number suffixes
  // (PROD-2026-00001-L01, -L02, ...) — a sub-sequence per order, deliberately
  // not routed through the shared DocumentNumberingService (a different
  // concern: a per-company/fiscal-year document number vs. a per-order line
  // counter).
  nextLotSequence            Int                    @default(1) @map("next_lot_sequence")
  remarks                    String?
  requestedByUserId          String                 @map("requested_by_user_id") @db.Uuid
  // Dispatch Eligibility gate (2026-10-10, Dispatch/Production/Forwarder/
  // Barcode initiative) — a deliberately manual, independent judgment call,
  // NOT derived from status/lot completion: a Production Manager can release
  // partial output to dispatch while the order is still IN_PROGRESS (the
  // common partial-shipment case this ERP already supports elsewhere), so
  // reusing CLOSED (which requires every lot done, see closeProductionOrder's
  // own guard) would be far too strict. Nullable = not yet released, the
  // default for every order; set/cleared only via the dedicated release/
  // revoke actions in production-order.service.ts, never the generic
  // status-transition endpoint.
  releasedToDispatchAt       DateTime?              @map("released_to_dispatch_at")
  releasedToDispatchByUserId String?                @map("released_to_dispatch_by_user_id") @db.Uuid
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")

  company              Company                         @relation(fields: [companyId], references: [id])
  branch               Branch?                         @relation(fields: [branchId], references: [id])
  salesOrderItem       SalesOrderItem?                 @relation(fields: [salesOrderItemId], references: [id])
  product              Product                         @relation(fields: [productId], references: [id])
  bom                  Bom?                            @relation(fields: [bomId], references: [id])
  requestedBy          User                            @relation("ProductionOrderRequestedBy", fields: [requestedByUserId], references: [id])
  releasedToDispatchBy User?                           @relation("ProductionOrderReleasedToDispatchBy", fields: [releasedToDispatchByUserId], references: [id])
  lots                 Lot[]
  jobOrders            JobOrder[]
  stageTransactions    ProductionStageTransaction[]
  qcInspections        QcInspection[]
  materialRequests     MaterialRequest[]
  quantityChanges      ProductionOrderQuantityChange[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([salesOrderItemId])
  @@index([productId])
  @@map("production_orders")
}

enum ProductionOrderQuantityChangeType {
  EXTRA_PRODUCTION
}

// Append-only history of quantity added to a Production Order after lots
// already exist (2026-09-29). One Sales Order line keeps ONE Production
// Order; extra quantity is added to it here (only once everything already
// planned has been processed), never as a second, duplicate order.
model ProductionOrderQuantityChange {
  id                String                            @id @default(uuid()) @db.Uuid
  companyId         String                            @map("company_id") @db.Uuid
  productionOrderId String                            @map("production_order_id") @db.Uuid
  changeType        ProductionOrderQuantityChangeType @map("change_type")
  previousQuantity  Decimal                           @map("previous_quantity") @db.Decimal(18, 4)
  addedQuantity     Decimal                           @map("added_quantity") @db.Decimal(18, 4)
  newQuantity       Decimal                           @map("new_quantity") @db.Decimal(18, 4)
  reason            String?
  createdByUserId   String                            @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                          @default(now()) @map("created_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  createdBy       User            @relation(fields: [createdByUserId], references: [id])

  @@index([productionOrderId])
  @@index([companyId])
  @@map("production_order_quantity_changes")
}

enum LotStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  // Terminal — this lot's full quantity was consumed by a SPLIT/MERGE
  // LotRelation. Never re-activated; genealogy is what remains traceable.
  SPLIT
  MERGED
  CANCELLED
}

// A Lot is first-class, not a string on another table — it has its own
// lifecycle, and (via LotRelation below) its own genealogy.
model Lot {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  productionOrderId String    @map("production_order_id") @db.Uuid
  lotNumber         String    @map("lot_number")
  // Immutable after creation except via a recorded split/merge event, which
  // closes this lot (status -> SPLIT/MERGED) rather than mutating it.
  quantity          Decimal   @map("quantity") @db.Decimal(18, 4)
  uomId             String    @map("uom_id") @db.Uuid
  status            LotStatus @default(PLANNED)
  // CACHE ONLY, refreshed whenever a ProductionStageTransaction posts for
  // this lot — never the source of truth for correctness-critical logic
  // (that's always "which JobOrders for this lot have no onward transaction
  // yet"). This is deliberate: it's what lets a future multi-position
  // (parallel-stage) upgrade be additive rather than a breaking migration —
  // see PRODUCTION_MODULE_DESIGN.md §6.
  currentStageId    String?   @map("current_stage_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company           Company                      @relation(fields: [companyId], references: [id])
  branch            Branch?                      @relation(fields: [branchId], references: [id])
  productionOrder   ProductionOrder              @relation(fields: [productionOrderId], references: [id])
  uom               UnitOfMeasure                @relation(fields: [uomId], references: [id])
  currentStage      ProductionStage?             @relation("LotCurrentStage", fields: [currentStageId], references: [id])
  createdBy         User                         @relation("LotCreatedBy", fields: [createdByUserId], references: [id])
  asParentRelations LotRelation[]                @relation("LotRelationParent")
  asChildRelations  LotRelation[]                @relation("LotRelationChild")
  jobOrders         JobOrder[]
  stageTransactions ProductionStageTransaction[]
  qcInspections     QcInspection[]
  variantBreakdown  LotVariantBreakdown[]
  materialRequests  MaterialRequest[]
  // Informational only (Extra Dispatch Quantity, 2026-09-30) — see
  // DispatchItem.sourceLotId's own comment.
  dispatchItems     DispatchItem[]

  @@unique([companyId, lotNumber])
  @@index([productionOrderId])
  @@index([companyId, status])
  @@map("lots")
}

// Purely informational size/color breakdown of a Lot's own flat `quantity` —
// entered once at Lot creation (auto-suggested from the linked Sales Order's
// own real SalesOrderItemBreakdown when one exists, manual otherwise) so a
// floor worker can see exactly which sizes/colors make up the number they're
// handling at any stage. Deliberately NOT tracked per-variant through
// completed/rejected/damaged/forwarded/qcPassed — every JobOrder quantity
// accumulator stays a flat aggregate exactly as before; this table is read
// (never decremented) by the Stage Transfer Slip and the Lot's own detail
// page only.
model LotVariantBreakdown {
  id               String   @id @default(uuid()) @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Decimal  @map("quantity") @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  lot            Lot            @relation(fields: [lotId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([lotId, productVariantId])
  @@map("lot_variant_breakdowns")
}

enum LotRelationType {
  SPLIT
  MERGE
}

// Genealogy as a join table, not a single parentLotId column — a single FK
// can't represent MERGE (many parents -> one child). Full ancestry/descent
// in either direction is a plain recursive walk over this table; no separate
// materialized genealogy table needed.
model LotRelation {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  parentLotId       String          @map("parent_lot_id") @db.Uuid
  childLotId        String          @map("child_lot_id") @db.Uuid
  relationType      LotRelationType @map("relation_type")
  // The slice of the parent that went into this specific child. Split:
  // sum(children) must equal the parent's quantity exactly, in one
  // transaction (all-or-nothing — no partial split in V1). Merge: every
  // named parent is fully consumed; sum(parents) must equal the new child's
  // quantity exactly.
  quantity          Decimal         @map("quantity") @db.Decimal(18, 4)
  reason            String?
  performedByUserId String          @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime        @default(now()) @map("performed_at")

  company     Company @relation(fields: [companyId], references: [id])
  parentLot   Lot     @relation("LotRelationParent", fields: [parentLotId], references: [id])
  childLot    Lot     @relation("LotRelationChild", fields: [childLotId], references: [id])
  performedBy User    @relation("LotRelationPerformedBy", fields: [performedByUserId], references: [id])

  @@index([parentLotId])
  @@index([childLotId])
  @@map("lot_relations")
}

enum JobOrderStatus {
  PENDING
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  ON_HOLD
  CANCELLED
}

// Generic by construction: Lot x whatever ProductionStage a company has
// configured. Replaces every stage-named table (no CuttingPlan/
// SewingProduction/FinishingRecord) — this is the ONLY work-tracking header,
// for any stage, at any company. Auto-created (never hand-created) by the
// service layer whenever a ProductionStageTransaction posts a quantity into
// a stage — including the very first stage, a rework return, and a
// QC-driven revert, all through the same mechanism.
model JobOrder {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  productionOrderId String             @map("production_order_id") @db.Uuid
  lotId             String             @map("lot_id") @db.Uuid
  productionStageId String             @map("production_stage_id") @db.Uuid
  // Deterministic display code ({lotNumber}-{stageCode}-{n}), not a
  // fiscal-year document sequence.
  jobNumber         String             @map("job_number")
  // The JobOrder this one's input came from — null only for a lot's very
  // first stage entry.
  sourceJobOrderId  String?            @map("source_job_order_id") @db.Uuid
  productionLineId  String?            @map("production_line_id") @db.Uuid
  plannedQuantity   Decimal            @map("planned_quantity") @db.Decimal(18, 4)
  // Guarded accumulators — completed+rejected+damaged <= planned, enforced
  // by a service-layer read-verify-write inside one transaction AND a
  // Postgres CHECK constraint as a hard backstop (see migration SQL; this
  // 3-column constraint can't be expressed as the single-column guarded
  // updateMany idiom used everywhere else in this codebase).
  completedQuantity Decimal            @default(0) @map("completed_quantity") @db.Decimal(18, 4)
  rejectedQuantity  Decimal            @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity   Decimal            @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  // Explicitly-recorded extra pieces beyond plannedQuantity (only on a stage
  // with allowsExtraQuantity, e.g. Cutting). The quantity CHECK constraint is
  // completed + rejected + damaged <= planned + extra, so extras are
  // auditable and forwardable like any other completed piece.
  extraQuantity     Decimal            @default(0) @map("extra_quantity") @db.Decimal(18, 4)
  // How much of completedQuantity has already been pushed to the next stage
  // — forwarding is an explicit action, never automatic on every progress
  // entry (this is what makes partial, continuous hand-off between stages
  // representable). Guarded: forwarded <= completed.
  forwardedQuantity Decimal            @default(0) @map("forwarded_quantity") @db.Decimal(18, 4)
  // Guarded: qcPassed <= completed — prevents double-QC-ing the same units.
  qcPassedQuantity  Decimal            @default(0) @map("qc_passed_quantity") @db.Decimal(18, 4)
  status            JobOrderStatus     @default(PENDING)
  priority          ProductionPriority @default(NORMAL)
  plannedStartAt    DateTime?          @map("planned_start_at")
  plannedEndAt      DateTime?          @map("planned_end_at")
  actualStartAt     DateTime?          @map("actual_start_at")
  actualEndAt       DateTime?          @map("actual_end_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  company              Company                      @relation(fields: [companyId], references: [id])
  productionOrder      ProductionOrder              @relation(fields: [productionOrderId], references: [id])
  lot                  Lot                          @relation(fields: [lotId], references: [id])
  productionStage      ProductionStage              @relation(fields: [productionStageId], references: [id])
  sourceJobOrder       JobOrder?                    @relation("JobOrderChain", fields: [sourceJobOrderId], references: [id])
  nextJobOrders        JobOrder[]                   @relation("JobOrderChain")
  productionLine       ProductionLine?              @relation(fields: [productionLineId], references: [id])
  assignments          JobOrderAssignment[]
  progressEntries      JobOrderProgressEntry[]
  incomingTransactions ProductionStageTransaction[] @relation("StageTransactionTo")
  outgoingTransactions ProductionStageTransaction[] @relation("StageTransactionFrom")
  qcInspections        QcInspection[]
  jobWorkOrders        JobWorkOrder[]
  pieceRateEarnings    PieceRateEarning[]
  materialRequests     MaterialRequest[]

  // Not unique on (lotId, productionStageId) — a lot can legitimately
  // revisit the same stage after rework; each revisit is a NEW row, never an
  // update to an old one (history is never overwritten).
  @@index([lotId, productionStageId])
  @@index([productionOrderId])
  @@index([companyId, status])
  @@index([productionStageId])
  @@map("job_orders")
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REASSIGNED
  CANCELLED
}

// Multiple workers per JobOrder falls out of this directly — "multiple
// Cutting Masters on one lot" is just multiple rows here against the same
// Cutting-stage JobOrder. No separate "CuttingMaster" concept anywhere.
model JobOrderAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  jobOrderId       String           @map("job_order_id") @db.Uuid
  // Reuses the existing Employee master — NOT User. Tracking who did the
  // work never requires that person to have a login (see
  // PRODUCTION_MODULE_DESIGN.md §7).
  employeeId       String           @map("employee_id") @db.Uuid
  // Soft-validated (sum across a JobOrder's assignments should not exceed
  // plannedQuantity) at assignment time — not DB-enforced, since assignments
  // can be freely rebalanced before work actually starts.
  assignedQuantity Decimal          @map("assigned_quantity") @db.Decimal(18, 4)
  status           AssignmentStatus @default(ASSIGNED)
  assignedByUserId String           @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime         @default(now()) @map("assigned_at")
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  // Expected time window for this worker's share (2026-09-28). Nullable at
  // the DB level (pre-existing rows); required for new assignments by Zod.
  expectedStartAt  DateTime?        @map("expected_start_at")
  expectedEndAt    DateTime?        @map("expected_end_at")

  // Piece-Rate Job Rate Snapshot (2026-09-18) — resolved and frozen ONCE by
  // assignWorker() via resolvePieceRate(), never recomputed even if the Rate
  // Card changes later. All nullable/defaulted: every pre-existing assignment
  // row, and every assignment for a FIXED_SALARY employee, simply has none of
  // this set. One rate applies per assignment (a re-assignment/override just
  // updates these same columns, itself audit-logged) — deliberately not a
  // child table.
  productionOperationId String?             @map("production_operation_id") @db.Uuid
  resolvedRate          Decimal?            @map("resolved_rate") @db.Decimal(18, 4)
  resolvedRateSource    RateCardRateSource? @map("resolved_rate_source")
  resolvedRateCardId    String?             @map("resolved_rate_card_id") @db.Uuid
  rateSnapshotAt        DateTime?           @map("rate_snapshot_at")
  // Authorized override — resolvedRate/resolvedRateSource above are left
  // untouched by an override; getEffectiveAssignmentRate() picks
  // overriddenRate whenever rateOverridden is true. Gated by the piece_rate
  // "override" RBAC action, distinct from ordinary production.edit.
  rateOverridden        Boolean             @default(false) @map("rate_overridden")
  overriddenRate        Decimal?            @map("overridden_rate") @db.Decimal(18, 4)
  overrideReason        String?             @map("override_reason")
  overriddenByUserId    String?             @map("overridden_by_user_id") @db.Uuid
  overriddenAt          DateTime?           @map("overridden_at")

  jobOrder            JobOrder                @relation(fields: [jobOrderId], references: [id])
  employee            Employee                @relation("JobOrderAssignmentEmployee", fields: [employeeId], references: [id])
  assignedBy          User                    @relation("JobOrderAssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  progressEntries     JobOrderProgressEntry[]
  productionOperation ProductionOperation?    @relation(fields: [productionOperationId], references: [id])
  resolvedRateCard    PieceRateCard?          @relation(fields: [resolvedRateCardId], references: [id])
  overriddenBy        User?                   @relation("JobOrderAssignmentRateOverriddenBy", fields: [overriddenByUserId], references: [id])
  pieceRateEarnings   PieceRateEarning[]

  @@index([jobOrderId])
  @@index([employeeId])
  @@map("job_order_assignments")
}

// Append-only worker-level logging — never edited or deleted. A genuine
// data-entry mistake is corrected with a NEW isAdjustment=true row (the only
// kind allowed to carry a negative quantity), mirroring
// InventoryTransaction's own signed-reversal convention, rather than ever
// touching an existing row.
model JobOrderProgressEntry {
  id                   String                      @id @default(uuid()) @db.Uuid
  jobOrderId           String                      @map("job_order_id") @db.Uuid
  jobOrderAssignmentId String?                     @map("job_order_assignment_id") @db.Uuid
  // Nullable specifically for isAdjustment=true rows: a correction entry has
  // no real "worker" to attribute it to (recordAdjustmentEntry resolves the
  // acting User's own linked Employee via User.employeeId, which most
  // non-floor accounts — e.g. Super Admin — legitimately have none of).
  // Every non-adjustment row still always carries a real Employee.
  employeeId           String?                     @map("employee_id") @db.Uuid
  // Who is logged in and clicked save — may differ from employeeId (the
  // supervisor-entry model recommended for V1; see
  // PRODUCTION_MODULE_DESIGN.md §7).
  recordedByUserId     String                      @map("recorded_by_user_id") @db.Uuid
  completedQuantity    Decimal                     @default(0) @map("completed_quantity") @db.Decimal(18, 4)
  rejectedQuantity     Decimal                     @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity      Decimal                     @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  // Explicit extra pieces (only on an allowsExtraQuantity stage). Part of
  // completedQuantity, not additional to it — completed 105 with extra 5 on a
  // 100-piece assignment consumes exactly the 100 assigned.
  extraQuantity        Decimal                     @default(0) @map("extra_quantity") @db.Decimal(18, 4)
  isAdjustment         Boolean                     @default(false) @map("is_adjustment")
  remarks              String?
  startedAt            DateTime?                   @map("started_at")
  endedAt              DateTime?                   @map("ended_at")
  // Discriminates the existing supervisor-direct path (recordProgressEntry,
  // applied immediately, no approval) from the new worker self-entry path
  // (submitSelfProgressEntry, held PENDING until a Supervisor decides).
  // Every pre-existing row and every future supervisor-entered row is
  // SUPERVISOR/NOT_REQUIRED — this table's original append-only, always-
  // final behavior is completely unchanged for that path.
  enteredBy            ProgressEntrySource         @default(SUPERVISOR) @map("entered_by")
  approvalStatus       ProgressEntryApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  approvalRemark       String?                     @map("approval_remark")
  approvedByUserId     String?                     @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?                   @map("approved_at")
  createdAt            DateTime                    @default(now()) @map("created_at")
  // New — the table was purely append-only before; a PENDING self-entry can
  // now be edited once by a Supervisor prior to their approve/reject decision.
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  jobOrder           JobOrder            @relation(fields: [jobOrderId], references: [id])
  jobOrderAssignment JobOrderAssignment? @relation(fields: [jobOrderAssignmentId], references: [id])
  employee           Employee?           @relation("JobOrderProgressEntryEmployee", fields: [employeeId], references: [id])
  recordedBy         User                @relation("JobOrderProgressEntryRecordedBy", fields: [recordedByUserId], references: [id])
  approvedBy         User?               @relation("JobOrderProgressEntryApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([jobOrderId])
  @@index([employeeId])
  @@index([approvalStatus])
  @@map("job_order_progress_entries")
}

enum ProgressEntrySource {
  SUPERVISOR
  SELF
}

enum ProgressEntryApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum StageTransactionType {
  FORWARD
  REWORK
  ADJUSTMENT
}

// The single append-only ledger — never edited, never deleted. Everything
// else (a lot's current position, a JobOrder's existence) is derived from
// this table; it is the actual source of truth in this module, the same
// role InventoryTransaction plays for stock.
model ProductionStageTransaction {
  id                    String               @id @default(uuid()) @db.Uuid
  companyId             String               @map("company_id") @db.Uuid
  productionOrderId     String               @map("production_order_id") @db.Uuid
  lotId                 String               @map("lot_id") @db.Uuid
  fromJobOrderId        String?              @map("from_job_order_id") @db.Uuid
  toJobOrderId          String               @map("to_job_order_id") @db.Uuid
  // Denormalized directly onto the transaction for fast reporting — same
  // rationale already used for FabricRoll.rollNumber-style denormalization
  // elsewhere in this schema.
  fromProductionStageId String?              @map("from_production_stage_id") @db.Uuid
  toProductionStageId   String               @map("to_production_stage_id") @db.Uuid
  transactionType       StageTransactionType @map("transaction_type")
  // Always positive — direction is expressed by from/to, not sign.
  quantity              Decimal              @map("quantity") @db.Decimal(18, 4)
  // Precomputed at insert (toStage.sequence < fromStage.sequence) for fast
  // querying/reporting.
  isBackward            Boolean              @default(false) @map("is_backward")
  // Required by the service layer whenever isBackward=true — not DB-enforced
  // (a conditionally-required field isn't expressible as a plain NOT NULL).
  revertReason          String?              @map("revert_reason")
  performedByUserId     String               @map("performed_by_user_id") @db.Uuid
  performedAt           DateTime             @default(now()) @map("performed_at")
  notes                 String?

  company                  Company          @relation(fields: [companyId], references: [id])
  productionOrder          ProductionOrder  @relation(fields: [productionOrderId], references: [id])
  lot                      Lot              @relation(fields: [lotId], references: [id])
  fromJobOrder             JobOrder?        @relation("StageTransactionFrom", fields: [fromJobOrderId], references: [id])
  toJobOrder               JobOrder         @relation("StageTransactionTo", fields: [toJobOrderId], references: [id])
  fromProductionStage      ProductionStage? @relation("StageTransactionFromStage", fields: [fromProductionStageId], references: [id])
  toProductionStage        ProductionStage  @relation("StageTransactionToStage", fields: [toProductionStageId], references: [id])
  performedBy              User             @relation("ProductionStageTransactionPerformedBy", fields: [performedByUserId], references: [id])
  qcInspectionsCausingThis QcInspection[]   @relation("QcInspectionReworkTransaction")

  @@index([lotId, performedAt])
  @@index([toProductionStageId])
  @@index([productionOrderId])
  @@map("production_stage_transactions")
}

enum QcResult {
  PASS
  PARTIAL_PASS
  FAIL
}

// Generic by construction: keyed on jobOrderId, never a stage name. No
// SewingQC/FinishingQC-style tables. A Fail or Partial-Pass creates a new
// ProductionStageTransaction (REWORK) using the exact same target-stage
// validation function as a manual revert — one mechanism, not two.
model QcInspection {
  id                       String   @id @default(uuid()) @db.Uuid
  companyId                String   @map("company_id") @db.Uuid
  productionOrderId        String   @map("production_order_id") @db.Uuid
  lotId                    String   @map("lot_id") @db.Uuid
  jobOrderId               String   @map("job_order_id") @db.Uuid
  inspectedQuantity        Decimal  @map("inspected_quantity") @db.Decimal(18, 4)
  acceptedQuantity         Decimal  @map("accepted_quantity") @db.Decimal(18, 4)
  rejectedQuantity         Decimal  @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity          Decimal  @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  result                   QcResult
  reworkStageTransactionId String?  @map("rework_stage_transaction_id") @db.Uuid
  inspectorUserId          String   @map("inspector_user_id") @db.Uuid
  inspectedAt              DateTime @default(now()) @map("inspected_at")
  remarks                  String?

  company                Company                     @relation(fields: [companyId], references: [id])
  productionOrder        ProductionOrder             @relation(fields: [productionOrderId], references: [id])
  lot                    Lot                         @relation(fields: [lotId], references: [id])
  jobOrder               JobOrder                    @relation(fields: [jobOrderId], references: [id])
  reworkStageTransaction ProductionStageTransaction? @relation("QcInspectionReworkTransaction", fields: [reworkStageTransactionId], references: [id])
  inspector              User                        @relation("QcInspectionInspector", fields: [inspectorUserId], references: [id])
  defects                QcDefect[]

  @@index([jobOrderId])
  @@index([lotId])
  @@map("qc_inspections")
}

model QcDefect {
  id             String  @id @default(uuid()) @db.Uuid
  qcInspectionId String  @map("qc_inspection_id") @db.Uuid
  defectTypeId   String  @map("defect_type_id") @db.Uuid
  quantity       Decimal @map("quantity") @db.Decimal(18, 4)
  severity       String?
  remarks        String?

  qcInspection QcInspection @relation(fields: [qcInspectionId], references: [id])
  defectType   DefectType   @relation(fields: [defectTypeId], references: [id])

  @@index([qcInspectionId])
  @@map("qc_defects")
}

// Company-configurable defect catalogue — same shape as ProductionStage/
// Color/Size etc.
model DefectType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  qcDefects QcDefect[]

  @@unique([companyId, code])
  @@map("defect_types")
}

enum JobWorkOrderStatus {
  ISSUED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum JobWorkReceiptStatus {
  COMPLETED
  PARTIALLY_REVERSED
  CANCELLED
}

enum JobWorkOrderRateStatus {
  RESOLVED
  UNRESOLVED
  OVERRIDDEN
}

// Discriminates who actually submitted a JobWorkReceipt — INTERNAL_SUPERVISOR
// (today's only path, unchanged) vs. EXTERNAL_UNIT_USER (the vendor's own
// portal login reporting its own output). Mirrors ProgressEntrySource's own
// SUPERVISOR/SELF discriminator on the internal side.
enum JobWorkReceiptSource {
  INTERNAL_SUPERVISOR
  EXTERNAL_UNIT_USER
}

// Mirrors ProgressEntryApprovalStatus exactly. An EXTERNAL_UNIT_USER
// submission (when ProductionSettings.externalEntryBy allows it) sits PENDING
// with no accumulator/JobOrder quantity change until an internal Supervisor
// decides — the same "worker's own unverified claim must never count as real
// production before someone checks it" discipline as the internal self-entry
// flow.
enum JobWorkReceiptApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// External job-work: an alternative fulfillment path for an existing
// JobOrder's completed/rejected/damaged accumulators — the same three
// columns internal JobOrderProgressEntry recording already drives, guarded
// by the same applyJobOrderQuantityDelta() in job-order.service.ts. This is
// deliberately NOT a parallel production system: once a JobWorkReceipt
// applies its delta onto the parent JobOrder, the already-built
// forwardJobOrder()/recordQcInspection() become usable on that quantity for
// free, with zero changes to either. issuedQuantity draws down the parent
// JobOrder's "remaining/unprocessed" pool (plannedQuantity - completed -
// rejected - damaged), the exact same pool internal Assign+Progress draws
// from — job-work-out is an external alternative to that, not a different
// concept.
model JobWorkOrder {
  id                       String                 @id @default(uuid()) @db.Uuid
  companyId                String                 @map("company_id") @db.Uuid
  branchId                 String?                @map("branch_id") @db.Uuid
  jobWorkNumber            String                 @map("job_work_number")
  contractorId             String                 @map("contractor_id") @db.Uuid
  jobOrderId               String                 @map("job_order_id") @db.Uuid
  // Piece-Rate/External-costing (2026-09-18) — set explicitly at creation
  // (a JobWorkOrder's single stage may have more than one configured
  // Operation, so this is never inferred). Nullable: an unresolved rate never
  // blocks WIP issuance (business continuity) — it just flags UNRESOLVED for
  // later correction. resolvedRate is a snapshot, frozen at creation, never
  // recomputed if the Rate Card later changes.
  productionOperationId    String?                @map("production_operation_id") @db.Uuid
  resolvedRate             Decimal?               @map("resolved_rate") @db.Decimal(18, 4)
  rateResolutionStatus     JobWorkOrderRateStatus @default(UNRESOLVED) @map("rate_resolution_status")
  rateSourceId             String?                @map("rate_source_id") @db.Uuid
  issuedQuantity           Decimal                @map("issued_quantity") @db.Decimal(18, 4)
  uomId                    String                 @map("uom_id") @db.Uuid
  issueDate                DateTime               @map("issue_date") @db.Date
  expectedCompletionDate   DateTime?              @map("expected_completion_date") @db.Date
  status                   JobWorkOrderStatus     @default(ISSUED)
  statusBeforeHold         JobWorkOrderStatus?    @map("status_before_hold")
  // Guarded accumulators — the exact PurchaseOrderItem.receivedQuantity
  // idiom, capped at issuedQuantity via a guarded updateMany, never a
  // plain read-then-write.
  receivedQuantity         Decimal                @default(0) @map("received_quantity") @db.Decimal(18, 4)
  rejectedQuantity         Decimal                @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity          Decimal                @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  // Multi-stage job work + cost sheet (2026-09-28). The covered stages and
  // their frozen rates live in JobWorkOrderStage; these totals are
  // snapshotted at creation and never recomputed from master data, so a
  // later Style/Design cost change can't alter this historical record.
  stageCostTotal           Decimal                @default(0) @map("stage_cost_total") @db.Decimal(18, 2)
  extraCostTotal           Decimal                @default(0) @map("extra_cost_total") @db.Decimal(18, 2)
  totalCost                Decimal                @default(0) @map("total_cost") @db.Decimal(18, 2)
  // Required only when the covered range ends on an isFinal stage — the
  // received pieces then land in Finished Goods at this warehouse.
  finishedGoodsWarehouseId String?                @map("finished_goods_warehouse_id") @db.Uuid
  remarks                  String?
  requestedByUserId        String                 @map("requested_by_user_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  company                Company                   @relation(fields: [companyId], references: [id])
  branch                 Branch?                   @relation(fields: [branchId], references: [id])
  contractor             Contractor                @relation(fields: [contractorId], references: [id])
  jobOrder               JobOrder                  @relation(fields: [jobOrderId], references: [id])
  uom                    UnitOfMeasure             @relation(fields: [uomId], references: [id])
  requestedBy            User                      @relation(fields: [requestedByUserId], references: [id])
  materials              JobWorkOrderMaterial[]
  receipts               JobWorkReceipt[]
  coveredStages          JobWorkOrderStage[]
  extraCharges           JobWorkOrderExtraCharge[]
  finishedGoodsWarehouse Warehouse?                @relation("JobWorkOrderFgWarehouse", fields: [finishedGoodsWarehouseId], references: [id])
  productionOperation    ProductionOperation?      @relation(fields: [productionOperationId], references: [id])
  pieceRateEarnings      PieceRateEarning[]

  @@unique([companyId, jobWorkNumber])
  @@index([companyId, status])
  @@index([contractorId])
  @@index([jobOrderId])
  @@map("job_work_orders")
}

// Optional raw-material lines accompanying the WIP goods sent to the
// contractor (e.g. trims/extra fabric) — a genuinely separate concern from
// the WIP quantity itself, since these DO have a real StockBalance row to
// decrement. Each line posts one JOB_WORK_ISSUE ledger transaction; no
// return-of-unused-material flow in this pass (see the enum comment).
model JobWorkOrderMaterial {
  id             String  @id @default(uuid()) @db.Uuid
  jobWorkOrderId String  @map("job_work_order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Decimal @db.Decimal(18, 4)
  uomId          String  @map("uom_id") @db.Uuid
  warehouseId    String  @map("warehouse_id") @db.Uuid
  fabricRollId   String? @map("fabric_roll_id") @db.Uuid
  notes          String?

  jobWorkOrder JobWorkOrder  @relation(fields: [jobWorkOrderId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  uom          UnitOfMeasure @relation(fields: [uomId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  fabricRoll   FabricRoll?   @relation(fields: [fabricRollId], references: [id])

  @@map("job_work_order_materials")
}

// Mirrors GoodsReceipt's shape exactly: one JobWorkOrder can have several
// receipts (partial/multi-shipment return from the contractor). receiptNumber
// is a simple "<jobWorkNumber>-R<n>" computed at create time, not a global
// atomic document-number sequence — mirrors SampleVersion's own
// scoped-to-parent numbering, since this is sub-document numbering, not a
// standalone business document.
model JobWorkReceipt {
  id                String                       @id @default(uuid()) @db.Uuid
  companyId         String                       @map("company_id") @db.Uuid
  jobWorkOrderId    String                       @map("job_work_order_id") @db.Uuid
  receiptNumber     String                       @map("receipt_number")
  receivedDate      DateTime                     @map("received_date") @db.Date
  receivedQuantity  Decimal                      @map("received_quantity") @db.Decimal(18, 4)
  rejectedQuantity  Decimal                      @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  damagedQuantity   Decimal                      @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  status            JobWorkReceiptStatus         @default(COMPLETED)
  remarks           String?
  receivedByUserId  String                       @map("received_by_user_id") @db.Uuid
  // CF-5: no branchId field exists on this model at all, so this is
  // naturally company-only already — see StockMovement.idempotencyKey for
  // why company-only (not branch-inclusive) is the deliberate choice anyway.
  idempotencyKey    String?                      @map("idempotency_key")
  // External Unit User (2026-09-18) — who actually submitted this receipt
  // and whether it's still awaiting an internal Supervisor's decision.
  // submittedBySource/approvalStatus default to the pre-existing behavior
  // (INTERNAL_SUPERVISOR/NOT_REQUIRED) for every historical row and every
  // ordinary internal-submitted receipt going forward — nothing changes for
  // that path. submittedByUserId is distinct from receivedByUserId
  // ("who received it internally," which for a PENDING external submission
  // is only populated once approved).
  submittedBySource JobWorkReceiptSource         @default(INTERNAL_SUPERVISOR) @map("submitted_by_source")
  approvalStatus    JobWorkReceiptApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  approvalRemark    String?                      @map("approval_remark")
  approvedByUserId  String?                      @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?                    @map("approved_at")
  submittedByUserId String?                      @map("submitted_by_user_id") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at")

  company           Company            @relation(fields: [companyId], references: [id])
  jobWorkOrder      JobWorkOrder       @relation(fields: [jobWorkOrderId], references: [id])
  receivedBy        User               @relation(fields: [receivedByUserId], references: [id])
  approvedBy        User?              @relation("JobWorkReceiptApprovedBy", fields: [approvedByUserId], references: [id])
  submittedBy       User?              @relation("JobWorkReceiptSubmittedBy", fields: [submittedByUserId], references: [id])
  pieceRateEarnings PieceRateEarning[]

  @@unique([companyId, jobWorkOrderId, receiptNumber])
  @@unique([companyId, idempotencyKey])
  @@index([jobWorkOrderId])
  @@map("job_work_receipts")
}

// Only GOODS_RECEIPT and GOODS_RECEIPT_REVERSAL are reachable by Purchasing —
// PRODUCTION_RECEIPT/DAMAGE are Phase 5C's own, ADJUSTMENT/STOCK_TRANSFER/
// RETURN_TO_SUPPLIER are StockMovement's (Phase 6), DISPATCH is Phase 8's own.
// OPENING_BALANCE's manual entry point is explicitly deferred (see CLAUDE.md).
enum InventoryTransactionType {
  OPENING_BALANCE
  GOODS_RECEIPT
  GOODS_RECEIPT_REVERSAL
  MATERIAL_ISSUE
  PRODUCTION_RECEIPT
  // Fully-damaged production quantity posted into a REJECT-type warehouse —
  // repairable damage never touches inventory at all, it's purely a backward
  // ProductionStageTransaction (see PRODUCTION_MODULE_DESIGN.md §6).
  DAMAGE
  ADJUSTMENT
  STOCK_TRANSFER
  // Stock leaving a warehouse back to a supplier — the physical/stock side
  // only; a supplier credit note is a Phase 7 (Accounts) concept that
  // doesn't exist yet, deliberately not modeled here.
  RETURN_TO_SUPPLIER
  // Finished-Goods stock leaving the warehouse against a confirmed Dispatch
  // (Phase 8) — always a negative quantity, posted only at Confirm Dispatch
  // time (never at Draft/Packed), matching every other module's "post-time,
  // not draft-time" ledger discipline.
  DISPATCH
  // Raw-material lines handed to an external job-work contractor alongside
  // a JobOrder's WIP quantity (see JobWorkOrder) — the WIP quantity itself
  // never posts here, since it has no StockBalance row to decrement (its
  // location is tracked structurally via the JobOrder/stage graph, not the
  // inventory ledger).
  JOB_WORK_ISSUE
  // Posted when a Job Work Order with zero receipts against it is cancelled
  // — returns its issued raw-material lines to stock. Deliberately a
  // dedicated reversal type (matching GOODS_RECEIPT_REVERSAL's precedent)
  // rather than reusing JOB_WORK_ISSUE with a flipped sign, so the ledger
  // itself makes the cancellation-driven return legible.
  JOB_WORK_ISSUE_REVERSAL
}

// Append-only, source of truth — no delete column, no edit path, ever.
// Corrections are always a new compensating row, never an update to an
// existing one (the project's established ledger discipline).
model InventoryTransaction {
  id                  String                   @id @default(uuid()) @db.Uuid
  companyId           String                   @map("company_id") @db.Uuid
  branchId            String?                  @map("branch_id") @db.Uuid
  productId           String                   @map("product_id") @db.Uuid
  warehouseId         String                   @map("warehouse_id") @db.Uuid
  warehouseLocationId String?                  @map("warehouse_location_id") @db.Uuid
  transactionType     InventoryTransactionType @map("transaction_type")
  // Signed: positive for a receipt, negative for a reversal/issue.
  quantity            Decimal                  @map("quantity") @db.Decimal(18, 4)
  // Polymorphic discriminator — reuses the existing RelatedModule enum
  // instead of inventing a parallel one, matching the Attachment/AuditLog
  // convention already established for this class of table.
  referenceModule     RelatedModule            @map("reference_module")
  referenceRecordId   String                   @map("reference_record_id") @db.Uuid
  fabricRollId        String?                  @map("fabric_roll_id") @db.Uuid
  performedByUserId   String                   @map("performed_by_user_id") @db.Uuid
  performedAt         DateTime                 @default(now()) @map("performed_at")
  notes               String?

  company               Company                @relation(fields: [companyId], references: [id])
  branch                Branch?                @relation(fields: [branchId], references: [id])
  product               Product                @relation(fields: [productId], references: [id])
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  warehouseLocation     WarehouseLocation?     @relation(fields: [warehouseLocationId], references: [id])
  fabricRoll            FabricRoll?            @relation(fields: [fabricRollId], references: [id])
  performedBy           User                   @relation("InventoryTransactionPerformedBy", fields: [performedByUserId], references: [id])
  materialSubstitutions MaterialSubstitution[]

  @@index([companyId, productId, warehouseId])
  @@index([referenceModule, referenceRecordId])
  @@index([fabricRollId])
  @@map("inventory_transactions")
}

// Derived cache — upserted in the SAME transaction as every InventoryTransaction
// insert that justifies it, never computed by summing the ledger at read time.
model StockBalance {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@map("stock_balances")
}

// A single unified header for the three remaining Phase 6 stock-movement
// documents (Consolidation decision from Phase 1's architecture doc:
// "material issues/returns/transfers merged into one stock_movements table
// via a movement_type discriminator" — Material Request's own ISSUE already
// has its own dedicated flow and is NOT part of this table). Immutable once
// created, matching every other inventory/financial transactional table in
// this project — no delete/edit column; a mistake is corrected with a new,
// opposite-direction StockMovement, never an update to an existing one.
enum StockMovementType {
  TRANSFER
  ADJUSTMENT
  RETURN_TO_SUPPLIER
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  branchId          String?           @map("branch_id") @db.Uuid
  movementNumber    String            @map("movement_number")
  movementType      StockMovementType @map("movement_type")
  // TRANSFER: the source warehouse. ADJUSTMENT / RETURN_TO_SUPPLIER: the
  // only warehouse involved.
  warehouseId       String            @map("warehouse_id") @db.Uuid
  // TRANSFER only — the destination warehouse.
  toWarehouseId     String?           @map("to_warehouse_id") @db.Uuid
  // RETURN_TO_SUPPLIER only.
  supplierId        String?           @map("supplier_id") @db.Uuid
  // Required for ADJUSTMENT (a stock discrepancy correction should always
  // explain why); optional context for TRANSFER/RETURN_TO_SUPPLIER.
  reason            String?
  remarks           String?
  performedByUserId String            @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime          @default(now()) @map("performed_at")
  // CF-5: see GoodsReceipt.idempotencyKey for the full rationale. Company-only
  // (not branch-inclusive) deliberately — a nullable branchId in a composite
  // unique would let Postgres treat every null-branch row as non-conflicting
  // with every other, silently defeating the protection for exactly the
  // common case (no branch set) this is meant to cover.
  idempotencyKey    String?           @map("idempotency_key")
  createdAt         DateTime          @default(now()) @map("created_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  warehouse   Warehouse           @relation("StockMovementSourceWarehouse", fields: [warehouseId], references: [id])
  toWarehouse Warehouse?          @relation("StockMovementDestinationWarehouse", fields: [toWarehouseId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  performedBy User                @relation("StockMovementPerformedBy", fields: [performedByUserId], references: [id])
  items       StockMovementItem[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, movementType])
  @@index([companyId, warehouseId])
  @@map("stock_movements")
}

model StockMovementItem {
  id                  String  @id @default(uuid()) @db.Uuid
  stockMovementId     String  @map("stock_movement_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  uomId               String  @map("uom_id") @db.Uuid
  // TRANSFER / RETURN_TO_SUPPLIER: always positive (the quantity moved or
  // returned). ADJUSTMENT: signed — positive means stock found on a
  // physical count, negative means shrinkage/write-off.
  quantity            Decimal @db.Decimal(18, 4)
  remarks             String?
  // Which room/section within the SOURCE warehouse this line's stock is
  // coming from — traceability only (passed straight through to the ledger's
  // own existing warehouseLocationId, exactly like GoodsReceiptItem already
  // does), not a stock-availability dimension: StockBalance has no location
  // column, so getAvailableQuantity() stays warehouse-level. The destination
  // side of a TRANSFER has no location field — out of scope for this pass.
  warehouseLocationId String? @map("warehouse_location_id") @db.Uuid

  stockMovement     StockMovement      @relation(fields: [stockMovementId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  uom               UnitOfMeasure      @relation(fields: [uomId], references: [id])
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])

  @@index([stockMovementId])
  @@map("stock_movement_items")
}

// ─────────────────────────────────────────────────────────────
// Dispatch (Phase 8) — the shipping workflow that fulfills a confirmed Sales
// Order: pick which style lines/quantities to ship, pack them into Cartons,
// confirm the shipment (which decrements Finished-Goods stock), and record
// delivery. Deliberately consolidated — no separate PickingList/PackingList
// tables (picking/packing are status states on this one document, matching
// the project's own Material-Request/Stock-Movement consolidation
// precedent) — and deliberately product-level only for the real stock
// check/decrement (the FG ledger has no productVariantId dimension at all,
// same as Production's Lot/JobOrder; CartonItem's own productVariantId is
// informational/for packing-list labeling only, never enforced against
// per-variant stock — see CLAUDE.md for the full reasoning).
// ─────────────────────────────────────────────────────────────

enum DispatchStatus {
  DRAFT
  PACKED
  DISPATCHED
  DELIVERED
  ON_HOLD
  CANCELLED
}

// Extra Dispatch Quantity (2026-09-30) — a Dispatch line may ship more than
// the Sale Order's own remaining ordered quantity (customer request,
// replacement, FOC, sample, promotional, packing rounding, etc.). Mandatory
// whenever a line's own extraDispatchQuantity > 0 (enforced in
// dispatch.service.ts, since the split is computed server-side from a
// cumulative Regular total the client can't itself know in advance).
enum ExtraDispatchReason {
  CUSTOMER_REQUEST
  REPLACEMENT
  FREE_FOC
  SAMPLE
  PROMOTIONAL
  PACKING_ADJUSTMENT
  OTHER
}

// Company-wide Extra Dispatch behavior toggles — a missing row means the
// defaults below, same "single flat row, no backfill" precedent as
// ProductionSettings/ActionDisplaySettings.
model DispatchSettings {
  id                                    String   @id @default(uuid()) @db.Uuid
  companyId                             String   @unique @map("company_id") @db.Uuid
  allowExtraDispatch                    Boolean  @default(true) @map("allow_extra_dispatch")
  extraDispatchApprovalRequired         Boolean  @default(false) @map("extra_dispatch_approval_required")
  // Either threshold, if set, independently triggers the approval gate even
  // when extraDispatchApprovalRequired is false — a company may want "only
  // approve if it's a lot of extra," not every single extra unit.
  extraDispatchApprovalThresholdQty     Int?     @map("extra_dispatch_approval_threshold_qty")
  extraDispatchApprovalThresholdPercent Decimal? @map("extra_dispatch_approval_threshold_percent") @db.Decimal(5, 2)
  createdAt                             DateTime @default(now()) @map("created_at")
  updatedAt                             DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("dispatch_settings")
}

model Dispatch {
  id                   String          @id @default(uuid()) @db.Uuid
  companyId            String          @map("company_id") @db.Uuid
  branchId             String?         @map("branch_id") @db.Uuid
  dispatchNumber       String          @map("dispatch_number")
  // Required — Dispatch always fulfills a real Sales Order; a make-to-stock
  // shipment with no formal order (e.g. straight to a distributor) has no
  // Dispatch path this slice — use a plain StockMovement (STOCK_TRANSFER)
  // if that's ever actually needed. Revisit only if requested.
  salesOrderId         String          @map("sales_order_id") @db.Uuid
  // Denormalized from the order — this table is itself the shipping
  // document of record, same justification as SalesInvoice.customerId.
  customerId           String          @map("customer_id") @db.Uuid
  // The source Finished-Goods warehouse this shipment is issued from.
  warehouseId          String          @map("warehouse_id") @db.Uuid
  dispatchDate         DateTime        @map("dispatch_date") @db.Date
  status               DispatchStatus  @default(DRAFT)
  statusBeforeHold     DispatchStatus? @map("status_before_hold")
  deliveryAddress      String          @map("delivery_address")
  // Kept exactly as-is — plain free-text fallback for a one-off/unmastered
  // transporter, alongside the new forwarderId below (added, not replacing).
  transporterName      String?         @map("transporter_name")
  vehicleNumber        String?         @map("vehicle_number")
  trackingNumber       String?         @map("tracking_number")
  // Forwarder Master integration (2026-10-10) — a live FK, same discipline
  // already used for customerId/warehouseId on this same model: if the
  // Forwarder's own master data (name/phone/address) changes later, a past
  // dispatch shows the current master data, exactly like it already does
  // for Customer. Only the genuinely per-shipment facts below are frozen
  // directly on this row, since those vary per dispatch, not per forwarder.
  forwarderId          String?         @map("forwarder_id") @db.Uuid
  lrNumber             String?         @map("lr_number")
  awbNumber            String?         @map("awb_number")
  driverDetails        String?         @map("driver_details")
  freightCharges       Decimal?        @map("freight_charges") @db.Decimal(18, 2)
  expectedDeliveryDate DateTime?       @map("expected_delivery_date") @db.Date
  shipmentRemarks      String?         @map("shipment_remarks")
  // Stamped only inside confirmDispatch()'s own transaction, the moment the
  // ledger is actually touched — a hard fact, not a status label, that
  // cancelDispatch() checks directly and unconditionally (see
  // dispatch.service.ts) rather than trusting the current status alone,
  // the same lesson this project already learned twice (Sampling's Hold/
  // Resume bug, Purchasing's cancel-from-ON_HOLD bug).
  dispatchedAt         DateTime?       @map("dispatched_at")
  deliveredAt          DateTime?       @map("delivered_at")
  receivedByName       String?         @map("received_by_name")
  requestedByUserId    String          @map("requested_by_user_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  company     Company        @relation(fields: [companyId], references: [id])
  branch      Branch?        @relation(fields: [branchId], references: [id])
  salesOrder  SalesOrder     @relation(fields: [salesOrderId], references: [id])
  customer    Customer       @relation(fields: [customerId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  requestedBy User           @relation("DispatchRequestedBy", fields: [requestedByUserId], references: [id])
  forwarder   Forwarder?     @relation(fields: [forwarderId], references: [id], onDelete: SetNull)
  items       DispatchItem[]
  cartons     Carton[]

  @@unique([companyId, branchId, dispatchNumber])
  @@map("dispatches")
}

model DispatchItem {
  id                      String               @id @default(uuid()) @db.Uuid
  dispatchId              String               @map("dispatch_id") @db.Uuid
  salesOrderItemId        String               @map("sales_order_item_id") @db.Uuid
  productId               String               @map("product_id") @db.Uuid
  // TOTAL physical quantity for this line — regularDispatchQuantity +
  // extraDispatchQuantity, an invariant enforced entirely in
  // dispatch.service.ts (never independently client-supplied; both
  // components are always derived server-side from the split formula).
  // This is the number markPacked()'s carton-sum check and confirmDispatch()'s
  // real FG-stock check both use — unchanged meaning/mechanism from before
  // Extra Dispatch Quantity existed, since it was already "the total to ship."
  dispatchedQuantity      Int                  @map("dispatched_quantity")
  // Extra Dispatch Quantity (2026-09-30) — split of dispatchedQuantity.
  // regularDispatchQuantity is what SalesOrderItem.regularDispatchedQuantity
  // is incremented by (capped at the order's own remaining quantity);
  // extraDispatchQuantity is the remainder, never counted toward Sale Order
  // fulfillment. regularDispatchQuantity + extraDispatchQuantity ===
  // dispatchedQuantity always.
  regularDispatchQuantity Int                  @default(0) @map("regular_dispatch_quantity")
  extraDispatchQuantity   Int                  @default(0) @map("extra_dispatch_quantity")
  // Mandatory whenever extraDispatchQuantity > 0 (service-layer check —
  // Zod can't enforce this alone since the split is computed server-side).
  extraDispatchReason     ExtraDispatchReason? @map("extra_dispatch_reason")
  // Mandatory whenever extraDispatchReason = OTHER (Zod .superRefine(), a
  // pure input-shape rule).
  extraDispatchRemarks    String?              @map("extra_dispatch_remarks")
  // Informational traceability only (2026-09-30) — which Production Lot this
  // line was understood to be fulfilled from at dispatch time. Deliberately
  // NEVER enforced against a real per-lot stock balance: Finished-Goods
  // stock in this schema is pooled at (productId, warehouseId) with no lot
  // dimension on the consumption side (InventoryTransaction has no lotId
  // column at all — see PRODUCTION_MODULE_DESIGN.md). Building genuine
  // lot-level allocation would mean making Production's own finished-goods
  // posting lot-aware everywhere it already isn't; explicitly out of scope
  // here, matching CartonItem.productVariantId's own identical
  // "informational only, never enforced" precedent two models below.
  sourceLotId             String?              @map("source_lot_id") @db.Uuid
  createdAt               DateTime             @default(now()) @map("created_at")

  dispatch       Dispatch       @relation(fields: [dispatchId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  sourceLot      Lot?           @relation(fields: [sourceLotId], references: [id])
  cartonItems    CartonItem[]

  @@index([dispatchId])
  @@index([sourceLotId])
  @@map("dispatch_items")
}

model Carton {
  id            String   @id @default(uuid()) @db.Uuid
  dispatchId    String   @map("dispatch_id") @db.Uuid
  cartonNumber  Int      @map("carton_number")
  // Rollup of its own CartonItems — stored for display convenience, same
  // "stored rollup, not always-live-computed" pattern used elsewhere
  // (SalesOrder.totalAmount, PurchaseOrderItem.receivedQuantity).
  totalQuantity Int      @default(0) @map("total_quantity")
  createdAt     DateTime @default(now()) @map("created_at")

  dispatch Dispatch     @relation(fields: [dispatchId], references: [id])
  items    CartonItem[]

  @@unique([dispatchId, cartonNumber])
  @@map("cartons")
}

model CartonItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartonId         String   @map("carton_id") @db.Uuid
  dispatchItemId   String   @map("dispatch_item_id") @db.Uuid
  // Nullable — only set when the style has generated variants. This is the
  // real color/size packing detail (informational/for packing-list labeling
  // only — never enforced against per-variant stock, see the section
  // comment above).
  productVariantId String?  @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at")

  carton         Carton          @relation(fields: [cartonId], references: [id])
  dispatchItem   DispatchItem    @relation(fields: [dispatchItemId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([cartonId])
  @@index([dispatchItemId])
  @@map("carton_items")
}

// ─────────────────────────────────────────────────────────────
// Barcode Management & Scanning System, Phase 1 (2026-09-29)
//
// A single central registry, not scattered columns — one place for the
// universal resolve endpoint, the print/reprint history, and the management
// screen, at the cost of a polymorphic (entityType, entityId) reference
// validated at the app layer rather than a true DB FK — the same accepted
// tradeoff this schema already uses for Attachment.relatedModule/
// relatedRecordId and InventoryTransaction's optional entity refs.
// Deliberately a NEW enum, not a reuse of RelatedModule — the entity set
// genuinely differs (no SALES_ORDER/etc.; needs the ITEM/SKU split
// RelatedModule doesn't make). Phase 2 (not built yet): GARMENT_PIECE-level
// serialization, EAN-13/UPC/QR formats.
enum BarcodeEntityType {
  FABRIC_ROLL
  PRODUCTION_LOT
  CARTON
  ITEM // raw-material Product
  SKU // ProductVariant
}

enum BarcodeStatus {
  ACTIVE
  DISABLED
}

model Barcode {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  code            String
  entityType      BarcodeEntityType @map("entity_type")
  entityId        String            @map("entity_id") @db.Uuid
  format          String            @default("CODE128")
  status          BarcodeStatus     @default(ACTIVE)
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("BarcodeCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, code])
  @@index([entityType, entityId])
  @@map("barcodes")
}

// ─────────────────────────────────────────────────────────────
// Accounts (Phase 7A — Chart of Accounts, Tax Config, Journal Engine)
//
// First slice of Phase 7. Sales/Purchase Invoices, Payments+Allocations, and
// Expenses are NOT part of this slice — they're later slices that will post
// through the Journal engine built here. Multi-currency is deliberately out
// of scope (JournalLine amounts are base-currency-only), matching the
// project-wide multi-currency-UI deferral already applied to SalesOrder/
// PurchaseOrder.
// ─────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model ChartOfAccount {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  code            String
  name            String
  accountType     AccountType @map("account_type")
  // Self-relation, schema-only for now — no hierarchy UI yet, matching the
  // ProductionStage.parentStageId precedent (column exists, exposed later
  // when actually needed). NOT YET DECIDED: nothing here distinguishes a
  // postable "leaf" account from a rollup "group" account (e.g. a future
  // isGroup/postable flag) — deliberately deferred, not solved, so whichever
  // slice builds the hierarchy UI doesn't rediscover this as a surprise.
  parentAccountId String?     @map("parent_account_id") @db.Uuid
  // Protects control accounts (AR/AP/GST) seeded by prisma/seed.ts from
  // deactivation — checked alongside the JournalLine-reference guard, not a
  // replacement for it.
  isSystemAccount Boolean     @default(false) @map("is_system_account")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company                       Company                     @relation(fields: [companyId], references: [id])
  parentAccount                 ChartOfAccount?             @relation("ChartOfAccountParent", fields: [parentAccountId], references: [id])
  childAccounts                 ChartOfAccount[]            @relation("ChartOfAccountParent")
  journalLines                  JournalLine[]
  expenses                      Expense[]
  customInvoicesAsIncomeAccount CustomInvoice[]
  employeeAdvanceSettlements    EmployeeAdvanceSettlement[]
  purchaseInvoiceDirectLines    PurchaseInvoiceItem[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

model TaxType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company   @relation(fields: [companyId], references: [id])
  rates   TaxRate[]

  @@unique([companyId, code])
  @@map("tax_types")
}

model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  taxTypeId      String    @map("tax_type_id") @db.Uuid
  name           String
  // Matches the existing SampleMaterial.gstPercentage precision precedent —
  // not inventing a new one.
  ratePercentage Decimal   @map("rate_percentage") @db.Decimal(5, 2)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  // Nullable = still the current rate. Service layer rejects a new rate whose
  // [effectiveFrom, effectiveTo) window overlaps an existing active rate for
  // the same taxTypeId — cheap to enforce now, avoids ambiguous data a later
  // slice's "find the effective rate as of date X" logic would mishandle.
  effectiveTo    DateTime? @map("effective_to") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company                    Company                     @relation(fields: [companyId], references: [id])
  taxType                    TaxType                     @relation(fields: [taxTypeId], references: [id])
  salesInvoiceItems          SalesInvoiceItem[]
  purchaseInvoiceItems       PurchaseInvoiceItem[]
  expenses                   Expense[]
  employeeAdvanceSettlements EmployeeAdvanceSettlement[]

  @@index([taxTypeId])
  @@map("tax_rates")
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Journal {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  branchId            String?        @map("branch_id") @db.Uuid
  journalNumber       String         @map("journal_number")
  journalDate         DateTime       @map("journal_date") @db.Date
  status              JournalStatus  @default(DRAFT)
  narration           String?
  // Polymorphic "what caused this journal" discriminator, reusing the
  // existing RelatedModule enum rather than inventing a parallel one — null
  // for a manually-created journal (no source document). No enum value is
  // added this slice; later slices (Sales/Purchase Invoice) will populate
  // these with their own RelatedModule value + id when they auto-create a
  // journal on posting.
  sourceModule        RelatedModule? @map("source_module")
  sourceRecordId      String?        @map("source_record_id") @db.Uuid
  // Written only at post time, recomputed from a fresh read of JournalLine
  // rows inside the same transaction as the status flip — never trusted from
  // a client-submitted total.
  totalDebit          Decimal        @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit         Decimal        @default(0) @map("total_credit") @db.Decimal(18, 2)
  postedAt            DateTime?      @map("posted_at")
  postedByUserId      String?        @map("posted_by_user_id") @db.Uuid
  createdByUserId     String         @map("created_by_user_id") @db.Uuid
  // At most one reversal per original journal. The ORIGINAL journal's own
  // status never changes when reversed — it stays POSTED forever, since a
  // posted journal is an immutable historical accounting fact, not something
  // that "un-happens." Only the read model (via this back-relation) shows
  // that a reversal exists.
  reversalOfJournalId String?        @unique @map("reversal_of_journal_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  company                   Company                    @relation(fields: [companyId], references: [id])
  branch                    Branch?                    @relation(fields: [branchId], references: [id])
  postedBy                  User?                      @relation("JournalPostedBy", fields: [postedByUserId], references: [id])
  createdBy                 User                       @relation("JournalCreatedBy", fields: [createdByUserId], references: [id])
  reversalOf                Journal?                   @relation("JournalReversal", fields: [reversalOfJournalId], references: [id])
  reversedByJournal         Journal?                   @relation("JournalReversal")
  lines                     JournalLine[]
  salesInvoice              SalesInvoice?
  purchaseInvoice           PurchaseInvoice?
  payment                   Payment?
  expense                   Expense?
  internalTransfer          InternalTransfer?
  employeeAdvance           EmployeeAdvance?
  employeeAdvanceSettlement EmployeeAdvanceSettlement?

  @@unique([companyId, journalNumber])
  @@map("journals")
}

model JournalLine {
  id           String   @id @default(uuid()) @db.Uuid
  journalId    String   @map("journal_id") @db.Uuid
  lineNumber   Int      @map("line_number")
  accountId    String   @map("account_id") @db.Uuid
  debitAmount  Decimal  @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount Decimal  @default(0) @map("credit_amount") @db.Decimal(18, 2)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  journal Journal        @relation(fields: [journalId], references: [id])
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

// ─────────────────────────────────────────────────────────────
// Sales Invoices (Phase 7B) — the first real consumer of the Journal engine.
// Posting an invoice auto-creates+auto-posts a Journal (Dr Accounts
// Receivable / Cr Sales Revenue / Cr GST Payable) and flips the originating
// SalesOrder to INVOICED.
// ─────────────────────────────────────────────────────────────

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  // Reserved for the Payments slice — not reachable by any code yet, same
  // "enum has values nothing reaches yet" discipline as SalesOrderStatus.
  PARTIALLY_PAID
  PAID
  CLOSED
  CANCELLED
}

model SalesInvoice {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  branchId         String?            @map("branch_id") @db.Uuid
  invoiceNumber    String             @map("invoice_number")
  salesOrderId     String             @map("sales_order_id") @db.Uuid
  // Denormalized from the order — justified here (unlike e.g. GoodsReceipt
  // not denormalizing supplierId) because this table IS the AR ledger's own
  // document of record, not a downstream operational record.
  customerId       String             @map("customer_id") @db.Uuid
  invoiceDate      DateTime           @map("invoice_date") @db.Date
  dueDate          DateTime           @map("due_date") @db.Date
  status           SalesInvoiceStatus @default(DRAFT)
  // Copied from the SalesOrder at creation time, never re-derived — same
  // frozen-currency convention as SalesOrder/PurchaseOrder.
  currencyCode     String             @map("currency_code") @db.Char(3)
  exchangeRate     Decimal            @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode String             @map("base_currency_code") @db.Char(3)
  subtotalAmount   Decimal            @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  taxAmount        Decimal            @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount  Decimal            @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  // Accumulator, incremented only at Payment-post time (Phase 7D) via a
  // guarded conditional update capped against the frozen totalAmount (safe
  // with the plain Prisma updateMany idiom — totalAmount never changes once
  // POSTED). Drives the PARTIALLY_PAID/PAID status derivation.
  paidAmount       Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 2)
  // Set only at post time — the settlement Journal this invoice generated.
  journalId        String?            @unique @map("journal_id") @db.Uuid
  postedAt         DateTime?          @map("posted_at")
  postedByUserId   String?            @map("posted_by_user_id") @db.Uuid
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  // A distinct constraint from the existing one_active_per_order partial
  // index below (a real, non-null-per-row column comparing companyId+
  // idempotencyKey only) — createSalesInvoice's P2002 handler must branch on
  // error.meta.target to tell the two apart.
  idempotencyKey   String?            @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  salesOrder  SalesOrder          @relation(fields: [salesOrderId], references: [id])
  customer    Customer            @relation(fields: [customerId], references: [id])
  journal     Journal?            @relation(fields: [journalId], references: [id])
  postedBy    User?               @relation("SalesInvoicePostedBy", fields: [postedByUserId], references: [id])
  createdBy   User                @relation("SalesInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  items       SalesInvoiceItem[]
  allocations PaymentAllocation[]

  @@unique([companyId, branchId, invoiceNumber])
  @@unique([companyId, idempotencyKey])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id               String   @id @default(uuid()) @db.Uuid
  salesInvoiceId   String   @map("sales_invoice_id") @db.Uuid
  // Traces back to the originating line — the Sales Order remains the source
  // of truth for size/color breakdown; this table aggregates to one line per
  // style since SalesOrderItem.unitPrice is already per-style, not per-variant.
  salesOrderItemId String   @map("sales_order_item_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 2)
  // Deliberate deviation from CLAUDE.md's 13-table Accounts plan (a shared
  // tax_transactions table): freezes the tax rate/amount directly on the
  // item since this is the first consumer. Revisit if Purchase Invoices
  // (7C) or a third consumer make the shared shape worth building — not
  // speculatively generalizing before a second real caller exists.
  taxRateId        String?  @map("tax_rate_id") @db.Uuid
  taxPercentage    Decimal? @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  salesInvoice   SalesInvoice   @relation(fields: [salesInvoiceId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  taxRate        TaxRate?       @relation(fields: [taxRateId], references: [id])

  @@index([salesInvoiceId])
  @@map("sales_invoice_items")
}

// ─────────────────────────────────────────────────────────────
// Purchase Invoices (Phase 7C) — deliberately diverges from Sales Invoice's
// one-shot-per-order shape: partial, repeatable invoicing against a Purchase
// Order (multiple Goods Receipts against one PO are already a live pattern,
// so multiple invoices are too). PurchaseOrderItem.invoicedQuantity (added
// above) tracks progress; PurchaseOrder.status is never changed by invoicing
// (no invoiced-adjacent status value exists, and a single flip wouldn't be
// semantically correct for a partial document) — "how much has been
// invoiced" is derived by comparing invoicedQuantity to receivedQuantity.
// ─────────────────────────────────────────────────────────────

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  // Reserved for the Payments slice — not reachable by any code yet, same
  // discipline as SalesInvoiceStatus's own reserved values.
  PARTIALLY_PAID
  PAID
  CLOSED
  CANCELLED
}

model PurchaseInvoice {
  id                    String                @id @default(uuid()) @db.Uuid
  companyId             String                @map("company_id") @db.Uuid
  branchId              String?               @map("branch_id") @db.Uuid
  invoiceNumber         String                @map("invoice_number")
  // Nullable — null means a standalone "party/direct bill" with no backing
  // Purchase Order at all (a service/expense bill from a supplier, e.g.
  // freight, consulting, rent — nothing to receive against). When set, the
  // invoice may still mix PO-linked lines with direct lines on the SAME
  // document (e.g. goods against the PO plus an ad hoc freight charge) —
  // see PurchaseInvoiceItem's own per-line discriminator below.
  purchaseOrderId       String?               @map("purchase_order_id") @db.Uuid
  // Denormalized from the order when linked; a real, directly-supplied
  // input when there is no order — this table IS the AP ledger's own
  // document of record either way, same justification as SalesInvoice.customerId.
  supplierId            String                @map("supplier_id") @db.Uuid
  // The supplier's own bill/reference number — free text, since we don't
  // control it (unlike invoiceNumber, which we generate). Guarded against
  // double-entry via a hand-added partial unique index (see migration) since
  // this slice has no other "at most one" constraint to lean on.
  supplierInvoiceNumber String?               @map("supplier_invoice_number")
  invoiceDate           DateTime              @map("invoice_date") @db.Date
  dueDate               DateTime              @map("due_date") @db.Date
  status                PurchaseInvoiceStatus @default(DRAFT)
  // Copied from the PurchaseOrder at creation time, never re-derived — same
  // frozen-currency convention used throughout this project.
  currencyCode          String                @map("currency_code") @db.Char(3)
  exchangeRate          Decimal               @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  baseCurrencyCode      String                @map("base_currency_code") @db.Char(3)
  subtotalAmount        Decimal               @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  taxAmount             Decimal               @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount           Decimal               @default(0) @map("total_amount") @db.Decimal(18, 2)
  baseTotalAmount       Decimal               @default(0) @map("base_total_amount") @db.Decimal(18, 2)
  // Accumulator, incremented only at Payment-post time (Phase 7D) — same
  // shape/reasoning as SalesInvoice.paidAmount above.
  paidAmount            Decimal               @default(0) @map("paid_amount") @db.Decimal(18, 2)
  // Set only at post time — the settlement Journal this invoice generated.
  journalId             String?               @unique @map("journal_id") @db.Uuid
  postedAt              DateTime?             @map("posted_at")
  postedByUserId        String?               @map("posted_by_user_id") @db.Uuid
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  // A distinct constraint from the existing supplierInvoiceNumber partial
  // unique below — createPurchaseInvoice's P2002 handler must branch on
  // error.meta.target to tell the two apart.
  idempotencyKey        String?               @map("idempotency_key")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  company       Company               @relation(fields: [companyId], references: [id])
  branch        Branch?               @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  journal       Journal?              @relation(fields: [journalId], references: [id])
  postedBy      User?                 @relation("PurchaseInvoicePostedBy", fields: [postedByUserId], references: [id])
  createdBy     User                  @relation("PurchaseInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  items         PurchaseInvoiceItem[]
  allocations   PaymentAllocation[]

  @@unique([companyId, branchId, invoiceNumber])
  @@unique([companyId, idempotencyKey])
  @@map("purchase_invoices")
}

// Every line is EXACTLY one of two shapes, discriminated per-line (not just
// per-header — an invoice can mix both, e.g. goods against a PO plus an ad
// hoc freight line): a PO-linked line (purchaseOrderItemId + productId set,
// bounded by receivedQuantity - invoicedQuantity, debits COGS automatically
// at post time — unchanged from before this line ever supported a second
// shape) or a direct/"party bill" line (description + expenseAccountId set,
// no PO backing at all, debits the chosen account directly). Enforced by a
// hand-added CHECK constraint (see migration), the same two-nullable-field-
// XOR shape already proven by PaymentAllocation's
// (sales_invoice_id IS NOT NULL) != (purchase_invoice_id IS NOT NULL).
model PurchaseInvoiceItem {
  id                  String   @id @default(uuid()) @db.Uuid
  purchaseInvoiceId   String   @map("purchase_invoice_id") @db.Uuid
  purchaseOrderItemId String?  @map("purchase_order_item_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  // Direct-line only: what this line is for (e.g. "Legal consulting — August").
  description         String?  @map("description")
  // Direct-line only: which GL account to debit — a PO-linked line always
  // debits COGS automatically instead, same as before this field existed.
  expenseAccountId    String?  @map("expense_account_id") @db.Uuid
  // Both user-entered, bounded by (receivedQuantity - invoicedQuantity) as a
  // friendly check plus a real atomic guard at post time — NOT auto-derived
  // like Sales Invoice, since a supplier invoice can cover a subset of a PO's
  // lines and routinely bills at a different price than the PO (rate
  // revision, negotiated discount). A direct line has no such backing figure
  // to bound against — its quantity/unitPrice are simply what was entered.
  quantity            Decimal  @map("quantity") @db.Decimal(18, 4)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(18, 2)
  // Same deliberate tax_transactions-table deviation as SalesInvoiceItem.
  taxRateId           String?  @map("tax_rate_id") @db.Uuid
  taxPercentage       Decimal? @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount           Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotal           Decimal  @map("line_total") @db.Decimal(18, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  purchaseInvoice   PurchaseInvoice    @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  expenseAccount    ChartOfAccount?    @relation(fields: [expenseAccountId], references: [id])
  taxRate           TaxRate?           @relation(fields: [taxRateId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([purchaseOrderItemId])
  @@index([expenseAccountId])
  @@map("purchase_invoice_items")
}

// ─────────────────────────────────────────────────────────────
// Custom Invoice — a standalone, ad-hoc billing document, deliberately
// separate from SalesInvoice. SalesInvoice is always order-linked (quantity/
// price derived server-side from a confirmed SalesOrder — see that model's
// own comments); a Custom Invoice has no such backing order at all — the
// customer, items, pricing, and discount are all entered directly on the
// document itself. Modeled after a reference billing tool the user pointed
// at (D:\office-data\claude-projects\hrms's own Invoice/InvoiceSeries), not
// the SalesInvoice pattern — this is intentionally the "quick invoice /
// petty billing" tool, not a second AR ledger. It does NOT post a Journal
// and does NOT touch Chart of Accounts/paidAmount/AR — same "not every
// financial-looking document needs to flow through the ledger engine"
// reasoning already applied to Expense's own scope decisions, applied here
// because unlike Expense (a real cost) or SalesInvoice (a real AR claim
// against a confirmed order), a Custom Invoice has no requirement backing it
// that the rest of this system can verify — wiring it into the ledger would
// let anyone post arbitrary revenue with zero traceability. Revisit only if
// asked to post these for real.
// ─────────────────────────────────────────────────────────────

enum CustomInvoiceType {
  TAX_INVOICE
  PROFORMA_INVOICE
}

enum CustomInvoiceStatus {
  DRAFT
  CANCELLED
}

// A company can define several independently-numbered series (e.g. "Retail
// Series" -> RET/2025-2026/1, "Export Series" -> EXP/2025-2026/1) — a
// deliberate departure from this project's usual single atomic
// DocumentSequence-per-(company,branch,type,year) numbering (see
// DocumentNumberingService), which has no concept of more than one named
// series per document type. Reusing that engine here would have meant either
// forcing every Custom Invoice through one shared counter (losing the
// multi-series requirement entirely) or bolting a "series name" dimension
// onto DocumentSequence for a feature nothing else needs — a new, narrowly-
// scoped counter table is the smaller, more honest change.
model InvoiceSeries {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  prefix          String
  // Plain text, not derived from Company.fiscalYearStartMonth — a user-typed
  // label ("2025-2026") that becomes part of the printed invoice number, not
  // a real date-bounded fiscal period the system enforces.
  fiscalYearLabel String   @map("fiscal_year_label")
  // Atomically incremented (guarded updateMany) inside the same transaction
  // as CustomInvoice creation — never SELECT MAX()+1, same discipline as
  // every other counter in this project.
  nextNumber      Int      @default(1) @map("next_number")
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  customInvoices CustomInvoice[]

  @@unique([companyId, name])
  @@unique([companyId, prefix])
  @@map("invoice_series")
}

model CustomInvoice {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  branchId             String?             @map("branch_id") @db.Uuid
  invoiceDate          DateTime            @map("invoice_date") @db.Date
  invoiceType          CustomInvoiceType   @default(TAX_INVOICE) @map("invoice_type")
  hasDueDate           Boolean             @default(false) @map("has_due_date")
  dueDate              DateTime?           @map("due_date") @db.Date
  invoiceSeriesId      String              @map("invoice_series_id") @db.Uuid
  // Pre-filled from the series' own nextNumber at create time but always
  // user-editable (the reference tool's "Edit" button) — uniqueness is
  // enforced by the DB constraint below, not by the series counter itself,
  // matching this project's own established "external numbering" precedent
  // (Phase 3's Customer/Supplier/... sequential codes: the system suggests,
  // the field stays editable, the unique constraint is the real guard).
  invoiceNumber        String              @map("invoice_number")
  customerId           String              @map("customer_id") @db.Uuid
  // Optional classification of this invoice's revenue against the existing
  // Chart of Accounts (an INCOME-type account) — deliberately reuses this
  // project's own, more rigorous accounting master instead of adding a
  // parallel flat "Category" master the reference tool has for the same
  // purpose (its own Category/Transaction tables are that app's *entire*
  // bookkeeping ledger; this app already has a real one). Informational
  // only — does not itself post a Journal entry (see the module-level
  // comment above on why Custom Invoice stays outside the ledger).
  incomeAccountId      String?             @map("income_account_id") @db.Uuid
  // Applied per line at calculation time (discountedPrice = unitPrice * (1 -
  // discount%)), not as a flat subtotal deduction — matches the reference
  // tool's own calculation exactly, confirmed by reading its live calc code
  // rather than guessing from the screenshot alone.
  discountPercentage   Decimal             @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  // When true, no line's GST is charged at all (the buyer self-assesses) —
  // matches the reference tool's isRCM behavior exactly (GST forced to 0 on
  // every line, not just hidden from the printed total).
  isReverseCharge      Boolean             @default(false) @map("is_reverse_charge")
  subtotalAmount       Decimal             @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  discountAmount       Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 2)
  grandTotal           Decimal             @default(0) @map("grand_total") @db.Decimal(18, 2)
  advancePaymentTitle  String?             @map("advance_payment_title")
  advancePaymentAmount Decimal?            @map("advance_payment_amount") @db.Decimal(18, 2)
  payableAmountTitle   String?             @map("payable_amount_title")
  payableAmountValue   Decimal?            @map("payable_amount_value") @db.Decimal(18, 2)
  // grandTotal - advancePaymentAmount - payableAmountValue — stored (not
  // computed on read) purely so the list page can sort/filter on it without
  // a per-row calc, matching PurchaseRequest.estimatedTotalAmount's own
  // stored-rollup precedent; always recomputed server-side, never trusted
  // from the client.
  // Recomputed at every relevant mutation (create/update items, record/cancel
  // a payment, issue/cancel a credit note) to
  // grandTotal - advancePaymentAmount - payableAmountValue - paidAmount -
  // creditedAmount — a genuinely real-time running balance, not a
  // creation-time snapshot, so it never goes stale as payments/credit notes
  // are recorded later. Stored (not computed on read) purely so the list
  // page can sort/filter on it without a per-row calc, matching
  // PurchaseRequest.estimatedTotalAmount's own stored-rollup precedent;
  // always recomputed server-side, never trusted from the client.
  balanceDue           Decimal             @default(0) @map("balance_due") @db.Decimal(18, 2)
  // Guarded accumulators (same idiom as SalesInvoice.paidAmount /
  // PurchaseOrderItem.receivedQuantity) — paidAmount capped at
  // (grandTotal - creditedAmount), creditedAmount capped at grandTotal.
  paidAmount           Decimal             @default(0) @map("paid_amount") @db.Decimal(18, 2)
  creditedAmount       Decimal             @default(0) @map("credited_amount") @db.Decimal(18, 2)
  // Free-form list, not a single field — matches the reference tool's own
  // "+ Add Note" repeatable list (see CustomInvoiceNote below), same
  // reasoning as SampleComment being its own table rather than one big text
  // blob.
  termsAndConditions   String?             @map("terms_and_conditions")
  status               CustomInvoiceStatus @default(DRAFT)
  createdByUserId      String              @map("created_by_user_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company       Company                   @relation(fields: [companyId], references: [id])
  branch        Branch?                   @relation(fields: [branchId], references: [id])
  invoiceSeries InvoiceSeries             @relation(fields: [invoiceSeriesId], references: [id])
  customer      Customer                  @relation(fields: [customerId], references: [id])
  incomeAccount ChartOfAccount?           @relation(fields: [incomeAccountId], references: [id])
  createdBy     User                      @relation(fields: [createdByUserId], references: [id])
  items         CustomInvoiceItem[]
  notes         CustomInvoiceNote[]
  payments      CustomInvoicePayment[]
  creditNotes   CustomInvoiceCreditNote[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([customerId])
  @@map("custom_invoices")
}

model CustomInvoiceItem {
  id              String  @id @default(uuid()) @db.Uuid
  customInvoiceId String  @map("custom_invoice_id") @db.Uuid
  // Optional — picking an existing Product/Material auto-fills
  // name/HSN/price/GST client-side (matching the reference tool's own
  // auto-fill-then-editable behavior) but every field below stays a real,
  // independently-stored, user-editable value. Unlike SalesInvoiceItem
  // (always productId-backed, quantity/price always derived), a Custom
  // Invoice line can be entirely free text with no master link at all —
  // that flexibility is this feature's whole reason for existing.
  productId       String? @map("product_id") @db.Uuid
  itemName        String  @map("item_name")
  hsnCode         String? @map("hsn_code")
  quantity        Decimal @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  gstPercentage   Decimal @default(0) @map("gst_percentage") @db.Decimal(5, 2)
  // All three always recomputed server-side from
  // quantity/unitPrice/gstPercentage/the header's discount%/reverse-charge
  // flag — never trusted from the client, same discipline as every other
  // invoice line in this project.
  lineAmount      Decimal @default(0) @map("line_amount") @db.Decimal(18, 2)
  lineTaxAmount   Decimal @default(0) @map("line_tax_amount") @db.Decimal(18, 2)
  lineTotal       Decimal @default(0) @map("line_total") @db.Decimal(18, 2)
  // Guarded accumulator, capped at lineTotal — written only by a
  // PRODUCT_WISE or PRODUCT_RETURN credit note targeting this specific
  // line (OVERALL_DISCOUNT credit notes never touch item-level rows).
  creditedAmount  Decimal @default(0) @map("credited_amount") @db.Decimal(18, 2)

  customInvoice   CustomInvoice                 @relation(fields: [customInvoiceId], references: [id])
  product         Product?                      @relation(fields: [productId], references: [id])
  creditNoteLines CustomInvoiceCreditNoteItem[]

  @@index([customInvoiceId])
  @@map("custom_invoice_items")
}

model CustomInvoiceNote {
  id              String   @id @default(uuid()) @db.Uuid
  customInvoiceId String   @map("custom_invoice_id") @db.Uuid
  note            String
  createdAt       DateTime @default(now()) @map("created_at")

  customInvoice CustomInvoice @relation(fields: [customInvoiceId], references: [id])

  @@index([customInvoiceId])
  @@map("custom_invoice_notes")
}

// A self-contained "record a receipt against this bill" tool — deliberately
// NOT the same Payment/PaymentAllocation model Sales/Purchase Invoice use
// (Phase 7D below). That engine auto-posts a settlement Journal crediting
// Accounts Receivable — correct there because the originating invoice
// already debited AR at post time. Custom Invoice never posts anything to
// the ledger at all (see the module comment above), so a real Payment
// crediting AR here would silently corrupt the trial balance by reducing a
// balance that was never increased for this specific invoice. This model
// only ever touches CustomInvoice's own paidAmount accumulator — it has no
// ledger effect, matching Custom Invoice's own deliberately-standalone
// scope.
enum CustomInvoicePaymentStatus {
  RECORDED
  CANCELLED
}

model CustomInvoicePayment {
  id               String                     @id @default(uuid()) @db.Uuid
  companyId        String                     @map("company_id") @db.Uuid
  customInvoiceId  String                     @map("custom_invoice_id") @db.Uuid
  paymentDate      DateTime                   @map("payment_date") @db.Date
  amount           Decimal                    @db.Decimal(18, 2)
  // Reuses the existing PaymentType master (CASH/BANK/CHEQUE/CARD/UPI/OTHER)
  // rather than a new enum — same master Payment/Expense already use.
  paymentTypeId    String?                    @map("payment_type_id") @db.Uuid
  referenceNote    String?                    @map("reference_note")
  status           CustomInvoicePaymentStatus @default(RECORDED)
  receivedByUserId String                     @map("received_by_user_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id])
  customInvoice CustomInvoice @relation(fields: [customInvoiceId], references: [id])
  paymentType   PaymentType?  @relation(fields: [paymentTypeId], references: [id])
  receivedBy    User          @relation(fields: [receivedByUserId], references: [id])

  @@index([customInvoiceId])
  @@map("custom_invoice_payments")
}

// Adapts the reference tool's own 3 real credit-note types (confirmed by
// reading its schema, not guessed): OVERALL_DISCOUNT (one flat amount
// against the whole invoice, no item targeting), PRODUCT_WISE (a manual
// amount reduction against one specific line), PRODUCT_RETURN (a returned
// quantity against one specific line, amount derived from that line's own
// effective per-unit rate). Same "no ledger effect" scope as
// CustomInvoicePayment above — a credit note here only ever reduces
// CustomInvoice/CustomInvoiceItem's own creditedAmount accumulators.
enum CustomInvoiceCreditNoteType {
  OVERALL_DISCOUNT
  PRODUCT_WISE
  PRODUCT_RETURN
}

enum CustomInvoiceCreditNoteStatus {
  ISSUED
  CANCELLED
}

model CustomInvoiceCreditNote {
  id               String                        @id @default(uuid()) @db.Uuid
  companyId        String                        @map("company_id") @db.Uuid
  customInvoiceId  String                        @map("custom_invoice_id") @db.Uuid
  creditNoteNumber String                        @map("credit_note_number")
  creditNoteDate   DateTime                      @map("credit_note_date") @db.Date
  type             CustomInvoiceCreditNoteType
  reason           String?
  // Total reduction this credit note applies — for OVERALL_DISCOUNT this is
  // the whole story; for PRODUCT_WISE/PRODUCT_RETURN it's the sum of its own
  // CustomInvoiceCreditNoteItem rows (denormalized here purely for list/sort
  // display, same stored-rollup precedent as CustomInvoice.balanceDue).
  totalAmount      Decimal                       @map("total_amount") @db.Decimal(18, 2)
  status           CustomInvoiceCreditNoteStatus @default(ISSUED)
  createdByUserId  String                        @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                      @default(now()) @map("created_at")

  company       Company                       @relation(fields: [companyId], references: [id])
  customInvoice CustomInvoice                 @relation(fields: [customInvoiceId], references: [id])
  createdBy     User                          @relation(fields: [createdByUserId], references: [id])
  items         CustomInvoiceCreditNoteItem[]

  @@unique([companyId, creditNoteNumber])
  @@index([customInvoiceId])
  @@map("custom_invoice_credit_notes")
}

// Only populated for PRODUCT_WISE/PRODUCT_RETURN credit notes — an
// OVERALL_DISCOUNT credit note has zero rows here, its whole effect living
// on the header's own totalAmount.
model CustomInvoiceCreditNoteItem {
  id                  String   @id @default(uuid()) @db.Uuid
  creditNoteId        String   @map("credit_note_id") @db.Uuid
  customInvoiceItemId String   @map("custom_invoice_item_id") @db.Uuid
  // Set only for PRODUCT_RETURN — the quantity being returned.
  quantity            Decimal? @db.Decimal(18, 4)
  // Net reduction this line contributes — for PRODUCT_RETURN this is
  // computed server-side (quantity * the line's own effective per-unit
  // rate, i.e. lineTotal / quantity), for PRODUCT_WISE it's the amount the
  // caller directly specified.
  amount              Decimal  @db.Decimal(18, 2)

  creditNote        CustomInvoiceCreditNote @relation(fields: [creditNoteId], references: [id])
  customInvoiceItem CustomInvoiceItem       @relation(fields: [customInvoiceItemId], references: [id])

  @@index([creditNoteId])
  @@map("custom_invoice_credit_note_items")
}

// ─────────────────────────────────────────────────────────────
// Payments + Allocations (Phase 7D) — records money received from a Customer
// (RECEIPT) or paid to a Supplier (PAYMENT_OUT), allocated across one or more
// invoices. Posting increments each allocated invoice's paidAmount (guarded,
// capped by its own frozen totalAmount), derives PARTIALLY_PAID/PAID via a
// fresh in-transaction re-read + unconditional write (same idiom as
// PurchaseOrder's own received-quantity status recompute — NOT a guarded
// conditional transition, since a second/third partial payment has no single
// "expected prior status" to key against), and auto-posts a settlement
// Journal via journal.service.ts's postJournalCore. No updatePayment exists —
// deliberately: RBAC's "payments" module has no "edit" action for any role
// except SUPER_ADMIN's wildcard; the only DRAFT-stage correction is
// cancel-and-recreate.
// ─────────────────────────────────────────────────────────────

enum PaymentDirection {
  RECEIPT
  PAYMENT_OUT
}

enum PaymentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Payment {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  branchId        String?          @map("branch_id") @db.Uuid
  // Single shared "PAY-" series for both directions (DocumentType.PAYMENT) —
  // confirmed with the user rather than splitting RECEIPT/PAYMENT_OUT into
  // two series, matching the single-table design.
  paymentNumber   String           @map("payment_number")
  direction       PaymentDirection
  // Exactly one of customerId/supplierId is set, matching `direction` —
  // service-layer check only (no DB trigger anywhere in this codebase; see
  // PaymentAllocation's own CHECK constraint for the one case that IS
  // DB-enforced, which doesn't need direction awareness).
  customerId      String?          @map("customer_id") @db.Uuid
  supplierId      String?          @map("supplier_id") @db.Uuid
  paymentDate     DateTime         @map("payment_date") @db.Date
  paymentTypeId   String           @map("payment_type_id") @db.Uuid
  bankAccountId   String?          @map("bank_account_id") @db.Uuid
  // Free text — cheque number, bank UTR/reference, etc. We don't control it.
  referenceNumber String?          @map("reference_number")
  amount          Decimal          @map("amount") @db.Decimal(18, 2)
  status          PaymentStatus    @default(DRAFT)
  // Always company.baseCurrencyCode — every Sales/Purchase Order (and thus
  // invoice) this pays against is already forced to base currency, so no
  // exchangeRate/baseAmount split is needed here, unlike Sales/Purchase
  // Order's own multi-currency-ready columns.
  currencyCode    String           @map("currency_code") @db.Char(3)
  // Set only at post time — the settlement Journal this payment generated.
  journalId       String?          @unique @map("journal_id") @db.Uuid
  postedAt        DateTime?        @map("posted_at")
  postedByUserId  String?          @map("posted_by_user_id") @db.Uuid
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  idempotencyKey  String?          @map("idempotency_key")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  paymentType PaymentType         @relation(fields: [paymentTypeId], references: [id])
  bankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id])
  journal     Journal?            @relation(fields: [journalId], references: [id])
  postedBy    User?               @relation("PaymentPostedBy", fields: [postedByUserId], references: [id])
  createdBy   User                @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  allocations PaymentAllocation[]

  @@unique([companyId, branchId, paymentNumber])
  @@unique([companyId, idempotencyKey])
  @@map("payments")
}

model PaymentAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  // Exactly one of these two is set — DB-enforced via a hand-added CHECK
  // constraint (see migration), not just a service-layer convention, since
  // this is the one real "exactly one of two FKs" invariant this table has.
  salesInvoiceId    String?  @map("sales_invoice_id") @db.Uuid
  purchaseInvoiceId String?  @map("purchase_invoice_id") @db.Uuid
  allocatedAmount   Decimal  @map("allocated_amount") @db.Decimal(18, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  payment         Payment          @relation(fields: [paymentId], references: [id])
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@index([paymentId])
  @@index([salesInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("payment_allocations")
}

// ─────────────────────────────────────────────────────────────
// Expenses (Phase 7E) — a direct, day-to-day cost (rent, utilities, salaries,
// misc.) that doesn't flow through Purchase Order → Goods Receipt → Purchase
// Invoice. Deliberately always paid immediately at post time (no unpaid/
// payable lifecycle, no later settlement via Payment — an unpaid vendor bill
// with terms already has a home: Purchase Invoice + Payment) and always a
// single flat row (no child items table) — both confirmed with the user.
// Posting creates one Journal (Dr the chosen Expense account, Dr GST Input
// Tax Credit if any, Cr Cash-or-Bank) via the same postJournalCore engine
// every other Accounts document uses. No reversal/correction path exists
// this slice — see journal.service.ts's reverseJournal() sourceModule guard,
// which blocks EXPENSE alongside PAYMENT/SALES_INVOICE/PURCHASE_INVOICE.
// ─────────────────────────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

// Expense's own richer workflow — distinct from the shared ExpenseStatus
// above (EmployeeAdvanceSettlement still uses that simpler 3-state enum
// for its own single-step post; it does not need an approval gate).
// PENDING_APPROVAL (created, editable) -> APPROVED/REJECTED (Admin
// decision, no cash movement) -> from APPROVED only, PAID (Accountant
// pays, the actual Dr Expense/Cr Cash-Bank journal — same journal-posting
// logic this model already had, just now reachable only post-approval).
// REJECTED is terminal by design (confirmed with the user) — matches every
// other rejection in this app (Sample, Sales Order, Purchase Order, ...):
// rejected stays rejected, a correction is a new Expense, not a reversal.
enum ExpenseApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model Expense {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @map("company_id") @db.Uuid
  branchId         String?               @map("branch_id") @db.Uuid
  expenseNumber    String                @map("expense_number")
  expenseDate      DateTime              @map("expense_date") @db.Date
  // Service-validated as accountType === EXPENSE, code !== "COGS" (COGS is a
  // Purchase-Invoice-only control account, never user-selectable — see
  // postPurchaseInvoice's own hardcoded findByCode lookup), and isActive.
  accountId        String                @map("account_id") @db.Uuid
  // Pure reference field — no business logic gated on it, unlike Payment's
  // customerId/supplierId (which are direction-required).
  supplierId       String?               @map("supplier_id") @db.Uuid
  description      String
  amount           Decimal               @map("amount") @db.Decimal(18, 2)
  taxRateId        String?               @map("tax_rate_id") @db.Uuid
  taxPercentage    Decimal?              @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount        Decimal               @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount      Decimal               @map("total_amount") @db.Decimal(18, 2)
  // TDS (Tax Deducted at Source) — computed on the base `amount`, not the
  // GST-inclusive totalAmount (matches standard Indian TDS practice, and the
  // reference tool's own live calc). Posting debits the full totalAmount to
  // the expense/GST-ITC accounts as before, but now credits TDS Payable for
  // tdsAmount and only the net (totalAmount - tdsAmount) to Cash-or-Bank —
  // the amount actually paid out once TDS is withheld.
  tdsPercentage    Decimal?              @map("tds_percentage") @db.Decimal(5, 2)
  tdsAmount        Decimal               @default(0) @map("tds_amount") @db.Decimal(18, 2)
  paymentTypeId    String                @map("payment_type_id") @db.Uuid
  bankAccountId    String?               @map("bank_account_id") @db.Uuid
  referenceNumber  String?               @map("reference_number")
  // Always company.baseCurrencyCode, no exchangeRate/baseAmount split —
  // matches Payment's own simplification (multi-currency UI deferred
  // project-wide).
  currencyCode     String                @map("currency_code") @db.Char(3)
  status           ExpenseApprovalStatus @default(PENDING_APPROVAL)
  // Admin's decision — no cash movement, just a status flip.
  approvedAt       DateTime?             @map("approved_at")
  approvedByUserId String?               @map("approved_by_user_id") @db.Uuid
  rejectedAt       DateTime?             @map("rejected_at")
  rejectedByUserId String?               @map("rejected_by_user_id") @db.Uuid
  rejectionReason  String?               @map("rejection_reason")
  // Set only at pay time (from APPROVED) — the settlement Journal this expense generated.
  journalId        String?               @unique @map("journal_id") @db.Uuid
  postedAt         DateTime?             @map("posted_at")
  postedByUserId   String?               @map("posted_by_user_id") @db.Uuid
  createdByUserId  String                @map("created_by_user_id") @db.Uuid
  // CF-5: company-only, not branch-inclusive — see StockMovement.idempotencyKey.
  idempotencyKey   String?               @map("idempotency_key")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  company     Company        @relation(fields: [companyId], references: [id])
  branch      Branch?        @relation(fields: [branchId], references: [id])
  account     ChartOfAccount @relation(fields: [accountId], references: [id])
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  taxRate     TaxRate?       @relation(fields: [taxRateId], references: [id])
  paymentType PaymentType    @relation(fields: [paymentTypeId], references: [id])
  bankAccount BankAccount?   @relation(fields: [bankAccountId], references: [id])
  journal     Journal?       @relation(fields: [journalId], references: [id])
  postedBy    User?          @relation("ExpensePostedBy", fields: [postedByUserId], references: [id])
  createdBy   User           @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy  User?          @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id])
  rejectedBy  User?          @relation("ExpenseRejectedBy", fields: [rejectedByUserId], references: [id])

  @@unique([companyId, branchId, expenseNumber])
  @@unique([companyId, idempotencyKey])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────
// Internal Transfer — moving money between two of the company's own
// Cash/Bank accounts (e.g. cash deposited into the bank). Zero P&L impact,
// deliberately NOT an Expense (an Expense always debits an income-statement
// account; this only ever touches balance-sheet Cash-or-Bank on both sides).
// Cash/Bank resolution reuses the exact PaymentType.type -> ChartOfAccount
// idiom Payment already established (never PaymentType.code, see that
// model's own comment) — a real, accepted limitation of this scheme: this
// Chart of Accounts has exactly one CASH and one BANK control account, not
// one per physical bank account, so a transfer between two BANK-typed
// payment types (e.g. two different real bank accounts) has no real GL
// effect and is rejected — only CASH<->BANK is postable. fromBankAccountId/
// toBankAccountId are informational only (which physical account, for the
// audit trail), never the accounting entry itself.
// ─────────────────────────────────────────────────────────────

enum InternalTransferStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InternalTransfer {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @map("company_id") @db.Uuid
  branchId          String?                @map("branch_id") @db.Uuid
  transferNumber    String                 @map("transfer_number")
  transferDate      DateTime               @map("transfer_date") @db.Date
  fromPaymentTypeId String                 @map("from_payment_type_id") @db.Uuid
  fromBankAccountId String?                @map("from_bank_account_id") @db.Uuid
  toPaymentTypeId   String                 @map("to_payment_type_id") @db.Uuid
  toBankAccountId   String?                @map("to_bank_account_id") @db.Uuid
  amount            Decimal                @db.Decimal(18, 2)
  narration         String?
  status            InternalTransferStatus @default(DRAFT)
  journalId         String?                @unique @map("journal_id") @db.Uuid
  postedAt          DateTime?              @map("posted_at")
  postedByUserId    String?                @map("posted_by_user_id") @db.Uuid
  createdByUserId   String                 @map("created_by_user_id") @db.Uuid
  idempotencyKey    String?                @map("idempotency_key")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  company         Company      @relation(fields: [companyId], references: [id])
  branch          Branch?      @relation(fields: [branchId], references: [id])
  fromPaymentType PaymentType  @relation("InternalTransferFrom", fields: [fromPaymentTypeId], references: [id])
  toPaymentType   PaymentType  @relation("InternalTransferTo", fields: [toPaymentTypeId], references: [id])
  fromBankAccount BankAccount? @relation("InternalTransferFromBank", fields: [fromBankAccountId], references: [id])
  toBankAccount   BankAccount? @relation("InternalTransferToBank", fields: [toBankAccountId], references: [id])
  journal         Journal?     @relation(fields: [journalId], references: [id])
  postedBy        User?        @relation("InternalTransferPostedBy", fields: [postedByUserId], references: [id])
  createdBy       User         @relation("InternalTransferCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, branchId, transferNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@map("internal_transfers")
}

// ─────────────────────────────────────────────────────────────
// Employee Advance (Imprest) — an advance given to an employee to spend,
// settled later against real expense receipts. Two real Journal postings,
// not one: issuing debits an "Employee Advances" asset control account
// (money owed back by the employee) and credits Cash-or-Bank; settling
// debits the actual expense account the spend belongs to (+ GST-ITC if any)
// and credits Employee Advances back down. This is genuinely more correct
// double-entry accounting than the reference tool's own design (a bare
// float column on the user with no ledger trail at all — see the
// investigation this was modeled from) — the two-journal design was chosen
// specifically to fix that gap, not copy it.
// ─────────────────────────────────────────────────────────────

enum EmployeeAdvanceStatus {
  DRAFT
  ISSUED
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

model EmployeeAdvance {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  branchId        String?               @map("branch_id") @db.Uuid
  advanceNumber   String                @map("advance_number")
  advanceDate     DateTime              @map("advance_date") @db.Date
  employeeId      String                @map("employee_id") @db.Uuid
  amount          Decimal               @db.Decimal(18, 2)
  paymentTypeId   String                @map("payment_type_id") @db.Uuid
  bankAccountId   String?               @map("bank_account_id") @db.Uuid
  purpose         String?
  // Guarded accumulator (same idiom as every other running-total in this
  // project), capped at `amount` — incremented only by a POSTED settlement
  // against this advance.
  settledAmount   Decimal               @default(0) @map("settled_amount") @db.Decimal(18, 2)
  status          EmployeeAdvanceStatus @default(DRAFT)
  journalId       String?               @unique @map("journal_id") @db.Uuid
  postedAt        DateTime?             @map("posted_at")
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  idempotencyKey  String?               @map("idempotency_key")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  company     Company                     @relation(fields: [companyId], references: [id])
  branch      Branch?                     @relation(fields: [branchId], references: [id])
  employee    Employee                    @relation(fields: [employeeId], references: [id])
  paymentType PaymentType                 @relation(fields: [paymentTypeId], references: [id])
  bankAccount BankAccount?                @relation(fields: [bankAccountId], references: [id])
  journal     Journal?                    @relation(fields: [journalId], references: [id])
  createdBy   User                        @relation("EmployeeAdvanceCreatedBy", fields: [createdByUserId], references: [id])
  settlements EmployeeAdvanceSettlement[]

  @@unique([companyId, branchId, advanceNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@map("employee_advances")
}

model EmployeeAdvanceSettlement {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  employeeAdvanceId String        @map("employee_advance_id") @db.Uuid
  settlementNumber  String        @map("settlement_number")
  settlementDate    DateTime      @map("settlement_date") @db.Date
  // Which real Expense account this settled spend belongs to (Travel,
  // Office Supplies, ...) — same validation as Expense.accountId
  // (accountType EXPENSE, code != "COGS", isActive).
  expenseAccountId  String        @map("expense_account_id") @db.Uuid
  description       String
  amount            Decimal       @db.Decimal(18, 2)
  taxRateId         String?       @map("tax_rate_id") @db.Uuid
  taxPercentage     Decimal?      @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount         Decimal       @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(18, 2)
  status            ExpenseStatus @default(DRAFT)
  journalId         String?       @unique @map("journal_id") @db.Uuid
  postedAt          DateTime?     @map("posted_at")
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  company         Company         @relation(fields: [companyId], references: [id])
  employeeAdvance EmployeeAdvance @relation(fields: [employeeAdvanceId], references: [id])
  expenseAccount  ChartOfAccount  @relation(fields: [expenseAccountId], references: [id])
  taxRate         TaxRate?        @relation(fields: [taxRateId], references: [id])
  journal         Journal?        @relation(fields: [journalId], references: [id])
  createdBy       User            @relation("EmployeeAdvanceSettlementCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, settlementNumber])
  @@index([employeeAdvanceId])
  @@map("employee_advance_settlements")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow (2026-09-06)
//
// A pre-Style development/ideation workflow -- NOT a second Style Master.
// AiGarmentProject is a resumable header that starts before any real Style
// exists (an uploaded reference photo or fabric swatch, no style code yet)
// and later, deliberately and manually, graduates into a real Product row
// (itemType STYLE) via convertProjectToStyle() -- the exact same shape
// already proven twice in this codebase: BuyerEnquiryLine -> SampleRequest
// (convertEnquiryLineToSampleRequest) and SampleRequest -> Product
// (convertSampleToStyle). BOM and Costing steps require this graduation and
// then reuse the existing BOM/MRP module and Sampling's own costing engine
// -- no parallel BOM/costing schema exists here.
// ─────────────────────────────────────────────────────────────

enum AiGarmentSourceType {
  REFERENCE
  FABRIC
}

enum AiGarmentProjectStatus {
  IDEA
  REFERENCE_ANALYSIS
  DESIGN_DEVELOPMENT
  DESIGN_SELECTED
  TECHNICAL_DEVELOPMENT
  COSTING
  SAMPLING
  BUYER_REVIEW
  APPROVED
  PRODUCTION
  COMPLETED
  REJECTED
  ON_HOLD
  CANCELLED
}

model AiGarmentProject {
  id                                     String                  @id @default(uuid()) @db.Uuid
  companyId                              String                  @map("company_id") @db.Uuid
  branchId                               String?                 @map("branch_id") @db.Uuid
  projectNumber                          String                  @map("project_number")
  projectName                            String                  @map("project_name")
  sourceType                             AiGarmentSourceType     @map("source_type")
  customerId                             String?                 @map("customer_id") @db.Uuid
  buyerId                                String?                 @map("buyer_id") @db.Uuid
  brandId                                String?                 @map("brand_id") @db.Uuid
  seasonId                               String?                 @map("season_id") @db.Uuid
  categoryId                             String?                 @map("category_id") @db.Uuid
  // Free text -- no "Market" master exists anywhere in this ERP today; a
  // deliberate foundation-stage simplification, same reasoning already used
  // for SampleRequest.color.
  targetMarket                           String?                 @map("target_market")
  // A descriptive demographic/positioning note, distinct from the real
  // customerId/buyerId FKs above -- no existing master fits this.
  targetCustomerProfile                  String?                 @map("target_customer_profile")
  targetSellingPrice                     Decimal?                @map("target_selling_price") @db.Decimal(18, 2)
  // Soft-matched against Currency.code, same non-FK convention
  // Customer.defaultCurrencyCode already uses -- not a real @relation.
  currencyCode                           String?                 @map("currency_code") @db.Char(3)
  orderQuantityEstimate                  Decimal?                @map("order_quantity_estimate") @db.Decimal(18, 2)
  status                                 AiGarmentProjectStatus  @default(IDEA)
  statusBeforeHold                       AiGarmentProjectStatus? @map("status_before_hold")
  // Drives wizard resumability -- e.g. "PROJECT_INFO", "UPLOAD_REFERENCE",
  // "COSTING". Save-and-leave-and-return reads/writes this, not a session.
  currentStepKey                         String                  @map("current_step_key")
  // Native Postgres array -- drives the progress-stepper UI's completed ticks.
  completedStepKeys                      String[]                @map("completed_step_keys")
  // Set once, only by convertProjectToStyle() -- mirrors SampleRequest.productId.
  productId                              String?                 @unique @map("product_id") @db.Uuid
  // Set once, only by createSampleRequestFromProject() -- mirrors
  // BuyerEnquiryLine.sampleRequestId.
  sampleRequestId                        String?                 @unique @map("sample_request_id") @db.Uuid
  // Reserved, unused this phase -- see the schema comment on SalesOrder's own
  // aiGarmentProject back-relation. @unique since the back-relation there is
  // singular (one Sales Order can be reserved-linked from at most one project).
  salesOrderId                           String?                 @unique @map("sales_order_id") @db.Uuid
  // Soft reference to an Attachment.id -- no hard FK, same convention as
  // AiGarmentDesignOption.imageAttachmentId. Points at whichever reference
  // image is CURRENT for this project (a single-image "Replace"/"Delete"
  // model, not a gallery) -- uploading a new one replaces this pointer and
  // the old Attachment row/file are removed.
  referenceImageAttachmentId             String?                 @map("reference_image_attachment_id") @db.Uuid
  // Soft reference to an Attachment.id, mirroring referenceImageAttachmentId's
  // exact "single current image, Replace/Delete" shape -- the Fabric-sourced
  // workflow's own starting swatch photo (Process 7's own analysis subject).
  fabricSwatchImageAttachmentId          String?                 @map("fabric_swatch_image_attachment_id") @db.Uuid
  notes                                  String?
  // Process 5 (Commercial Design Evaluation)'s own "SELECT DESIGN FOR
  // DEVELOPMENT" outcome -- set once, via selectDesignForDevelopment(),
  // never by any other path. This project record IS the pre-Style form of
  // the eventual Style Master (see the foundation phase's own architecture
  // note); recording the selection here rather than only on a real `Product`
  // row is deliberate, since a Product/Style may not exist yet at this stage
  // of the workflow (graduation via convertProjectToStyle() is a later,
  // separate, still-manual step required only once BOM/Costing begin).
  selectedDesignDirectionId              String?                 @map("selected_design_direction_id") @db.Uuid
  selectedDesignAt                       DateTime?               @map("selected_design_at")
  selectedDesignByUserId                 String?                 @map("selected_design_by_user_id") @db.Uuid
  // Process 6 (Apply Actual Fabric)'s own "APPROVE DESIGN & FABRIC" outcome --
  // set once, via approveDesignAndFabric(), same "recorded on the project
  // itself, not a real Style Master row yet" reasoning as
  // selectedDesignDirectionId above, and same "mutable, not a guarded
  // set-once graduation write" choice.
  approvedFabricApplicationId            String?                 @map("approved_fabric_application_id") @db.Uuid
  approvedFabricApplicationAt            DateTime?               @map("approved_fabric_application_at")
  approvedFabricApplicationByUserId      String?                 @map("approved_fabric_application_by_user_id") @db.Uuid
  // Process 7 (Technical Development)'s own "APPROVE TECHNICAL FLAT" outcome --
  // same "recorded on the project itself, mutable, not a guarded set-once
  // graduation write" reasoning as approvedFabricApplicationId above.
  approvedTechnicalFlatId                String?                 @map("approved_technical_flat_id") @db.Uuid
  approvedTechnicalFlatAt                DateTime?               @map("approved_technical_flat_at")
  approvedTechnicalFlatByUserId          String?                 @map("approved_technical_flat_by_user_id") @db.Uuid
  // Process 11 (Technical Specification)'s own "APPROVE TECHNICAL SPECIFICATION"
  // outcome -- same "recorded on the project itself, mutable, not a guarded
  // set-once graduation write" reasoning as approvedTechnicalFlatId above.
  approvedTechnicalSpecificationId       String?                 @map("approved_technical_specification_id") @db.Uuid
  approvedTechnicalSpecificationAt       DateTime?               @map("approved_technical_specification_at")
  approvedTechnicalSpecificationByUserId String?                 @map("approved_technical_specification_by_user_id") @db.Uuid
  // Process 9 (Cost Analysis)'s own "Mark Costing Complete" outcome -- a
  // one-time milestone stamp (guarded so only the FIRST review stamps it,
  // via `where: { costingCompletedAt: null }`), but NOT this project's own
  // terminal milestone: Process 10 added real steps after COSTING
  // (SAMPLING_REVIEW, PRODUCTION), so this field now means only "the
  // AI-assisted costing phase was reviewed," never "the whole workflow is
  // done" -- see productionHandoffCompletedAt below for the real terminal
  // milestone.
  costingCompletedAt                     DateTime?               @map("costing_completed_at")
  costingCompletedByUserId               String?                 @map("costing_completed_by_user_id") @db.Uuid
  // Process 10's own "Mark Project Complete" outcome -- PRODUCTION is the
  // genuinely last step in both stepsForSourceType() sequences, so this is
  // this project's real terminal milestone. Guarded via a single updateMany
  // keyed on `status != COMPLETED` -- the same "precondition in the WHERE
  // clause" idiom already used by setProductIdGuarded/setSampleRequestIdGuarded/
  // the old markCostingComplete, just guarding against a double-click rather
  // than a race between two different actors.
  productionHandoffCompletedAt           DateTime?               @map("production_handoff_completed_at")
  productionHandoffCompletedByUserId     String?                 @map("production_handoff_completed_by_user_id") @db.Uuid
  createdByUserId                        String                  @map("created_by_user_id") @db.Uuid
  createdAt                              DateTime                @default(now()) @map("created_at")
  updatedAt                              DateTime                @updatedAt @map("updated_at")

  company                          Company                              @relation(fields: [companyId], references: [id])
  branch                           Branch?                              @relation(fields: [branchId], references: [id])
  customer                         Customer?                            @relation(fields: [customerId], references: [id])
  buyer                            Buyer?                               @relation(fields: [buyerId], references: [id])
  brand                            Brand?                               @relation(fields: [brandId], references: [id])
  season                           Season?                              @relation(fields: [seasonId], references: [id])
  category                         Category?                            @relation(fields: [categoryId], references: [id])
  product                          Product?                             @relation(fields: [productId], references: [id])
  sampleRequest                    SampleRequest?                       @relation(fields: [sampleRequestId], references: [id])
  salesOrder                       SalesOrder?                          @relation(fields: [salesOrderId], references: [id])
  createdBy                        User                                 @relation("AiGarmentProjectCreatedBy", fields: [createdByUserId], references: [id])
  selectedDesignDirection          AiGarmentDesignDirection?            @relation("AiGarmentProjectSelectedDesign", fields: [selectedDesignDirectionId], references: [id])
  selectedDesignBy                 User?                                @relation("AiGarmentProjectSelectedDesignBy", fields: [selectedDesignByUserId], references: [id])
  approvedFabricApplication        AiGarmentFabricApplication?          @relation("AiGarmentProjectApprovedFabricApplication", fields: [approvedFabricApplicationId], references: [id])
  approvedFabricApplicationBy      User?                                @relation("AiGarmentProjectApprovedFabricApplicationBy", fields: [approvedFabricApplicationByUserId], references: [id])
  approvedTechnicalFlat            AiGarmentTechnicalFlat?              @relation("AiGarmentProjectApprovedTechnicalFlat", fields: [approvedTechnicalFlatId], references: [id])
  approvedTechnicalFlatBy          User?                                @relation("AiGarmentProjectApprovedTechnicalFlatBy", fields: [approvedTechnicalFlatByUserId], references: [id])
  approvedTechnicalSpecification   AiGarmentTechnicalSpecification?     @relation("AiGarmentProjectApprovedTechnicalSpecification", fields: [approvedTechnicalSpecificationId], references: [id])
  approvedTechnicalSpecificationBy User?                                @relation("AiGarmentProjectApprovedTechnicalSpecificationBy", fields: [approvedTechnicalSpecificationByUserId], references: [id])
  costingCompletedBy               User?                                @relation("AiGarmentProjectCostingCompletedBy", fields: [costingCompletedByUserId], references: [id])
  productionHandoffCompletedBy     User?                                @relation("AiGarmentProjectProductionHandoffCompletedBy", fields: [productionHandoffCompletedByUserId], references: [id])
  fabricDetail                     AiGarmentFabricDetail?
  designOptions                    AiGarmentDesignOption[]
  referenceAnalysis                AiGarmentReferenceAnalysis?
  referenceAnalysisRuns            AiGarmentReferenceAnalysisRun[]
  fabricAnalysis                   AiGarmentFabricAnalysis?
  fabricAnalysisRuns               AiGarmentFabricAnalysisRun[]
  developmentBriefRuns             AiGarmentDevelopmentBriefRun[]
  designDirections                 AiGarmentDesignDirection[]
  imageGenerationRuns              AiGarmentImageGenerationRun[]
  generatedImages                  AiGarmentGeneratedImage[]
  designVariationRuns              AiGarmentDesignVariationRun[]
  designVariations                 AiGarmentDesignVariation[]
  commercialEvaluationRuns         AiGarmentCommercialEvaluationRun[]
  commercialEvaluations            AiGarmentCommercialEvaluation[]
  fabricApplicationRuns            AiGarmentFabricApplicationRun[]
  fabricApplications               AiGarmentFabricApplication[]         @relation("AiGarmentFabricApplicationsOfProject")
  technicalFlatRuns                AiGarmentTechnicalFlatRun[]
  technicalFlats                   AiGarmentTechnicalFlat[]             @relation("AiGarmentTechnicalFlatsOfProject")
  technicalSpecificationRuns       AiGarmentTechnicalSpecificationRun[]
  technicalSpecifications          AiGarmentTechnicalSpecification[]    @relation("AiGarmentTechnicalSpecificationsOfProject")
  bomSuggestionRuns                AiGarmentBomSuggestionRun[]
  bomSuggestions                   AiGarmentBomSuggestion[]
  costAnalysisRuns                 AiGarmentCostAnalysisRun[]
  costAnalyses                     AiGarmentCostAnalysis[]
  valueEngineeringRuns             AiGarmentValueEngineeringRun[]
  valueEngineeringAnalyses         AiGarmentValueEngineeringAnalysis[]
  buyerCommentsRuns                AiGarmentBuyerCommentsRun[]
  buyerCommentsAnalyses            AiGarmentBuyerCommentsAnalysis[]
  aiGarmentProductSuitability      AiGarmentProductSuitability?
  aiGarmentProductSuitabilityRuns  AiGarmentProductSuitabilityRun[]
  aiGarmentFabricDevelopmentRuns   AiGarmentFabricDevelopmentRun[]

  @@unique([companyId, projectNumber])
  @@index([companyId, status])
  @@map("ai_garment_projects")
}

// 1:1 child, mirroring Bom.productId's @unique 1:1 pattern -- used by both
// workflows' fabric-related steps ("Fabric Information" in Start From
// Fabric, "Apply Fabric" in Start From Reference). Reuses the existing
// fabric sub-masters (Phase 3) instead of free-text/Decimal fields, the
// same masters already wired into Purchasing's FabricRoll.
model AiGarmentFabricDetail {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @unique @map("project_id") @db.Uuid
  gsmId         String?  @map("gsm_id") @db.Uuid
  dyeId         String?  @map("dye_id") @db.Uuid
  weaveTypeId   String?  @map("weave_type_id") @db.Uuid
  widthId       String?  @map("width_id") @db.Uuid
  compositionId String?  @map("composition_id") @db.Uuid
  colorId       String?  @map("color_id") @db.Uuid
  supplierId    String?  @map("supplier_id") @db.Uuid
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project     AiGarmentProject   @relation(fields: [projectId], references: [id])
  gsm         FabricGsm?         @relation(fields: [gsmId], references: [id])
  dye         FabricDye?         @relation(fields: [dyeId], references: [id])
  weaveType   FabricWeaveType?   @relation(fields: [weaveTypeId], references: [id])
  width       FabricWidth?       @relation(fields: [widthId], references: [id])
  composition FabricComposition? @relation(fields: [compositionId], references: [id])
  color       Color?             @relation(fields: [colorId], references: [id])
  supplier    Supplier?          @relation(fields: [supplierId], references: [id])

  @@map("ai_garment_fabric_details")
}

// Supports "Generate Variations"/"Generate Designs" and "Select Design" --
// one row per design candidate. aiMetadata is a placeholder for a future
// real AI response (prompt/model/confidence); empty/unused this phase, no
// fabricated AI output is ever written here.
model AiGarmentDesignOption {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  label             String?
  notes             String?
  isSelected        Boolean  @default(false) @map("is_selected")
  // Soft reference to an Attachment.id -- no hard FK, deliberately mirroring
  // Attachment.relatedRecordId's own existing "no DB-enforced polymorphic
  // FK, app-layer validated" convention already used throughout this codebase.
  imageAttachmentId String?  @map("image_attachment_id") @db.Uuid
  aiMetadata        Json?    @map("ai_metadata")
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project   AiGarmentProject @relation(fields: [projectId], references: [id])
  createdBy User             @relation("AiGarmentDesignOptionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId])
  @@map("ai_garment_design_options")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 1: Reference Garment Analysis (2026-09-06)
//
// Hierarchy this schema enforces structurally: Reference Image -> AI
// Original Analysis -> Human Review -> Final Approved Analysis -> future
// processes. AiGarmentReferenceObservation keeps `aiObservation` (never
// overwritten) and `approvedObservation` (starts equal to the AI value,
// diverges once a user edits it) as two separate columns for exactly this
// reason -- a later process reads `approvedObservation`, never
// `aiObservation`, so "bypass the approved analysis and silently use the
// uncorrected AI output" is impossible by construction, not just by
// convention.
// ─────────────────────────────────────────────────────────────

enum AiGarmentAnalysisConfidence {
  CONFIRMED_VISUALLY
  LIKELY_INFERRED
  NOT_DETERMINABLE
}

enum AiGarmentConstructionComplexity {
  LOW
  MEDIUM
  HIGH
}

// DRAFT: no successful AI run yet. AI_ANALYSED: a run completed, nothing
// edited yet. UNDER_REVIEW: at least one observation has been user-edited.
// APPROVED: the explicit "Approve Analysis & Continue" action fired. STALE:
// the reference image was replaced after this analysis existed -- the
// analysis row and its observations are kept (audit value) but every
// further edit/approve action is blocked until a fresh AI run replaces them,
// so a replaced image can never leave a stale APPROVED analysis silently
// trusted by a later process.
enum AiGarmentReferenceAnalysisStatus {
  DRAFT
  AI_ANALYSED
  UNDER_REVIEW
  APPROVED
  STALE
}

enum AiGarmentAnalysisRunStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

// The current analysis for a project -- 1:1, always fully replaced (its
// observations deleted and recreated) by the next successful AI run, not
// versioned/append-only like SampleVersion. `rawResponseJson` keeps the
// complete original AI response for audit/debugging, but per explicit
// instruction is never the only usable data structure -- every individual
// observation is also a real row in AiGarmentReferenceObservation.
model AiGarmentReferenceAnalysis {
  id                                 String                           @id @default(uuid()) @db.Uuid
  companyId                          String                           @map("company_id") @db.Uuid
  projectId                          String                           @unique @map("project_id") @db.Uuid
  // Soft reference to the Attachment this analysis was actually run against
  // -- kept even if the project's own current reference image is later
  // replaced, so a STALE analysis still records what it was analysing.
  referenceAttachmentId              String                           @map("reference_attachment_id") @db.Uuid
  status                             AiGarmentReferenceAnalysisStatus @default(DRAFT)
  analysisVersion                    Int                              @default(0) @map("analysis_version")
  promptVersion                      String                           @map("prompt_version")
  provider                           String
  model                              String
  rawResponseJson                    Json                             @map("raw_response_json")
  constructionComplexityLevel        AiGarmentConstructionComplexity? @map("construction_complexity_level")
  constructionComplexityExplanation  String?                          @map("construction_complexity_explanation")
  manufacturingChallenges            String[]                         @map("manufacturing_challenges")
  keyDesignLanguageFeatures          String[]                         @map("key_design_language_features")
  featuresForFurtherDevelopment      String[]                         @map("features_for_further_development")
  featuresToChangeForDifferentiation String[]                         @map("features_to_change_for_differentiation")
  missingInformation                 String[]                         @map("missing_information")
  designDnaSummary                   String?                          @map("design_dna_summary")
  approvedByUserId                   String?                          @map("approved_by_user_id") @db.Uuid
  approvedAt                         DateTime?                        @map("approved_at")
  createdByUserId                    String                           @map("created_by_user_id") @db.Uuid
  createdAt                          DateTime                         @default(now()) @map("created_at")
  updatedAt                          DateTime                         @updatedAt @map("updated_at")

  company              Company                         @relation(fields: [companyId], references: [id])
  project              AiGarmentProject                @relation(fields: [projectId], references: [id])
  approvedBy           User?                           @relation("AiGarmentReferenceAnalysisApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy            User                            @relation("AiGarmentReferenceAnalysisCreatedBy", fields: [createdByUserId], references: [id])
  observations         AiGarmentReferenceObservation[]
  runs                 AiGarmentReferenceAnalysisRun[]
  developmentBriefRuns AiGarmentDevelopmentBriefRun[]

  @@map("ai_garment_reference_analyses")
}

// One row per analysed feature (garmentCategory, silhouette, sleeve.type,
// fabricObservations.weight, ...) -- 36 rows per analysis, matching the AI
// prompt's own 24 top-level + sleeve's 4 + fabricObservations' 6 +
// printPattern's 5 sub-keys. featureKey is the dotted path (e.g.
// "sleeve.type"); its display label/grouping is derived from a shared
// constant map (src/core/ai/reference-analysis/feature-registry.ts), not
// stored here, to avoid duplicating data that never varies per row.
model AiGarmentReferenceObservation {
  id                       String                      @id @default(uuid()) @db.Uuid
  analysisId               String                      @map("analysis_id") @db.Uuid
  featureKey               String                      @map("feature_key")
  aiObservation            String                      @map("ai_observation")
  aiConfidence             AiGarmentAnalysisConfidence @map("ai_confidence")
  aiManufacturingRelevance String                      @map("ai_manufacturing_relevance")
  // Defaults to aiObservation at creation (nothing corrected yet) --
  // "final approved observation" always has a value for a later process to
  // read, even before a human has touched it.
  approvedObservation      String                      @map("approved_observation")
  userEdited               Boolean                     @default(false) @map("user_edited")
  approvedByUserId         String?                     @map("approved_by_user_id") @db.Uuid
  approvedAt               DateTime?                   @map("approved_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")

  analysis   AiGarmentReferenceAnalysis @relation(fields: [analysisId], references: [id])
  approvedBy User?                      @relation("AiGarmentReferenceObservationApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([analysisId, featureKey])
  @@map("ai_garment_reference_observations")
}

// Append-only log of every AI analysis attempt for a project, success or
// failure -- distinct from AiGarmentReferenceAnalysis (the one current,
// mutable "result") since a failed attempt must never overwrite a
// previously successful analysis, and every attempt (including failures)
// needs its own audit trail per explicit instruction.
model AiGarmentReferenceAnalysisRun {
  id                    String                     @id @default(uuid()) @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  projectId             String                     @map("project_id") @db.Uuid
  analysisId            String?                    @map("analysis_id") @db.Uuid
  referenceAttachmentId String                     @map("reference_attachment_id") @db.Uuid
  provider              String
  model                 String
  promptVersion         String                     @map("prompt_version")
  analysisVersion       Int                        @map("analysis_version")
  status                AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory         String?                    @map("error_category")
  errorMessage          String?                    @map("error_message")
  requestedAt           DateTime                   @default(now()) @map("requested_at")
  completedAt           DateTime?                  @map("completed_at")
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid

  company   Company                     @relation(fields: [companyId], references: [id])
  project   AiGarmentProject            @relation(fields: [projectId], references: [id])
  analysis  AiGarmentReferenceAnalysis? @relation(fields: [analysisId], references: [id])
  createdBy User                        @relation("AiGarmentReferenceAnalysisRunCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId, status])
  @@map("ai_garment_reference_analysis_runs")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 7: Fabric Analysis (2026-09-08)
//
// Mirrors Process 1 (Reference Garment Analysis)'s exact architecture --
// single-current-swatch-image + STALE-on-replace + per-field
// approve/edit/reset discipline -- scoped narrower (17 fields, not 36),
// since there is no garment yet to describe, only the fabric itself.
// Reuses AiGarmentAnalysisConfidence/AiGarmentAnalysisRunStatus verbatim --
// both are already generic enough (no garment-specific meaning baked in).
// Deliberately does NOT suggest which garments suit this fabric -- that is
// the separate Product Suitability process's own job, not this one's.
// ─────────────────────────────────────────────────────────────

// Identical state shape to AiGarmentReferenceAnalysisStatus (a second enum,
// not a shared one, so each process's own status values can evolve
// independently without the other silently gaining/losing a state).
enum AiGarmentFabricAnalysisStatus {
  DRAFT
  AI_ANALYSED
  UNDER_REVIEW
  APPROVED
  STALE
}

// The current fabric analysis for a project -- 1:1, always fully replaced
// (its observations deleted and recreated) by the next successful AI run,
// same "never versioned/append-only" shape as AiGarmentReferenceAnalysis.
model AiGarmentFabricAnalysis {
  id                 String                        @id @default(uuid()) @db.Uuid
  companyId          String                        @map("company_id") @db.Uuid
  projectId          String                        @unique @map("project_id") @db.Uuid
  // Soft reference to the Attachment this analysis was actually run against
  // -- kept even if the project's own current swatch is later replaced, so
  // a STALE analysis still records what it was analysing.
  swatchAttachmentId String                        @map("swatch_attachment_id") @db.Uuid
  status             AiGarmentFabricAnalysisStatus @default(DRAFT)
  analysisVersion    Int                           @default(0) @map("analysis_version")
  promptVersion      String                        @map("prompt_version")
  provider           String
  model              String
  rawResponseJson    Json                          @map("raw_response_json")
  // A short narrative summary, analogous to AiGarmentReferenceAnalysis's own
  // designDnaSummary -- max ~150 words per the hidden prompt.
  fabricSummary      String?                       @map("fabric_summary")
  missingInformation String[]                      @map("missing_information")
  approvedByUserId   String?                       @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime?                     @map("approved_at")
  createdByUserId    String                        @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  company               Company                         @relation(fields: [companyId], references: [id])
  project               AiGarmentProject                @relation(fields: [projectId], references: [id])
  approvedBy            User?                           @relation("AiGarmentFabricAnalysisApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy             User                            @relation("AiGarmentFabricAnalysisCreatedBy", fields: [createdByUserId], references: [id])
  observations          AiGarmentFabricObservation[]
  runs                  AiGarmentFabricAnalysisRun[]
  fabricDevelopmentRuns AiGarmentFabricDevelopmentRun[]

  @@map("ai_garment_fabric_analyses")
}

// One row per analysed fabric feature -- 17 rows per analysis (see
// src/core/ai/fabric-analysis/feature-registry.ts). Same two-column
// aiObservation (never overwritten) / approvedObservation (starts equal,
// diverges on edit) shape as AiGarmentReferenceObservation, for the same
// "a later process can never silently bypass the approved value" reason.
model AiGarmentFabricObservation {
  id                       String                      @id @default(uuid()) @db.Uuid
  analysisId               String                      @map("analysis_id") @db.Uuid
  featureKey               String                      @map("feature_key")
  aiObservation            String                      @map("ai_observation")
  aiConfidence             AiGarmentAnalysisConfidence @map("ai_confidence")
  aiManufacturingRelevance String                      @map("ai_manufacturing_relevance")
  approvedObservation      String                      @map("approved_observation")
  userEdited               Boolean                     @default(false) @map("user_edited")
  approvedByUserId         String?                     @map("approved_by_user_id") @db.Uuid
  approvedAt               DateTime?                   @map("approved_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")

  analysis   AiGarmentFabricAnalysis @relation(fields: [analysisId], references: [id])
  approvedBy User?                   @relation("AiGarmentFabricObservationApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([analysisId, featureKey])
  @@map("ai_garment_fabric_observations")
}

// Append-only log of every AI fabric-analysis attempt, success or failure --
// mirrors AiGarmentReferenceAnalysisRun exactly.
model AiGarmentFabricAnalysisRun {
  id                 String                     @id @default(uuid()) @db.Uuid
  companyId          String                     @map("company_id") @db.Uuid
  projectId          String                     @map("project_id") @db.Uuid
  analysisId         String?                    @map("analysis_id") @db.Uuid
  swatchAttachmentId String                     @map("swatch_attachment_id") @db.Uuid
  provider           String
  model              String
  promptVersion      String                     @map("prompt_version")
  analysisVersion    Int                        @map("analysis_version")
  status             AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory      String?                    @map("error_category")
  errorMessage       String?                    @map("error_message")
  requestedAt        DateTime                   @default(now()) @map("requested_at")
  completedAt        DateTime?                  @map("completed_at")
  createdByUserId    String                     @map("created_by_user_id") @db.Uuid

  company   Company                  @relation(fields: [companyId], references: [id])
  project   AiGarmentProject         @relation(fields: [projectId], references: [id])
  analysis  AiGarmentFabricAnalysis? @relation(fields: [analysisId], references: [id])
  createdBy User                     @relation("AiGarmentFabricAnalysisRunCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId, status])
  @@map("ai_garment_fabric_analysis_runs")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Product/Fabric Suitability (the user's own process 8) (2026-09-08)
//
// Assesses which of the company's own real ProductType master rows (T-Shirt,
// Jacket, Trouser, ...) this fabric suits, using the just-approved Fabric
// Analysis's own 17 observations as its only real evidence -- never a raw
// image call (this reasons from already-established facts, not a photo), so
// it uses requestStructuredTextOutput, not the vision variant. Deliberately
// stops short of suggesting concrete silhouettes/design details for any one
// garment type -- that is the separate, still-unbuilt Product Directions
// process's own job (the user's item 9), not this one's.
// ─────────────────────────────────────────────────────────────

// A second, independent 5-state enum rather than reusing
// AiGarmentFabricAnalysisStatus/AiGarmentReferenceAnalysisStatus -- matches
// the reasoning already given twice for those two: each process's own
// states should be free to evolve independently.
enum AiGarmentSuitabilityStatus {
  DRAFT
  AI_ANALYSED
  UNDER_REVIEW
  APPROVED
  STALE
}

enum AiGarmentSuitabilityRating {
  HIGHLY_SUITABLE
  SUITABLE
  MARGINALLY_SUITABLE
  NOT_SUITABLE
}

// The current suitability assessment for a project -- 1:1, always fully
// replaced (its items deleted and recreated) by the next successful AI run,
// same "never versioned/append-only" shape as AiGarmentFabricAnalysis/
// AiGarmentReferenceAnalysis. No automatic cascading STALE if the underlying
// Fabric Analysis is later re-approved with different values -- matches this
// project's own established precedent (Process 8/BOM Suggestion doesn't
// cascade-stale if the Development Brief direction it drew from is edited
// after suggestions were generated either); re-running this assessment is a
// deliberate user action, not an automatic reaction.
model AiGarmentProductSuitability {
  id               String                     @id @default(uuid()) @db.Uuid
  companyId        String                     @map("company_id") @db.Uuid
  projectId        String                     @unique @map("project_id") @db.Uuid
  status           AiGarmentSuitabilityStatus @default(DRAFT)
  analysisVersion  Int                        @default(0) @map("analysis_version")
  promptVersion    String                     @map("prompt_version")
  provider         String
  model            String
  rawResponseJson  Json                       @map("raw_response_json")
  // A short narrative summary of the fabric's best-fit product direction in
  // general terms -- analogous to AiGarmentFabricAnalysis's own
  // fabricSummary, never itself naming a specific silhouette/design.
  overallSummary   String?                    @map("overall_summary")
  approvedByUserId String?                    @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?                  @map("approved_at")
  createdByUserId  String                     @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  company               Company                           @relation(fields: [companyId], references: [id])
  project               AiGarmentProject                  @relation(fields: [projectId], references: [id])
  approvedBy            User?                             @relation("AiGarmentProductSuitabilityApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy             User                              @relation("AiGarmentProductSuitabilityCreatedBy", fields: [createdByUserId], references: [id])
  items                 AiGarmentProductSuitabilityItem[]
  runs                  AiGarmentProductSuitabilityRun[]
  fabricDevelopmentRuns AiGarmentFabricDevelopmentRun[]

  @@map("ai_garment_product_suitabilities")
}

// One row per assessed ProductType -- a REAL hard FK (unlike
// AiGarmentDesignOption.imageAttachmentId's soft-reference convention),
// since ProductType is a genuine, permanent master, not a polymorphic
// Attachment. aiRating/aiReasoning are never overwritten; approvedRating
// starts equal to aiRating and is the only field a later process (Product
// Directions) ever reads, the same "bypass the approved value" structural
// guarantee already established for AiGarmentFabricObservation/
// AiGarmentReferenceObservation. aiReasoning itself stays a fixed read-only
// annotation even when approvedRating is overridden -- mirrors those same
// two models' own "only the value is editable, the AI's own supporting
// annotation is not" shape exactly (their aiManufacturingRelevance is
// likewise never independently editable).
model AiGarmentProductSuitabilityItem {
  id               String                     @id @default(uuid()) @db.Uuid
  suitabilityId    String                     @map("suitability_id") @db.Uuid
  productTypeId    String                     @map("product_type_id") @db.Uuid
  aiRating         AiGarmentSuitabilityRating @map("ai_rating")
  aiReasoning      String                     @map("ai_reasoning")
  approvedRating   AiGarmentSuitabilityRating @map("approved_rating")
  userEdited       Boolean                    @default(false) @map("user_edited")
  approvedByUserId String?                    @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?                  @map("approved_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  suitability AiGarmentProductSuitability @relation(fields: [suitabilityId], references: [id])
  productType ProductType                 @relation(fields: [productTypeId], references: [id])
  approvedBy  User?                       @relation("AiGarmentProductSuitabilityItemApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([suitabilityId, productTypeId])
  @@map("ai_garment_product_suitability_items")
}

// Append-only log of every AI suitability-assessment attempt, success or
// failure -- mirrors AiGarmentFabricAnalysisRun/AiGarmentReferenceAnalysisRun
// exactly, reusing AiGarmentAnalysisRunStatus verbatim (already generic
// enough, no suitability-specific meaning baked in).
model AiGarmentProductSuitabilityRun {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @map("company_id") @db.Uuid
  projectId       String                     @map("project_id") @db.Uuid
  suitabilityId   String?                    @map("suitability_id") @db.Uuid
  provider        String
  model           String
  promptVersion   String                     @map("prompt_version")
  analysisVersion Int                        @map("analysis_version")
  status          AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory   String?                    @map("error_category")
  errorMessage    String?                    @map("error_message")
  requestedAt     DateTime                   @default(now()) @map("requested_at")
  completedAt     DateTime?                  @map("completed_at")
  createdByUserId String                     @map("created_by_user_id") @db.Uuid

  company     Company                      @relation(fields: [companyId], references: [id])
  project     AiGarmentProject             @relation(fields: [projectId], references: [id])
  suitability AiGarmentProductSuitability? @relation(fields: [suitabilityId], references: [id])
  createdBy   User                         @relation("AiGarmentProductSuitabilityRunCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId, status])
  @@map("ai_garment_product_suitability_runs")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 2: Commercial Design Development Brief (2026-09-06)
//
// Starts only once AiGarmentReferenceAnalysis.status = APPROVED (enforced in
// saveWorkflowStep). Every design direction is its own row, mutated in place
// on Edit/Regenerate (a `version` counter tracks regenerations, matching the
// brief's own explicit field list) rather than versioned/append-only like
// SampleVersion -- the brief asks for "Version" as a field ON the record,
// not "one row per version". `aiRawJson` keeps the complete original AI
// response per direction for audit, same precedent as AiGarmentReferenceAnalysis
// .rawResponseJson; the scalar columns are the current (possibly
// user-edited) content future processes (Generate Variations onward) read.
// ─────────────────────────────────────────────────────────────

enum AiGarmentDesignBalance {
  COMMERCIAL_LOWER_RISK
  BALANCED
  FASHION_FORWARD
}

enum AiGarmentCommercialClassification {
  SAFE_COMMERCIAL
  BALANCED
  FASHION_FORWARD
}

// Shared 3-tier rating used by Process 2's own Production Complexity /
// Expected Fabric Consumption / Target Price Compatibility fields --
// deliberately a new, generically-named enum rather than reusing Process
// 1's AiGarmentConstructionComplexity (same LOW/MEDIUM/HIGH values, but that
// enum's own name is specific to construction complexity; reusing it here
// would read confusingly on an unrelated column).
enum AiGarmentRatingLevel {
  LOW
  MEDIUM
  HIGH
}

enum AiGarmentDesignDirectionStatus {
  GENERATED
  APPROVED
  REJECTED
  SAVED_FOR_LATER
}

// One row per "Create Development Brief" click (batch of N directions) or
// per single-direction Regenerate -- reuses AiGarmentAnalysisRunStatus
// (IN_PROGRESS/SUCCESS/FAILED) from Process 1 verbatim, same generic
// AI-call-lifecycle concept. contextSnapshotJson captures the short form's
// resolved market/customer/season/category/price/currency/buyer/preferred-
// fabric/factory-capabilities at request time -- the user may override any
// of these for just this one brief without permanently changing the Style
// Master (Screen 1 already owns that), so this is the only place that
// exact input combination is ever recoverable for audit.
model AiGarmentDevelopmentBriefRun {
  id                      String                     @id @default(uuid()) @db.Uuid
  companyId               String                     @map("company_id") @db.Uuid
  projectId               String                     @map("project_id") @db.Uuid
  referenceAnalysisId     String                     @map("reference_analysis_id") @db.Uuid
  provider                String
  model                   String
  promptVersion           String                     @map("prompt_version")
  requestedDirectionCount Int                        @map("requested_direction_count")
  designBalance           AiGarmentDesignBalance     @map("design_balance")
  contextSnapshotJson     Json                       @map("context_snapshot_json")
  status                  AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory           String?                    @map("error_category")
  errorMessage            String?                    @map("error_message")
  requestedAt             DateTime                   @default(now()) @map("requested_at")
  completedAt             DateTime?                  @map("completed_at")
  createdByUserId         String                     @map("created_by_user_id") @db.Uuid

  company           Company                    @relation(fields: [companyId], references: [id])
  project           AiGarmentProject           @relation(fields: [projectId], references: [id])
  referenceAnalysis AiGarmentReferenceAnalysis @relation(fields: [referenceAnalysisId], references: [id])
  createdBy         User                       @relation("AiGarmentDevelopmentBriefRunCreatedBy", fields: [createdByUserId], references: [id])
  directions        AiGarmentDesignDirection[]

  @@index([projectId, status])
  @@map("ai_garment_development_brief_runs")
}

// developmentBriefRunId/fabricDevelopmentRunId are a two-nullable-FK XOR pair
// (enforced by a hand-added CHECK constraint,
// ai_garment_design_directions_exactly_one_source_check -- same shape as
// payment_allocations_exactly_one_invoice_check/
// purchase_invoice_items_exactly_one_source_check elsewhere in this schema):
// a REFERENCE-sourced direction always has exactly developmentBriefRunId
// set, a FABRIC-sourced one always has exactly fabricDevelopmentRunId set.
// This is what lets Process 5 (Commercial Design Evaluation), Process 3
// (Visual Generation), and every other consumer of this table stay
// completely unchanged and source-type-agnostic -- they only ever key off
// projectId/status, never off which run created a row.
model AiGarmentDesignDirection {
  id                     String                         @id @default(uuid()) @db.Uuid
  companyId              String                         @map("company_id") @db.Uuid
  projectId              String                         @map("project_id") @db.Uuid
  developmentBriefRunId  String?                        @map("development_brief_run_id") @db.Uuid
  fabricDevelopmentRunId String?                        @map("fabric_development_run_id") @db.Uuid
  version                Int                            @default(1)
  status                 AiGarmentDesignDirectionStatus @default(GENERATED)
  aiGeneratedAt          DateTime                       @default(now()) @map("ai_generated_at")
  userNotes              String?                        @map("user_notes")
  userEdited             Boolean                        @default(false) @map("user_edited")

  designDirectionName           String                            @map("design_direction_name")
  commercialClassification      AiGarmentCommercialClassification @map("commercial_classification")
  targetConsumer                String                            @map("target_consumer")
  silhouette                    String
  garmentLength                 String                            @map("garment_length")
  fit                           String
  neckline                      String
  collar                        String
  sleeve                        String
  shoulderConstruction          String                            @map("shoulder_construction")
  frontConstruction             String                            @map("front_construction")
  backConstruction              String                            @map("back_construction")
  closure                       String
  pocket                        String
  waistTreatment                String                            @map("waist_treatment")
  hem                           String
  keyNewDesignFeature           String                            @map("key_new_design_feature")
  // For a REFERENCE-sourced direction: a fabric character SUGGESTION (no
  // fabric is chosen yet at this stage). For a FABRIC-sourced direction: the
  // fabric is already fixed and known -- this instead describes how that
  // specific known fabric behaves/reads within this particular design.
  // Same column, an adapted per-source meaning, matching this codebase's own
  // established "reuse an existing field, document the adapted meaning"
  // discipline (e.g. STEP_TO_STATUS's own FABRIC_ANALYSIS entry).
  suggestedFabricCharacter      String                            @map("suggested_fabric_character")
  suggestedTrims                String                            @map("suggested_trims")
  productionComplexity          AiGarmentRatingLevel              @map("production_complexity")
  expectedFabricConsumption     AiGarmentRatingLevel              @map("expected_fabric_consumption")
  targetPriceCompatibilityLevel AiGarmentRatingLevel              @map("target_price_compatibility_level")
  commercialRationale           String                            @map("commercial_rationale")
  manufacturingRisk             String                            @map("manufacturing_risk")
  // For a REFERENCE-sourced direction: how this design differs from the
  // uploaded reference photo. For a FABRIC-sourced direction (no reference
  // photo exists): how this direction differs from the OTHER directions
  // generated in the same batch -- same column, adapted meaning per source,
  // same reasoning as suggestedFabricCharacter above.
  differentiationFromReference  String                            @map("differentiation_from_reference")

  commercialPotentialScore      Int     @map("commercial_potential_score")
  buyerFitScore                 Int     @map("buyer_fit_score")
  manufacturingEaseScore        Int     @map("manufacturing_ease_score")
  targetPriceCompatibilityScore Int     @map("target_price_compatibility_score")
  fabricEfficiencyScore         Int     @map("fabric_efficiency_score")
  designFreshnessScore          Int     @map("design_freshness_score")
  overallScore                  Int     @map("overall_score")
  isRecommendedForVisualisation Boolean @default(false) @map("is_recommended_for_visualisation")

  aiRawJson Json @map("ai_raw_json")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company                    Company                              @relation(fields: [companyId], references: [id])
  project                    AiGarmentProject                     @relation(fields: [projectId], references: [id])
  developmentBriefRun        AiGarmentDevelopmentBriefRun?        @relation(fields: [developmentBriefRunId], references: [id])
  fabricDevelopmentRun       AiGarmentFabricDevelopmentRun?       @relation(fields: [fabricDevelopmentRunId], references: [id])
  createdBy                  User                                 @relation("AiGarmentDesignDirectionCreatedBy", fields: [createdByUserId], references: [id])
  imageGenerationRuns        AiGarmentImageGenerationRun[]
  generatedImages            AiGarmentGeneratedImage[]
  designVariationRuns        AiGarmentDesignVariationRun[]
  designVariations           AiGarmentDesignVariation[]
  commercialEvaluationItems  AiGarmentCommercialEvaluationItem[]
  selectedByProjects         AiGarmentProject[]                   @relation("AiGarmentProjectSelectedDesign")
  fabricApplicationRuns      AiGarmentFabricApplicationRun[]
  fabricApplications         AiGarmentFabricApplication[]
  technicalFlatRuns          AiGarmentTechnicalFlatRun[]
  technicalFlats             AiGarmentTechnicalFlat[]
  technicalSpecificationRuns AiGarmentTechnicalSpecificationRun[]
  technicalSpecifications    AiGarmentTechnicalSpecification[]
  bomSuggestionRuns          AiGarmentBomSuggestionRun[]
  bomSuggestions             AiGarmentBomSuggestion[]

  @@index([projectId, status])
  @@map("ai_garment_design_directions")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Fabric-to-Garment Development (the user's own process 9) (2026-09-08)
//
// The FABRIC-sourced workflow's own analogue to AiGarmentDevelopmentBriefRun
// -- produces real AiGarmentDesignDirection rows (the exact same table/
// shape Process 2 already writes to and every downstream process already
// consumes) informed by the approved Fabric Analysis + approved Product
// Suitability instead of an approved Reference Analysis. Both
// fabricAnalysisId/productSuitabilityId are required (this run genuinely
// needs both, unlike AiGarmentDesignDirection's own single reference-
// analysis dependency) -- reuses AiGarmentAnalysisRunStatus/
// AiGarmentDesignBalance verbatim, no new enum needed.
// ─────────────────────────────────────────────────────────────

model AiGarmentFabricDevelopmentRun {
  id                      String                     @id @default(uuid()) @db.Uuid
  companyId               String                     @map("company_id") @db.Uuid
  projectId               String                     @map("project_id") @db.Uuid
  fabricAnalysisId        String                     @map("fabric_analysis_id") @db.Uuid
  productSuitabilityId    String                     @map("product_suitability_id") @db.Uuid
  provider                String
  model                   String
  promptVersion           String                     @map("prompt_version")
  requestedDirectionCount Int                        @map("requested_direction_count")
  designBalance           AiGarmentDesignBalance     @map("design_balance")
  contextSnapshotJson     Json                       @map("context_snapshot_json")
  status                  AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory           String?                    @map("error_category")
  errorMessage            String?                    @map("error_message")
  requestedAt             DateTime                   @default(now()) @map("requested_at")
  completedAt             DateTime?                  @map("completed_at")
  createdByUserId         String                     @map("created_by_user_id") @db.Uuid

  company            Company                     @relation(fields: [companyId], references: [id])
  project            AiGarmentProject            @relation(fields: [projectId], references: [id])
  fabricAnalysis     AiGarmentFabricAnalysis     @relation(fields: [fabricAnalysisId], references: [id])
  productSuitability AiGarmentProductSuitability @relation(fields: [productSuitabilityId], references: [id])
  createdBy          User                        @relation("AiGarmentFabricDevelopmentRunCreatedBy", fields: [createdByUserId], references: [id])
  directions         AiGarmentDesignDirection[]

  @@index([projectId, status])
  @@map("ai_garment_fabric_development_runs")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 3: Garment Design Visual Generation (2026-09-06)
//
// Provider-agnostic by construction: neither table stores anything about a
// specific vendor's request/response shape (that lives entirely behind
// src/core/ai/image-generation/'s ImageGenerationProvider interface) — only
// `provider`/`model` strings for audit, matching AiGarmentDevelopmentBriefRun's
// own precedent. Reuses AiGarmentAnalysisRunStatus (IN_PROGRESS/SUCCESS/FAILED)
// a third time — same generic AI-call-lifecycle concept, no new enum needed.
//
// Never overwritten, never deleted: a "Regenerate" or "Create Variation" is
// always a new AiGarmentImageGenerationRun + new AiGarmentGeneratedImage rows,
// never an update to an existing image's own imageAttachmentId — full version
// history is simply every row that ever existed for a design direction.
// ─────────────────────────────────────────────────────────────

enum AiGarmentGeneratedImageDecision {
  PENDING
  SELECTED
  REJECTED
}

// One row per "Generate Visual" click (a batch of 1/3/4 images for one design
// direction) or per "Create Variation" (image-to-image, parentGeneratedImageId
// set) — mirrors AiGarmentDevelopmentBriefRun's own run-log shape exactly.
model AiGarmentImageGenerationRun {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @map("company_id") @db.Uuid
  projectId              String                     @map("project_id") @db.Uuid
  designDirectionId      String                     @map("design_direction_id") @db.Uuid
  provider               String
  model                  String
  promptVersion          String                     @map("prompt_version")
  // The fully-resolved prompt text actually sent -- kept for audit/
  // reproducibility, the same reasoning AiGarmentReferenceAnalysis keeps the
  // complete raw AI response for.
  promptText             String                     @map("prompt_text")
  requestedImageCount    Int                        @map("requested_image_count")
  // Set only for "Create Variation" -- the specific prior generated image
  // this run was an image-to-image variation OF. Null for an ordinary
  // Generate Visual / Regenerate batch.
  parentGeneratedImageId String?                    @map("parent_generated_image_id") @db.Uuid
  status                 AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory          String?                    @map("error_category")
  errorMessage           String?                    @map("error_message")
  requestedAt            DateTime                   @default(now()) @map("requested_at")
  completedAt            DateTime?                  @map("completed_at")
  createdByUserId        String                     @map("created_by_user_id") @db.Uuid

  company         Company                   @relation(fields: [companyId], references: [id])
  project         AiGarmentProject          @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  createdBy       User                      @relation("AiGarmentImageGenerationRunCreatedBy", fields: [createdByUserId], references: [id])
  images          AiGarmentGeneratedImage[]

  @@index([projectId, designDirectionId, status])
  @@map("ai_garment_image_generation_runs")
}

model AiGarmentGeneratedImage {
  id                String                          @id @default(uuid()) @db.Uuid
  companyId         String                          @map("company_id") @db.Uuid
  projectId         String                          @map("project_id") @db.Uuid
  designDirectionId String                          @map("design_direction_id") @db.Uuid
  generationRunId   String                          @map("generation_run_id") @db.Uuid
  promptVersion     String                          @map("prompt_version")
  provider          String
  model             String
  // Soft reference to Attachment.id -- no hard FK, same convention as
  // AiGarmentProject.referenceImageAttachmentId / AiGarmentDesignOption.imageAttachmentId.
  imageAttachmentId String                          @map("image_attachment_id") @db.Uuid
  decision          AiGarmentGeneratedImageDecision @default(PENDING)
  userNotes         String?                         @map("user_notes")
  createdByUserId   String                          @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")

  company         Company                       @relation(fields: [companyId], references: [id])
  project         AiGarmentProject              @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection      @relation(fields: [designDirectionId], references: [id])
  generationRun   AiGarmentImageGenerationRun   @relation(fields: [generationRunId], references: [id])
  createdBy       User                          @relation("AiGarmentGeneratedImageCreatedBy", fields: [createdByUserId], references: [id])
  variationRuns   AiGarmentDesignVariationRun[]
  variations      AiGarmentDesignVariation[]

  @@index([projectId, designDirectionId])
  @@index([designDirectionId, decision])
  @@map("ai_garment_generated_images")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 4: Controlled Design Variation (2026-09-07)
//
// Starts from one existing AiGarmentGeneratedImage ("the original" — never
// edited or deleted by this process). A "Modify Design" submission targets
// exactly one named feature (the fixed picklist below) and is image-to-image
// generated from that same parent image, never from a prior variation —
// deliberately one level deep, not a chain: every AiGarmentDesignVariation's
// parentGeneratedImageId always points at the same original image, and
// variationNumber increments per parent image. "Create Another Variation"
// means "try a different feature/requirement against the same original," not
// "iterate on the variation I just made" — a simpler, easier-to-reason-about
// scope than open-ended chaining, matching this project's own repeated
// "explicit MVP simplification, documented not silently dropped" precedent.
//
// Mirrors AiGarmentImageGenerationRun/AiGarmentGeneratedImage's own shape
// exactly: a run-log row created before the provider is ever resolved (so a
// MISSING_CONFIG failure is still audited), and the variation row itself is
// never overwritten — full version history is just every row that ever
// existed for a given parent image.
// ─────────────────────────────────────────────────────────────

enum AiGarmentDesignFeature {
  NECKLINE
  COLLAR
  SLEEVE
  SLEEVE_LENGTH
  CUFF
  GARMENT_LENGTH
  FIT
  SILHOUETTE
  POCKET
  CLOSURE
  WAIST
  HEM
  COLOR
  BUTTONS
  BACKGROUND_ENVIRONMENT
  MODEL
  LOGO
  EMBROIDERY
  OTHER
}

enum AiGarmentDesignVariationDecision {
  PENDING
  SELECTED
  KEPT_ORIGINAL
}

// One row per "Modify Design" submission.
model AiGarmentDesignVariationRun {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @map("company_id") @db.Uuid
  projectId              String                     @map("project_id") @db.Uuid
  designDirectionId      String                     @map("design_direction_id") @db.Uuid
  parentGeneratedImageId String                     @map("parent_generated_image_id") @db.Uuid
  featureKey             AiGarmentDesignFeature     @map("feature_key")
  currentFeatureValue    String                     @map("current_feature_value")
  newRequirement         String                     @map("new_requirement")
  additionalInstructions String?                    @map("additional_instructions")
  provider               String
  model                  String
  promptVersion          String                     @map("prompt_version")
  // The fully-resolved prompt text actually sent -- same audit reasoning as
  // AiGarmentImageGenerationRun.promptText.
  promptText             String                     @map("prompt_text")
  status                 AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory          String?                    @map("error_category")
  errorMessage           String?                    @map("error_message")
  requestedAt            DateTime                   @default(now()) @map("requested_at")
  completedAt            DateTime?                  @map("completed_at")
  createdByUserId        String                     @map("created_by_user_id") @db.Uuid

  company              Company                   @relation(fields: [companyId], references: [id])
  project              AiGarmentProject          @relation(fields: [projectId], references: [id])
  designDirection      AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  parentGeneratedImage AiGarmentGeneratedImage   @relation(fields: [parentGeneratedImageId], references: [id])
  createdBy            User                      @relation("AiGarmentDesignVariationRunCreatedBy", fields: [createdByUserId], references: [id])
  variation            AiGarmentDesignVariation?

  @@index([parentGeneratedImageId, status])
  @@map("ai_garment_design_variation_runs")
}

// Version control per the spec: Parent Image ID, Variation Number, Changed
// Feature, Previous Value, New Value, Created Date. Never edited/deleted --
// "Keep Original"/"Select Variation" only ever change `decision`.
model AiGarmentDesignVariation {
  id                     String                           @id @default(uuid()) @db.Uuid
  companyId              String                           @map("company_id") @db.Uuid
  projectId              String                           @map("project_id") @db.Uuid
  designDirectionId      String                           @map("design_direction_id") @db.Uuid
  parentGeneratedImageId String                           @map("parent_generated_image_id") @db.Uuid
  variationRunId         String                           @unique @map("variation_run_id") @db.Uuid
  variationNumber        Int                              @map("variation_number")
  featureKey             AiGarmentDesignFeature           @map("feature_key")
  previousValue          String                           @map("previous_value")
  newValue               String                           @map("new_value")
  additionalInstructions String?                          @map("additional_instructions")
  promptVersion          String                           @map("prompt_version")
  provider               String
  model                  String
  // Soft reference to Attachment.id -- same no-hard-FK convention as
  // AiGarmentGeneratedImage.imageAttachmentId.
  imageAttachmentId      String                           @map("image_attachment_id") @db.Uuid
  decision               AiGarmentDesignVariationDecision @default(PENDING)
  createdByUserId        String                           @map("created_by_user_id") @db.Uuid
  createdAt              DateTime                         @default(now()) @map("created_at")
  updatedAt              DateTime                         @updatedAt @map("updated_at")

  company              Company                     @relation(fields: [companyId], references: [id])
  project              AiGarmentProject            @relation(fields: [projectId], references: [id])
  designDirection      AiGarmentDesignDirection    @relation(fields: [designDirectionId], references: [id])
  parentGeneratedImage AiGarmentGeneratedImage     @relation(fields: [parentGeneratedImageId], references: [id])
  variationRun         AiGarmentDesignVariationRun @relation(fields: [variationRunId], references: [id])
  createdBy            User                        @relation("AiGarmentDesignVariationCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([parentGeneratedImageId, variationNumber])
  @@index([parentGeneratedImageId, decision])
  @@map("ai_garment_design_variations")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 5: Commercial Design Evaluation (2026-09-07)
//
// Compares 2-8 of a project's own AiGarmentDesignDirection rows (the real
// named "designs" this whole flow produces — not a raw image or variation,
// which are visual renderings OF a design, not the design itself) on the
// spec's own 12-criterion commercial rubric. `commercialDevelopmentScore` is
// always computed server-side from the 12 raw scores via a fixed weighted
// formula — never trusted from the AI's own arithmetic, the same "never
// trust computed totals from the client/model" discipline this project
// applies everywhere else (Sales Order/Journal/MRP totals, etc.).
// ─────────────────────────────────────────────────────────────

enum AiGarmentCommercialRank {
  FIRST_CHOICE
  SECOND_CHOICE
  THIRD_CHOICE
  NOT_RANKED
}

// One row per "COMPARE COMMERCIALLY" click — mirrors every other AI Garment
// Flow run-log table exactly (created before the provider is even resolved).
model AiGarmentCommercialEvaluationRun {
  id                         String                     @id @default(uuid()) @db.Uuid
  companyId                  String                     @map("company_id") @db.Uuid
  projectId                  String                     @map("project_id") @db.Uuid
  comparedDesignDirectionIds String[]                   @map("compared_design_direction_ids") @db.Uuid
  provider                   String
  model                      String
  promptVersion              String                     @map("prompt_version")
  promptText                 String                     @map("prompt_text")
  // The auto-pulled Buyer/Market/Customer/Season/Target Price/Fabric/Order
  // Quantity/Factory Capability context actually sent — kept for audit, same
  // reasoning AiGarmentDevelopmentBriefRun.contextSnapshotJson already uses.
  contextSnapshotJson        Json                       @map("context_snapshot_json")
  status                     AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory              String?                    @map("error_category")
  errorMessage               String?                    @map("error_message")
  requestedAt                DateTime                   @default(now()) @map("requested_at")
  completedAt                DateTime?                  @map("completed_at")
  createdByUserId            String                     @map("created_by_user_id") @db.Uuid

  company    Company                        @relation(fields: [companyId], references: [id])
  project    AiGarmentProject               @relation(fields: [projectId], references: [id])
  createdBy  User                           @relation("AiGarmentCommercialEvaluationRunCreatedBy", fields: [createdByUserId], references: [id])
  evaluation AiGarmentCommercialEvaluation?

  @@index([projectId, status])
  @@map("ai_garment_commercial_evaluation_runs")
}

// One row per successful comparison — append-only, like AiGarmentDesignDirection
// itself: re-running the comparison (a different design set, or a re-ask on
// the same set) always creates a new evaluation, never overwrites a prior
// one, so the full history of past comparisons stays inspectable.
model AiGarmentCommercialEvaluation {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  runId                   String   @unique @map("run_id") @db.Uuid
  // The AI's own comparative reasoning across the whole set (why this design
  // ranked above that one) -- inherently a cross-design narrative, so it's
  // one field on the header, not duplicated per item.
  overallRankingRationale String   @map("overall_ranking_rationale")
  createdByUserId         String   @map("created_by_user_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")

  company   Company                             @relation(fields: [companyId], references: [id])
  project   AiGarmentProject                    @relation(fields: [projectId], references: [id])
  run       AiGarmentCommercialEvaluationRun    @relation(fields: [runId], references: [id])
  createdBy User                                @relation("AiGarmentCommercialEvaluationCreatedBy", fields: [createdByUserId], references: [id])
  items     AiGarmentCommercialEvaluationItem[]

  @@index([projectId])
  @@map("ai_garment_commercial_evaluations")
}

// One row per compared design direction. `aiRank` is the AI's own suggestion;
// `userRank` is the "allow user to override AI ranking" field the spec asks
// for -- null means "no override, defer to aiRank". Neither rank is what
// actually commits a design to development: that's `AiGarmentProject
// .selectedDesignDirectionId`, a wholly separate, explicitly-confirmed
// action ("Final choice must always be user-approved" holds structurally --
// nothing here can select a design for development on its own).
model AiGarmentCommercialEvaluationItem {
  id                String @id @default(uuid()) @db.Uuid
  evaluationId      String @map("evaluation_id") @db.Uuid
  designDirectionId String @map("design_direction_id") @db.Uuid

  targetCustomerFitScore           Int @map("target_customer_fit_score")
  buyerFitScore                    Int @map("buyer_fit_score")
  fabricSuitabilityScore           Int @map("fabric_suitability_score")
  commercialAppealScore            Int @map("commercial_appeal_score")
  manufacturingSimplicityScore     Int @map("manufacturing_simplicity_score")
  fabricConsumptionEfficiencyScore Int @map("fabric_consumption_efficiency_score")
  patternMakingComplexityScore     Int @map("pattern_making_complexity_score")
  sewingComplexityScore            Int @map("sewing_complexity_score")
  trimComplexityScore              Int @map("trim_complexity_score")
  targetPriceCompatibilityScore    Int @map("target_price_compatibility_score")
  bulkProductionScalabilityScore   Int @map("bulk_production_scalability_score")
  designFreshnessScore             Int @map("design_freshness_score")

  // /100, computed server-side -- see this block's own header comment.
  commercialDevelopmentScore Int @map("commercial_development_score")

  strengths            String
  weaknesses           String
  manufacturingRisks   String @map("manufacturing_risks")
  potentialCostRisks   String @map("potential_cost_risks")
  suggestedImprovement String @map("suggested_improvement")

  aiRank   AiGarmentCommercialRank  @map("ai_rank")
  userRank AiGarmentCommercialRank? @map("user_rank")

  evaluation      AiGarmentCommercialEvaluation @relation(fields: [evaluationId], references: [id])
  designDirection AiGarmentDesignDirection      @relation(fields: [designDirectionId], references: [id])

  @@unique([evaluationId, designDirectionId])
  @@map("ai_garment_commercial_evaluation_items")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 6: Apply Actual Fabric to Selected Garment (2026-09-07)
//
// Starts from the project's own SELECTED DESIGN (AiGarmentProject
// .selectedDesignDirectionId, Process 5's output) and its currently SELECTED
// visual (an AiGarmentGeneratedImage or, if one exists, a superseding
// AiGarmentDesignVariation — resolveSelectedGarmentImage() in the service
// picks whichever was most recently marked SELECTED). A genuine two-image
// composition: the base garment image AND the uploaded fabric swatch are
// both sent to the provider (see ImageGenerationProvider.applyFabric),
// never just described in text.
//
// "Do not overwrite the selected garment design" holds structurally: this
// process never writes to AiGarmentGeneratedImage or AiGarmentDesignVariation
// at all -- every attempt (Regenerate/Change Fabric/Adjust Print Scale/
// Adjust Placement all funnel through the same createFabricApplication(),
// just with different submitted fields) is a brand-new
// AiGarmentFabricApplication row, "before" and "after" images both kept.
// ─────────────────────────────────────────────────────────────

enum AiGarmentFabricApplicationDecision {
  PENDING
  APPROVED
}

// One row per "APPLY FABRIC" submission.
model AiGarmentFabricApplicationRun {
  id                    String                     @id @default(uuid()) @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  projectId             String                     @map("project_id") @db.Uuid
  designDirectionId     String                     @map("design_direction_id") @db.Uuid
  baseImageAttachmentId String                     @map("base_image_attachment_id") @db.Uuid
  swatchAttachmentId    String                     @map("swatch_attachment_id") @db.Uuid
  fabricCode            String?                    @map("fabric_code")
  composition           String?
  width                 String?
  gsm                   String?
  wovenOrKnit           String?                    @map("woven_or_knit")
  stretch               String?
  drape                 String?
  transparency          String?
  surfaceCharacter      String?                    @map("surface_character")
  printPattern          String?                    @map("print_pattern")
  directionality        String?
  specialPlacement      String?                    @map("special_placement")
  availableQuantity     Decimal?                   @map("available_quantity") @db.Decimal(18, 4)
  costPerMetre          Decimal?                   @map("cost_per_metre") @db.Decimal(18, 2)
  provider              String
  model                 String
  promptVersion         String                     @map("prompt_version")
  // The fully-resolved prompt text actually sent -- same audit reasoning as
  // every other AI Garment Flow run's own promptText.
  promptText            String                     @map("prompt_text")
  status                AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory         String?                    @map("error_category")
  errorMessage          String?                    @map("error_message")
  requestedAt           DateTime                   @default(now()) @map("requested_at")
  completedAt           DateTime?                  @map("completed_at")
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid

  company         Company                     @relation(fields: [companyId], references: [id])
  project         AiGarmentProject            @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection    @relation(fields: [designDirectionId], references: [id])
  createdBy       User                        @relation("AiGarmentFabricApplicationRunCreatedBy", fields: [createdByUserId], references: [id])
  application     AiGarmentFabricApplication?

  @@index([designDirectionId, status])
  @@map("ai_garment_fabric_application_runs")
}

// One row per successful "APPLY FABRIC" attempt -- version control mirroring
// AiGarmentDesignVariation's own shape: never edited/deleted, "Approve" only
// ever changes `decision`. `baseImageAttachmentId` is the "Before Fabric
// Application" image, `resultImageAttachmentId` is "After" -- both kept, so
// a side-by-side comparison never needs to reconstruct history from
// elsewhere. `swatchAttachmentId` is the original fabric swatch, stored
// separately per the spec's own "Store original fabric image separately."
model AiGarmentFabricApplication {
  id                      String                             @id @default(uuid()) @db.Uuid
  companyId               String                             @map("company_id") @db.Uuid
  projectId               String                             @map("project_id") @db.Uuid
  designDirectionId       String                             @map("design_direction_id") @db.Uuid
  runId                   String                             @unique @map("run_id") @db.Uuid
  baseImageAttachmentId   String                             @map("base_image_attachment_id") @db.Uuid
  swatchAttachmentId      String                             @map("swatch_attachment_id") @db.Uuid
  resultImageAttachmentId String                             @map("result_image_attachment_id") @db.Uuid
  fabricCode              String?                            @map("fabric_code")
  composition             String?
  width                   String?
  gsm                     String?
  wovenOrKnit             String?                            @map("woven_or_knit")
  stretch                 String?
  drape                   String?
  transparency            String?
  surfaceCharacter        String?                            @map("surface_character")
  printPattern            String?                            @map("print_pattern")
  directionality          String?
  specialPlacement        String?                            @map("special_placement")
  availableQuantity       Decimal?                           @map("available_quantity") @db.Decimal(18, 4)
  costPerMetre            Decimal?                           @map("cost_per_metre") @db.Decimal(18, 2)
  decision                AiGarmentFabricApplicationDecision @default(PENDING)
  createdByUserId         String                             @map("created_by_user_id") @db.Uuid
  createdAt               DateTime                           @default(now()) @map("created_at")
  updatedAt               DateTime                           @updatedAt @map("updated_at")

  company            Company                       @relation(fields: [companyId], references: [id])
  project            AiGarmentProject              @relation("AiGarmentFabricApplicationsOfProject", fields: [projectId], references: [id])
  designDirection    AiGarmentDesignDirection      @relation(fields: [designDirectionId], references: [id])
  run                AiGarmentFabricApplicationRun @relation(fields: [runId], references: [id])
  createdBy          User                          @relation("AiGarmentFabricApplicationCreatedBy", fields: [createdByUserId], references: [id])
  approvedByProjects AiGarmentProject[]            @relation("AiGarmentProjectApprovedFabricApplication")

  @@index([designDirectionId, decision])
  @@map("ai_garment_fabric_applications")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 7: Technical Development (2026-09-07)
//
// "Create Technical Flat" -- regenerates the currently selected garment
// visual (preferring an approved fabric-applied result, falling back to the
// plain selected design visual for FABRIC-sourced projects, which never go
// through Apply Fabric) as a professional flat/CAD-style technical line
// drawing (front + back, construction/seam/trim callouts, no photorealistic
// rendering) -- the standard tech-pack deliverable, distinct in kind from
// Processes 3/4/6's photorealistic renders. Mirrors AiGarmentFabricApplication's
// shape exactly (a run/audit-log table + a version-controlled result table,
// never edited/deleted, two-tier Approve/APPROVE-TECHNICAL-FLAT confirmation)
// since it's the same "regenerate an existing visual, keep full history"
// pattern -- reuses AiGarmentAnalysisRunStatus rather than a fourth identical
// PENDING/IN_PROGRESS/SUCCESS/FAILED enum.
// ─────────────────────────────────────────────────────────────

enum AiGarmentTechnicalFlatDecision {
  PENDING
  APPROVED
}

// One row per "CREATE TECHNICAL FLAT" submission (initial generation or
// Regenerate).
model AiGarmentTechnicalFlatRun {
  id                    String                     @id @default(uuid()) @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  projectId             String                     @map("project_id") @db.Uuid
  designDirectionId     String                     @map("design_direction_id") @db.Uuid
  baseImageAttachmentId String                     @map("base_image_attachment_id") @db.Uuid
  // The one optional user input this process takes -- a free-text note to
  // guide which construction details to call out (e.g. "show the back yoke
  // seam"), never a required field, since the deliverable is a visual
  // re-render, not a data-collection form the way Process 6's textile
  // fields are.
  additionalNotes       String?                    @map("additional_notes")
  provider              String
  model                 String
  promptVersion         String                     @map("prompt_version")
  promptText            String                     @map("prompt_text")
  status                AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory         String?                    @map("error_category")
  errorMessage          String?                    @map("error_message")
  requestedAt           DateTime                   @default(now()) @map("requested_at")
  completedAt           DateTime?                  @map("completed_at")
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid

  company         Company                  @relation(fields: [companyId], references: [id])
  project         AiGarmentProject         @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection @relation(fields: [designDirectionId], references: [id])
  createdBy       User                     @relation("AiGarmentTechnicalFlatRunCreatedBy", fields: [createdByUserId], references: [id])
  flat            AiGarmentTechnicalFlat?

  @@index([designDirectionId, status])
  @@map("ai_garment_technical_flat_runs")
}

// One row per successful "CREATE TECHNICAL FLAT" attempt -- version control
// mirroring AiGarmentFabricApplication's own shape: never edited/deleted,
// "Approve" only ever changes `decision`. `baseImageAttachmentId` is what it
// was generated from (kept for a side-by-side comparison), `resultImageAttachmentId`
// is the technical flat image itself.
model AiGarmentTechnicalFlat {
  id                      String                         @id @default(uuid()) @db.Uuid
  companyId               String                         @map("company_id") @db.Uuid
  projectId               String                         @map("project_id") @db.Uuid
  designDirectionId       String                         @map("design_direction_id") @db.Uuid
  runId                   String                         @unique @map("run_id") @db.Uuid
  baseImageAttachmentId   String                         @map("base_image_attachment_id") @db.Uuid
  resultImageAttachmentId String                         @map("result_image_attachment_id") @db.Uuid
  additionalNotes         String?                        @map("additional_notes")
  decision                AiGarmentTechnicalFlatDecision @default(PENDING)
  createdByUserId         String                         @map("created_by_user_id") @db.Uuid
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")

  company            Company                   @relation(fields: [companyId], references: [id])
  project            AiGarmentProject          @relation("AiGarmentTechnicalFlatsOfProject", fields: [projectId], references: [id])
  designDirection    AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  run                AiGarmentTechnicalFlatRun @relation(fields: [runId], references: [id])
  createdBy          User                      @relation("AiGarmentTechnicalFlatCreatedBy", fields: [createdByUserId], references: [id])
  approvedByProjects AiGarmentProject[]        @relation("AiGarmentProjectApprovedTechnicalFlat")

  @@index([designDirectionId, decision])
  @@map("ai_garment_technical_flats")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Technical Specification (the user's own process 11) (2026-09-08)
//
// The structured Point-of-Measure (POM) chart accompanying the visual
// Technical Flat -- the user confirmed this scope explicitly (via
// AskUserQuestion) over construction/stitch notes or trim/packaging notes,
// since this ERP has zero numeric body-measurement or grading data
// anywhere, making a real POM chart the one genuinely new, structured
// deliverable worth building first. No hard gate exists requiring this (or
// Technical Flat) to be approved before BOM -- mirrors the existing
// TECHNICAL_DEVELOPMENT->BOM mapping, which already imposes none.
//
// Deliberately does NOT require Style graduation (productId) -- unlike
// BOM/Costing, the measurement chart is built directly against the
// company's own global Size master (S/M/L/...), the same "reuse an
// existing master, never invent parallel data" discipline already applied
// throughout this module. Every AI-suggested value is explicitly an
// advisory starting draft pending real technical measurement -- the same
// "advisory, never a substitute for real data" framing Cost Analysis
// already established for its own cost-per-unit range.
model AiGarmentTechnicalSpecificationRun {
  id                String                     @id @default(uuid()) @db.Uuid
  companyId         String                     @map("company_id") @db.Uuid
  projectId         String                     @map("project_id") @db.Uuid
  designDirectionId String                     @map("design_direction_id") @db.Uuid
  // The one optional user input this process takes -- a free-text note to
  // guide which measurement points matter most (e.g. "focus on chest and
  // sleeve, this is an outerwear style"), never required.
  additionalNotes   String?                    @map("additional_notes")
  provider          String
  model             String
  promptVersion     String                     @map("prompt_version")
  promptText        String                     @map("prompt_text")
  status            AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory     String?                    @map("error_category")
  errorMessage      String?                    @map("error_message")
  requestedAt       DateTime                   @default(now()) @map("requested_at")
  completedAt       DateTime?                  @map("completed_at")
  createdByUserId   String                     @map("created_by_user_id") @db.Uuid

  company         Company                          @relation(fields: [companyId], references: [id])
  project         AiGarmentProject                 @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection         @relation(fields: [designDirectionId], references: [id])
  createdBy       User                             @relation("AiGarmentTechnicalSpecificationRunCreatedBy", fields: [createdByUserId], references: [id])
  specification   AiGarmentTechnicalSpecification?

  @@index([projectId, status])
  @@map("ai_garment_technical_specification_runs")
}

enum AiGarmentTechnicalSpecificationDecision {
  PENDING
  APPROVED
}

// One header per successful run -- version control mirroring
// AiGarmentTechnicalFlat's own shape exactly (never edited/deleted as a
// whole; "Approve" only ever changes `decision`).
model AiGarmentTechnicalSpecification {
  id                String                                  @id @default(uuid()) @db.Uuid
  companyId         String                                  @map("company_id") @db.Uuid
  projectId         String                                  @map("project_id") @db.Uuid
  designDirectionId String                                  @map("design_direction_id") @db.Uuid
  runId             String                                  @unique @map("run_id") @db.Uuid
  // A short overall caveat/grading-note paragraph from the AI (e.g. "grading
  // assumes a standard +/-2cm per size step; verify against the company's
  // own grade rules before cutting") -- distinct from any one measurement
  // point's own tolerance text.
  generalNotes      String?                                 @map("general_notes")
  decision          AiGarmentTechnicalSpecificationDecision @default(PENDING)
  createdByUserId   String                                  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                                @default(now()) @map("created_at")
  updatedAt         DateTime                                @updatedAt @map("updated_at")

  company            Company                            @relation(fields: [companyId], references: [id])
  project            AiGarmentProject                   @relation("AiGarmentTechnicalSpecificationsOfProject", fields: [projectId], references: [id])
  designDirection    AiGarmentDesignDirection           @relation(fields: [designDirectionId], references: [id])
  run                AiGarmentTechnicalSpecificationRun @relation(fields: [runId], references: [id])
  createdBy          User                               @relation("AiGarmentTechnicalSpecificationCreatedBy", fields: [createdByUserId], references: [id])
  points             AiGarmentMeasurementPoint[]
  approvedByProjects AiGarmentProject[]                 @relation("AiGarmentProjectApprovedTechnicalSpecification")

  @@index([designDirectionId, decision])
  @@map("ai_garment_technical_specifications")
}

// One row per measurement point (e.g. "Chest Width", "Body Length") --
// the row itself carries no numeric value (that varies per size, see
// AiGarmentMeasurementValue below); deleting/regenerating a specification
// never touches a prior one, matching every other AI Garment Flow result
// table's append-only-per-run shape.
model AiGarmentMeasurementPoint {
  id                       String   @id @default(uuid()) @db.Uuid
  technicalSpecificationId String   @map("technical_specification_id") @db.Uuid
  measurementName          String   @map("measurement_name")
  howToMeasure             String?  @map("how_to_measure")
  toleranceText            String?  @map("tolerance_text")
  sortOrder                Int      @default(0) @map("sort_order")
  createdAt                DateTime @default(now()) @map("created_at")

  technicalSpecification AiGarmentTechnicalSpecification @relation(fields: [technicalSpecificationId], references: [id])
  values                 AiGarmentMeasurementValue[]

  @@map("ai_garment_measurement_points")
}

// One row per (measurement point x company Size) -- the same
// aiValue-never-overwritten / approvedValue-starts-equal-diverges-on-edit
// discipline as AiGarmentFabricObservation/AiGarmentReferenceObservation,
// so a later reader always reads approvedValueText, never a value a human
// hasn't had the chance to correct.
model AiGarmentMeasurementValue {
  id                 String   @id @default(uuid()) @db.Uuid
  measurementPointId String   @map("measurement_point_id") @db.Uuid
  sizeId             String   @map("size_id") @db.Uuid
  aiValueText        String   @map("ai_value_text")
  approvedValueText  String   @map("approved_value_text")
  userEdited         Boolean  @default(false) @map("user_edited")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  measurementPoint AiGarmentMeasurementPoint @relation(fields: [measurementPointId], references: [id])
  size             Size                      @relation(fields: [sizeId], references: [id])

  @@unique([measurementPointId, sizeId])
  @@map("ai_garment_measurement_values")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 8: BOM Suggestion (2026-09-07)
//
// "Generate Draft BOM" -- unlike every prior process, this one's real
// deliverable is never written to a schema of its own: BOM/Costing steps
// were architected from the foundation phase onward to require graduation
// to a real Style and then reuse the EXISTING bom-mrp module's Bom/
// BomVersion/BomItem tables and its own upsertBom()/approveBomVersion()
// actions, with no parallel BOM schema in this module. What this section
// adds is only the AI's own advisory suggestions (free-text material
// descriptions/estimated quantities the model proposes) plus the run/audit
// log -- a suggestion is never itself a real BomItem; resolving one always
// goes through bom-mrp's own real upsertBom() (bom-suggestion.service.ts's
// resolveBomSuggestion() reads the current real BOM, appends the one
// user-confirmed line, and calls upsertBom() unchanged -- the exact
// "reuse an existing module's real write path, orchestrate around it"
// shape already used by Material Request's generatePurchaseOrdersForShortfall()
// calling createPurchaseOrder()).
// ─────────────────────────────────────────────────────────────

// One row per "GENERATE DRAFT BOM" submission.
model AiGarmentBomSuggestionRun {
  id                String                     @id @default(uuid()) @db.Uuid
  companyId         String                     @map("company_id") @db.Uuid
  projectId         String                     @map("project_id") @db.Uuid
  designDirectionId String                     @map("design_direction_id") @db.Uuid
  provider          String
  model             String
  promptVersion     String                     @map("prompt_version")
  promptText        String                     @map("prompt_text")
  status            AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory     String?                    @map("error_category")
  errorMessage      String?                    @map("error_message")
  requestedAt       DateTime                   @default(now()) @map("requested_at")
  completedAt       DateTime?                  @map("completed_at")
  createdByUserId   String                     @map("created_by_user_id") @db.Uuid

  company         Company                  @relation(fields: [companyId], references: [id])
  project         AiGarmentProject         @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection @relation(fields: [designDirectionId], references: [id])
  createdBy       User                     @relation("AiGarmentBomSuggestionRunCreatedBy", fields: [createdByUserId], references: [id])
  suggestions     AiGarmentBomSuggestion[]

  @@index([designDirectionId, status])
  @@map("ai_garment_bom_suggestion_runs")
}

enum AiGarmentBomSuggestionDecision {
  PENDING
  ADDED
  DISMISSED
}

// One row per AI-suggested draft BOM line. Never itself a real BomItem --
// PENDING is purely advisory; ADDED means a user reviewed it (optionally
// editing every value) and resolveBomSuggestion() wrote a real BomItem via
// the existing upsertBom(); DISMISSED means the user decided not to use it.
// `resolvedBomItemId` is a soft reference only (no hard FK) -- upsertBom()
// deletes and recreates every BomItem row on each save (see
// bom.repository.ts's saveDraftWithItems), so a real FK to a BomItem would
// dangle the moment that style's BOM is next edited through the ordinary
// BOM editor, completely independent of this module.
model AiGarmentBomSuggestion {
  id                         String                         @id @default(uuid()) @db.Uuid
  companyId                  String                         @map("company_id") @db.Uuid
  projectId                  String                         @map("project_id") @db.Uuid
  designDirectionId          String                         @map("design_direction_id") @db.Uuid
  runId                      String                         @map("run_id") @db.Uuid
  materialDescription        String                         @map("material_description")
  materialCategory           MaterialCategory               @map("material_category")
  suggestedQuantityPerUnit   Decimal                        @map("suggested_quantity_per_unit") @db.Decimal(18, 4)
  suggestedUom               String                         @map("suggested_uom")
  suggestedWastagePercentage Decimal                        @map("suggested_wastage_percentage") @db.Decimal(5, 2)
  colorNote                  String?                        @map("color_note")
  reasoning                  String
  decision                   AiGarmentBomSuggestionDecision @default(PENDING)
  resolvedBomItemId          String?                        @map("resolved_bom_item_id") @db.Uuid
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")

  company         Company                   @relation(fields: [companyId], references: [id])
  project         AiGarmentProject          @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  run             AiGarmentBomSuggestionRun @relation(fields: [runId], references: [id])

  @@index([designDirectionId, decision])
  @@map("ai_garment_bom_suggestions")
}

// ─────────────────────────────────────────────────────────────
// Process 9 (Cost Analysis) -- an advisory AI cost estimate/commentary over
// the project's own approved design + resolved BOM (if any) + known fabric
// detail + real Sampling costing figures (if a linked Sample Request's
// current version is already priced). Deliberately never writes to, and
// never duplicates, Sampling's own real costing engine (SampleVersion
// .costSubtotal/finalTotal/marginPercent/commissionPercent/freightAmount,
// isCostingLocked) -- the exact same "advisory suggestion, real numbers
// live in the existing module" shape Process 8's BOM Suggestion already
// established, just for commentary instead of a resolvable line item.
// ─────────────────────────────────────────────────────────────

// One row per "ANALYSE COST WITH AI" click -- mirrors every other AI
// Garment Flow run-log table exactly (created before the provider is even
// resolved). Reuses AiGarmentAnalysisRunStatus rather than a sixth
// identical PENDING/IN_PROGRESS/SUCCESS/FAILED enum.
model AiGarmentCostAnalysisRun {
  id                  String                     @id @default(uuid()) @db.Uuid
  companyId           String                     @map("company_id") @db.Uuid
  projectId           String                     @map("project_id") @db.Uuid
  provider            String
  model               String
  promptVersion       String                     @map("prompt_version")
  promptText          String                     @map("prompt_text")
  contextSnapshotJson Json                       @map("context_snapshot_json")
  status              AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory       String?                    @map("error_category")
  errorMessage        String?                    @map("error_message")
  requestedAt         DateTime                   @default(now()) @map("requested_at")
  completedAt         DateTime?                  @map("completed_at")
  createdByUserId     String                     @map("created_by_user_id") @db.Uuid

  company   Company                @relation(fields: [companyId], references: [id])
  project   AiGarmentProject       @relation(fields: [projectId], references: [id])
  createdBy User                   @relation("AiGarmentCostAnalysisRunCreatedBy", fields: [createdByUserId], references: [id])
  analysis  AiGarmentCostAnalysis?

  @@index([projectId, status])
  @@map("ai_garment_cost_analysis_runs")
}

// One row per successful "ANALYSE COST WITH AI" run -- append-only, the
// same "full history stays inspectable, only the most recent is surfaced in
// the UI" precedent AiGarmentCommercialEvaluation already established: a
// re-run always creates a new analysis, never overwrites a prior one.
model AiGarmentCostAnalysis {
  id                          String   @id @default(uuid()) @db.Uuid
  companyId                   String   @map("company_id") @db.Uuid
  projectId                   String   @map("project_id") @db.Uuid
  runId                       String   @unique @map("run_id") @db.Uuid
  estimatedCostPerUnitLow     Decimal  @map("estimated_cost_per_unit_low") @db.Decimal(18, 2)
  estimatedCostPerUnitHigh    Decimal  @map("estimated_cost_per_unit_high") @db.Decimal(18, 2)
  costBreakdownCommentary     String   @map("cost_breakdown_commentary")
  pricePositioningCommentary  String   @map("price_positioning_commentary")
  marginFeasibilityCommentary String   @map("margin_feasibility_commentary")
  riskNotes                   String   @map("risk_notes")
  createdByUserId             String   @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at")

  company   Company                  @relation(fields: [companyId], references: [id])
  project   AiGarmentProject         @relation(fields: [projectId], references: [id])
  run       AiGarmentCostAnalysisRun @relation(fields: [runId], references: [id])
  createdBy User                     @relation("AiGarmentCostAnalysisCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId])
  @@map("ai_garment_cost_analyses")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Value Engineering (the user's own process 14) (2026-09-08)
//
// Scoped via AskUserQuestion ("cost-reduction suggestions against the real
// BOM", over a broader design-level pass) since this process, unlike every
// other one in this module, genuinely REQUIRES the real, graduated Style's
// approved BOM to already exist -- it reviews real BomItem lines (material/
// quantity/wastage, plus a real per-piece cost contribution wherever the
// material's own Product.unitCost is set), never a pre-graduation design's
// own structured fields alone. Purely advisory and read-only by design: no
// suggestion here is ever resolved into a real BomItem write (unlike BOM
// Suggestion's own resolvedBomItemId/upsertBom() flow) -- a human decides
// whether to actually apply an idea by editing the real BOM themselves in
// the existing BOM editor, so no bomItemId reference (soft or hard) is
// stored at all; each suggestion simply echoes the material description it
// was about as plain text for display.
model AiGarmentValueEngineeringRun {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @map("company_id") @db.Uuid
  projectId       String                     @map("project_id") @db.Uuid
  provider        String
  model           String
  promptVersion   String                     @map("prompt_version")
  promptText      String                     @map("prompt_text")
  status          AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory   String?                    @map("error_category")
  errorMessage    String?                    @map("error_message")
  requestedAt     DateTime                   @default(now()) @map("requested_at")
  completedAt     DateTime?                  @map("completed_at")
  createdByUserId String                     @map("created_by_user_id") @db.Uuid

  company   Company                            @relation(fields: [companyId], references: [id])
  project   AiGarmentProject                   @relation(fields: [projectId], references: [id])
  createdBy User                               @relation("AiGarmentValueEngineeringRunCreatedBy", fields: [createdByUserId], references: [id])
  analysis  AiGarmentValueEngineeringAnalysis?

  @@index([projectId, status])
  @@map("ai_garment_value_engineering_runs")
}

enum AiGarmentCostImpactDirection {
  LOWER
  SIMILAR
  HIGHER
}

// One row per successful "ANALYSE FOR VALUE ENGINEERING" run -- append-only,
// the same "full history stays inspectable, only the most recent surfaced
// in the UI" precedent AiGarmentCostAnalysis already established, since
// there's no per-suggestion decision/resolution to track here at all.
model AiGarmentValueEngineeringAnalysis {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  runId           String   @unique @map("run_id") @db.Uuid
  // Holistic commentary not tied to any one BOM line (e.g. "the bulk of
  // this style's cost sits in the fabric itself, not trims").
  overallSummary  String   @map("overall_summary")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company     Company                               @relation(fields: [companyId], references: [id])
  project     AiGarmentProject                      @relation(fields: [projectId], references: [id])
  run         AiGarmentValueEngineeringRun          @relation(fields: [runId], references: [id])
  createdBy   User                                  @relation("AiGarmentValueEngineeringAnalysisCreatedBy", fields: [createdByUserId], references: [id])
  suggestions AiGarmentValueEngineeringSuggestion[]

  @@index([projectId])
  @@map("ai_garment_value_engineering_analyses")
}

model AiGarmentValueEngineeringSuggestion {
  id                  String                       @id @default(uuid()) @db.Uuid
  analysisId          String                       @map("analysis_id") @db.Uuid
  // Plain-text echo of the real BOM line this suggestion is about -- never a
  // stored reference to the real BomItem (see the module comment above).
  materialDescription String                       @map("material_description")
  suggestedChange     String                       @map("suggested_change")
  costImpactDirection AiGarmentCostImpactDirection @map("cost_impact_direction")
  qualityRiskNotes    String                       @map("quality_risk_notes")
  reasoning           String
  sortOrder           Int                          @default(0) @map("sort_order")
  createdAt           DateTime                     @default(now()) @map("created_at")

  analysis AiGarmentValueEngineeringAnalysis @relation(fields: [analysisId], references: [id])

  @@map("ai_garment_value_engineering_suggestions")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Buyer Comments (the user's own process 16) (2026-09-08)
//
// Scoped via AskUserQuestion ("AI summary of the real Sampling feedback",
// over a separate pre-sample comment log) since the real buyer feedback
// already lives in Sampling -- SampleComment's own thread and
// SampleApproval.decisionNotes on the linked Sample Request -- once it's
// been submitted for buyer review. This process never invents feedback
// that wasn't actually given: it reads the real comment thread and decision
// notes for the project's linked Sample Request and produces a structured,
// categorized summary of what the buyer is actually asking to change --
// read-only insight over real data, the same "advisory, never a substitute
// for the real record" discipline every other AI Garment Flow process in
// this file already applies to its own upstream source.
model AiGarmentBuyerCommentsRun {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @map("company_id") @db.Uuid
  projectId       String                     @map("project_id") @db.Uuid
  provider        String
  model           String
  promptVersion   String                     @map("prompt_version")
  promptText      String                     @map("prompt_text")
  status          AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory   String?                    @map("error_category")
  errorMessage    String?                    @map("error_message")
  requestedAt     DateTime                   @default(now()) @map("requested_at")
  completedAt     DateTime?                  @map("completed_at")
  createdByUserId String                     @map("created_by_user_id") @db.Uuid

  company   Company                         @relation(fields: [companyId], references: [id])
  project   AiGarmentProject                @relation(fields: [projectId], references: [id])
  createdBy User                            @relation("AiGarmentBuyerCommentsRunCreatedBy", fields: [createdByUserId], references: [id])
  analysis  AiGarmentBuyerCommentsAnalysis?

  @@index([projectId, status])
  @@map("ai_garment_buyer_comments_runs")
}

enum AiGarmentBuyerCommentCategory {
  FIT
  CONSTRUCTION
  FABRIC
  COLOR
  TRIM
  PRICING
  OTHER
}

// One row per successful "SUMMARISE BUYER COMMENTS" run -- append-only, the
// same "full history stays inspectable, only the most recent surfaced in
// the UI" precedent Cost Analysis/Value Engineering already established,
// since the real underlying feedback keeps growing over time (a fresh
// summary each time reflects whatever's been recorded so far, not a
// decision to resolve).
model AiGarmentBuyerCommentsAnalysis {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  runId           String   @unique @map("run_id") @db.Uuid
  overallSummary  String   @map("overall_summary")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company    Company                                @relation(fields: [companyId], references: [id])
  project    AiGarmentProject                       @relation(fields: [projectId], references: [id])
  run        AiGarmentBuyerCommentsRun              @relation(fields: [runId], references: [id])
  createdBy  User                                   @relation("AiGarmentBuyerCommentsAnalysisCreatedBy", fields: [createdByUserId], references: [id])
  categories AiGarmentBuyerCommentCategorySummary[]

  @@index([projectId])
  @@map("ai_garment_buyer_comments_analyses")
}

model AiGarmentBuyerCommentCategorySummary {
  id              String                        @id @default(uuid()) @db.Uuid
  analysisId      String                        @map("analysis_id") @db.Uuid
  category        AiGarmentBuyerCommentCategory
  summary         String
  // A short quoted/paraphrased excerpt of the real comment(s)/decision notes
  // this summary was drawn from -- kept for traceability back to the real
  // source, so a reader is never asked to just trust an ungrounded claim.
  evidenceExcerpt String                        @map("evidence_excerpt")
  sortOrder       Int                           @default(0) @map("sort_order")
  createdAt       DateTime                      @default(now()) @map("created_at")

  analysis AiGarmentBuyerCommentsAnalysis @relation(fields: [analysisId], references: [id])

  @@map("ai_garment_buyer_comment_category_summaries")
}

// ─────────────────────────────────────────────────────────────
// System
// ─────────────────────────────────────────────────────────────

enum RelatedModule {
  SAMPLE_REQUEST
  BUYER_ENQUIRY
  SALES_ORDER
  PURCHASE_ORDER
  MATERIAL_REQUEST
  SALES_INVOICE
  PURCHASE_INVOICE
  QC_INSPECTION
  DISPATCH
  PAYMENT
  GOODS_RECEIPT
  PRODUCTION_ORDER
  EXPENSE
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  PRODUCT
  STOCK_MOVEMENT
  JOB_WORK_ORDER
  LEAVE_REQUEST
  ATTENDANCE_CORRECTION
  EMPLOYEE_ADVANCE_SETTLEMENT
  // The Bulk Master Data Import portal (Super Admin only) -- used as the
  // referenceModule for an Opening Stock row's ledger entry (referencing
  // the ImportBatch that created it, not a real document of any other
  // type).
  IMPORT_BATCH
  // AI Garment Flow (2026-09-06) -- every file uploaded anywhere in a
  // project's workflow (reference images, fabric swatches, generated design
  // images, technical flats, etc.) attaches at the project header level
  // (relatedRecordId = AiGarmentProject.id), disambiguated by Attachment's
  // own contextLabel reused as an asset-type tag -- matching Sampling's own
  // precedent of keeping attachments at the header level, not per-child-row.
  AI_GARMENT_PROJECT
  // AI Designer (2026-09-10) -- a genuinely separate module from AI Garment
  // Flow (own ai_-prefixed schema, own APIs, zero shared business logic, per
  // explicit user decision). Every file uploaded in an AI Designer project
  // (uploaded fabric image, exported PNG/JPG/PDF) attaches at the project
  // header level (relatedRecordId = AiDesignerProject.id) -- same "attach at
  // the header, not per-child-row" precedent as every other module here.
  AI_DESIGNER_PROJECT
  // Replicate Design (2026-09-13) -- a new page inside the AI Designer
  // module. Every file uploaded (reference garment photos, fabric photo)
  // attaches at the project header level (relatedRecordId =
  // ReplicateDesignProject.id), same precedent as AI_DESIGNER_PROJECT.
  REPLICATE_DESIGN_PROJECT
  // CRM Contacts (Phase 04, 2026-10-02) -- documents attached to a CRM
  // contact (relatedRecordId = CrmContact.id). Moved to the survivor on merge.
  CRM_CONTACT
  // CRM Companies (Phase 05, 2026-10-03) -- documents attached to a CRM
  // company (relatedRecordId = CrmCompany.id). Moved to the survivor on merge.
  CRM_COMPANY
  // CRM Opportunities (Phase 06, 2026-10-04) -- documents attached to an
  // opportunity (relatedRecordId = CrmOpportunity.id).
  CRM_OPPORTUNITY
  // CRM Activities (Phase 09, 2026-10-06) -- in-app task reminders and
  // assignment notifications point at the activity (relatedRecordId = CrmActivity.id).
  CRM_ACTIVITY
  // CRM Conversations (Phase 11, 2026-10-08) -- message attachments and
  // conversation notifications (relatedRecordId = CrmConversation.id).
  CRM_CONVERSATION
}

model Attachment {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  uploadedById    String        @map("uploaded_by") @db.Uuid
  relatedModule   RelatedModule @map("related_module")
  relatedRecordId String        @map("related_record_id") @db.Uuid
  fileName        String        @map("file_name")
  storageKey      String        @map("storage_key")
  fileSizeBytes   Int           @map("file_size_bytes")
  mimeType        String        @map("mime_type")
  // Free-text snapshot of "what state was the parent record in when this was
  // uploaded" (e.g. a SampleStatus value like "IN_DEVELOPMENT") — generic
  // string, not FK'd to any one module's status enum, since Attachment is
  // shared across every future module, not owned by Sampling.
  contextLabel    String?       @map("context_label")
  uploadedAt      DateTime      @default(now()) @map("uploaded_at")

  company               Company                @relation(fields: [companyId], references: [id])
  uploadedBy            User                   @relation(fields: [uploadedById], references: [id])
  crmMessageAttachments CrmMessageAttachment[]

  @@index([relatedModule, relatedRecordId])
  @@map("attachments")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  title           String
  body            String
  relatedModule   RelatedModule?      @map("related_module")
  relatedRecordId String?             @map("related_record_id") @db.Uuid
  channel         NotificationChannel @default(IN_APP)
  isRead          Boolean             @default(false) @map("is_read")
  sentAt          DateTime?           @map("sent_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// CRM — foundation (Phase 01, 2026-10-01). See docs/crm/CRM_MASTER_BLUEPRINT.md.
// ─────────────────────────────────────────────────────────────

// The CRM record types that can own timeline events, tags, notes, tasks and
// custom-field values. Grows one value per phase as each entity is built
// (e.g. TASK, APPOINTMENT, CONVERSATION later).
enum CrmEntityType {
  LEAD
  CONTACT
  COMPANY
  OPPORTUNITY
  // Phase 09: tasks, calls, meetings… (crm_activities). Its events
  // (activity.*) appear on the timelines of the records it is linked to.
  ACTIVITY
  // Phase 11: unified conversations. conversation.* / message.* events appear
  // on the timelines of the contact / company / opportunity it is linked to.
  CONVERSATION
  // Phase 12: message templates. template.* events form the template's own history.
  TEMPLATE
}

// Append-only business event log for the CRM. One row per thing that
// happened to a CRM record ("lead.created", "opportunity.stage_changed").
// It is the source for record timelines today and the input for workflow
// triggers (Phase 18) and outbound webhooks (Phase 29) later, so rows are
// never updated or deleted. AuditLog remains the compliance trail; this is
// the user-facing story. `eventType` is validated in code against the event
// registry (src/modules/crm/core/crm-event-types.ts) rather than a DB enum, so
// adding an event type never needs a migration.
model CrmEvent {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  entityType    CrmEntityType @map("entity_type")
  entityId      String        @map("entity_id") @db.Uuid
  eventType     String        @map("event_type")
  summary       String?
  payload       Json?
  actorUserId   String?       @map("actor_user_id") @db.Uuid
  correlationId String?       @map("correlation_id")
  occurredAt    DateTime      @default(now()) @map("occurred_at")

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation("CrmEventActor", fields: [actorUserId], references: [id])

  @@index([companyId, entityType, entityId, occurredAt])
  @@index([companyId, eventType, occurredAt])
  @@index([companyId, occurredAt])
  @@map("crm_events")
}

// ─────────────────────────────────────────────────────────────
// CRM — Phase 02 Leads (2026-10-01). See docs/crm/PHASE_02_LEADS.md.
// Statuses/sources/tags/custom fields are per-company configuration; every
// rule keys on stable `key` / `kind` values, never on display names.
// ─────────────────────────────────────────────────────────────

// What a status *means* to the system. Display names are free to change;
// conversion moves a lead to the company's CONVERTED status, and reports
// treat LOST as closed. OPEN covers every working status (new, contacted…).
enum CrmLeadStatusKind {
  OPEN
  CONVERTED
  LOST
}

enum CrmLeadTemperature {
  COLD
  WARM
  HOT
}

// ── Lead import & capture (Phase 03) ────────────────────────────────

// The channel a lead came in through (distinct from CrmLeadSource, which is
// the configurable marketing source such as "Trade fair" or "IndiaMART").
enum CrmLeadCaptureChannel {
  MANUAL
  CSV
  XLSX
  WEBSITE_FORM
  API
  WEBHOOK
  INTEGRATION
}

enum CrmImportFileType {
  CSV
  XLSX
}

enum CrmImportJobStatus {
  PENDING
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum CrmDuplicatePolicy {
  SKIP
  UPDATE
  CREATE
  FLAG_FOR_REVIEW
}

enum CrmImportRowValidation {
  PENDING
  VALID
  WARNING
  ERROR
}

enum CrmIngestOutcome {
  PENDING
  IMPORTED
  UPDATED
  SKIPPED
  FLAGGED
  FAILED
}

enum CrmIngestEventStatus {
  RECEIVED
  PROCESSED
  FLAGGED
  FAILED
}

/// One CSV/XLSX import. Rows live in crm_import_rows so preview, review of
/// flagged rows and the error file all read from the database; the uploaded
/// file itself is temporary and removed once the job finishes.
model CrmImportJob {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  fileName          String             @map("file_name")
  fileType          CrmImportFileType  @map("file_type")
  fileSizeBytes     Int                @map("file_size_bytes")
  // FileStorage key of the (temporary) uploaded file; null once cleaned up.
  fileKey           String?            @map("file_key")
  status            CrmImportJobStatus @default(PENDING)
  sourceId          String?            @map("source_id") @db.Uuid
  duplicatePolicy   CrmDuplicatePolicy @default(SKIP) @map("duplicate_policy")
  headers           Json               @default("[]")
  mapping           Json               @default("{}")
  options           Json               @default("{}")
  totalRows         Int                @default(0) @map("total_rows")
  validRows         Int                @default(0) @map("valid_rows")
  warningRows       Int                @default(0) @map("warning_rows")
  errorRows         Int                @default(0) @map("error_rows")
  duplicateRows     Int                @default(0) @map("duplicate_rows")
  processedRows     Int                @default(0) @map("processed_rows")
  importedRows      Int                @default(0) @map("imported_rows")
  updatedRows       Int                @default(0) @map("updated_rows")
  skippedRows       Int                @default(0) @map("skipped_rows")
  flaggedRows       Int                @default(0) @map("flagged_rows")
  failedRows        Int                @default(0) @map("failed_rows")
  errorSummary      String?            @map("error_summary")
  queueJobId        String?            @map("queue_job_id")
  validatedAt       DateTime?          @map("validated_at")
  startedAt         DateTime?          @map("started_at")
  completedAt       DateTime?          @map("completed_at")
  cancelRequestedAt DateTime?          @map("cancel_requested_at")
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  source    CrmLeadSource? @relation(fields: [sourceId], references: [id])
  createdBy User           @relation("CrmImportJobCreatedBy", fields: [createdByUserId], references: [id])
  rows      CrmImportRow[]
  leads     CrmLead[]

  @@index([companyId, createdAt])
  @@index([companyId, createdByUserId])
  @@index([status, updatedAt])
  @@map("crm_import_jobs")
}

/// One line of an import file and what happened to it. Every row ends in a
/// known outcome — rows are never silently dropped.
model CrmImportRow {
  id                String                 @id @default(uuid()) @db.Uuid
  jobId             String                 @map("job_id") @db.Uuid
  rowNumber         Int                    @map("row_number")
  raw               Json
  normalized        Json?
  validation        CrmImportRowValidation @default(PENDING)
  messages          Json                   @default("[]")
  duplicateMatches  Json?                  @map("duplicate_matches")
  inFileDuplicateOf Int?                   @map("in_file_duplicate_of")
  outcome           CrmIngestOutcome       @default(PENDING)
  outcomeReason     String?                @map("outcome_reason")
  leadId            String?                @map("lead_id") @db.Uuid
  reviewedAt        DateTime?              @map("reviewed_at")
  reviewedByUserId  String?                @map("reviewed_by_user_id") @db.Uuid
  processedAt       DateTime?              @map("processed_at")

  job        CrmImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead       CrmLead?     @relation("CrmImportRowLead", fields: [leadId], references: [id], onDelete: SetNull)
  reviewedBy User?        @relation("CrmImportRowReviewedBy", fields: [reviewedByUserId], references: [id])

  @@unique([jobId, rowNumber])
  @@index([jobId, outcome])
  @@index([jobId, validation])
  @@map("crm_import_rows")
}

/// A lead's id in an external system (provider + external id, unique per
/// company) — how a re-delivered external lead is recognised.
model CrmLeadExternalRef {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  provider   String
  externalId String   @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  lead    CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, externalId])
  @@index([leadId])
  @@map("crm_lead_external_refs")
}

/// Inbox of every API / webhook lead submission: raw payload, idempotency
/// key, outcome and retry state.
model CrmIngestEvent {
  id                String                @id @default(uuid()) @db.Uuid
  companyId         String                @map("company_id") @db.Uuid
  channel           CrmLeadCaptureChannel
  provider          String
  apiKeyId          String?               @map("api_key_id") @db.Uuid
  webhookEndpointId String?               @map("webhook_endpoint_id") @db.Uuid
  idempotencyKey    String?               @map("idempotency_key")
  externalEventId   String?               @map("external_event_id")
  externalLeadId    String?               @map("external_lead_id")
  payload           Json
  status            CrmIngestEventStatus  @default(RECEIVED)
  outcome           CrmIngestOutcome      @default(PENDING)
  outcomeReason     String?               @map("outcome_reason")
  duplicateMatches  Json?                 @map("duplicate_matches")
  leadId            String?               @map("lead_id") @db.Uuid
  attempts          Int                   @default(0)
  lastError         String?               @map("last_error")
  nextRetryAt       DateTime?             @map("next_retry_at")
  processedAt       DateTime?             @map("processed_at")
  receivedAt        DateTime              @default(now()) @map("received_at")

  company         Company             @relation(fields: [companyId], references: [id])
  apiKey          CrmApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  webhookEndpoint CrmWebhookEndpoint? @relation(fields: [webhookEndpointId], references: [id], onDelete: SetNull)
  lead            CrmLead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([companyId, provider, idempotencyKey])
  @@index([companyId, receivedAt])
  @@index([companyId, status])
  @@map("crm_ingest_events")
}

/// API key for POST /api/v1/crm/leads/ingest. Only a SHA-256 hash is stored;
/// the full key is shown once at creation.
model CrmApiKey {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  name               String
  prefix             String             @unique
  keyHash            String             @map("key_hash")
  scopes             String[]           @default(["leads:ingest"])
  defaultSourceId    String?            @map("default_source_id") @db.Uuid
  defaultOwnerUserId String?            @map("default_owner_user_id") @db.Uuid
  duplicatePolicy    CrmDuplicatePolicy @default(UPDATE) @map("duplicate_policy")
  lastUsedAt         DateTime?          @map("last_used_at")
  expiresAt          DateTime?          @map("expires_at")
  revokedAt          DateTime?          @map("revoked_at")
  createdByUserId    String             @map("created_by_user_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")

  company       Company          @relation(fields: [companyId], references: [id])
  defaultSource CrmLeadSource?   @relation(fields: [defaultSourceId], references: [id])
  defaultOwner  User?            @relation("CrmApiKeyDefaultOwner", fields: [defaultOwnerUserId], references: [id])
  createdBy     User             @relation("CrmApiKeyCreatedBy", fields: [createdByUserId], references: [id])
  events        CrmIngestEvent[]

  @@index([companyId])
  @@map("crm_api_keys")
}

/// Incoming webhook endpoint: unique URL per endpoint, HMAC signing secret
/// (encrypted at rest) and a payload → lead field mapping. `provider` picks
/// the adapter ("generic" now; Meta / IndiaMART adapters later).
model CrmWebhookEndpoint {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  name               String
  provider           String             @default("generic")
  secretEncrypted    String             @map("secret_encrypted")
  fieldMapping       Json               @default("{}") @map("field_mapping")
  defaultSourceId    String?            @map("default_source_id") @db.Uuid
  defaultOwnerUserId String?            @map("default_owner_user_id") @db.Uuid
  duplicatePolicy    CrmDuplicatePolicy @default(UPDATE) @map("duplicate_policy")
  isActive           Boolean            @default(true) @map("is_active")
  lastReceivedAt     DateTime?          @map("last_received_at")
  createdByUserId    String             @map("created_by_user_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  company       Company          @relation(fields: [companyId], references: [id])
  defaultSource CrmLeadSource?   @relation(fields: [defaultSourceId], references: [id])
  defaultOwner  User?            @relation("CrmWebhookEndpointDefaultOwner", fields: [defaultOwnerUserId], references: [id])
  createdBy     User             @relation("CrmWebhookEndpointCreatedBy", fields: [createdByUserId], references: [id])
  events        CrmIngestEvent[]

  @@index([companyId])
  @@map("crm_webhook_endpoints")
}

// Field types for the shared CRM custom-field engine (Lead now; Contact,
// Company, Opportunity, Custom Objects and Forms later reuse the same table).
enum CrmCustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DECIMAL
  CURRENCY
  DATE
  DATETIME
  BOOLEAN
  DROPDOWN
  MULTI_SELECT
  PHONE
  EMAIL
  URL
}

// Opportunity lifecycle status. Pipelines/stages arrive in Phase 07 as extra
// nullable columns on CrmOpportunity, not a replacement table.
enum CrmOpportunityStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

enum CrmSavedViewVisibility {
  PRIVATE
  SHARED
}

model CrmLeadStatus {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  key       String
  name      String
  kind      CrmLeadStatusKind @default(OPEN)
  color     String?
  sortOrder Int               @default(0) @map("sort_order")
  isDefault Boolean           @default(false) @map("is_default")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  company Company   @relation(fields: [companyId], references: [id])
  leads   CrmLead[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
  @@map("crm_lead_statuses")
}

// `key` is how integrations identify their source ("facebook", "indiamart").
model CrmLeadSource {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  key       String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isSystem  Boolean  @default(false) @map("is_system")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company              @relation(fields: [companyId], references: [id])
  leads            CrmLead[]
  opportunities    CrmOpportunity[]
  importJobs       CrmImportJob[]
  apiKeys          CrmApiKey[]
  webhookEndpoints CrmWebhookEndpoint[]
  contacts         CrmContact[]
  companies        CrmCompany[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
  @@map("crm_lead_sources")
}

model CrmLead {
  id                     String                @id @default(uuid()) @db.Uuid
  companyId              String                @map("company_id") @db.Uuid
  branchId               String?               @map("branch_id") @db.Uuid
  leadNumber             String                @map("lead_number")
  firstName              String                @map("first_name")
  lastName               String?               @map("last_name")
  fullName               String                @map("full_name")
  // Prospect's organisation as typed on the lead; crmCompanyId links a real
  // CRM Company once known (on conversion or when picked on the form).
  companyName            String?               @map("company_name")
  designation            String?
  crmCompanyId           String?               @map("crm_company_id") @db.Uuid
  crmContactId           String?               @map("crm_contact_id") @db.Uuid
  email                  String?
  alternateEmail         String?               @map("alternate_email")
  phone                  String?
  mobile                 String?
  whatsapp               String?
  // Normalised match keys maintained by the lead service (lower-cased emails;
  // last 10 digits of every phone field) for indexed duplicate detection.
  emailKeys              String[]              @default([]) @map("email_keys")
  phoneKeys              String[]              @default([]) @map("phone_keys")
  // Lower-cased name/number/company/contact/requirement text for search.
  searchText             String                @default("") @map("search_text")
  statusId               String                @map("status_id") @db.Uuid
  sourceId               String?               @map("source_id") @db.Uuid
  ownerUserId            String?               @map("owner_user_id") @db.Uuid
  score                  Int                   @default(0)
  temperature            CrmLeadTemperature?
  industry               String?
  city                   String?
  state                  String?
  country                String?
  requirement            String?
  estimatedValue         Decimal?              @map("estimated_value") @db.Decimal(15, 2)
  currencyCode           String?               @map("currency_code") @db.Char(3)
  utmSource              String?               @map("utm_source")
  utmMedium              String?               @map("utm_medium")
  utmCampaign            String?               @map("utm_campaign")
  utmTerm                String?               @map("utm_term")
  utmContent             String?               @map("utm_content")
  campaignSource         String?               @map("campaign_source")
  referralSource         String?               @map("referral_source")
  // Real FK into Marketing's Campaign (2026-10-09, CRM Replacement) — the
  // UTM fields above are free-text only; this is what lets Marketing's
  // dashboard count leads/revenue per campaign with a real join, mirroring
  // the legacy CRM's own Lead.campaignId exactly.
  campaignId             String?               @map("campaign_id") @db.Uuid
  customFields           Json                  @default("{}") @map("custom_fields")
  // How the lead entered the CRM (set once on create, never changed by later
  // updates) and, for connectors, which provider sent it.
  captureChannel         CrmLeadCaptureChannel @default(MANUAL) @map("capture_channel")
  captureProvider        String?               @map("capture_provider")
  importJobId            String?               @map("import_job_id") @db.Uuid
  lastContactedAt        DateTime?             @map("last_contacted_at")
  nextFollowUpAt         DateTime?             @map("next_follow_up_at")
  convertedAt            DateTime?             @map("converted_at")
  convertedByUserId      String?               @map("converted_by_user_id") @db.Uuid
  convertedOpportunityId String?               @map("converted_opportunity_id") @db.Uuid
  archivedAt             DateTime?             @map("archived_at")
  archivedByUserId       String?               @map("archived_by_user_id") @db.Uuid
  createdByUserId        String                @map("created_by_user_id") @db.Uuid
  updatedByUserId        String?               @map("updated_by_user_id") @db.Uuid
  // Optimistic-locking counter: every update must send the version it loaded.
  version                Int                   @default(1)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id])
  branch               Branch?               @relation(fields: [branchId], references: [id])
  status               CrmLeadStatus         @relation(fields: [statusId], references: [id])
  source               CrmLeadSource?        @relation(fields: [sourceId], references: [id])
  owner                User?                 @relation("CrmLeadOwner", fields: [ownerUserId], references: [id])
  createdBy            User                  @relation("CrmLeadCreatedBy", fields: [createdByUserId], references: [id])
  crmCompany           CrmCompany?           @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)
  crmContact           CrmContact?           @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  convertedOpportunity CrmOpportunity?       @relation("CrmLeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  opportunities        CrmOpportunity[]      @relation("CrmOpportunityLead")
  importJob            CrmImportJob?         @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  externalRefs         CrmLeadExternalRef[]
  importRows           CrmImportRow[]        @relation("CrmImportRowLead")
  ingestEvents         CrmIngestEvent[]
  sourcedContacts      CrmContact[]          @relation("CrmContactSourceLead")
  sourcedCompanies     CrmCompany[]          @relation("CrmCompanySourceLead")
  campaign             Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignAttributions CampaignAttribution[]

  @@unique([companyId, leadNumber])
  @@index([companyId, archivedAt, createdAt])
  @@index([companyId, statusId])
  @@index([companyId, ownerUserId])
  @@index([companyId, sourceId])
  @@index([companyId, nextFollowUpAt])
  @@index([companyId, captureChannel])
  @@index([companyId, campaignId])
  @@index([emailKeys], type: Gin)
  @@index([phoneKeys], type: Gin)
  @@map("crm_leads")
}

// The CRM's view of a business relationship (Phase 05, 2026-10-03). The
// authoritative customer master stays the ERP `Customer`: a CRM company only
// references it (customer_id, unique) and never copies its commercial,
// tax or financial data. city/state/country are the company's headline
// location; full postal addresses live in crm_addresses.
model CrmCompany {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  name                String
  nameKey             String    @map("name_key")
  // Name without punctuation / legal suffixes ("Rao Exports Pvt. Ltd." →
  // "rao exports") — the duplicate-matching key; legalMatchKey the same for legalName.
  nameMatchKey        String    @default("") @map("name_match_key")
  legalName           String?   @map("legal_name")
  legalMatchKey       String?   @map("legal_match_key")
  displayName         String?   @map("display_name")
  companyType         String?   @map("company_type")
  website             String?
  // Bare host ("abc.com") for duplicate matching.
  websiteKey          String?   @map("website_key")
  industry            String?
  email               String?
  phone               String?
  mobile              String?
  city                String?
  state               String?
  postalCode          String?   @map("postal_code")
  country             String?
  emailKeys           String[]  @default([]) @map("email_keys")
  phoneKeys           String[]  @default([]) @map("phone_keys")
  searchText          String    @default("") @map("search_text")
  statusId            String?   @map("status_id") @db.Uuid
  sourceId            String?   @map("source_id") @db.Uuid
  sourceLeadId        String?   @map("source_lead_id") @db.Uuid
  primaryContactId    String?   @map("primary_contact_id") @db.Uuid
  customerId          String?   @unique @map("customer_id") @db.Uuid
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  customFields        Json      @default("{}") @map("custom_fields")
  lastActivityAt      DateTime? @map("last_activity_at")
  duplicateFlaggedAt  DateTime? @map("duplicate_flagged_at")
  flaggedDuplicateIds String[]  @default([]) @map("flagged_duplicate_ids") @db.Uuid
  mergedIntoId        String?   @map("merged_into_id") @db.Uuid
  mergedAt            DateTime? @map("merged_at")
  mergedByUserId      String?   @map("merged_by_user_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at")
  archivedByUserId    String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  updatedByUserId     String?   @map("updated_by_user_id") @db.Uuid
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company        Company           @relation(fields: [companyId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner          User?             @relation("CrmCompanyOwner", fields: [ownerUserId], references: [id])
  createdBy      User              @relation("CrmCompanyCreatedBy", fields: [createdByUserId], references: [id])
  status         CrmCompanyStatus? @relation(fields: [statusId], references: [id])
  source         CrmLeadSource?    @relation(fields: [sourceId], references: [id])
  sourceLead     CrmLead?          @relation("CrmCompanySourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  primaryContact CrmContact?       @relation("CrmCompanyPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  mergedInto     CrmCompany?       @relation("CrmCompanyMergedInto", fields: [mergedIntoId], references: [id])
  mergedFrom     CrmCompany[]      @relation("CrmCompanyMergedInto")
  leads          CrmLead[]
  contacts       CrmContact[]
  opportunities  CrmOpportunity[]
  addresses      CrmAddress[]
  mergesSurvived CrmCompanyMerge[] @relation("CrmCompanyMergeSurvivor")
  mergeRecord    CrmCompanyMerge?  @relation("CrmCompanyMergeMerged")
  conversations  CrmConversation[]

  @@index([companyId, nameKey])
  @@index([companyId, nameMatchKey])
  @@index([companyId, legalMatchKey])
  @@index([companyId, websiteKey])
  @@index([companyId, archivedAt, createdAt])
  @@index([companyId, ownerUserId])
  @@index([companyId, statusId])
  @@index([companyId, lastActivityAt])
  @@index([mergedIntoId])
  @@index([emailKeys], type: Gin)
  @@index([phoneKeys], type: Gin)
  @@map("crm_companies")
}

// Configurable company relationship statuses (Prospect, Customer, Partner…).
// Nothing in the code depends on a particular status; `key` is stable for
// integrations, names/colours/order are free to change.
model CrmCompanyStatus {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  key       String
  name      String
  color     String?
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company      @relation(fields: [companyId], references: [id])
  companies CrmCompany[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
  @@map("crm_company_statuses")
}

// One row per completed company merge (snapshot of the merged company;
// moved counts). Same contract as crm_contact_merges.
model CrmCompanyMerge {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  survivorId     String   @map("survivor_id") @db.Uuid
  mergedId       String   @unique @map("merged_id") @db.Uuid
  fieldChoices   Json     @default("{}") @map("field_choices")
  mergedSnapshot Json     @map("merged_snapshot")
  moved          Json     @default("{}")
  mergedByUserId String   @map("merged_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  company  Company    @relation(fields: [companyId], references: [id])
  survivor CrmCompany @relation("CrmCompanyMergeSurvivor", fields: [survivorId], references: [id])
  merged   CrmCompany @relation("CrmCompanyMergeMerged", fields: [mergedId], references: [id])

  @@index([companyId, survivorId])
  @@map("crm_company_merges")
}

// The CRM's person record (the ERP has no person master). Created manually,
// by lead conversion, or later by integrations; reaches the ERP Customer only
// through its CRM company (crm_companies.customer_id). Phase 04, 2026-10-02.
model CrmContact {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  crmCompanyId        String?   @map("crm_company_id") @db.Uuid
  firstName           String    @map("first_name")
  middleName          String?   @map("middle_name")
  lastName            String?   @map("last_name")
  fullName            String    @map("full_name")
  // Lower-cased, single-spaced full name for the name+company / name+email duplicate rules.
  nameKey             String    @default("") @map("name_key")
  designation         String?
  department          String?
  // The person's role in the relationship with their company ("Decision
  // maker", "Accounts"…). Free text with suggestions from crm_option_values.
  relationshipRole    String?   @map("relationship_role")
  email               String?
  alternateEmail      String?   @map("alternate_email")
  phone               String?
  mobile              String?
  whatsapp            String?
  // Normalised match keys over the core fields AND crm_contact_channels.
  emailKeys           String[]  @default([]) @map("email_keys")
  phoneKeys           String[]  @default([]) @map("phone_keys")
  searchText          String    @default("") @map("search_text")
  // Reuses the CRM source list (crm_lead_sources). sourceLeadId is the lead
  // this contact was created from on conversion (kept even if more leads link later).
  sourceId            String?   @map("source_id") @db.Uuid
  sourceLeadId        String?   @map("source_lead_id") @db.Uuid
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  customFields        Json      @default("{}") @map("custom_fields")
  // Optional link to the specific Buyer master row (under this contact's
  // linked Customer, via crmCompany.customerId) this contact represents
  // (2026-10-09, CRM Replacement) -- a soft link, never enforced, following
  // the exact same pattern as CrmCompany.customerId.
  buyerId             String?   @map("buyer_id") @db.Uuid
  // Last time anything happened to the contact (its own CRM events).
  lastActivityAt      DateTime? @map("last_activity_at")
  // Set when a FLAG duplicate rule matched on save: ids of the suspected
  // duplicates, cleared by merging or by "not a duplicate".
  duplicateFlaggedAt  DateTime? @map("duplicate_flagged_at")
  flaggedDuplicateIds String[]  @default([]) @map("flagged_duplicate_ids") @db.Uuid
  // Merge never deletes: the merged contact is archived and points at the survivor.
  mergedIntoId        String?   @map("merged_into_id") @db.Uuid
  mergedAt            DateTime? @map("merged_at")
  mergedByUserId      String?   @map("merged_by_user_id") @db.Uuid
  archivedAt          DateTime? @map("archived_at")
  archivedByUserId    String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  updatedByUserId     String?   @map("updated_by_user_id") @db.Uuid
  // Optimistic-locking counter (same contract as crm_leads.version).
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company                  Company                      @relation(fields: [companyId], references: [id])
  crmCompany               CrmCompany?                  @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)
  owner                    User?                        @relation("CrmContactOwner", fields: [ownerUserId], references: [id])
  createdBy                User                         @relation("CrmContactCreatedBy", fields: [createdByUserId], references: [id])
  source                   CrmLeadSource?               @relation(fields: [sourceId], references: [id])
  sourceLead               CrmLead?                     @relation("CrmContactSourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  mergedInto               CrmContact?                  @relation("CrmContactMergedInto", fields: [mergedIntoId], references: [id])
  mergedFrom               CrmContact[]                 @relation("CrmContactMergedInto")
  leads                    CrmLead[]
  opportunities            CrmOpportunity[]
  addresses                CrmAddress[]
  channels                 CrmContactChannel[]
  consents                 CrmContactConsent[]
  mergesSurvived           CrmContactMerge[]            @relation("CrmContactMergeSurvivor")
  mergeRecord              CrmContactMerge?             @relation("CrmContactMergeMerged")
  primaryOf                CrmCompany[]                 @relation("CrmCompanyPrimaryContact")
  buyer                    Buyer?                       @relation(fields: [buyerId], references: [id])
  conversations            CrmConversation[]
  conversationParticipants CrmConversationParticipant[]

  @@index([companyId, crmCompanyId])
  @@index([companyId, archivedAt, createdAt])
  @@index([companyId, ownerUserId])
  @@index([companyId, nameKey])
  @@index([companyId, lastActivityAt])
  @@index([mergedIntoId])
  @@index([emailKeys], type: Gin)
  @@index([phoneKeys], type: Gin)
  @@map("crm_contacts")
}

// ─────────────────────────────────────────────────────────────
// CRM — Phase 04 Contacts (2026-10-02). See docs/crm/PHASE_04_CONTACTS.md.
// ─────────────────────────────────────────────────────────────

enum CrmAddressType {
  BILLING
  SHIPPING
  OFFICE
  HOME
  FACTORY
  OTHER
}

// Structured addresses for CRM records (the ERP has only free-text address
// fields on Customer). Exactly one owner column is set (CHECK constraint):
// contacts now, CRM companies from Phase 05.
model CrmAddress {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  contactId       String?        @map("contact_id") @db.Uuid
  crmCompanyId    String?        @map("crm_company_id") @db.Uuid
  addressType     CrmAddressType @default(OFFICE) @map("address_type")
  label           String?
  line1           String
  line2           String?
  city            String?
  state           String?
  postalCode      String?        @map("postal_code")
  country         String?
  isPrimary       Boolean        @default(false) @map("is_primary")
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  contact    CrmContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  crmCompany CrmCompany? @relation(fields: [crmCompanyId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([crmCompanyId])
  @@map("crm_addresses")
}

// Additional ways to reach a contact beyond the core email/phone columns
// (second mobile, LinkedIn, website…). `channelType` is validated in code
// (src/modules/crm/contacts/contact-channels.ts) so a new channel needs no
// migration. Email/phone-type values feed duplicate matching.
model CrmContactChannel {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  contactId       String   @map("contact_id") @db.Uuid
  channelType     String   @map("channel_type")
  value           String
  valueKey        String   @map("value_key")
  label           String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company Company    @relation(fields: [companyId], references: [id])
  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channelType, valueKey])
  @@map("crm_contact_channels")
}

enum CrmContactabilityStatus {
  ALLOWED
  DO_NOT_CONTACT
  UNSUBSCRIBED
  BOUNCED
}

// Contactability / DND per channel (one current row per contact+channel;
// every change is also an AuditLog row and a contact.contactability_changed
// event). Channel "ALL" overrides every channel. Campaigns, sequences and the
// inbox (later phases) must check canContact() before sending.
model CrmContactConsent {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @map("company_id") @db.Uuid
  contactId       String                  @map("contact_id") @db.Uuid
  channel         String
  status          CrmContactabilityStatus
  reason          String?
  source          String                  @default("MANUAL")
  changedAt       DateTime                @default(now()) @map("changed_at")
  changedByUserId String?                 @map("changed_by_user_id") @db.Uuid

  company Company    @relation(fields: [companyId], references: [id])
  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel])
  @@index([companyId, channel, status])
  @@map("crm_contact_consents")
}

// One row per completed merge. `mergedSnapshot` keeps the merged contact as
// it was (core fields, channels, addresses, custom fields) so nothing is lost
// and a future unmerge has the data it needs.
model CrmContactMerge {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  survivorId     String   @map("survivor_id") @db.Uuid
  mergedId       String   @unique @map("merged_id") @db.Uuid
  fieldChoices   Json     @default("{}") @map("field_choices")
  mergedSnapshot Json     @map("merged_snapshot")
  moved          Json     @default("{}")
  mergedByUserId String   @map("merged_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  company  Company    @relation(fields: [companyId], references: [id])
  survivor CrmContact @relation("CrmContactMergeSurvivor", fields: [survivorId], references: [id])
  merged   CrmContact @relation("CrmContactMergeMerged", fields: [mergedId], references: [id])

  @@index([companyId, survivorId])
  @@map("crm_contact_merges")
}

// Admin-managed suggestion lists (contact departments, designations,
// relationship roles). `listKey` is validated in code.
model CrmOptionValue {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  listKey   String   @map("list_key")
  value     String
  valueKey  String   @map("value_key")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company              @relation(fields: [companyId], references: [id])
  templates CrmMessageTemplate[]

  @@unique([companyId, listKey, valueKey])
  @@index([companyId, listKey, sortOrder])
  @@map("crm_option_values")
}

// Lean Phase 02 version (created from a lead). Phase 06/07 add pages,
// pipeline and stage.
model CrmOpportunity {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  opportunityNumber String               @map("opportunity_number")
  name              String
  // Phase 06: lower/space-normalised name for the open-duplicate warning.
  nameKey           String               @default("") @map("name_key")
  leadId            String?              @map("lead_id") @db.Uuid
  crmContactId      String?              @map("crm_contact_id") @db.Uuid
  crmCompanyId      String?              @map("crm_company_id") @db.Uuid
  sourceId          String?              @map("source_id") @db.Uuid
  ownerUserId       String?              @map("owner_user_id") @db.Uuid
  // Phase 06: minimum pipeline/stage relationship (management UI is Phase 07).
  pipelineId        String?              @map("pipeline_id") @db.Uuid
  stageId           String?              @map("stage_id") @db.Uuid
  stageChangedAt    DateTime?            @map("stage_changed_at")
  status            CrmOpportunityStatus @default(OPEN)
  // Estimated CRM value — never overwritten from ERP documents.
  amount            Decimal?             @db.Decimal(15, 2)
  currencyCode      String?              @map("currency_code") @db.Char(3)
  // 0–100 (CHECK constraint in the migration).
  probability       Int?
  // Phase 07: STAGE = follows the stage default; MANUAL = set by a user (kept on stage changes).
  probabilitySource String?              @map("probability_source")
  expectedCloseDate DateTime?            @map("expected_close_date") @db.Date
  description       String?
  customFields      Json                 @default("{}") @map("custom_fields")
  closedAt          DateTime?            @map("closed_at")
  closedByUserId    String?              @map("closed_by_user_id") @db.Uuid
  closeReason       String?              @map("close_reason")
  // Name, number and linked ERP document numbers (company/contact are searched through their own keys).
  searchText        String               @default("") @map("search_text")
  lastActivityAt    DateTime?            @map("last_activity_at")
  archivedAt        DateTime?            @map("archived_at")
  archivedByUserId  String?              @map("archived_by_user_id") @db.Uuid
  updatedByUserId   String?              @map("updated_by_user_id") @db.Uuid
  version           Int                  @default(1)
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  company            Company                      @relation(fields: [companyId], references: [id])
  lead               CrmLead?                     @relation("CrmOpportunityLead", fields: [leadId], references: [id], onDelete: SetNull)
  crmContact         CrmContact?                  @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  crmCompany         CrmCompany?                  @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)
  source             CrmLeadSource?               @relation(fields: [sourceId], references: [id])
  owner              User?                        @relation("CrmOpportunityOwner", fields: [ownerUserId], references: [id])
  createdBy          User                         @relation("CrmOpportunityCreatedBy", fields: [createdByUserId], references: [id])
  pipeline           CrmPipeline?                 @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage              CrmPipelineStage?            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  convertedFromLeads CrmLead[]                    @relation("CrmLeadConvertedOpportunity")
  erpLinks           CrmOpportunityErpLink[]
  stageHistory       CrmOpportunityStageHistory[]
  conversations      CrmConversation[]

  originatingSalesOrders SalesOrder[]

  @@unique([companyId, opportunityNumber])
  @@index([companyId, status])
  @@index([companyId, leadId])
  @@index([companyId, archivedAt, createdAt])
  @@index([companyId, crmCompanyId])
  @@index([companyId, crmContactId])
  @@index([companyId, pipelineId, stageId])
  @@index([companyId, ownerUserId])
  @@index([companyId, expectedCloseDate])
  @@index([companyId, lastActivityAt])
  @@index([companyId, nameKey])
  // Phase 08: board columns (pipeline → stage, newest stage entry first).
  @@index([companyId, pipelineId, stageId, stageChangedAt], map: "crm_opportunities_board_idx")
  @@map("crm_opportunities")
}

// Phase 06 (2026-10-04): the minimum pipeline/stage relationship opportunities
// need. Pipeline management (CRUD, ordering, rules, board) is Phase 07; until
// then a default "Sales" pipeline is created lazily per company.
model CrmPipeline {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  key              String
  name             String
  // Phase 07: lower/space-normalised name — unique among non-archived pipelines (partial index in SQL).
  nameKey          String    @default("") @map("name_key")
  description      String?
  // Exactly one default per company (partial unique index in SQL); used when an opportunity is created without a pipeline.
  isDefault        Boolean   @default(false) @map("is_default")
  // Kept in sync with archivedAt (false while archived) for Phase 06 readers.
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  archivedAt       DateTime? @map("archived_at")
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  updatedByUserId  String?   @map("updated_by_user_id") @db.Uuid
  version          Int       @default(1)
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company         Company                  @relation(fields: [companyId], references: [id])
  stages          CrmPipelineStage[]
  opportunities   CrmOpportunity[]
  transitionRules CrmStageTransitionRule[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  pipelineId       String    @map("pipeline_id") @db.Uuid
  key              String
  name             String
  // Phase 07: unique among the pipeline's non-archived stages (partial index in SQL).
  nameKey          String    @default("") @map("name_key")
  description      String?
  // Default probability (0–100) applied when an opportunity enters the stage (unless set by hand).
  probability      Int?
  // One default (starting) stage per pipeline (partial unique index in SQL).
  isDefault        Boolean   @default(false) @map("is_default")
  // Kept in sync with archivedAt (false while archived) for Phase 06 readers.
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  // Field keys an opportunity must have before it may enter this stage
  // (registry: src/modules/crm/pipelines/stage-requirements.ts).
  requiredFields   Json      @default("[]") @map("required_fields")
  // ANY = every move out of this stage is allowed unless a rule blocks it;
  // ONLY_LISTED = only moves to stages with an "allowed" rule.
  transitionMode   String    @default("ANY") @map("transition_mode")
  archivedAt       DateTime? @map("archived_at")
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  updatedByUserId  String?   @map("updated_by_user_id") @db.Uuid
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company       Company                  @relation(fields: [companyId], references: [id])
  pipeline      CrmPipeline              @relation(fields: [pipelineId], references: [id])
  opportunities CrmOpportunity[]
  rulesFrom     CrmStageTransitionRule[] @relation("CrmStageTransitionFrom")
  rulesTo       CrmStageTransitionRule[] @relation("CrmStageTransitionTo")

  @@unique([pipelineId, key])
  @@index([companyId, pipelineId, sortOrder])
  @@map("crm_pipeline_stages")
}

// Phase 07: a move between two stages of one pipeline — allowed or blocked —
// with extra fields required for that specific move.
model CrmStageTransitionRule {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  pipelineId      String   @map("pipeline_id") @db.Uuid
  fromStageId     String   @map("from_stage_id") @db.Uuid
  toStageId       String   @map("to_stage_id") @db.Uuid
  allowed         Boolean  @default(true)
  requiredFields  Json     @default("[]") @map("required_fields")
  message         String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id])
  pipeline  CrmPipeline      @relation(fields: [pipelineId], references: [id])
  fromStage CrmPipelineStage @relation("CrmStageTransitionFrom", fields: [fromStageId], references: [id])
  toStage   CrmPipelineStage @relation("CrmStageTransitionTo", fields: [toStageId], references: [id])

  @@unique([fromStageId, toStageId])
  @@index([companyId, pipelineId])
  @@map("crm_stage_transition_rules")
}

// Phase 07: one row per applied stage / pipeline change of an opportunity
// (rejected moves are never written). Read by the detail page and the
// conversion report.
model CrmOpportunityStageHistory {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  opportunityId     String   @map("opportunity_id") @db.Uuid
  // INITIAL | STAGE_CHANGE | PIPELINE_TRANSFER | STAGE_REASSIGNED
  changeType        String   @map("change_type")
  // FORM | STAGE_ACTION | BULK | TRANSFER | STAGE_ARCHIVE | PIPELINE_ARCHIVE | CREATE | BACKFILL
  source            String
  fromPipelineId    String?  @map("from_pipeline_id") @db.Uuid
  toPipelineId      String   @map("to_pipeline_id") @db.Uuid
  fromStageId       String?  @map("from_stage_id") @db.Uuid
  toStageId         String   @map("to_stage_id") @db.Uuid
  // Names at the time of the change (stages can be renamed later).
  fromStageName     String?  @map("from_stage_name")
  toStageName       String   @map("to_stage_name")
  fromProbability   Int?     @map("from_probability")
  toProbability     Int?     @map("to_probability")
  probabilitySource String?  @map("probability_source")
  // Always APPLIED today; kept for future audited rejections.
  result            String   @default("APPLIED")
  reason            String?
  changedByUserId   String?  @map("changed_by_user_id") @db.Uuid
  changedAt         DateTime @default(now()) @map("changed_at")

  company     Company        @relation(fields: [companyId], references: [id])
  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id])

  @@index([companyId, opportunityId, changedAt], map: "crm_opp_stage_history_opportunity_idx")
  @@index([companyId, toPipelineId, toStageId], map: "crm_opp_stage_history_stage_idx")
  @@map("crm_opportunity_stage_history")
}

// Phase 06: an opportunity's references to authoritative ERP documents
// (many per opportunity — e.g. several revisions). `docType` is validated in
// code by a provider registry (crm-opportunity-erp.service.ts), so a future
// ERP Quotation module plugs in without a migration. Only the document's
// identifier and number are stored; everything else is read live from the ERP.
model CrmOpportunityErpLink {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  opportunityId  String   @map("opportunity_id") @db.Uuid
  docType        String   @map("doc_type")
  docId          String   @map("doc_id") @db.Uuid
  docNumber      String   @map("doc_number")
  linkedByUserId String   @map("linked_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  company     Company        @relation(fields: [companyId], references: [id])
  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id])

  @@unique([opportunityId, docType, docId])
  @@index([companyId, docType, docId])
  @@map("crm_opportunity_erp_links")
}

// Reusable tags for every CRM record type. `nameKey` (lower-cased, trimmed,
// single-spaced) stops "VIP", "vip " and "Vip" becoming three tags.
model CrmTag {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  nameKey         String   @map("name_key")
  color           String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company     Company        @relation(fields: [companyId], references: [id])
  assignments CrmEntityTag[]

  @@unique([companyId, nameKey])
  @@map("crm_tags")
}

model CrmEntityTag {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  tagId           String        @map("tag_id") @db.Uuid
  entityType      CrmEntityType @map("entity_type")
  entityId        String        @map("entity_id") @db.Uuid
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  tag     CrmTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([companyId, entityType, entityId])
  @@map("crm_entity_tags")
}

// Notes on any CRM record. Soft-deleted (deletedAt) so history survives;
// edits are kept in AuditLog.
model CrmNote {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  entityType      CrmEntityType @map("entity_type")
  entityId        String        @map("entity_id") @db.Uuid
  body            String
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  updatedByUserId String?       @map("updated_by_user_id") @db.Uuid
  editedAt        DateTime?     @map("edited_at")
  deletedAt       DateTime?     @map("deleted_at")
  deletedByUserId String?       @map("deleted_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("CrmNoteAuthor", fields: [createdByUserId], references: [id])

  @@index([companyId, entityType, entityId, createdAt])
  @@map("crm_notes")
}

// Phase 09 — CRM activities: tasks, calls, meetings, appointments and logged
// communication (email / SMS / WhatsApp / other). The ERP has no task or
// activity module; notes stay in crm_notes. `type`, `status`, `priority`,
// `direction` and `source` are validated in code (src/modules/crm/activities/
// activity-registry.ts) so a new type needs no migration. Overdue is derived
// from due_at / all_day / status, never stored. Rows are soft-deleted and a
// completed activity is never deleted.
model CrmActivity {
  id                    String        @id @default(uuid()) @db.Uuid
  companyId             String        @map("company_id") @db.Uuid
  type                  String
  subject               String
  description           String?
  // PENDING | IN_PROGRESS | COMPLETED | CANCELLED (logged activities are COMPLETED).
  status                String        @default("PENDING")
  // LOW | NORMAL | HIGH | URGENT
  priority              String        @default("NORMAL")
  // The record it was created on; crm_activity_links holds every record it shows on.
  entityType            CrmEntityType @map("entity_type")
  entityId              String        @map("entity_id") @db.Uuid
  assignedToUserId      String?       @map("assigned_to_user_id") @db.Uuid
  // When it is due / scheduled to start. All-day items store the business-day start.
  dueAt                 DateTime?     @map("due_at")
  allDay                Boolean       @default(false) @map("all_day")
  endAt                 DateTime?     @map("end_at")
  // First due date ever set (kept when rescheduled).
  originalDueAt         DateTime?     @map("original_due_at")
  rescheduleCount       Int           @default(0) @map("reschedule_count")
  // Minutes before due (0 = at due time); null = no reminder.
  reminderOffsetMinutes Int?          @map("reminder_offset_minutes")
  reminderAt            DateTime?     @map("reminder_at")
  // PENDING (scheduled) | SENT | CANCELLED; null = no reminder.
  reminderState         String?       @map("reminder_state")
  reminderSentAt        DateTime?     @map("reminder_sent_at")
  outcome               String?
  // INBOUND | OUTBOUND (calls and messages)
  direction             String?
  durationMinutes       Int?          @map("duration_minutes")
  location              String?
  // Phase 10 — appointments (type APPOINTMENT). `status` then holds the
  // appointment lifecycle (SCHEDULED | CONFIRMED | RESCHEDULED | COMPLETED |
  // CANCELLED | NO_SHOW); due_at / end_at are the start / end instants (UTC)
  // and `timezone` is the IANA zone the times were entered in.
  timezone              String?
  videoLink             String?       @map("video_link")
  appointmentType       String?       @map("appointment_type")
  confirmedAt           DateTime?     @map("confirmed_at")
  confirmedByUserId     String?       @map("confirmed_by_user_id") @db.Uuid
  cancelledAt           DateTime?     @map("cancelled_at")
  cancelledByUserId     String?       @map("cancelled_by_user_id") @db.Uuid
  cancelReason          String?       @map("cancel_reason")
  noShowAt              DateTime?     @map("no_show_at")
  noShowByUserId        String?       @map("no_show_by_user_id") @db.Uuid
  noShowReason          String?       @map("no_show_reason")
  completedAt           DateTime?     @map("completed_at")
  completedByUserId     String?       @map("completed_by_user_id") @db.Uuid
  // MANUAL | API | an integration key (future email / WhatsApp / telephony connectors).
  source                String        @default("MANUAL")
  externalRef           String?       @map("external_ref")
  metadata              Json          @default("{}")
  deletedAt             DateTime?     @map("deleted_at")
  deletedByUserId       String?       @map("deleted_by_user_id") @db.Uuid
  createdByUserId       String        @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?       @map("updated_by_user_id") @db.Uuid
  version               Int           @default(1)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id])
  assignedTo User?             @relation("CrmActivityAssignee", fields: [assignedToUserId], references: [id])
  createdBy  User              @relation("CrmActivityCreatedBy", fields: [createdByUserId], references: [id])
  links      CrmActivityLink[]

  @@index([companyId, assignedToUserId, status, dueAt], map: "crm_activities_assignee_idx")
  @@index([companyId, status, dueAt], map: "crm_activities_due_idx")
  @@index([companyId, entityType, entityId, createdAt], map: "crm_activities_entity_idx")
  @@index([companyId, type, createdAt], map: "crm_activities_type_idx")
  @@index([companyId, createdByUserId, createdAt], map: "crm_activities_creator_idx")
  @@map("crm_activities")
}

// Every CRM record an activity appears on (polymorphic, like notes and tags).
// The record it was created on is `isPrimary`; an activity on an opportunity
// is also linked to that opportunity's company and contact.
model CrmActivityLink {
  id         String        @id @default(uuid()) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  activityId String        @map("activity_id") @db.Uuid
  entityType CrmEntityType @map("entity_type")
  entityId   String        @map("entity_id") @db.Uuid
  isPrimary  Boolean       @default(false) @map("is_primary")
  createdAt  DateTime      @default(now()) @map("created_at")

  company  Company     @relation(fields: [companyId], references: [id])
  activity CrmActivity @relation(fields: [activityId], references: [id])

  @@unique([activityId, entityType, entityId], map: "crm_activity_links_unique")
  @@index([companyId, entityType, entityId, activityId], map: "crm_activity_links_entity_idx")
  @@map("crm_activity_links")
}

// ─────────────────────────────────────────────────────────────
// CRM — Phase 11 Unified Conversations (2026-10-08).
// See docs/crm/PHASE_11_UNIFIED_CONVERSATIONS.md.
//
// One provider-neutral model for every channel: a channel (configured
// connection) → conversations (threads) → messages + participants. Channel
// providers (src/core/communication) only translate payloads; the CRM never
// stores provider-specific JSON. Internal notes are CrmNote rows on the
// CONVERSATION entity (never in this table, so they can never be sent).
// Type / status / kind columns are validated in code
// (src/modules/crm/conversations/conversation-registry.ts).
// ─────────────────────────────────────────────────────────────

/// A configured communication channel (a WhatsApp number, a support mailbox,
/// a website chat…). `provider` picks the adapter ("generic" now). The
/// webhook signing secret is encrypted at rest like CRM webhook endpoints;
/// `config` holds non-secret settings only.
model CrmChannel {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  // EMAIL | SMS | WHATSAPP | FACEBOOK_MESSENGER | INSTAGRAM | WEB_CHAT | OTHER
  channelType           String    @map("channel_type")
  name                  String
  provider              String    @default("generic")
  // ACTIVE | PAUSED
  status                String    @default("ACTIVE")
  // The business identity on this channel (mailbox, phone number, page name) — display only.
  address               String?
  config                Json      @default("{}")
  secretEncrypted       String    @map("secret_encrypted")
  defaultAssigneeUserId String?   @map("default_assignee_user_id") @db.Uuid
  lastInboundAt         DateTime? @map("last_inbound_at")
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  company         Company           @relation(fields: [companyId], references: [id])
  defaultAssignee User?             @relation("CrmChannelDefaultAssignee", fields: [defaultAssigneeUserId], references: [id])
  createdBy       User              @relation("CrmChannelCreatedBy", fields: [createdByUserId], references: [id])
  conversations   CrmConversation[]
  messages        CrmMessage[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("crm_channels")
}

/// A logical thread on one channel. Contact / company / opportunity are each
/// optional; `matchStatus` UNMATCHED / MULTIPLE puts it in the unmatched
/// queue until a user links it. `unreadCount` = inbound messages not yet seen
/// by the team; denormalised last-message fields keep the inbox one query.
model CrmConversation {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  channelId            String    @map("channel_id") @db.Uuid
  channelType          String    @map("channel_type")
  subject              String?
  // OPEN | PENDING | CLOSED | ARCHIVED
  status               String    @default("OPEN")
  // MATCHED | UNMATCHED | MULTIPLE
  matchStatus          String    @default("UNMATCHED") @map("match_status")
  // Contact ids found when matching was ambiguous (MULTIPLE) — the user picks one.
  matchCandidateIds    String[]  @default([]) @map("match_candidate_ids") @db.Uuid
  contactId            String?   @map("contact_id") @db.Uuid
  crmCompanyId         String?   @map("crm_company_id") @db.Uuid
  opportunityId        String?   @map("opportunity_id") @db.Uuid
  assignedToUserId     String?   @map("assigned_to_user_id") @db.Uuid
  // Provider thread reference (email root Message-ID, chat session…), when the provider has one.
  externalThreadRef    String?   @map("external_thread_ref")
  // Who the conversation is with, for the inbox row (kept from the first customer participant).
  displayName          String?   @map("display_name")
  displayIdentifier    String?   @map("display_identifier")
  unreadCount          Int       @default(0) @map("unread_count")
  lastReadAt           DateTime? @map("last_read_at")
  lastReadByUserId     String?   @map("last_read_by_user_id") @db.Uuid
  messageCount         Int       @default(0) @map("message_count")
  lastMessageAt        DateTime? @map("last_message_at")
  lastMessagePreview   String?   @map("last_message_preview")
  lastMessageDirection String?   @map("last_message_direction")
  lastInboundAt        DateTime? @map("last_inbound_at")
  lastOutboundAt       DateTime? @map("last_outbound_at")
  // Lower-cased subject, participants and linked record names (inbox search).
  searchText           String    @default("") @map("search_text")
  closedAt             DateTime? @map("closed_at")
  closedByUserId       String?   @map("closed_by_user_id") @db.Uuid
  archivedAt           DateTime? @map("archived_at")
  createdByUserId      String?   @map("created_by_user_id") @db.Uuid
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  company      Company                      @relation(fields: [companyId], references: [id])
  channel      CrmChannel                   @relation(fields: [channelId], references: [id])
  contact      CrmContact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  crmCompany   CrmCompany?                  @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)
  opportunity  CrmOpportunity?              @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignedTo   User?                        @relation("CrmConversationAssignee", fields: [assignedToUserId], references: [id])
  participants CrmConversationParticipant[]
  messages     CrmMessage[]

  @@index([companyId, lastMessageAt], map: "crm_conversations_recent_idx")
  @@index([companyId, status, lastMessageAt], map: "crm_conversations_status_idx")
  @@index([companyId, assignedToUserId, lastMessageAt], map: "crm_conversations_assignee_idx")
  @@index([companyId, channelId, lastMessageAt], map: "crm_conversations_channel_idx")
  @@index([companyId, contactId], map: "crm_conversations_contact_idx")
  @@index([companyId, crmCompanyId], map: "crm_conversations_company_idx")
  @@index([companyId, opportunityId], map: "crm_conversations_opportunity_idx")
  @@map("crm_conversations")
}

/// Who takes part in a conversation: the customer identity on the channel
/// (email address, phone number, provider user id, anonymous chat session),
/// linked to a contact once known, and ERP users who replied.
model CrmConversationParticipant {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  conversationId     String   @map("conversation_id") @db.Uuid
  channelId          String   @map("channel_id") @db.Uuid
  // CONTACT | EXTERNAL | ANONYMOUS | USER
  participantType    String   @map("participant_type")
  // CUSTOMER | AGENT | CC
  role               String   @default("CUSTOMER")
  // EMAIL | PHONE | PROVIDER_ID | SESSION (null for users)
  identifierKind     String?  @map("identifier_kind")
  externalIdentifier String?  @map("external_identifier")
  // Normalised for matching (lower-cased email, last 10 phone digits, raw id).
  identifierKey      String?  @map("identifier_key")
  displayName        String?  @map("display_name")
  contactId          String?  @map("contact_id") @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      CrmContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user         User?           @relation("CrmConversationParticipantUser", fields: [userId], references: [id])

  @@index([conversationId])
  @@index([companyId, channelId, identifierKind, identifierKey], map: "crm_conversation_participants_identity_idx")
  @@index([companyId, identifierKind, identifierKey], map: "crm_conversation_participants_key_idx")
  @@map("crm_conversation_participants")
}

/// One customer-visible message (inbound or outbound) — never an internal
/// note. `(channel_id, provider_message_id)` is unique so a provider
/// retrying a webhook can never create the same message twice. Ordered by
/// `occurred_at` (provider time for inbound) with id as the tie-breaker.
model CrmMessage {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  conversationId      String    @map("conversation_id") @db.Uuid
  channelId           String    @map("channel_id") @db.Uuid
  // INBOUND | OUTBOUND
  direction           String
  // TEXT | IMAGE | FILE | AUDIO | VIDEO | DOCUMENT | LOCATION | SYSTEM | OTHER
  messageType         String    @default("TEXT") @map("message_type")
  subject             String?
  body                String    @default("")
  senderIdentifier    String?   @map("sender_identifier")
  senderName          String?   @map("sender_name")
  recipientIdentifier String?   @map("recipient_identifier")
  // The ERP user who wrote an outbound message.
  senderUserId        String?   @map("sender_user_id") @db.Uuid
  // RECEIVED (inbound) | QUEUED | SENT | DELIVERED | READ | FAILED (outbound)
  status              String
  providerMessageId   String?   @map("provider_message_id")
  occurredAt          DateTime  @default(now()) @map("occurred_at")
  sentAt              DateTime? @map("sent_at")
  deliveredAt         DateTime? @map("delivered_at")
  readAt              DateTime? @map("read_at")
  failedAt            DateTime? @map("failed_at")
  // Inbound: when a CRM user first saw it (drives unread counts).
  seenAt              DateTime? @map("seen_at")
  seenByUserId        String?   @map("seen_by_user_id") @db.Uuid
  // Safe, user-facing failure reason (never raw provider responses or credentials).
  errorCode           String?   @map("error_code")
  errorMessage        String?   @map("error_message")
  attempts            Int       @default(0)
  lastAttemptAt       DateTime? @map("last_attempt_at")
  // Provider-neutral extras: email threading headers, location, reply-to id…
  metadata            Json      @default("{}")
  // Phase 12: the template and exact version an outbound message was written
  // from. The message keeps its own rendered subject/body — history never
  // depends on the template staying unchanged.
  templateId          String?   @map("template_id") @db.Uuid
  templateVersionId   String?   @map("template_version_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company         Company                    @relation(fields: [companyId], references: [id])
  conversation    CrmConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel         CrmChannel                 @relation(fields: [channelId], references: [id])
  senderUser      User?                      @relation("CrmMessageSender", fields: [senderUserId], references: [id])
  template        CrmMessageTemplate?        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion CrmMessageTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  attachments     CrmMessageAttachment[]

  @@index([conversationId, occurredAt, id], map: "crm_messages_thread_idx")
  @@index([companyId, occurredAt], map: "crm_messages_recent_idx")
  @@map("crm_messages")
}

/// A file on a message. The bytes live in the ERP's shared file storage
/// (`attachments` row, related module CRM_CONVERSATION); this row is the
/// CRM-side record. Provider media not (yet) downloaded keeps only its
/// provider reference (attachment_id null).
model CrmMessageAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  messageId        String   @map("message_id") @db.Uuid
  attachmentId     String?  @map("attachment_id") @db.Uuid
  // IMAGE | DOCUMENT | AUDIO | VIDEO | FILE
  kind             String
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  sizeBytes        Int?     @map("size_bytes")
  providerMediaRef String?  @map("provider_media_ref")
  createdAt        DateTime @default(now()) @map("created_at")

  message    CrmMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  attachment Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([attachmentId])
  @@map("crm_message_attachments")
}

// Metadata for the shared custom-field engine. Values live in each record's
// `customFields` JSON keyed by `key`, so adding a field never needs a
// migration. `key` and `fieldType` are fixed once created.
// ─────────────────────────────────────────────────────────────
// CRM — Phase 12 Message Templates (2026-10-08). See docs/crm/PHASE_12_MESSAGE_TEMPLATES.md.
// ─────────────────────────────────────────────────────────────

/// A reusable, provider-neutral message template for one channel type.
/// Content lives in immutable versions; `currentVersionId` is the one used
/// for new messages. Categories reuse crm_option_values (list
/// "template_category"). Never hard-deleted — archived instead.
model CrmMessageTemplate {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  name                 String
  // Lower-cased, single-spaced name: unique among non-archived templates (partial index in SQL).
  nameKey              String    @map("name_key")
  // EMAIL | SMS | WHATSAPP (enabled today); other channel types are allowed by the CHECK for later.
  channelType          String    @map("channel_type")
  categoryId           String?   @map("category_id") @db.Uuid
  description          String?
  // DRAFT | ACTIVE | ARCHIVED
  status               String    @default("DRAFT")
  currentVersionId     String?   @unique @map("current_version_id") @db.Uuid
  currentVersionNumber Int       @default(0) @map("current_version_number")
  searchText           String    @default("") @map("search_text")
  duplicatedFromId     String?   @map("duplicated_from_id") @db.Uuid
  activatedAt          DateTime? @map("activated_at")
  activatedByUserId    String?   @map("activated_by_user_id") @db.Uuid
  archivedAt           DateTime? @map("archived_at")
  archivedByUserId     String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  updatedByUserId      String?   @map("updated_by_user_id") @db.Uuid
  // Optimistic-locking counter (same contract as crm_leads.version).
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  company        Company                     @relation(fields: [companyId], references: [id])
  category       CrmOptionValue?             @relation(fields: [categoryId], references: [id])
  createdBy      User                        @relation("CrmMessageTemplateCreatedBy", fields: [createdByUserId], references: [id])
  currentVersion CrmMessageTemplateVersion?  @relation("CrmMessageTemplateCurrentVersion", fields: [currentVersionId], references: [id])
  versions       CrmMessageTemplateVersion[] @relation("CrmMessageTemplateVersions")
  messages       CrmMessage[]

  @@index([companyId, status, updatedAt])
  @@index([companyId, channelType, status])
  @@index([companyId, categoryId])
  @@index([companyId, createdAt])
  @@map("crm_message_templates")
}

/// One immutable snapshot of a template's content (a database trigger
/// refuses UPDATE and DELETE). Editing, restoring or duplicating always adds
/// a new version; messages keep the version they were written from.
model CrmMessageTemplateVersion {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  templateId       String   @map("template_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  subject          String?
  body             String
  // Variable keys used by subject + body ("contact.first_name"…), in order of first use.
  variables        String[] @default([])
  // Provider-neutral key/value refs (e.g. an externally approved template name + language).
  providerMetadata Json     @default("{}") @map("provider_metadata")
  changeNote       String?  @map("change_note")
  // Set when this version was created by restoring an older one.
  restoredFromId   String?  @map("restored_from_id") @db.Uuid
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  company   Company             @relation(fields: [companyId], references: [id])
  template  CrmMessageTemplate  @relation("CrmMessageTemplateVersions", fields: [templateId], references: [id], onDelete: Restrict)
  currentOf CrmMessageTemplate? @relation("CrmMessageTemplateCurrentVersion")
  createdBy User                @relation("CrmMessageTemplateVersionCreatedBy", fields: [createdByUserId], references: [id])
  messages  CrmMessage[]

  @@unique([templateId, versionNumber])
  @@map("crm_message_template_versions")
}

model CrmCustomFieldDefinition {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  entityType  CrmEntityType      @map("entity_type")
  key         String
  label       String
  fieldType   CrmCustomFieldType @map("field_type")
  description String?
  // DROPDOWN / MULTI_SELECT: [{ "value": "...", "label": "..." }]
  options     Json?
  isRequired  Boolean            @default(false) @map("is_required")
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, entityType, key])
  @@index([companyId, entityType, sortOrder])
  @@map("crm_custom_field_definitions")
}

// Per-company CRM settings that are not lists (duplicate rules for now).
model CrmSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @map("company_id") @db.Uuid
  // [{ "rule": "EMAIL" | "PHONE" | "COMPANY_AND_EMAIL" | "COMPANY_AND_PHONE", "action": "WARN" | "BLOCK" | "OFF" }]

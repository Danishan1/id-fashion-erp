// 1:1 per project, replaced each run. Never a hard block on Generate — per
// the feature's own spec, any rating other than COMPATIBLE just surfaces a
// warning requiring an explicit "Continue Anyway" before Generate proceeds.
model ReplicateDesignCompatibilityCheck {
  id                String                        @id @default(uuid()) @db.Uuid
  companyId         String                        @map("company_id") @db.Uuid
  projectId         String                        @unique @map("project_id") @db.Uuid
  promptVersion     String                        @map("prompt_version")
  provider          String
  model             String
  rawResponseJson   Json                          @map("raw_response_json")
  overallSummary    String?                       @map("overall_summary")
  overallRating     ReplicateCompatibilityRating? @map("overall_rating")
  // One concrete, actionable next step for the whole material selection
  // together (e.g. "no changes needed" when fully compatible, or a specific
  // fabric/material adjustment when not) — nullable so a check row created
  // before this field existed still renders without it, never a crash.
  overallSuggestion String?                       @map("overall_suggestion")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company                @relation(fields: [companyId], references: [id])
  project   ReplicateDesignProject @relation(fields: [projectId], references: [id])
  createdBy User                   @relation("ReplicateDesignCompatibilityCheckCreatedBy", fields: [createdByUserId], references: [id])

  items ReplicateDesignCompatibilityItem[]
  runs  ReplicateDesignCompatibilityRun[]

  @@map("replicate_design_compatibility_checks")
}

// One row per fabric/material line the compatibility check actually assessed.
model ReplicateDesignCompatibilityItem {
  id             String                        @id @default(uuid()) @db.Uuid
  checkId        String                        @map("check_id") @db.Uuid
  subjectType    ReplicateCompatibilitySubject @map("subject_type")
  // Null when subjectType=FABRIC (the fabric itself, not a material line).
  materialLineId String?                       @map("material_line_id") @db.Uuid
  aiRating       ReplicateCompatibilityRating  @map("ai_rating")
  aiReasoning    String                        @map("ai_reasoning")
  // A concrete, actionable recommendation for this one subject specifically
  // (e.g. "add a fusible interlining" for a MINOR_CONCERN, or "no changes
  // needed" for a COMPATIBLE rating) — nullable for the same backward-
  // compatibility reason as overallSuggestion above.
  aiSuggestion   String?                       @map("ai_suggestion")
  createdAt      DateTime                      @default(now()) @map("created_at")

  check        ReplicateDesignCompatibilityCheck @relation(fields: [checkId], references: [id])
  materialLine ReplicateDesignMaterialLine?      @relation(fields: [materialLineId], references: [id])

  @@map("replicate_design_compatibility_items")
}

// Append-only audit log, mirrors ReplicateDesignDnaAnalysisRun exactly.
model ReplicateDesignCompatibilityRun {

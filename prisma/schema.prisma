// Renamed from SupplierCategory (2026-08-27) — Supplier itself moved to a
// real dynamic master (see the SupplierCategory model below); this enum's
// only remaining consumer is Product.materialCategory, which already had
// its own independent Zod validation (MATERIAL_CATEGORIES) the whole time,
// so the rename has zero downstream TypeScript impact.
enum MaterialCategory {
  FABRIC
  TRIMS
  // Split out of TRIMS on 2026-08-21 so the "Add Material" grouped picker in
  // Sampling can distinguish them at a glance — Trims stays as the general
  // bucket for anything that isn't specifically a zip or a button (elastic,
  // labels, etc.).
  ZIPS
  BUTTONS
  ACCESSORIES
  PACKAGING
  SERVICES
  MACHINERY
  OTHER
  // Added 2026-09-04 so a WarehouseLocation (the only other consumer of this
  // enum) can tag a room/section for a production STAGE, not just a raw
  // material sub-category — mirrors 4 of WarehouseType's own 7 values
  // (RAW_MATERIAL/FABRIC/TRIMS already fit via the values above). Product's
  // own materialCategory (an actual raw material's type) deliberately never
  // uses these — its Zod schema (MATERIAL_CATEGORIES) still only allows the
  // original 9 values above; only WarehouseLocation's own, wider Zod list
  // (LOCATION_MATERIAL_CATEGORIES) accepts them.
  WIP
  FINISHED_GOODS
  DISPATCH
  REJECT
}

/**
 * Supplier's category, made a real per-company master (2026-08-27, at the
 * user's explicit request) instead of the fixed enum it used to share with
 * Product.materialCategory — same {code,name,isActive} shape and
 * makeSimpleLookupService() factory as every other Garment Attributes
 * master (Brand/Category/Season/...). Product.materialCategory is
 * deliberately NOT part of this cutover — it already had its own
 * independent validation and UI (grouped material pickers in Sampling/BOM/
 * Purchasing), a separate, larger decision than what was actually asked.
 */
model SupplierCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                    Company                    @relation(fields: [companyId], references: [id])
  suppliers                  Supplier[]
  supplierMaterialCategories SupplierMaterialCategory[]

  @@unique([companyId, code])
  @@map("supplier_categories")
}

model Supplier {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  code                String
  name                String
  categoryId          String    @map("category_id") @db.Uuid
  contactPerson       String?   @map("contact_person")
  email               String?
  phone               String?
  address             String?
  // Added 2026-09-15 -- Supplier had no city/pinCode/country breakdown at
  // all, only a single free-text address field.
  city                String?
  pinCode             String?   @map("pin_code")
  country             String?
  taxRegistrationNo   String?   @map("tax_registration_no")
  paymentTermsDays    Int?      @map("payment_terms_days")
  defaultCurrencyCode String?   @map("default_currency_code") @db.Char(3)
  bankDetailsJson     Json?     @map("bank_details_json")
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company                 Company                    @relation(fields: [companyId], references: [id])
  category                SupplierCategory           @relation(fields: [categoryId], references: [id])
  defaultForProducts      Product[]
  suppliedMaterials       SupplierMaterial[]
  suppliedCategories      SupplierMaterialCategory[]
  purchaseOrders          PurchaseOrder[]
  stockMovements          StockMovement[]
  purchaseInvoices        PurchaseInvoice[]
  payments                Payment[]
  expenses                Expense[]
  aiGarmentFabricDetails  AiGarmentFabricDetail[]
  aiDesignerProjects      AiDesignerProject[]
  replicateDesignProjects ReplicateDesignProject[]

  @@unique([companyId, code])
  @@map("suppliers")
}

/**
 * A genuinely separate master from Supplier (2026-09-25, promoted from the
 * short-lived `Supplier.isJobWorkContractor` flag) — an external job-work
 * unit/contractor is a different real-world relationship than a
 * raw-material vendor (paid via the Piece-Rate earning ledger, not the
 * Purchase Order/Invoice/Payment pipeline Suppliers use), so it gets its
 * own identity rather than riding on Supplier's much larger, PO-oriented
 * shape. Deliberately a lighter field set than Supplier (no category, tax
 * registration, payment terms, or bank details) — see CLAUDE.md's own
 * dated note for the reasoning.
 */
model Contractor {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  code          String
  name          String
  contactPerson String?   @map("contact_person")
  phone         String?
  email         String?
  address       String?
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company                 Company                @relation(fields: [companyId], references: [id])
  jobWorkOrders           JobWorkOrder[]
  pieceRateCards          PieceRateCard[]
  pieceRateEarnings       PieceRateEarning[]
  portalUser              User?                  @relation("ContractorPortalUser")
  preferredForRouteStages ProductionRouteStage[]
  // Which production stages this contractor performs (2026-09-28), in their
  // working order. Zero rows = unrestricted (every pre-existing contractor),
  // matching RoleProductionStageAccess's "no rows means no restriction".
  stages                  ContractorStage[]

  @@unique([companyId, code])
  @@map("contractors")
}

// Forwarder / Transporter / Courier master (2026-10-10, Dispatch Forwarder
// Master) — confirmed via a full-codebase audit that no equivalent entity
// existed anywhere (only plain free-text Dispatch.transporterName/
// vehicleNumber/trackingNumber columns, now kept as-is alongside this).
// Mirrors Contractor's own "simple rich master" shape exactly (soft-delete,
// masters_core RBAC, sequential master-code numbering) since it's the same
// kind of entity — a real-world external party referenced by id, not a
// second free-text field.
enum ForwarderType {
  COURIER
  ROAD
  RAIL
  AIR
  OTHER
}

model Forwarder {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  code          String
  name          String
  type          ForwarderType @default(COURIER)
  contactPerson String?       @map("contact_person")
  phone         String?
  altPhone      String?       @map("alt_phone")
  email         String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?       @map("postal_code")
  gstin         String?
  remarks       String?
  isActive      Boolean       @default(true) @map("is_active")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  dispatches Dispatch[]

  @@unique([companyId, code])
  @@map("forwarders")
}

/**
 * The full catalog of "which suppliers can supply which materials" — a real
 * many-to-many, deliberately separate from Product.defaultSupplierId (a
 * single FK used only for auto-suggesting a supplier when generating a
 * Purchase Order from a Material Request shortfall). A material routinely
 * has more than one real-world eligible supplier (three different suppliers
 * all selling the same Cotton Fabric is the ordinary case, not an edge
 * case) — this table represents that full set; defaultSupplierId remains
 * the narrower "which one do we auto-pick" pointer and is untouched by this
 * table either way.
 */
model SupplierMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([companyId, productId])
  @@map("supplier_materials")
}

/**
 * A coarser sibling to SupplierMaterial — "this supplier can supply ANY
 * material in this category," including ones that don't exist yet. Exists
 * specifically for the case a user pointed out directly: a Supplier master
 * is created once, but new Fabric/Trims materials get added to the catalog
 * over time — re-opening every existing supplier to tick each new material
 * individually would be exactly the friction SupplierMaterial's own bulk
 * multi-select was built to reduce, just one level further. The two tables
 * are independent and both checked when something ever needs "can this
 * supplier supply material X" (a specific product-level link OR the
 * material's own category being linked broadly) — neither writes to the
 * other, and a supplier can freely mix broad category coverage with a few
 * extra specific materials outside those categories.
 * FK's to the real, per-company SupplierCategory master (2026-08-31) rather
 * than the fixed MaterialCategory enum this table originally used — it was
 * built the same day as SupplierCategory's own cutover from a hardcoded enum
 * to a dynamic master (see the comment on SupplierCategory) and initially
 * copy-pasted the old enum shape from Product.materialCategory for
 * convenience. Once the user asked for this list to grow/shrink with the
 * real master instead of a fixed set of 7 values, an enum column couldn't
 * express that — only a real FK to the master can.
 */
model SupplierMaterialCategory {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  supplierId         String   @map("supplier_id") @db.Uuid
  supplierCategoryId String   @map("supplier_category_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  company          Company          @relation(fields: [companyId], references: [id])
  supplier         Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierCategory SupplierCategory @relation(fields: [supplierCategoryId], references: [id], onDelete: Cascade)

  @@unique([supplierId, supplierCategoryId])
  @@map("supplier_material_categories")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  employees        Employee[]
  productionLines  ProductionLine[]
  materialRequests MaterialRequest[]
  productionStages ProductionStage[]
  designations     Designation[]

  @@unique([companyId, code])
  @@map("departments")
}

model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  branchId           String?          @map("branch_id") @db.Uuid
  departmentId       String?          @map("department_id") @db.Uuid
  reportsToId        String?          @map("reports_to_id") @db.Uuid
  // Nullable — wiring this in is the one deliberate HRMS improvement over
  // the WordPress source, which hardcodes a single 10:15 late-cutoff for
  // every employee company-wide. See CRM_SALES_MARKETING_HRMS_MIGRATION_REPORT.md.
  shiftId            String?          @map("shift_id") @db.Uuid
  // Wired to the real Designation master (HRMS gap-analysis Priority 1 item
  // #1, 2026-08-26) — was a plain free-text string, now a real FK, matching
  // the same string→FK cutover already done once for Product.category/season
  // in Phase 3. The old `designation` string column is intentionally gone
  // (not kept as a shim) — its data was backfilled into `designationId`
  // before the column was dropped, see the migration's own backfill note.
  designationId      String?          @map("designation_id") @db.Uuid
  // A sibling to departmentId/designationId, not nested under either — employment
  // classification (Permanent/Contract/Probation/...) is orthogonal to organizational
  // placement (which department, what title). See the Item 7 analysis, 2026-09-01.
  employeeCategoryId String?          @map("employee_category_id") @db.Uuid
  employeeCode       String           @map("employee_code")
  fullName           String           @map("full_name")
  phone              String?
  email              String?
  // Added 2026-09-15 -- Employee had zero location fields at all before this.
  address            String?
  city               String?
  pinCode            String?          @map("pin_code")
  country            String?
  joinDate           DateTime?        @map("join_date")
  // Pay-basis data only — stored for reference/reporting, no payroll
  // run/payslip generation exists or is computed from these (deliberate
  // scope decision, 2026-09-02). Nullable: most existing employees have
  // never had this set.
  payType            EmployeePayType? @map("pay_type")
  fixedMonthlySalary Decimal?         @map("fixed_monthly_salary") @db.Decimal(18, 2)
  pieceRatePerUnit   Decimal?         @map("piece_rate_per_unit") @db.Decimal(18, 4)
  travelAllowance    Decimal?         @map("travel_allowance") @db.Decimal(18, 2)
  dearnessAllowance  Decimal?         @map("dearness_allowance") @db.Decimal(18, 2)
  // Per-employee Admin toggle: can this worker submit their OWN production
  // progress (subject to also having a User login linked via
  // User.employeeId), or must a Supervisor always log it for them (today's
  // default behavior for every employee). Defaults false so no existing
  // employee's workflow changes on migration.
  selfEntryEnabled   Boolean          @default(false) @map("self_entry_enabled")
  isActive           Boolean          @default(true) @map("is_active")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  shift            ShiftMaster?      @relation(fields: [shiftId], references: [id])
  designation      Designation?      @relation(fields: [designationId], references: [id])
  employeeCategory EmployeeCategory? @relation(fields: [employeeCategoryId], references: [id])
  reportsTo        Employee?         @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  reports          Employee[]        @relation("EmployeeHierarchy")
  user             User?

  // Production (Phase 5C) — a worker/operator is always tracked here, never
  // via User, so shop-floor staff never need a login just to be assigned
  // work or logged against (see PRODUCTION_MODULE_DESIGN.md §7).
  productionStagesOwned   ProductionStage[]       @relation("ProductionStageDefaultOwner")
  jobOrderAssignments     JobOrderAssignment[]    @relation("JobOrderAssignmentEmployee")
  jobOrderProgressEntries JobOrderProgressEntry[] @relation("JobOrderProgressEntryEmployee")
  pieceRateCards          PieceRateCard[]
  pieceRateEarnings       PieceRateEarning[]
  // Which production stages this worker can do (2026-09-29). Assign Worker
  // only offers, and the backend only accepts, workers holding the stage.
  workSkills              EmployeeWorkSkill[]

  // HRMS (migrated from WordPress "EQ HRMS")
  attendanceRecords            AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  leaveRequests                LeaveRequest[]
  leaveBalanceCarryForwards    LeaveBalanceCarryForward[]
  employeeAdvances             EmployeeAdvance[]

  @@unique([companyId, employeeCode])
  @@map("employees")
}

/// An employee's Work Skill = one production stage they are trained for
/// (2026-09-29). An employee with none can't be assigned production work
/// until an Admin adds skills in Employee Master.
model EmployeeWorkSkill {
  id                String   @id @default(uuid()) @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  productionStageId String   @map("production_stage_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  productionStage ProductionStage @relation(fields: [productionStageId], references: [id], onDelete: Cascade)

  @@unique([employeeId, productionStageId])
  @@index([productionStageId])
  @@map("employee_work_skills")
}

enum EmployeePayType {
  FIXED_SALARY
  PIECE_RATE
}

enum ItemType {
  STYLE
  RAW_MATERIAL
}

model Product {
  id                    String            @id @default(uuid()) @db.Uuid
  companyId             String            @map("company_id") @db.Uuid
  customerId            String?           @map("customer_id") @db.Uuid
  departmentId          String?           @map("department_id") @db.Uuid
  baseUomId             String?           @map("base_uom_id") @db.Uuid
  defaultSupplierId     String?           @map("default_supplier_id") @db.Uuid
  itemType              ItemType          @default(STYLE) @map("item_type")
  materialCategory      MaterialCategory? @map("material_category")
  styleCode             String            @map("style_code")
  styleName             String            @map("style_name")
  // Some companies identify a style primarily by a design number rather than
  // (or alongside) styleCode/styleName — free text, not unique, since design
  // numbering conventions vary by company and this is a display/reference
  // field, not the system's own identity key for the style.
  designNumber          String?           @map("design_number")
  categoryId            String?           @map("category_id") @db.Uuid
  seasonId              String?           @map("season_id") @db.Uuid
  // Wired for real catalog filtering (Brand/Type/Fitting) — the masters
  // themselves have existed since Phase 3 but were never attached to a
  // Product FK until now. Design/DesignPattern/Pattern and the fabric
  // sub-masters (Gsm/Dye/WeaveType/Width) are deliberately NOT wired here —
  // their right anchor (style-level vs material-level) isn't unambiguous
  // yet, and guessing would risk exactly the "duplicate/unclear wiring"
  // this pass was told to avoid.
  brandId               String?           @map("brand_id") @db.Uuid
  productTypeId         String?           @map("product_type_id") @db.Uuid
  productFittingId      String?           @map("product_fitting_id") @db.Uuid
  gender                String?
  description           String?
  imageUrl              String?           @map("image_url")
  // Soft reference to Attachment.id — no hard FK, same convention as
  // AiGarmentProject.referenceImageAttachmentId — points at whichever
  // uploaded gallery image (relatedModule PRODUCT) is the designated cover/
  // main image, for a future product-gallery/e-commerce-style display.
  mainImageAttachmentId String?           @map("main_image_attachment_id") @db.Uuid
  hsnSacCode            String?           @map("hsn_sac_code")
  reorderLevel          Decimal?          @map("reorder_level") @db.Decimal(18, 4)
  unitCost              Decimal?          @map("unit_cost") @db.Decimal(18, 2)
  isActive              Boolean           @default(true) @map("is_active")
  deletedAt             DateTime?         @map("deleted_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  company                           Company                       @relation(fields: [companyId], references: [id])
  customer                          Customer?                     @relation(fields: [customerId], references: [id])
  baseUom                           UnitOfMeasure?                @relation(fields: [baseUomId], references: [id])
  defaultSupplier                   Supplier?                     @relation(fields: [defaultSupplierId], references: [id])
  variants                          ProductVariant[]
  category                          Category?                     @relation(fields: [categoryId], references: [id])
  season                            Season?                       @relation(fields: [seasonId], references: [id])
  brand                             Brand?                        @relation(fields: [brandId], references: [id])
  productType                       ProductType?                  @relation(fields: [productTypeId], references: [id])
  productFitting                    ProductFitting?               @relation(fields: [productFittingId], references: [id])
  sampleRequests                    SampleRequest[]               @relation("SampleRequestStyle")
  sampleMaterialUse                 SampleMaterial[]              @relation("SampleMaterialProduct")
  buyerEnquiryLines                 BuyerEnquiryLine[]
  salesOrderItems                   SalesOrderItem[]
  purchaseOrderItems                PurchaseOrderItem[]
  goodsReceiptItems                 GoodsReceiptItem[]
  inventoryTransactions             InventoryTransaction[]
  stockBalances                     StockBalance[]
  bom                               Bom?
  bomItemUsages                     BomItem[]                     @relation("BomItemMaterial")
  materialRequestItems              MaterialRequestItem[]         @relation("MaterialRequestItemMaterial")
  supplierLinks                     SupplierMaterial[]
  productionOrders                  ProductionOrder[]
  stockMovementItems                StockMovementItem[]
  salesInvoiceItems                 SalesInvoiceItem[]
  purchaseInvoiceItems              PurchaseInvoiceItem[]
  dispatchItems                     DispatchItem[]
  jobWorkOrderMaterials             JobWorkOrderMaterial[]
  customInvoiceItems                CustomInvoiceItem[]
  // Virtual back-relation only — the single authoritative FK lives on
  // AiGarmentProject.productId (@unique), set once by convertProjectToStyle().
  aiGarmentProject                  AiGarmentProject?
  // AI Designer's own read-only reference when a project picks this row as
  // its "existing fabric" — many AI Designer projects may point at the same
  // material, so this is a plain array, not a unique back-relation.
  aiDesignerProjects                AiDesignerProject[]
  // Replicate Design's own read-only reference when a project picks this row
  // as its "existing fabric" (fabricProductId) — same "many projects may
  // point at the same material" plain-array shape as AI Designer's own.
  replicateDesignProjects           ReplicateDesignProject[]
  replicateDesignMaterialLines      ReplicateDesignMaterialLine[]
  pieceRateCards                    PieceRateCard[]
  productionRoutes                  ProductionRoute[]
  salesOrderBomOverridesAsOriginal  SalesOrderBomOverride[]       @relation("SalesOrderBomOverrideOriginalMaterial")
  salesOrderBomOverridesAsEffective SalesOrderBomOverride[]       @relation("SalesOrderBomOverrideEffectiveMaterial")
  materialSubstitutionsAsOriginal   MaterialSubstitution[]        @relation("MaterialSubstitutionOriginalMaterial")
  materialSubstitutionsAsSubstitute MaterialSubstitution[]        @relation("MaterialSubstitutionSubstituteMaterial")

  stageCosts StyleStageCost[]

  @@unique([companyId, styleCode])
  @@map("products")
}

model Color {

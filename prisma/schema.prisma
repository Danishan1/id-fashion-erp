// Fashion ERP — Phase 2 schema: Organization/Auth + Masters + System domains.
// Sampling, Sales Orders, Production, Inventory, Accounts, and Dispatch domains
// are added in their respective phases (see CLAUDE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Organization / Auth
// ─────────────────────────────────────────────────────────────

model Company {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String?  @map("legal_name")
  taxRegistrationNo    String?  @unique @map("tax_registration_no")
  baseCurrencyCode     String   @map("base_currency_code") @db.Char(3)
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  addressJson          Json?    @map("address_json")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  baseCurrency                Currency                     @relation(fields: [baseCurrencyCode], references: [code])
  branches                    Branch[]
  users                       User[]
  roles                       Role[]
  customers                   Customer[]
  suppliers                   Supplier[]
  departments                 Department[]
  employees                   Employee[]
  products                    Product[]
  colors                      Color[]
  sizes                       Size[]
  warehouses                  Warehouse[]
  productionStages            ProductionStage[]
  productionLines             ProductionLine[]
  salesAgents                 SalesAgent[]
  brands                      Brand[]
  categories                  Category[]
  seasons                     Season[]
  productFittings             ProductFitting[]
  productTypes                ProductType[]
  designs                     Design[]
  designPatterns              DesignPattern[]
  patterns                    Pattern[]
  fabricGsms                  FabricGsm[]
  fabricDyes                  FabricDye[]
  fabricWeaveTypes            FabricWeaveType[]
  fabricWidths                FabricWidth[]
  fabricCompositions          FabricComposition[]
  machines                    Machine[]
  designations                Designation[]
  employeeCategories          EmployeeCategory[]
  shiftMasters                ShiftMaster[]
  holidayMasters              HolidayMaster[]
  costMasters                 CostMaster[]
  paymentTypes                PaymentType[]
  bankAccounts                BankAccount[]
  sampleRequests              SampleRequest[]
  buyerEnquiries              BuyerEnquiry[]
  salesOrders                 SalesOrder[]
  boms                        Bom[]
  purchaseOrders              PurchaseOrder[]
  materialRequests            MaterialRequest[]
  goodsReceipts               GoodsReceipt[]
  fabricRolls                 FabricRoll[]
  inventoryTransactions       InventoryTransaction[]
  stockBalances               StockBalance[]
  stockMovements              StockMovement[]
  productionOrders            ProductionOrder[]
  lots                        Lot[]
  lotRelations                LotRelation[]
  jobOrders                   JobOrder[]
  productionStageTransactions ProductionStageTransaction[]
  qcInspections               QcInspection[]
  defectTypes                 DefectType[]
  documentSequences           DocumentSequence[]
  auditLogs                   AuditLog[]
  notifications               Notification[]
  attachments                 Attachment[]
  leads                       Lead[]
  deals                       Deal[]
  crmActivities               CrmActivity[]
  crmFollowups                CrmFollowup[]
  crmRoundRobinState          CrmRoundRobinState?
  chartOfAccounts             ChartOfAccount[]
  taxTypes                    TaxType[]
  taxRates                    TaxRate[]
  journals                    Journal[]
  salesInvoices               SalesInvoice[]
  purchaseInvoices            PurchaseInvoice[]

  @@map("companies")
}

enum BranchType {
  FACTORY
  OFFICE
  WAREHOUSE
}

model Branch {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  code        String
  name        String
  type        BranchType
  addressJson Json?      @map("address_json")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  usersDefault          User[]                 @relation("UserDefaultBranch")
  userBranchRoles       UserBranchRole[]
  employees             Employee[]
  departments           Department[]
  warehouses            Warehouse[]
  productionLines       ProductionLine[]
  sampleRequests        SampleRequest[]
  buyerEnquiries        BuyerEnquiry[]
  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]
  materialRequests      MaterialRequest[]
  goodsReceipts         GoodsReceipt[]
  inventoryTransactions InventoryTransaction[]
  stockMovements        StockMovement[]
  productionOrders      ProductionOrder[]
  lots                  Lot[]
  documentSequences     DocumentSequence[]
  leads                 Lead[]
  deals                 Deal[]
  journals              Journal[]
  salesInvoices         SalesInvoice[]
  purchaseInvoices      PurchaseInvoice[]

  @@unique([companyId, code])
  @@map("branches")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  defaultBranchId String?    @map("default_branch_id") @db.Uuid
  employeeId      String?    @unique @map("employee_id") @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  phone           String?
  mfaSecret       String?    @map("mfa_secret")
  lastLoginAt     DateTime?  @map("last_login_at")
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  company                              Company                      @relation(fields: [companyId], references: [id])
  defaultBranch                        Branch?                      @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  employee                             Employee?                    @relation(fields: [employeeId], references: [id])
  branchRoles                          UserBranchRole[]
  auditLogs                            AuditLog[]
  notifications                        Notification[]
  uploadedFiles                        Attachment[]
  sampleRequestsMade                   SampleRequest[]              @relation("SampleRequestedBy")
  buyerEnquiriesMade                   BuyerEnquiry[]               @relation("BuyerEnquiryRequestedBy")
  salesOrdersRequested                 SalesOrder[]                 @relation("SalesOrderRequestedBy")
  purchaseOrdersRequested              PurchaseOrder[]              @relation("PurchaseOrderRequestedBy")
  materialRequestsMade                 MaterialRequest[]            @relation("MaterialRequestRequestedBy")
  goodsReceiptsReceived                GoodsReceipt[]               @relation("GoodsReceiptReceivedBy")
  inventoryTransactionsPerformed       InventoryTransaction[]       @relation("InventoryTransactionPerformedBy")
  stockMovementsPerformed              StockMovement[]              @relation("StockMovementPerformedBy")
  sampleVersionsCreated                SampleVersion[]              @relation("SampleVersionCreatedBy")
  sampleVersionsCostingLocked          SampleVersion[]              @relation("SampleVersionCostingLockedBy")
  sampleApprovalsMade                  SampleApproval[]             @relation("SampleApprovalDecidedBy")
  sampleCommentsMade                   SampleComment[]              @relation("SampleCommentAuthor")
  productionOrdersRequested            ProductionOrder[]            @relation("ProductionOrderRequestedBy")
  lotsCreated                          Lot[]                        @relation("LotCreatedBy")
  lotRelationsPerformed                LotRelation[]                @relation("LotRelationPerformedBy")
  jobOrderAssignmentsMade              JobOrderAssignment[]         @relation("JobOrderAssignmentAssignedBy")
  jobOrderProgressEntriesRecorded      JobOrderProgressEntry[]      @relation("JobOrderProgressEntryRecordedBy")
  productionStageTransactionsPerformed ProductionStageTransaction[] @relation("ProductionStageTransactionPerformedBy")
  qcInspectionsMade                    QcInspection[]               @relation("QcInspectionInspector")
  leadsAssigned                        Lead[]                       @relation("LeadAssignedTo")
  leadsCreated                         Lead[]                       @relation("LeadCreatedBy")
  dealsAssigned                        Deal[]                       @relation("DealAssignedTo")
  dealsCreated                         Deal[]                       @relation("DealCreatedBy")
  crmActivitiesPerformed               CrmActivity[]                @relation("CrmActivityPerformedBy")
  crmFollowupsAssigned                 CrmFollowup[]                @relation("CrmFollowupAssignedTo")
  crmFollowupsCreated                  CrmFollowup[]                @relation("CrmFollowupCreatedBy")
  journalsCreated                      Journal[]                    @relation("JournalCreatedBy")
  journalsPosted                       Journal[]                    @relation("JournalPostedBy")
  salesInvoicesCreated                 SalesInvoice[]               @relation("SalesInvoiceCreatedBy")
  salesInvoicesPosted                  SalesInvoice[]               @relation("SalesInvoicePostedBy")
  purchaseInvoicesCreated              PurchaseInvoice[]            @relation("PurchaseInvoiceCreatedBy")
  purchaseInvoicesPosted               PurchaseInvoice[]            @relation("PurchaseInvoicePostedBy")

  @@map("users")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userBranchRoles UserBranchRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId, roleId])
  @@map("user_branch_roles")
}

// ─────────────────────────────────────────────────────────────
// Masters
// ─────────────────────────────────────────────────────────────

model Currency {
  code          String @id @db.Char(3)
  name          String
  symbol        String
  decimalPlaces Int    @default(2) @map("decimal_places")

  companies Company[]

  @@map("currencies")
}

model Customer {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  code                String
  name                String
  type                String    @default("CUSTOMER")
  country             String?
  paymentTermsDays    Int?      @map("payment_terms_days")
  creditLimit         Decimal?  @map("credit_limit") @db.Decimal(18, 2)
  defaultCurrencyCode String?   @map("default_currency_code") @db.Char(3)
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  buyers         Buyer[]
  products       Product[]
  sampleRequests SampleRequest[]
  buyerEnquiries BuyerEnquiry[]
  salesOrders    SalesOrder[]
  deals          Deal[]
  salesInvoices  SalesInvoice[]

  @@unique([companyId, code])
  @@map("customers")
}

model Buyer {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  code          String
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer       Customer        @relation(fields: [customerId], references: [id])
  sampleRequests SampleRequest[]
  buyerEnquiries BuyerEnquiry[]
  salesOrders    SalesOrder[]

  @@unique([customerId, code])
  @@map("buyers")
}

enum SupplierCategory {
  FABRIC
  TRIMS
  // Split out of TRIMS on 2026-08-21 so the "Add Material" grouped picker in
  // Sampling can distinguish them at a glance — Trims stays as the general
  // bucket for anything that isn't specifically a zip or a button (elastic,
  // labels, etc.).
  ZIPS
  BUTTONS
  ACCESSORIES
  PACKAGING
  SERVICES
  MACHINERY
  OTHER
}

model Supplier {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  code                String
  name                String
  category            SupplierCategory
  contactPerson       String?          @map("contact_person")
  email               String?
  phone               String?
  address             String?
  taxRegistrationNo   String?          @map("tax_registration_no")
  paymentTermsDays    Int?             @map("payment_terms_days")
  defaultCurrencyCode String?          @map("default_currency_code") @db.Char(3)
  bankDetailsJson     Json?            @map("bank_details_json")
  isActive            Boolean          @default(true) @map("is_active")
  deletedAt           DateTime?        @map("deleted_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  company            Company           @relation(fields: [companyId], references: [id])
  defaultForProducts Product[]
  purchaseOrders     PurchaseOrder[]
  stockMovements     StockMovement[]
  purchaseInvoices   PurchaseInvoice[]

  @@unique([companyId, code])
  @@map("suppliers")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  employees        Employee[]
  productionLines  ProductionLine[]
  materialRequests MaterialRequest[]
  productionStages ProductionStage[]

  @@unique([companyId, code])
  @@map("departments")
}

model Employee {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  reportsToId  String?   @map("reports_to_id") @db.Uuid
  employeeCode String    @map("employee_code")
  fullName     String    @map("full_name")
  designation  String?
  phone        String?
  email        String?
  joinDate     DateTime? @map("join_date")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  reportsTo  Employee?   @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  reports    Employee[]  @relation("EmployeeHierarchy")
  user       User?

  // Production (Phase 5C) — a worker/operator is always tracked here, never
  // via User, so shop-floor staff never need a login just to be assigned
  // work or logged against (see PRODUCTION_MODULE_DESIGN.md §7).
  productionStagesOwned   ProductionStage[]       @relation("ProductionStageDefaultOwner")
  jobOrderAssignments     JobOrderAssignment[]    @relation("JobOrderAssignmentEmployee")
  jobOrderProgressEntries JobOrderProgressEntry[] @relation("JobOrderProgressEntryEmployee")

  @@unique([companyId, employeeCode])
  @@map("employees")
}

enum ItemType {
  STYLE
  RAW_MATERIAL
}

model Product {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  customerId        String?           @map("customer_id") @db.Uuid
  departmentId      String?           @map("department_id") @db.Uuid
  baseUomId         String?           @map("base_uom_id") @db.Uuid
  defaultSupplierId String?           @map("default_supplier_id") @db.Uuid
  itemType          ItemType          @default(STYLE) @map("item_type")
  materialCategory  SupplierCategory? @map("material_category")
  styleCode         String            @map("style_code")
  styleName         String            @map("style_name")
  // Some companies identify a style primarily by a design number rather than
  // (or alongside) styleCode/styleName — free text, not unique, since design
  // numbering conventions vary by company and this is a display/reference
  // field, not the system's own identity key for the style.
  designNumber      String?           @map("design_number")
  categoryId        String?           @map("category_id") @db.Uuid
  seasonId          String?           @map("season_id") @db.Uuid
  gender            String?
  description       String?
  imageUrl          String?           @map("image_url")
  hsnSacCode        String?           @map("hsn_sac_code")
  reorderLevel      Decimal?          @map("reorder_level") @db.Decimal(18, 4)
  unitCost          Decimal?          @map("unit_cost") @db.Decimal(18, 2)
  isActive          Boolean           @default(true) @map("is_active")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  baseUom               UnitOfMeasure?         @relation(fields: [baseUomId], references: [id])
  defaultSupplier       Supplier?              @relation(fields: [defaultSupplierId], references: [id])
  variants              ProductVariant[]
  category              Category?              @relation(fields: [categoryId], references: [id])
  season                Season?                @relation(fields: [seasonId], references: [id])
  sampleRequests        SampleRequest[]        @relation("SampleRequestStyle")
  sampleMaterialUse     SampleMaterial[]       @relation("SampleMaterialProduct")
  buyerEnquiryLines     BuyerEnquiryLine[]
  salesOrderItems       SalesOrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceiptItems     GoodsReceiptItem[]
  inventoryTransactions InventoryTransaction[]
  stockBalances         StockBalance[]
  bom                   Bom?
  bomItemUsages         BomItem[]              @relation("BomItemMaterial")
  materialRequestItems  MaterialRequestItem[]  @relation("MaterialRequestItemMaterial")
  productionOrders      ProductionOrder[]
  stockMovementItems    StockMovementItem[]
  salesInvoiceItems     SalesInvoiceItem[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]

  @@unique([companyId, styleCode])
  @@map("products")
}

model Color {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  hexValue  String?  @map("hex_value")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id])
  variants             ProductVariant[]
  sampleMaterials      SampleMaterial[]
  bomItems             BomItem[]
  materialRequestItems MaterialRequestItem[]

  @@unique([companyId, code])
  @@map("colors")
}

model Size {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company          @relation(fields: [companyId], references: [id])
  variants ProductVariant[]

  @@unique([companyId, code])
  @@map("sizes")
}

model UnitOfMeasure {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique
  name             String
  baseUnitId       String? @map("base_unit_id") @db.Uuid
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(18, 6)

  baseUnit             UnitOfMeasure?        @relation("UomConversion", fields: [baseUnitId], references: [id])
  derived              UnitOfMeasure[]       @relation("UomConversion")
  products             Product[]
  sampleMaterials      SampleMaterial[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  materialRequestItems MaterialRequestItem[]
  bomItems             BomItem[]
  lots                 Lot[]
  stockMovementItems   StockMovementItem[]

  @@map("units_of_measure")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  colorId   String   @map("color_id") @db.Uuid
  sizeId    String   @map("size_id") @db.Uuid
  skuCode   String   @unique @map("sku_code")
  barcode   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  color   Color   @relation(fields: [colorId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])

  salesOrderBreakdown SalesOrderItemBreakdown[]

  @@unique([productId, colorId, sizeId])
  @@map("product_variants")
}

enum WarehouseType {
  RAW_MATERIAL
  FABRIC
  TRIMS
  WIP
  FINISHED_GOODS
  DISPATCH
  REJECT
}

model Warehouse {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  code              String
  name              String
  type              WarehouseType
  managerEmployeeId String?       @map("manager_employee_id") @db.Uuid
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  branch                Branch                 @relation(fields: [branchId], references: [id])
  locations             WarehouseLocation[]
  goodsReceiptItems     GoodsReceiptItem[]
  inventoryTransactions InventoryTransaction[]
  stockBalances         StockBalance[]
  materialRequests      MaterialRequest[]
  stockMovementsFrom    StockMovement[]        @relation("StockMovementSourceWarehouse")
  stockMovementsTo      StockMovement[]        @relation("StockMovementDestinationWarehouse")

  @@unique([branchId, code])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  code        String
  zone        String?
  rack        String?
  bin         String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // NOTE: no companyId column of its own — any company-scoped lookup on a
  // warehouseLocationId FK must join through warehouse.companyId, never
  // assume a direct filter (the exact bug class fixed 27 times project-wide).
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  goodsReceiptItems     GoodsReceiptItem[]
  fabricRolls           FabricRoll[]
  inventoryTransactions InventoryTransaction[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model ProductionStage {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  parentStageId          String?  @map("parent_stage_id") @db.Uuid
  code                   String
  name                   String
  sequence               Int      @default(0)
  // Landing here (forward) is what auto-fires the Finished-Goods receipt —
  // avoids inferring "last stage" from MAX(sequence), which breaks the
  // moment a company appends a stage after their current final one.
  isFinal                Boolean  @default(false) @map("is_final")
  // A stage can be marked "no rework back into this stage" (e.g. a
  // post-Dispatch labeling step) — checked on the TARGET stage of a revert.
  allowRework            Boolean  @default(true) @map("allow_rework")
  // Advisory only — QC remains possible at any stage regardless of this
  // flag; it just pre-selects a sensible default in the UI.
  isQcRecommended        Boolean  @default(false) @map("is_qc_recommended")
  departmentId           String?  @map("department_id") @db.Uuid
  // UI default only ("who's usually responsible here") — never an
  // enforcement gate.
  defaultOwnerEmployeeId String?  @map("default_owner_employee_id") @db.Uuid
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company              Company                      @relation(fields: [companyId], references: [id])
  parentStage          ProductionStage?             @relation("StageHierarchy", fields: [parentStageId], references: [id])
  subStages            ProductionStage[]            @relation("StageHierarchy")
  department           Department?                  @relation(fields: [departmentId], references: [id])
  defaultOwner         Employee?                    @relation("ProductionStageDefaultOwner", fields: [defaultOwnerEmployeeId], references: [id])
  jobOrders            JobOrder[]

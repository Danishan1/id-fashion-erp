// Only meaningful for the Bulk Master Data Import portal's async types
// (CUSTOMER..CHART_OF_ACCOUNT) -- the original synchronous CRM import
// (LEAD/DEAL/CAMPAIGN_DAILY_METRIC) creates a batch already in its final
// COMPLETED state, since it has no queued/processing phase of its own.
enum ImportBatchStatus {
  PENDING
  VALIDATING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  UNDONE
}

// "Import history" from the CRM/Marketing enhancement request's own CSV
// import spec — one row per completed import run (not per imported record;
// the imported Leads/Deals/DailyMetrics are the real rows, this is just the
// run's own summary + a way to look back at what was imported and when).
// `failedRowsJson` stores just enough to reconstruct a "download failed
// rows" CSV after the fact. `originalFileKey`/`jobId`/`status` are new
// (2026-09-04, Bulk Master Data Import) -- the original CRM import still
// never persists its source file or has an async status, so both stay
// nullable and simply unused by that path.
model ImportBatch {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  importType      ImportBatchType   @map("import_type")
  fileName        String            @map("file_name")
  totalRows       Int               @map("total_rows")
  importedCount   Int               @map("imported_count")
  skippedCount    Int               @map("skipped_count")
  failedRowsJson  Json?             @map("failed_rows_json")
  status          ImportBatchStatus @default(COMPLETED)
  // FileStorage storageKey of the originally-uploaded file, kept for audit —
  // nullable since the original CRM import path never persists its source
  // file (see the module-level comment above).
  originalFileKey String?           @map("original_file_key")
  // BullMQ job id, for polling progress on an in-flight async import.
  jobId           String?           @map("job_id")
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")

  company   Company             @relation(fields: [companyId], references: [id])
  createdBy User                @relation(fields: [createdByUserId], references: [id])
  records   ImportBatchRecord[]

  @@index([companyId, importType])
  @@map("import_batches")
}

// One row per record a Bulk Master Data Import batch actually created —
// what makes "Undo Batch" possible (look up every record the batch
// created, call that table's own existing deactivate function on each).
// `tableName` is a real Postgres table name (e.g. "customers"), matching
// AuditLog's own convention, not the Prisma model name.
model ImportBatchRecord {
  id            String   @id @default(uuid()) @db.Uuid
  importBatchId String   @map("import_batch_id") @db.Uuid
  rowNumber     Int      @map("row_number")
  tableName     String   @map("table_name")
  recordId      String   @map("record_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])

  @@index([importBatchId])
  @@map("import_batch_records")
}

enum AuditAction {
  CREATE
  UPDATE
  APPROVE
  REJECT
  POST
  CANCEL
  DELETE

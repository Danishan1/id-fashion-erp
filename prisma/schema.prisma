enum BranchType {
  FACTORY
  OFFICE
  WAREHOUSE
}

model Branch {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  code        String
  name        String
  type        BranchType
  addressJson Json?      @map("address_json")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  usersDefault          User[]                 @relation("UserDefaultBranch")
  userBranchRoles       UserBranchRole[]
  employees             Employee[]
  departments           Department[]
  warehouses            Warehouse[]
  productionLines       ProductionLine[]
  sampleRequests        SampleRequest[]
  buyerEnquiries        BuyerEnquiry[]
  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]
  materialRequests      MaterialRequest[]
  goodsReceipts         GoodsReceipt[]
  inventoryTransactions InventoryTransaction[]
  stockMovements        StockMovement[]
  productionOrders      ProductionOrder[]
  lots                  Lot[]
  documentSequences     DocumentSequence[]
  leads                 Lead[]
  deals                 Deal[]
  campaigns             Campaign[]
  journals              Journal[]
  salesInvoices         SalesInvoice[]
  purchaseInvoices      PurchaseInvoice[]
  payments              Payment[]
  expenses              Expense[]
  dispatches            Dispatch[]
  jobWorkOrders         JobWorkOrder[]
  customInvoices        CustomInvoice[]
  internalTransfers     InternalTransfer[]
  employeeAdvances      EmployeeAdvance[]
  aiGarmentProjects     AiGarmentProject[]

  @@unique([companyId, code])
  @@map("branches")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  defaultBranchId   String?    @map("default_branch_id") @db.Uuid
  employeeId        String?    @unique @map("employee_id") @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  phone             String?
  mfaSecret         String?    @map("mfa_secret")
  lastLoginAt       DateTime?  @map("last_login_at")
  // Stamped on every self-service change and admin reset. CF-7's own
  // isUserActive() checks already re-verify live DB state on every
  // permission check, uncached — this reuses that exact same chokepoint to
  // also compare the session's issued-at time against this timestamp, so an
  // old session survives a password change no better than it survives a
  // suspension.
  passwordChangedAt DateTime?  @map("password_changed_at")
  // A capability layered ON TOP OF, not part of, this user's own company's
  // RBAC — a platform admin still belongs to a real company (companyId
  // above is never null) but can additionally provision brand-new,
  // independent companies via src/modules/platform. Deliberately NOT a
  // Permission/Role — that whole system is scoped per-company by design,
  // and "create another company" has no company to be scoped to yet.
  // Checked live from the DB on every use (requirePlatformAdmin()), never
  // trusted from the JWT alone, matching this project's own passwordChangedAt/
  // status re-verification discipline.
  isPlatformAdmin   Boolean    @default(false) @map("is_platform_admin")
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  company                                  Company                            @relation(fields: [companyId], references: [id])
  defaultBranch                            Branch?                            @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  employee                                 Employee?                          @relation(fields: [employeeId], references: [id])
  branchRoles                              UserBranchRole[]
  auditLogs                                AuditLog[]
  notifications                            Notification[]
  uploadedFiles                            Attachment[]
  sampleRequestsMade                       SampleRequest[]                    @relation("SampleRequestedBy")
  buyerEnquiriesMade                       BuyerEnquiry[]                     @relation("BuyerEnquiryRequestedBy")
  salesOrdersRequested                     SalesOrder[]                       @relation("SalesOrderRequestedBy")
  purchaseOrdersRequested                  PurchaseOrder[]                    @relation("PurchaseOrderRequestedBy")
  materialRequestsMade                     MaterialRequest[]                  @relation("MaterialRequestRequestedBy")
  goodsReceiptsReceived                    GoodsReceipt[]                     @relation("GoodsReceiptReceivedBy")
  inventoryTransactionsPerformed           InventoryTransaction[]             @relation("InventoryTransactionPerformedBy")
  stockMovementsPerformed                  StockMovement[]                    @relation("StockMovementPerformedBy")
  sampleVersionsCreated                    SampleVersion[]                    @relation("SampleVersionCreatedBy")
  sampleVersionsCostingLocked              SampleVersion[]                    @relation("SampleVersionCostingLockedBy")
  bomVersionsCreated                       BomVersion[]                       @relation("BomVersionCreatedBy")
  bomVersionsApproved                      BomVersion[]                       @relation("BomVersionApprovedBy")
  sampleApprovalsMade                      SampleApproval[]                   @relation("SampleApprovalDecidedBy")
  sampleCommentsMade                       SampleComment[]                    @relation("SampleCommentAuthor")
  productionOrdersRequested                ProductionOrder[]                  @relation("ProductionOrderRequestedBy")
  lotsCreated                              Lot[]                              @relation("LotCreatedBy")
  lotRelationsPerformed                    LotRelation[]                      @relation("LotRelationPerformedBy")
  jobOrderAssignmentsMade                  JobOrderAssignment[]               @relation("JobOrderAssignmentAssignedBy")
  jobOrderProgressEntriesRecorded          JobOrderProgressEntry[]            @relation("JobOrderProgressEntryRecordedBy")
  jobOrderProgressEntriesApproved          JobOrderProgressEntry[]            @relation("JobOrderProgressEntryApprovedBy")
  productionStageTransactionsPerformed     ProductionStageTransaction[]       @relation("ProductionStageTransactionPerformedBy")
  qcInspectionsMade                        QcInspection[]                     @relation("QcInspectionInspector")
  leadsAssigned                            Lead[]                             @relation("LeadAssignedTo")
  leadsCreated                             Lead[]                             @relation("LeadCreatedBy")
  dealsAssigned                            Deal[]                             @relation("DealAssignedTo")
  dealsCreated                             Deal[]                             @relation("DealCreatedBy")
  crmActivitiesPerformed                   CrmActivity[]                      @relation("CrmActivityPerformedBy")
  crmFollowupsAssigned                     CrmFollowup[]                      @relation("CrmFollowupAssignedTo")
  crmFollowupsCreated                      CrmFollowup[]                      @relation("CrmFollowupCreatedBy")
  campaignsOwned                           Campaign[]                         @relation("CampaignOwner")
  campaignsCreated                         Campaign[]                         @relation("CampaignCreatedBy")
  campaignsApproved                        Campaign[]                         @relation("CampaignApprovedBy")
  campaignDailyMetricsRecorded             CampaignDailyMetric[]
  crmSettingsUpdated                       CrmSettings[]
  importBatchesCreated                     ImportBatch[]
  adAccountConnectionsCreated              AdAccountConnection[]
  attendanceRecordsRecorded                AttendanceRecord[]
  attendanceCorrectionsApproved            AttendanceCorrectionRequest[]      @relation("AttendanceCorrectionApprovedBy")
  attendanceCorrectionsCreated             AttendanceCorrectionRequest[]      @relation("AttendanceCorrectionCreatedBy")
  leaveRequestsApproved                    LeaveRequest[]                     @relation("LeaveRequestApprovedBy")
  leaveRequestsCreated                     LeaveRequest[]                     @relation("LeaveRequestCreatedBy")
  leaveBalanceCarryForwardsCreated         LeaveBalanceCarryForward[]
  journalsCreated                          Journal[]                          @relation("JournalCreatedBy")
  journalsPosted                           Journal[]                          @relation("JournalPostedBy")
  salesInvoicesCreated                     SalesInvoice[]                     @relation("SalesInvoiceCreatedBy")
  salesInvoicesPosted                      SalesInvoice[]                     @relation("SalesInvoicePostedBy")
  purchaseInvoicesCreated                  PurchaseInvoice[]                  @relation("PurchaseInvoiceCreatedBy")
  purchaseInvoicesPosted                   PurchaseInvoice[]                  @relation("PurchaseInvoicePostedBy")
  paymentsCreated                          Payment[]                          @relation("PaymentCreatedBy")
  paymentsPosted                           Payment[]                          @relation("PaymentPostedBy")
  expensesCreated                          Expense[]                          @relation("ExpenseCreatedBy")
  expensesPosted                           Expense[]                          @relation("ExpensePostedBy")
  expensesApproved                         Expense[]                          @relation("ExpenseApprovedBy")
  expensesRejected                         Expense[]                          @relation("ExpenseRejectedBy")
  dispatchesRequested                      Dispatch[]                         @relation("DispatchRequestedBy")
  jobWorkOrdersRequested                   JobWorkOrder[]
  jobWorkReceiptsReceived                  JobWorkReceipt[]
  customInvoicesCreated                    CustomInvoice[]
  customInvoicePaymentsReceived            CustomInvoicePayment[]
  customInvoiceCreditNotesCreated          CustomInvoiceCreditNote[]
  internalTransfersCreated                 InternalTransfer[]                 @relation("InternalTransferCreatedBy")
  internalTransfersPosted                  InternalTransfer[]                 @relation("InternalTransferPostedBy")
  employeeAdvancesCreated                  EmployeeAdvance[]                  @relation("EmployeeAdvanceCreatedBy")
  employeeAdvanceSettlementsCreated        EmployeeAdvanceSettlement[]        @relation("EmployeeAdvanceSettlementCreatedBy")
  aiGarmentProjectsCreated                 AiGarmentProject[]                 @relation("AiGarmentProjectCreatedBy")
  aiGarmentDesignOptionsCreated            AiGarmentDesignOption[]            @relation("AiGarmentDesignOptionCreatedBy")
  aiGarmentReferenceAnalysesApproved       AiGarmentReferenceAnalysis[]       @relation("AiGarmentReferenceAnalysisApprovedBy")
  aiGarmentReferenceAnalysesCreated        AiGarmentReferenceAnalysis[]       @relation("AiGarmentReferenceAnalysisCreatedBy")
  aiGarmentReferenceObservationsApproved   AiGarmentReferenceObservation[]    @relation("AiGarmentReferenceObservationApprovedBy")
  aiGarmentReferenceAnalysisRunsCreated    AiGarmentReferenceAnalysisRun[]    @relation("AiGarmentReferenceAnalysisRunCreatedBy")
  aiGarmentDevelopmentBriefRunsCreated     AiGarmentDevelopmentBriefRun[]     @relation("AiGarmentDevelopmentBriefRunCreatedBy")
  aiGarmentDesignDirectionsCreated         AiGarmentDesignDirection[]         @relation("AiGarmentDesignDirectionCreatedBy")
  aiGarmentImageGenerationRunsCreated      AiGarmentImageGenerationRun[]      @relation("AiGarmentImageGenerationRunCreatedBy")
  aiGarmentGeneratedImagesCreated          AiGarmentGeneratedImage[]          @relation("AiGarmentGeneratedImageCreatedBy")
  aiGarmentDesignVariationRunsCreated      AiGarmentDesignVariationRun[]      @relation("AiGarmentDesignVariationRunCreatedBy")
  aiGarmentDesignVariationsCreated         AiGarmentDesignVariation[]         @relation("AiGarmentDesignVariationCreatedBy")
  aiGarmentCommercialEvaluationRunsCreated AiGarmentCommercialEvaluationRun[] @relation("AiGarmentCommercialEvaluationRunCreatedBy")
  aiGarmentCommercialEvaluationsCreated    AiGarmentCommercialEvaluation[]    @relation("AiGarmentCommercialEvaluationCreatedBy")
  aiGarmentProjectsSelectedDesignBy        AiGarmentProject[]                 @relation("AiGarmentProjectSelectedDesignBy")
  aiGarmentFabricApplicationRunsCreated    AiGarmentFabricApplicationRun[]    @relation("AiGarmentFabricApplicationRunCreatedBy")
  aiGarmentFabricApplicationsCreated       AiGarmentFabricApplication[]       @relation("AiGarmentFabricApplicationCreatedBy")
  aiGarmentProjectsApprovedFabricAppBy     AiGarmentProject[]                 @relation("AiGarmentProjectApprovedFabricApplicationBy")
  aiGarmentTechnicalFlatRunsCreated        AiGarmentTechnicalFlatRun[]        @relation("AiGarmentTechnicalFlatRunCreatedBy")
  aiGarmentTechnicalFlatsCreated           AiGarmentTechnicalFlat[]           @relation("AiGarmentTechnicalFlatCreatedBy")
  aiGarmentProjectsApprovedTechFlatBy      AiGarmentProject[]                 @relation("AiGarmentProjectApprovedTechnicalFlatBy")
  aiGarmentBomSuggestionRunsCreated        AiGarmentBomSuggestionRun[]        @relation("AiGarmentBomSuggestionRunCreatedBy")
  aiGarmentCostAnalysisRunsCreated         AiGarmentCostAnalysisRun[]         @relation("AiGarmentCostAnalysisRunCreatedBy")
  aiGarmentCostAnalysesCreated             AiGarmentCostAnalysis[]            @relation("AiGarmentCostAnalysisCreatedBy")
  aiGarmentProjectsCostingCompletedBy      AiGarmentProject[]                 @relation("AiGarmentProjectCostingCompletedBy")
  aiGarmentProjectsProductionHandoffBy     AiGarmentProject[]                 @relation("AiGarmentProjectProductionHandoffCompletedBy")

  @@map("users")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company               Company                     @relation(fields: [companyId], references: [id])
  rolePermissions       RolePermission[]
  userBranchRoles       UserBranchRole[]
  productionStageAccess RoleProductionStageAccess[]

  @@unique([companyId, name])
  @@map("roles")
}

/**
 * Restricts a Role to specific ProductionStage(s) for floor-level separation
 * (e.g. a "Cutting Supervisor" role that should never see Stitching's lots) —
 * layered on top of the existing module/action RBAC, not a replacement for
 * it. A Role with ZERO rows here is unrestricted (sees every stage) — this
 * default keeps every pre-existing role (including the seeded
 * PRODUCTION_SUPERVISOR/PRODUCTION_MANAGER) behaving exactly as before with
 * no data migration needed. See PermissionService.getAllowedProductionStageIds()
 * for the read side and job-order.service.ts/lot.service.ts's
 * assertStageAccess() for the write side.
 */
model RoleProductionStageAccess {
  id                String   @id @default(uuid()) @db.Uuid
  roleId            String   @map("role_id") @db.Uuid
  productionStageId String   @map("production_stage_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  productionStage ProductionStage @relation(fields: [productionStageId], references: [id], onDelete: Cascade)

  @@unique([roleId, productionStageId])
  @@map("role_production_stage_access")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId, roleId])
  @@map("user_branch_roles")
}

// ─────────────────────────────────────────────────────────────
// Masters
// ─────────────────────────────────────────────────────────────

model Currency {
  code          String @id @db.Char(3)
  name          String
  symbol        String
  decimalPlaces Int    @default(2) @map("decimal_places")

  companies Company[]

  @@map("currencies")
}

model Customer {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  code                String
  name                String
  type                String    @default("CUSTOMER")
  country             String?
  // Added 2026-09-04 for the Bulk Master Data Import portal -- matches
  // Supplier's own existing taxRegistrationNo field exactly; Customer had no
  // GST/address fields of any kind before this.
  taxRegistrationNo   String?   @map("tax_registration_no")
  billingAddress      String?   @map("billing_address")
  shippingAddress     String?   @map("shipping_address")
  paymentTermsDays    Int?      @map("payment_terms_days")
  creditLimit         Decimal?  @map("credit_limit") @db.Decimal(18, 2)
  defaultCurrencyCode String?   @map("default_currency_code") @db.Char(3)
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id])
  buyers            Buyer[]
  products          Product[]
  sampleRequests    SampleRequest[]
  buyerEnquiries    BuyerEnquiry[]
  salesOrders       SalesOrder[]
  deals             Deal[]
  salesInvoices     SalesInvoice[]
  payments          Payment[]
  dispatches        Dispatch[]
  customInvoices    CustomInvoice[]
  aiGarmentProjects AiGarmentProject[]

  @@unique([companyId, code])
  @@map("customers")
}

model Buyer {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  code          String
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer          Customer           @relation(fields: [customerId], references: [id])
  sampleRequests    SampleRequest[]
  buyerEnquiries    BuyerEnquiry[]
  salesOrders       SalesOrder[]
  aiGarmentProjects AiGarmentProject[]

  @@unique([customerId, code])
  @@map("buyers")
}

// Renamed from SupplierCategory (2026-08-27) — Supplier itself moved to a
// real dynamic master (see the SupplierCategory model below); this enum's
// only remaining consumer is Product.materialCategory, which already had
// its own independent Zod validation (MATERIAL_CATEGORIES) the whole time,
// so the rename has zero downstream TypeScript impact.
enum MaterialCategory {
  FABRIC
  TRIMS
  // Split out of TRIMS on 2026-08-21 so the "Add Material" grouped picker in
  // Sampling can distinguish them at a glance — Trims stays as the general
  // bucket for anything that isn't specifically a zip or a button (elastic,
  // labels, etc.).
  ZIPS
  BUTTONS
  ACCESSORIES
  PACKAGING
  SERVICES
  MACHINERY
  OTHER
  // Added 2026-09-04 so a WarehouseLocation (the only other consumer of this
  // enum) can tag a room/section for a production STAGE, not just a raw
  // material sub-category — mirrors 4 of WarehouseType's own 7 values
  // (RAW_MATERIAL/FABRIC/TRIMS already fit via the values above). Product's
  // own materialCategory (an actual raw material's type) deliberately never
  // uses these — its Zod schema (MATERIAL_CATEGORIES) still only allows the
  // original 9 values above; only WarehouseLocation's own, wider Zod list
  // (LOCATION_MATERIAL_CATEGORIES) accepts them.
  WIP
  FINISHED_GOODS
  DISPATCH
  REJECT
}

/**
 * Supplier's category, made a real per-company master (2026-08-27, at the
 * user's explicit request) instead of the fixed enum it used to share with
 * Product.materialCategory — same {code,name,isActive} shape and
 * makeSimpleLookupService() factory as every other Garment Attributes
 * master (Brand/Category/Season/...). Product.materialCategory is
 * deliberately NOT part of this cutover — it already had its own
 * independent validation and UI (grouped material pickers in Sampling/BOM/
 * Purchasing), a separate, larger decision than what was actually asked.
 */
model SupplierCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                    Company                    @relation(fields: [companyId], references: [id])
  suppliers                  Supplier[]
  supplierMaterialCategories SupplierMaterialCategory[]

  @@unique([companyId, code])
  @@map("supplier_categories")
}

model Supplier {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  code                String
  name                String
  categoryId          String    @map("category_id") @db.Uuid
  contactPerson       String?   @map("contact_person")
  email               String?
  phone               String?
  address             String?
  taxRegistrationNo   String?   @map("tax_registration_no")
  paymentTermsDays    Int?      @map("payment_terms_days")
  defaultCurrencyCode String?   @map("default_currency_code") @db.Char(3)
  bankDetailsJson     Json?     @map("bank_details_json")
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company                Company                    @relation(fields: [companyId], references: [id])

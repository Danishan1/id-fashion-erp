model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  colorId   String   @map("color_id") @db.Uuid
  sizeId    String   @map("size_id") @db.Uuid
  skuCode   String   @unique @map("sku_code")
  // Previously free-text/unenforced (no rows conflicted, so this is a pure
  // integrity tightening, not a behavior change). Auto-generated by the
  // Barcode Management system's SKU code path (Barcode.entityType = SKU) —

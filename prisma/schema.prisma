// Fashion ERP — Phase 2 schema: Organization/Auth + Masters + System domains.
// Sampling, Sales Orders, Production, Inventory, Accounts, and Dispatch domains
// are added in their respective phases (see CLAUDE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Organization / Auth
// ─────────────────────────────────────────────────────────────

model Company {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String?  @map("legal_name")
  taxRegistrationNo    String?  @unique @map("tax_registration_no")
  baseCurrencyCode     String   @map("base_currency_code") @db.Char(3)
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  addressJson          Json?    @map("address_json")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  baseCurrency                      Currency                           @relation(fields: [baseCurrencyCode], references: [code])
  branches                          Branch[]
  users                             User[]
  roles                             Role[]
  customers                         Customer[]
  suppliers                         Supplier[]
  supplierCategories                SupplierCategory[]
  supplierMaterials                 SupplierMaterial[]
  supplierMaterialCategories        SupplierMaterialCategory[]
  departments                       Department[]
  employees                         Employee[]
  products                          Product[]
  colors                            Color[]
  sizes                             Size[]
  warehouses                        Warehouse[]
  productionStages                  ProductionStage[]
  productionLines                   ProductionLine[]
  salesAgents                       SalesAgent[]
  brands                            Brand[]
  categories                        Category[]
  seasons                           Season[]
  productFittings                   ProductFitting[]
  productTypes                      ProductType[]
  designs                           Design[]
  designPatterns                    DesignPattern[]
  patterns                          Pattern[]
  fabricGsms                        FabricGsm[]
  fabricDyes                        FabricDye[]
  fabricDyeTypes                    FabricDyeType[]
  fabricWeaveTypes                  FabricWeaveType[]
  fabricWidths                      FabricWidth[]
  fabricCompositions                FabricComposition[]
  machines                          Machine[]
  designations                      Designation[]
  employeeCategories                EmployeeCategory[]
  shiftMasters                      ShiftMaster[]
  holidayMasters                    HolidayMaster[]
  costMasters                       CostMaster[]
  paymentTypes                      PaymentType[]
  bankAccounts                      BankAccount[]
  sampleRequests                    SampleRequest[]
  buyerEnquiries                    BuyerEnquiry[]
  salesOrders                       SalesOrder[]
  boms                              Bom[]
  purchaseOrders                    PurchaseOrder[]
  materialRequests                  MaterialRequest[]
  goodsReceipts                     GoodsReceipt[]
  fabricRolls                       FabricRoll[]
  inventoryTransactions             InventoryTransaction[]
  stockBalances                     StockBalance[]
  stockMovements                    StockMovement[]
  productionOrders                  ProductionOrder[]
  lots                              Lot[]
  lotRelations                      LotRelation[]
  jobOrders                         JobOrder[]
  productionStageTransactions       ProductionStageTransaction[]
  qcInspections                     QcInspection[]
  defectTypes                       DefectType[]
  documentSequences                 DocumentSequence[]
  auditLogs                         AuditLog[]
  notifications                     Notification[]
  attachments                       Attachment[]
  leads                             Lead[]
  deals                             Deal[]
  crmActivities                     CrmActivity[]
  crmFollowups                      CrmFollowup[]
  crmRoundRobinState                CrmRoundRobinState?
  crmSettings                       CrmSettings?
  importBatches                     ImportBatch[]
  campaigns                         Campaign[]
  campaignAttributions              CampaignAttribution[]
  campaignAlerts                    CampaignAlert[]
  adAccountConnections              AdAccountConnection[]
  attendanceRecords                 AttendanceRecord[]
  attendanceCorrectionRequests      AttendanceCorrectionRequest[]
  leaveTypes                        LeaveType[]
  leaveRequests                     LeaveRequest[]
  leaveBalanceCarryForwards         LeaveBalanceCarryForward[]
  chartOfAccounts                   ChartOfAccount[]
  taxTypes                          TaxType[]
  taxRates                          TaxRate[]
  journals                          Journal[]
  salesInvoices                     SalesInvoice[]
  purchaseInvoices                  PurchaseInvoice[]
  payments                          Payment[]
  expenses                          Expense[]
  dispatches                        Dispatch[]
  jobWorkOrders                     JobWorkOrder[]
  jobWorkReceipts                   JobWorkReceipt[]
  invoiceSeries                     InvoiceSeries[]
  customInvoices                    CustomInvoice[]
  customInvoicePayments             CustomInvoicePayment[]
  customInvoiceCreditNotes          CustomInvoiceCreditNote[]
  internalTransfers                 InternalTransfer[]
  employeeAdvances                  EmployeeAdvance[]
  employeeAdvanceSettlements        EmployeeAdvanceSettlement[]
  submoduleVisibilities             SubmoduleVisibility[]
  aiGarmentProjects                 AiGarmentProject[]
  aiGarmentReferenceAnalyses        AiGarmentReferenceAnalysis[]
  aiGarmentReferenceAnalysisRuns    AiGarmentReferenceAnalysisRun[]
  aiGarmentDevelopmentBriefRuns     AiGarmentDevelopmentBriefRun[]
  aiGarmentDesignDirections         AiGarmentDesignDirection[]
  aiGarmentImageGenerationRuns      AiGarmentImageGenerationRun[]
  aiGarmentGeneratedImages          AiGarmentGeneratedImage[]
  aiGarmentDesignVariationRuns      AiGarmentDesignVariationRun[]
  aiGarmentDesignVariations         AiGarmentDesignVariation[]
  aiGarmentCommercialEvaluationRuns AiGarmentCommercialEvaluationRun[]
  aiGarmentCommercialEvaluations    AiGarmentCommercialEvaluation[]
  aiGarmentFabricApplicationRuns    AiGarmentFabricApplicationRun[]
  aiGarmentFabricApplications       AiGarmentFabricApplication[]
  aiGarmentTechnicalFlatRuns        AiGarmentTechnicalFlatRun[]
  aiGarmentTechnicalFlats           AiGarmentTechnicalFlat[]
  aiGarmentBomSuggestionRuns        AiGarmentBomSuggestionRun[]
  aiGarmentBomSuggestions           AiGarmentBomSuggestion[]
  aiGarmentCostAnalysisRuns         AiGarmentCostAnalysisRun[]
  aiGarmentCostAnalyses             AiGarmentCostAnalysis[]


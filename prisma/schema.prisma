// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 3: Garment Design Visual Generation (2026-09-06)
//
// Provider-agnostic by construction: neither table stores anything about a
// specific vendor's request/response shape (that lives entirely behind
// src/core/ai/image-generation/'s ImageGenerationProvider interface) — only
// `provider`/`model` strings for audit, matching AiGarmentDevelopmentBriefRun's
// own precedent. Reuses AiGarmentAnalysisRunStatus (IN_PROGRESS/SUCCESS/FAILED)
// a third time — same generic AI-call-lifecycle concept, no new enum needed.
//
// Never overwritten, never deleted: a "Regenerate" or "Create Variation" is
// always a new AiGarmentImageGenerationRun + new AiGarmentGeneratedImage rows,
// never an update to an existing image's own imageAttachmentId — full version
// history is simply every row that ever existed for a design direction.
// ─────────────────────────────────────────────────────────────

enum AiGarmentGeneratedImageDecision {
  PENDING
  SELECTED
  REJECTED
}

// One row per "Generate Visual" click (a batch of 1/3/4 images for one design
// direction) or per "Create Variation" (image-to-image, parentGeneratedImageId
// set) — mirrors AiGarmentDevelopmentBriefRun's own run-log shape exactly.
model AiGarmentImageGenerationRun {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @map("company_id") @db.Uuid
  projectId              String                     @map("project_id") @db.Uuid
  designDirectionId      String                     @map("design_direction_id") @db.Uuid
  provider               String
  model                  String
  promptVersion          String                     @map("prompt_version")
  // The fully-resolved prompt text actually sent -- kept for audit/
  // reproducibility, the same reasoning AiGarmentReferenceAnalysis keeps the
  // complete raw AI response for.
  promptText             String                     @map("prompt_text")
  requestedImageCount    Int                        @map("requested_image_count")
  // Set only for "Create Variation" -- the specific prior generated image
  // this run was an image-to-image variation OF. Null for an ordinary
  // Generate Visual / Regenerate batch.
  parentGeneratedImageId String?                    @map("parent_generated_image_id") @db.Uuid
  status                 AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory          String?                    @map("error_category")
  errorMessage           String?                    @map("error_message")
  requestedAt            DateTime                   @default(now()) @map("requested_at")
  completedAt            DateTime?                  @map("completed_at")
  createdByUserId        String                     @map("created_by_user_id") @db.Uuid

  company         Company                   @relation(fields: [companyId], references: [id])
  project         AiGarmentProject          @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  createdBy       User                      @relation("AiGarmentImageGenerationRunCreatedBy", fields: [createdByUserId], references: [id])
  images          AiGarmentGeneratedImage[]

  @@index([projectId, designDirectionId, status])
  @@map("ai_garment_image_generation_runs")
}

model AiGarmentGeneratedImage {
  id                String                          @id @default(uuid()) @db.Uuid
  companyId         String                          @map("company_id") @db.Uuid
  projectId         String                          @map("project_id") @db.Uuid
  designDirectionId String                          @map("design_direction_id") @db.Uuid
  generationRunId   String                          @map("generation_run_id") @db.Uuid
  promptVersion     String                          @map("prompt_version")
  provider          String
  model             String
  // Soft reference to Attachment.id -- no hard FK, same convention as
  // AiGarmentProject.referenceImageAttachmentId / AiGarmentDesignOption.imageAttachmentId.
  imageAttachmentId String                          @map("image_attachment_id") @db.Uuid
  decision          AiGarmentGeneratedImageDecision @default(PENDING)
  userNotes         String?                         @map("user_notes")
  createdByUserId   String                          @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")

  company         Company                       @relation(fields: [companyId], references: [id])
  project         AiGarmentProject              @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection      @relation(fields: [designDirectionId], references: [id])
  generationRun   AiGarmentImageGenerationRun   @relation(fields: [generationRunId], references: [id])
  createdBy       User                          @relation("AiGarmentGeneratedImageCreatedBy", fields: [createdByUserId], references: [id])
  variationRuns   AiGarmentDesignVariationRun[]
  variations      AiGarmentDesignVariation[]

  @@index([projectId, designDirectionId])
  @@index([designDirectionId, decision])
  @@map("ai_garment_generated_images")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 4: Controlled Design Variation (2026-09-07)
//
// Starts from one existing AiGarmentGeneratedImage ("the original" — never
// edited or deleted by this process). A "Modify Design" submission targets
// exactly one named feature (the fixed picklist below) and is image-to-image
// generated from that same parent image, never from a prior variation —
// deliberately one level deep, not a chain: every AiGarmentDesignVariation's
// parentGeneratedImageId always points at the same original image, and
// variationNumber increments per parent image. "Create Another Variation"
// means "try a different feature/requirement against the same original," not
// "iterate on the variation I just made" — a simpler, easier-to-reason-about
// scope than open-ended chaining, matching this project's own repeated
// "explicit MVP simplification, documented not silently dropped" precedent.
//
// Mirrors AiGarmentImageGenerationRun/AiGarmentGeneratedImage's own shape
// exactly: a run-log row created before the provider is ever resolved (so a
// MISSING_CONFIG failure is still audited), and the variation row itself is
// never overwritten — full version history is just every row that ever
// existed for a given parent image.
// ─────────────────────────────────────────────────────────────

enum AiGarmentDesignFeature {
  NECKLINE
  COLLAR
  SLEEVE
  SLEEVE_LENGTH
  CUFF
  GARMENT_LENGTH
  FIT
  SILHOUETTE
  POCKET
  CLOSURE
  WAIST
  HEM
  OTHER
}

enum AiGarmentDesignVariationDecision {
  PENDING
  SELECTED
  KEPT_ORIGINAL
}

// One row per "Modify Design" submission.
model AiGarmentDesignVariationRun {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @map("company_id") @db.Uuid
  projectId              String                     @map("project_id") @db.Uuid
  designDirectionId      String                     @map("design_direction_id") @db.Uuid
  parentGeneratedImageId String                     @map("parent_generated_image_id") @db.Uuid
  featureKey             AiGarmentDesignFeature     @map("feature_key")
  currentFeatureValue    String                     @map("current_feature_value")
  newRequirement         String                     @map("new_requirement")
  additionalInstructions String?                    @map("additional_instructions")
  provider               String
  model                  String
  promptVersion          String                     @map("prompt_version")
  // The fully-resolved prompt text actually sent -- same audit reasoning as
  // AiGarmentImageGenerationRun.promptText.
  promptText             String                     @map("prompt_text")
  status                 AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory          String?                    @map("error_category")
  errorMessage           String?                    @map("error_message")
  requestedAt            DateTime                   @default(now()) @map("requested_at")
  completedAt            DateTime?                  @map("completed_at")
  createdByUserId        String                     @map("created_by_user_id") @db.Uuid

  company              Company                   @relation(fields: [companyId], references: [id])
  project              AiGarmentProject          @relation(fields: [projectId], references: [id])
  designDirection      AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  parentGeneratedImage AiGarmentGeneratedImage   @relation(fields: [parentGeneratedImageId], references: [id])
  createdBy            User                      @relation("AiGarmentDesignVariationRunCreatedBy", fields: [createdByUserId], references: [id])
  variation            AiGarmentDesignVariation?

  @@index([parentGeneratedImageId, status])
  @@map("ai_garment_design_variation_runs")
}

// Version control per the spec: Parent Image ID, Variation Number, Changed
// Feature, Previous Value, New Value, Created Date. Never edited/deleted --
// "Keep Original"/"Select Variation" only ever change `decision`.
model AiGarmentDesignVariation {
  id                     String                           @id @default(uuid()) @db.Uuid
  companyId              String                           @map("company_id") @db.Uuid
  projectId              String                           @map("project_id") @db.Uuid
  designDirectionId      String                           @map("design_direction_id") @db.Uuid
  parentGeneratedImageId String                           @map("parent_generated_image_id") @db.Uuid
  variationRunId         String                           @unique @map("variation_run_id") @db.Uuid
  variationNumber        Int                              @map("variation_number")
  featureKey             AiGarmentDesignFeature           @map("feature_key")
  previousValue          String                           @map("previous_value")
  newValue               String                           @map("new_value")
  additionalInstructions String?                          @map("additional_instructions")
  promptVersion          String                           @map("prompt_version")
  provider               String
  model                  String
  // Soft reference to Attachment.id -- same no-hard-FK convention as
  // AiGarmentGeneratedImage.imageAttachmentId.
  imageAttachmentId      String                           @map("image_attachment_id") @db.Uuid
  decision               AiGarmentDesignVariationDecision @default(PENDING)
  createdByUserId        String                           @map("created_by_user_id") @db.Uuid
  createdAt              DateTime                         @default(now()) @map("created_at")
  updatedAt              DateTime                         @updatedAt @map("updated_at")

  company              Company                     @relation(fields: [companyId], references: [id])
  project              AiGarmentProject            @relation(fields: [projectId], references: [id])
  designDirection      AiGarmentDesignDirection    @relation(fields: [designDirectionId], references: [id])
  parentGeneratedImage AiGarmentGeneratedImage     @relation(fields: [parentGeneratedImageId], references: [id])
  variationRun         AiGarmentDesignVariationRun @relation(fields: [variationRunId], references: [id])
  createdBy            User                        @relation("AiGarmentDesignVariationCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([parentGeneratedImageId, variationNumber])
  @@index([parentGeneratedImageId, decision])
  @@map("ai_garment_design_variations")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 5: Commercial Design Evaluation (2026-09-07)
//
// Compares 2-8 of a project's own AiGarmentDesignDirection rows (the real
// named "designs" this whole flow produces — not a raw image or variation,
// which are visual renderings OF a design, not the design itself) on the
// spec's own 12-criterion commercial rubric. `commercialDevelopmentScore` is
// always computed server-side from the 12 raw scores via a fixed weighted
// formula — never trusted from the AI's own arithmetic, the same "never
// trust computed totals from the client/model" discipline this project
// applies everywhere else (Sales Order/Journal/MRP totals, etc.).
// ─────────────────────────────────────────────────────────────

enum AiGarmentCommercialRank {
  FIRST_CHOICE
  SECOND_CHOICE
  THIRD_CHOICE
  NOT_RANKED
}

// One row per "COMPARE COMMERCIALLY" click — mirrors every other AI Garment
// Flow run-log table exactly (created before the provider is even resolved).
model AiGarmentCommercialEvaluationRun {
  id                         String                     @id @default(uuid()) @db.Uuid
  companyId                  String                     @map("company_id") @db.Uuid
  projectId                  String                     @map("project_id") @db.Uuid
  comparedDesignDirectionIds String[]                   @map("compared_design_direction_ids") @db.Uuid
  provider                   String
  model                      String
  promptVersion              String                     @map("prompt_version")
  promptText                 String                     @map("prompt_text")
  // The auto-pulled Buyer/Market/Customer/Season/Target Price/Fabric/Order
  // Quantity/Factory Capability context actually sent — kept for audit, same
  // reasoning AiGarmentDevelopmentBriefRun.contextSnapshotJson already uses.
  contextSnapshotJson        Json                       @map("context_snapshot_json")
  status                     AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory              String?                    @map("error_category")
  errorMessage               String?                    @map("error_message")
  requestedAt                DateTime                   @default(now()) @map("requested_at")
  completedAt                DateTime?                  @map("completed_at")
  createdByUserId            String                     @map("created_by_user_id") @db.Uuid

  company    Company                        @relation(fields: [companyId], references: [id])
  project    AiGarmentProject               @relation(fields: [projectId], references: [id])
  createdBy  User                           @relation("AiGarmentCommercialEvaluationRunCreatedBy", fields: [createdByUserId], references: [id])
  evaluation AiGarmentCommercialEvaluation?

  @@index([projectId, status])
  @@map("ai_garment_commercial_evaluation_runs")
}

// One row per successful comparison — append-only, like AiGarmentDesignDirection
// itself: re-running the comparison (a different design set, or a re-ask on
// the same set) always creates a new evaluation, never overwrites a prior
// one, so the full history of past comparisons stays inspectable.
model AiGarmentCommercialEvaluation {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  runId                   String   @unique @map("run_id") @db.Uuid
  // The AI's own comparative reasoning across the whole set (why this design
  // ranked above that one) -- inherently a cross-design narrative, so it's
  // one field on the header, not duplicated per item.
  overallRankingRationale String   @map("overall_ranking_rationale")
  createdByUserId         String   @map("created_by_user_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")

  company   Company                             @relation(fields: [companyId], references: [id])
  project   AiGarmentProject                    @relation(fields: [projectId], references: [id])
  run       AiGarmentCommercialEvaluationRun    @relation(fields: [runId], references: [id])
  createdBy User                                @relation("AiGarmentCommercialEvaluationCreatedBy", fields: [createdByUserId], references: [id])
  items     AiGarmentCommercialEvaluationItem[]

  @@index([projectId])
  @@map("ai_garment_commercial_evaluations")
}

// One row per compared design direction. `aiRank` is the AI's own suggestion;
// `userRank` is the "allow user to override AI ranking" field the spec asks
// for -- null means "no override, defer to aiRank". Neither rank is what
// actually commits a design to development: that's `AiGarmentProject
// .selectedDesignDirectionId`, a wholly separate, explicitly-confirmed
// action ("Final choice must always be user-approved" holds structurally --
// nothing here can select a design for development on its own).
model AiGarmentCommercialEvaluationItem {
  id                String @id @default(uuid()) @db.Uuid
  evaluationId      String @map("evaluation_id") @db.Uuid
  designDirectionId String @map("design_direction_id") @db.Uuid

  targetCustomerFitScore           Int @map("target_customer_fit_score")
  buyerFitScore                    Int @map("buyer_fit_score")
  fabricSuitabilityScore           Int @map("fabric_suitability_score")
  commercialAppealScore            Int @map("commercial_appeal_score")
  manufacturingSimplicityScore     Int @map("manufacturing_simplicity_score")
  fabricConsumptionEfficiencyScore Int @map("fabric_consumption_efficiency_score")
  patternMakingComplexityScore     Int @map("pattern_making_complexity_score")
  sewingComplexityScore            Int @map("sewing_complexity_score")
  trimComplexityScore              Int @map("trim_complexity_score")
  targetPriceCompatibilityScore    Int @map("target_price_compatibility_score")
  bulkProductionScalabilityScore   Int @map("bulk_production_scalability_score")
  designFreshnessScore             Int @map("design_freshness_score")

  // /100, computed server-side -- see this block's own header comment.
  commercialDevelopmentScore Int @map("commercial_development_score")

  strengths            String
  weaknesses           String
  manufacturingRisks   String @map("manufacturing_risks")
  potentialCostRisks   String @map("potential_cost_risks")
  suggestedImprovement String @map("suggested_improvement")

  aiRank   AiGarmentCommercialRank  @map("ai_rank")
  userRank AiGarmentCommercialRank? @map("user_rank")

  evaluation      AiGarmentCommercialEvaluation @relation(fields: [evaluationId], references: [id])
  designDirection AiGarmentDesignDirection      @relation(fields: [designDirectionId], references: [id])

  @@unique([evaluationId, designDirectionId])
  @@map("ai_garment_commercial_evaluation_items")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 6: Apply Actual Fabric to Selected Garment (2026-09-07)
//
// Starts from the project's own SELECTED DESIGN (AiGarmentProject
// .selectedDesignDirectionId, Process 5's output) and its currently SELECTED
// visual (an AiGarmentGeneratedImage or, if one exists, a superseding
// AiGarmentDesignVariation — resolveSelectedGarmentImage() in the service
// picks whichever was most recently marked SELECTED). A genuine two-image
// composition: the base garment image AND the uploaded fabric swatch are
// both sent to the provider (see ImageGenerationProvider.applyFabric),
// never just described in text.
//
// "Do not overwrite the selected garment design" holds structurally: this
// process never writes to AiGarmentGeneratedImage or AiGarmentDesignVariation
// at all -- every attempt (Regenerate/Change Fabric/Adjust Print Scale/
// Adjust Placement all funnel through the same createFabricApplication(),
// just with different submitted fields) is a brand-new
// AiGarmentFabricApplication row, "before" and "after" images both kept.
// ─────────────────────────────────────────────────────────────

enum AiGarmentFabricApplicationDecision {
  PENDING
  APPROVED
}

// One row per "APPLY FABRIC" submission.
model AiGarmentFabricApplicationRun {
  id                    String                     @id @default(uuid()) @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  projectId             String                     @map("project_id") @db.Uuid
  designDirectionId     String                     @map("design_direction_id") @db.Uuid
  baseImageAttachmentId String                     @map("base_image_attachment_id") @db.Uuid
  swatchAttachmentId    String                     @map("swatch_attachment_id") @db.Uuid
  fabricCode            String?                    @map("fabric_code")
  composition           String?
  width                 String?
  gsm                   String?
  wovenOrKnit           String?                    @map("woven_or_knit")
  stretch               String?
  drape                 String?
  transparency          String?
  surfaceCharacter      String?                    @map("surface_character")
  printPattern          String?                    @map("print_pattern")
  directionality        String?
  specialPlacement      String?                    @map("special_placement")
  availableQuantity     Decimal?                   @map("available_quantity") @db.Decimal(18, 4)
  costPerMetre          Decimal?                   @map("cost_per_metre") @db.Decimal(18, 2)
  provider              String
  model                 String
  promptVersion         String                     @map("prompt_version")
  // The fully-resolved prompt text actually sent -- same audit reasoning as
  // every other AI Garment Flow run's own promptText.
  promptText            String                     @map("prompt_text")
  status                AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory         String?                    @map("error_category")
  errorMessage          String?                    @map("error_message")
  requestedAt           DateTime                   @default(now()) @map("requested_at")
  completedAt           DateTime?                  @map("completed_at")
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid

  company         Company                     @relation(fields: [companyId], references: [id])
  project         AiGarmentProject            @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection    @relation(fields: [designDirectionId], references: [id])
  createdBy       User                        @relation("AiGarmentFabricApplicationRunCreatedBy", fields: [createdByUserId], references: [id])
  application     AiGarmentFabricApplication?

  @@index([designDirectionId, status])
  @@map("ai_garment_fabric_application_runs")
}

// One row per successful "APPLY FABRIC" attempt -- version control mirroring
// AiGarmentDesignVariation's own shape: never edited/deleted, "Approve" only
// ever changes `decision`. `baseImageAttachmentId` is the "Before Fabric
// Application" image, `resultImageAttachmentId` is "After" -- both kept, so
// a side-by-side comparison never needs to reconstruct history from
// elsewhere. `swatchAttachmentId` is the original fabric swatch, stored
// separately per the spec's own "Store original fabric image separately."
model AiGarmentFabricApplication {
  id                      String                             @id @default(uuid()) @db.Uuid
  companyId               String                             @map("company_id") @db.Uuid
  projectId               String                             @map("project_id") @db.Uuid
  designDirectionId       String                             @map("design_direction_id") @db.Uuid
  runId                   String                             @unique @map("run_id") @db.Uuid
  baseImageAttachmentId   String                             @map("base_image_attachment_id") @db.Uuid
  swatchAttachmentId      String                             @map("swatch_attachment_id") @db.Uuid
  resultImageAttachmentId String                             @map("result_image_attachment_id") @db.Uuid
  fabricCode              String?                            @map("fabric_code")
  composition             String?
  width                   String?
  gsm                     String?
  wovenOrKnit             String?                            @map("woven_or_knit")
  stretch                 String?
  drape                   String?
  transparency            String?
  surfaceCharacter        String?                            @map("surface_character")
  printPattern            String?                            @map("print_pattern")
  directionality          String?
  specialPlacement        String?                            @map("special_placement")
  availableQuantity       Decimal?                           @map("available_quantity") @db.Decimal(18, 4)
  costPerMetre            Decimal?                           @map("cost_per_metre") @db.Decimal(18, 2)
  decision                AiGarmentFabricApplicationDecision @default(PENDING)
  createdByUserId         String                             @map("created_by_user_id") @db.Uuid
  createdAt               DateTime                           @default(now()) @map("created_at")
  updatedAt               DateTime                           @updatedAt @map("updated_at")

  company            Company                       @relation(fields: [companyId], references: [id])
  project            AiGarmentProject              @relation("AiGarmentFabricApplicationsOfProject", fields: [projectId], references: [id])
  designDirection    AiGarmentDesignDirection      @relation(fields: [designDirectionId], references: [id])
  run                AiGarmentFabricApplicationRun @relation(fields: [runId], references: [id])
  createdBy          User                          @relation("AiGarmentFabricApplicationCreatedBy", fields: [createdByUserId], references: [id])
  approvedByProjects AiGarmentProject[]            @relation("AiGarmentProjectApprovedFabricApplication")

  @@index([designDirectionId, decision])
  @@map("ai_garment_fabric_applications")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 7: Technical Development (2026-09-07)
//
// "Create Technical Flat" -- regenerates the currently selected garment
// visual (preferring an approved fabric-applied result, falling back to the
// plain selected design visual for FABRIC-sourced projects, which never go
// through Apply Fabric) as a professional flat/CAD-style technical line
// drawing (front + back, construction/seam/trim callouts, no photorealistic
// rendering) -- the standard tech-pack deliverable, distinct in kind from
// Processes 3/4/6's photorealistic renders. Mirrors AiGarmentFabricApplication's
// shape exactly (a run/audit-log table + a version-controlled result table,
// never edited/deleted, two-tier Approve/APPROVE-TECHNICAL-FLAT confirmation)
// since it's the same "regenerate an existing visual, keep full history"
// pattern -- reuses AiGarmentAnalysisRunStatus rather than a fourth identical
// PENDING/IN_PROGRESS/SUCCESS/FAILED enum.
// ─────────────────────────────────────────────────────────────

enum AiGarmentTechnicalFlatDecision {
  PENDING
  APPROVED
}

// One row per "CREATE TECHNICAL FLAT" submission (initial generation or
// Regenerate).
model AiGarmentTechnicalFlatRun {
  id                    String                     @id @default(uuid()) @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  projectId             String                     @map("project_id") @db.Uuid
  designDirectionId     String                     @map("design_direction_id") @db.Uuid
  baseImageAttachmentId String                     @map("base_image_attachment_id") @db.Uuid
  // The one optional user input this process takes -- a free-text note to
  // guide which construction details to call out (e.g. "show the back yoke
  // seam"), never a required field, since the deliverable is a visual
  // re-render, not a data-collection form the way Process 6's textile
  // fields are.
  additionalNotes       String?                    @map("additional_notes")
  provider              String
  model                 String
  promptVersion         String                     @map("prompt_version")
  promptText            String                     @map("prompt_text")
  status                AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory         String?                    @map("error_category")
  errorMessage          String?                    @map("error_message")
  requestedAt           DateTime                   @default(now()) @map("requested_at")
  completedAt           DateTime?                  @map("completed_at")
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid

  company         Company                  @relation(fields: [companyId], references: [id])
  project         AiGarmentProject         @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection @relation(fields: [designDirectionId], references: [id])
  createdBy       User                     @relation("AiGarmentTechnicalFlatRunCreatedBy", fields: [createdByUserId], references: [id])
  flat            AiGarmentTechnicalFlat?

  @@index([designDirectionId, status])
  @@map("ai_garment_technical_flat_runs")
}

// One row per successful "CREATE TECHNICAL FLAT" attempt -- version control
// mirroring AiGarmentFabricApplication's own shape: never edited/deleted,
// "Approve" only ever changes `decision`. `baseImageAttachmentId` is what it
// was generated from (kept for a side-by-side comparison), `resultImageAttachmentId`
// is the technical flat image itself.
model AiGarmentTechnicalFlat {
  id                      String                         @id @default(uuid()) @db.Uuid
  companyId               String                         @map("company_id") @db.Uuid
  projectId               String                         @map("project_id") @db.Uuid
  designDirectionId       String                         @map("design_direction_id") @db.Uuid
  runId                   String                         @unique @map("run_id") @db.Uuid
  baseImageAttachmentId   String                         @map("base_image_attachment_id") @db.Uuid
  resultImageAttachmentId String                         @map("result_image_attachment_id") @db.Uuid
  additionalNotes         String?                        @map("additional_notes")
  decision                AiGarmentTechnicalFlatDecision @default(PENDING)
  createdByUserId         String                         @map("created_by_user_id") @db.Uuid
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")

  company            Company                   @relation(fields: [companyId], references: [id])
  project            AiGarmentProject          @relation("AiGarmentTechnicalFlatsOfProject", fields: [projectId], references: [id])
  designDirection    AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  run                AiGarmentTechnicalFlatRun @relation(fields: [runId], references: [id])
  createdBy          User                      @relation("AiGarmentTechnicalFlatCreatedBy", fields: [createdByUserId], references: [id])
  approvedByProjects AiGarmentProject[]        @relation("AiGarmentProjectApprovedTechnicalFlat")

  @@index([designDirectionId, decision])
  @@map("ai_garment_technical_flats")
}

// ─────────────────────────────────────────────────────────────
// AI Garment Flow — Process 8: BOM Suggestion (2026-09-07)
//
// "Generate Draft BOM" -- unlike every prior process, this one's real
// deliverable is never written to a schema of its own: BOM/Costing steps
// were architected from the foundation phase onward to require graduation
// to a real Style and then reuse the EXISTING bom-mrp module's Bom/
// BomVersion/BomItem tables and its own upsertBom()/approveBomVersion()
// actions, with no parallel BOM schema in this module. What this section
// adds is only the AI's own advisory suggestions (free-text material
// descriptions/estimated quantities the model proposes) plus the run/audit
// log -- a suggestion is never itself a real BomItem; resolving one always
// goes through bom-mrp's own real upsertBom() (bom-suggestion.service.ts's
// resolveBomSuggestion() reads the current real BOM, appends the one
// user-confirmed line, and calls upsertBom() unchanged -- the exact
// "reuse an existing module's real write path, orchestrate around it"
// shape already used by Material Request's generatePurchaseOrdersForShortfall()
// calling createPurchaseOrder()).
// ─────────────────────────────────────────────────────────────

// One row per "GENERATE DRAFT BOM" submission.
model AiGarmentBomSuggestionRun {
  id                String                     @id @default(uuid()) @db.Uuid
  companyId         String                     @map("company_id") @db.Uuid
  projectId         String                     @map("project_id") @db.Uuid
  designDirectionId String                     @map("design_direction_id") @db.Uuid
  provider          String
  model             String
  promptVersion     String                     @map("prompt_version")
  promptText        String                     @map("prompt_text")
  status            AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory     String?                    @map("error_category")
  errorMessage      String?                    @map("error_message")
  requestedAt       DateTime                   @default(now()) @map("requested_at")
  completedAt       DateTime?                  @map("completed_at")
  createdByUserId   String                     @map("created_by_user_id") @db.Uuid

  company         Company                  @relation(fields: [companyId], references: [id])
  project         AiGarmentProject         @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection @relation(fields: [designDirectionId], references: [id])
  createdBy       User                     @relation("AiGarmentBomSuggestionRunCreatedBy", fields: [createdByUserId], references: [id])
  suggestions     AiGarmentBomSuggestion[]

  @@index([designDirectionId, status])
  @@map("ai_garment_bom_suggestion_runs")
}

enum AiGarmentBomSuggestionDecision {
  PENDING
  ADDED
  DISMISSED
}

// One row per AI-suggested draft BOM line. Never itself a real BomItem --
// PENDING is purely advisory; ADDED means a user reviewed it (optionally
// editing every value) and resolveBomSuggestion() wrote a real BomItem via
// the existing upsertBom(); DISMISSED means the user decided not to use it.
// `resolvedBomItemId` is a soft reference only (no hard FK) -- upsertBom()
// deletes and recreates every BomItem row on each save (see
// bom.repository.ts's saveDraftWithItems), so a real FK to a BomItem would
// dangle the moment that style's BOM is next edited through the ordinary
// BOM editor, completely independent of this module.
model AiGarmentBomSuggestion {
  id                         String                         @id @default(uuid()) @db.Uuid
  companyId                  String                         @map("company_id") @db.Uuid
  projectId                  String                         @map("project_id") @db.Uuid
  designDirectionId          String                         @map("design_direction_id") @db.Uuid
  runId                      String                         @map("run_id") @db.Uuid
  materialDescription        String                         @map("material_description")
  materialCategory           MaterialCategory               @map("material_category")
  suggestedQuantityPerUnit   Decimal                        @map("suggested_quantity_per_unit") @db.Decimal(18, 4)
  suggestedUom               String                         @map("suggested_uom")
  suggestedWastagePercentage Decimal                        @map("suggested_wastage_percentage") @db.Decimal(5, 2)
  colorNote                  String?                        @map("color_note")
  reasoning                  String
  decision                   AiGarmentBomSuggestionDecision @default(PENDING)
  resolvedBomItemId          String?                        @map("resolved_bom_item_id") @db.Uuid
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")

  company         Company                   @relation(fields: [companyId], references: [id])
  project         AiGarmentProject          @relation(fields: [projectId], references: [id])
  designDirection AiGarmentDesignDirection  @relation(fields: [designDirectionId], references: [id])
  run             AiGarmentBomSuggestionRun @relation(fields: [runId], references: [id])

  @@index([designDirectionId, decision])
  @@map("ai_garment_bom_suggestions")
}

// ─────────────────────────────────────────────────────────────
// Process 9 (Cost Analysis) -- an advisory AI cost estimate/commentary over
// the project's own approved design + resolved BOM (if any) + known fabric
// detail + real Sampling costing figures (if a linked Sample Request's
// current version is already priced). Deliberately never writes to, and
// never duplicates, Sampling's own real costing engine (SampleVersion
// .costSubtotal/finalTotal/marginPercent/commissionPercent/freightAmount,
// isCostingLocked) -- the exact same "advisory suggestion, real numbers
// live in the existing module" shape Process 8's BOM Suggestion already
// established, just for commentary instead of a resolvable line item.
// ─────────────────────────────────────────────────────────────

// One row per "ANALYSE COST WITH AI" click -- mirrors every other AI
// Garment Flow run-log table exactly (created before the provider is even
// resolved). Reuses AiGarmentAnalysisRunStatus rather than a sixth
// identical PENDING/IN_PROGRESS/SUCCESS/FAILED enum.
model AiGarmentCostAnalysisRun {
  id                  String                     @id @default(uuid()) @db.Uuid
  companyId           String                     @map("company_id") @db.Uuid
  projectId           String                     @map("project_id") @db.Uuid
  provider            String
  model               String
  promptVersion       String                     @map("prompt_version")
  promptText          String                     @map("prompt_text")
  contextSnapshotJson Json                       @map("context_snapshot_json")
  status              AiGarmentAnalysisRunStatus @default(IN_PROGRESS)
  errorCategory       String?                    @map("error_category")
  errorMessage        String?                    @map("error_message")
  requestedAt         DateTime                   @default(now()) @map("requested_at")
  completedAt         DateTime?                  @map("completed_at")
  createdByUserId     String                     @map("created_by_user_id") @db.Uuid

  company   Company                @relation(fields: [companyId], references: [id])
  project   AiGarmentProject       @relation(fields: [projectId], references: [id])
  createdBy User                   @relation("AiGarmentCostAnalysisRunCreatedBy", fields: [createdByUserId], references: [id])
  analysis  AiGarmentCostAnalysis?

  @@index([projectId, status])
  @@map("ai_garment_cost_analysis_runs")
}

// One row per successful "ANALYSE COST WITH AI" run -- append-only, the
// same "full history stays inspectable, only the most recent is surfaced in
// the UI" precedent AiGarmentCommercialEvaluation already established: a
// re-run always creates a new analysis, never overwrites a prior one.
model AiGarmentCostAnalysis {
  id                           String   @id @default(uuid()) @db.Uuid
  companyId                    String   @map("company_id") @db.Uuid
  projectId                    String   @map("project_id") @db.Uuid
  runId                        String   @unique @map("run_id") @db.Uuid
  estimatedCostPerUnitLow      Decimal  @map("estimated_cost_per_unit_low") @db.Decimal(18, 2)
  estimatedCostPerUnitHigh     Decimal  @map("estimated_cost_per_unit_high") @db.Decimal(18, 2)
  costBreakdownCommentary      String   @map("cost_breakdown_commentary")
  pricePositioningCommentary   String   @map("price_positioning_commentary")
  marginFeasibilityCommentary  String   @map("margin_feasibility_commentary")
  riskNotes                    String   @map("risk_notes")
  createdByUserId              String   @map("created_by_user_id") @db.Uuid
  createdAt                    DateTime @default(now()) @map("created_at")

  company   Company                  @relation(fields: [companyId], references: [id])
  project   AiGarmentProject         @relation(fields: [projectId], references: [id])
  run       AiGarmentCostAnalysisRun @relation(fields: [runId], references: [id])
  createdBy User                     @relation("AiGarmentCostAnalysisCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId])
  @@map("ai_garment_cost_analyses")
}

// ─────────────────────────────────────────────────────────────
// System
// ─────────────────────────────────────────────────────────────

enum RelatedModule {
  SAMPLE_REQUEST
  BUYER_ENQUIRY
  SALES_ORDER
  PURCHASE_ORDER
  MATERIAL_REQUEST
  SALES_INVOICE
  PURCHASE_INVOICE
  QC_INSPECTION
  DISPATCH
  PAYMENT
  GOODS_RECEIPT
  PRODUCTION_ORDER
  EXPENSE
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  PRODUCT
  STOCK_MOVEMENT
  LEAD
  DEAL
  CRM_FOLLOWUP
  JOB_WORK_ORDER
  LEAVE_REQUEST
  ATTENDANCE_CORRECTION
  EMPLOYEE_ADVANCE_SETTLEMENT
  // The Bulk Master Data Import portal (Super Admin only) -- used as the
  // referenceModule for an Opening Stock row's ledger entry (referencing
  // the ImportBatch that created it, not a real document of any other
  // type).
  IMPORT_BATCH
  // AI Garment Flow (2026-09-06) -- every file uploaded anywhere in a
  // project's workflow (reference images, fabric swatches, generated design
  // images, technical flats, etc.) attaches at the project header level
  // (relatedRecordId = AiGarmentProject.id), disambiguated by Attachment's
  // own contextLabel reused as an asset-type tag -- matching Sampling's own
  // precedent of keeping attachments at the header level, not per-child-row.
  AI_GARMENT_PROJECT
}

model Attachment {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  uploadedById    String        @map("uploaded_by") @db.Uuid
  relatedModule   RelatedModule @map("related_module")
  relatedRecordId String        @map("related_record_id") @db.Uuid
  fileName        String        @map("file_name")
  storageKey      String        @map("storage_key")
  fileSizeBytes   Int           @map("file_size_bytes")
  mimeType        String        @map("mime_type")
  // Free-text snapshot of "what state was the parent record in when this was
  // uploaded" (e.g. a SampleStatus value like "IN_DEVELOPMENT") — generic
  // string, not FK'd to any one module's status enum, since Attachment is
  // shared across every future module, not owned by Sampling.
  contextLabel    String?       @map("context_label")
  uploadedAt      DateTime      @default(now()) @map("uploaded_at")

  company    Company @relation(fields: [companyId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([relatedModule, relatedRecordId])
  @@map("attachments")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  title           String
  body            String
  relatedModule   RelatedModule?      @map("related_module")
  relatedRecordId String?             @map("related_record_id") @db.Uuid
  channel         NotificationChannel @default(IN_APP)
  isRead          Boolean             @default(false) @map("is_read")
  sentAt          DateTime?           @map("sent_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}


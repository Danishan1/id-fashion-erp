  errorMessage          String?            @map("error_message")
  requestedAt           DateTime           @default(now()) @map("requested_at")
  completedAt           DateTime?          @map("completed_at")
  createdByUserId       String             @map("created_by_user_id") @db.Uuid

  company   Company                     @relation(fields: [companyId], references: [id])
  project   ReplicateDesignProject      @relation(fields: [projectId], references: [id])
  analysis  ReplicateDesignDnaAnalysis? @relation(fields: [analysisId], references: [id])
  createdBy User                        @relation("ReplicateDesignDnaAnalysisRunCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId, status])
  @@map("replicate_design_dna_analysis_runs")
}

// A raw-material line the user picked (via the existing shared MaterialPicker
// component) to replace one of the reference garment's original materials —
// productId always points at a real Product row (itemType=RAW_MATERIAL).
model ReplicateDesignMaterialLine {
  id        String                @id @default(uuid()) @db.Uuid
  companyId String                @map("company_id") @db.Uuid
  projectId String                @map("project_id") @db.Uuid

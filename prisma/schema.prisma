  companyId    String   @map("company_id") @db.Uuid
  code         String
  name         String
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  // Minutes past startTime before a punch-in counts as late — HRMS
  // gap-analysis Priority 2 item; computeIsLate() applies this as a
  // tolerance window rather than the raw startTime cutoff.
  graceMinutes Int      @default(0) @map("grace_minutes")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, code])
  @@map("shift_masters")
}

model HolidayMaster {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  date      DateTime @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date, name])
  @@map("holiday_masters")
}

// ─────────────────────────────────────────────────────────────
// Masters — Costing
// (imported from Inventory reference system)
// ─────────────────────────────────────────────────────────────

enum CostMasterType {
  HOURLY
  MONTHLY
  PER_UNIT
  FIXED
  // A percentage of order value (e.g. "5" means 5%) -- rate stays the same
  // plain Decimal column as every other type; the % meaning comes from
  // this type tag alone, not a second unit column.
  PERCENTAGE
}

model CostMaster {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  code      String

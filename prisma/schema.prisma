  // Phase 04: [{ "rule": "EMAIL" | "PHONE" | "MOBILE" | "WHATSAPP" | "NAME_AND_COMPANY" | "NAME_AND_EMAIL", "action": "WARN" | "BLOCK" | "FLAG" | "OFF" }]; null = defaults.

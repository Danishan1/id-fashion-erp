enum BranchType {
  FACTORY
  OFFICE
  WAREHOUSE
}

model Branch {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  code        String
  name        String
  type        BranchType
  addressJson Json?      @map("address_json")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  usersDefault          User[]                 @relation("UserDefaultBranch")
  userBranchRoles       UserBranchRole[]
  employees             Employee[]
  departments           Department[]
  warehouses            Warehouse[]
  productionLines       ProductionLine[]
  sampleRequests        SampleRequest[]
  buyerEnquiries        BuyerEnquiry[]
  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]
  materialRequests      MaterialRequest[]
  goodsReceipts         GoodsReceipt[]
  inventoryTransactions InventoryTransaction[]
  stockMovements        StockMovement[]
  roleBranchAccess      RoleBranchAccess[]
  productionOrders      ProductionOrder[]
  lots                  Lot[]
  documentSequences     DocumentSequence[]
  journals              Journal[]
  salesInvoices         SalesInvoice[]
  purchaseInvoices      PurchaseInvoice[]
  payments              Payment[]
  expenses              Expense[]
  dispatches            Dispatch[]
  jobWorkOrders         JobWorkOrder[]
  customInvoices        CustomInvoice[]
  internalTransfers     InternalTransfer[]
  employeeAdvances      EmployeeAdvance[]
  aiGarmentProjects     AiGarmentProject[]
  campaigns             Campaign[]

  crmLeads CrmLead[]

  @@unique([companyId, code])
  @@map("branches")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

enum PlatformUserRole {
  PLATFORM_SUPER_ADMIN
  SUPPORT_AGENT
  BILLING_ADMIN
}

// A platform operator (Platform SaaS Phase 1, PLAT-001) — deliberately has no
// companyId: platform staff belong to no customer tenant and get no access to
// any tenant's ERP data. Signs in only at /platform/login (a separate NextAuth
// provider, "platform-credentials") and can only use the /platform portal.
// Access to a customer's ERP will come only through the customer-approved
// support session planned for Phase 2.
model PlatformUser {
  id                 String           @id @default(uuid()) @db.Uuid
  email              String           @unique
  passwordHash       String           @map("password_hash")
  fullName           String           @map("full_name")
  role               PlatformUserRole @default(SUPPORT_AGENT)
  status             UserStatus       @default(ACTIVE)
  lastLoginAt        DateTime?        @map("last_login_at")
  passwordChangedAt  DateTime?        @map("password_changed_at")
  // Set only for rows backfilled from users.is_platform_admin by the PLAT-001
  // migration — traceability back to the old tenant account, never a link
  // that grants anything.
  migratedFromUserId String?          @unique @map("migrated_from_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  auditLogs                AuditLog[]
  supportProxyUsers        User[]                     @relation("SupportProxyUser")
  supportAccessRequests    SupportAccessRequest[]
  supportAccessSessions    SupportAccessSession[]
  companiesSuspended       Company[]                  @relation("CompanySuspendedBy")
  moduleEntitlementChanges CompanyModuleEntitlement[]
  subscriptionsUpdated     CompanySubscription[]
  subscriptionPayments     SubscriptionPayment[]

  @@map("platform_users")
}

// Platform SaaS Phase 3 (PLAT-018) — which product packages (see
// src/config/module-entitlements.ts) a company may use. A missing row means
// the package is enabled, so only explicitly disabled packages need a row.
// Enforced by PermissionService (every API + sidebar + server page) and the
// proxy (page URLs).
model CompanyModuleEntitlement {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  packageKey              String   @map("package_key")
  isEnabled               Boolean  @default(true) @map("is_enabled")
  changedByPlatformUserId String?  @map("changed_by_platform_user_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changedBy PlatformUser? @relation(fields: [changedByPlatformUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, packageKey])
  @@map("company_module_entitlements")
}

// ---------------------------------------------------------------------------
// Platform SaaS Phase 4 — subscriptions, trials and the grace period
// (PLAT-021..025). Payment is recorded manually by platform staff (DEC-03);
// there is no payment gateway. A company's access state (trial / active /
// grace / expired) is DERIVED from `currentPeriodEndsAt` at read time — see
// src/core/subscriptions/subscription-state.ts — never stored. Grace (7 days
// after the period ends) and the post-grace archive (DEC-01) are both
// read-only: view, print and export only.
// ---------------------------------------------------------------------------

enum SubscriptionBillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionPaymentMethod {
  BANK_TRANSFER
  CHEQUE
  UPI
  CASH
  CARD
  OTHER
}

model SubscriptionPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  description        String?
  monthlyPrice       Decimal? @map("monthly_price") @db.Decimal(18, 2)
  annualPrice        Decimal? @map("annual_price") @db.Decimal(18, 2)
  currencyCode       String   @default("INR") @map("currency_code") @db.VarChar(3)
  trialDays          Int      @default(14) @map("trial_days")
  // null = unlimited users
  maxUsers           Int?     @map("max_users")
  isActive           Boolean  @default(true) @map("is_active")
  // The plan a newly created company starts its trial on.
  isDefaultTrialPlan Boolean  @default(false) @map("is_default_trial_plan")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  modules       SubscriptionPlanModule[]
  subscriptions CompanySubscription[]
  payments      SubscriptionPayment[]

  @@map("subscription_plans")
}

// The module packages (src/config/module-entitlements.ts) a plan includes.
model SubscriptionPlanModule {
  id         String @id @default(uuid()) @db.Uuid
  planId     String @map("plan_id") @db.Uuid
  packageKey String @map("package_key")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, packageKey])
  @@map("subscription_plan_modules")
}

// One current subscription per company.
model CompanySubscription {
  id                      String                   @id @default(uuid()) @db.Uuid
  companyId               String                   @unique @map("company_id") @db.Uuid
  planId                  String                   @map("plan_id") @db.Uuid
  billingCycle            SubscriptionBillingCycle @default(MONTHLY) @map("billing_cycle")
  isTrial                 Boolean                  @default(false) @map("is_trial")
  startedAt               DateTime                 @default(now()) @map("started_at")
  // null = no expiry (complimentary / existing customers before Phase 4)
  currentPeriodEndsAt     DateTime?                @map("current_period_ends_at")
  // Lifecycle worker idempotency: "<STAGE>|<period end ISO>" of the last notice sent.
  lastNotifiedKey         String?                  @map("last_notified_key")
  updatedByPlatformUserId String?                  @map("updated_by_platform_user_id") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  updatedBy PlatformUser?         @relation(fields: [updatedByPlatformUserId], references: [id], onDelete: SetNull)
  payments  SubscriptionPayment[]

  @@map("company_subscriptions")
}

// A manually recorded payment that renewed a subscription (DEC-03).
model SubscriptionPayment {
  id                       String                    @id @default(uuid()) @db.Uuid
  companyId                String                    @map("company_id") @db.Uuid
  subscriptionId           String                    @map("subscription_id") @db.Uuid
  planId                   String                    @map("plan_id") @db.Uuid
  billingCycle             SubscriptionBillingCycle  @map("billing_cycle")
  periods                  Int                       @default(1)
  amount                   Decimal                   @db.Decimal(18, 2)
  currencyCode             String                    @map("currency_code") @db.VarChar(3)
  paidAt                   DateTime                  @map("paid_at") @db.Date
  method                   SubscriptionPaymentMethod
  reference                String?
  notes                    String?
  periodStart              DateTime                  @map("period_start")
  periodEnd                DateTime                  @map("period_end")
  recordedByPlatformUserId String                    @map("recorded_by_platform_user_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at")

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription CompanySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  recordedBy   PlatformUser        @relation(fields: [recordedByPlatformUserId], references: [id], onDelete: Restrict)

  @@index([companyId, paidAt])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// Platform SaaS Phase 2 — customer-approved support access (PLAT-008..015).
// A platform operator can reach a customer's ERP only through a request the
// company's own Super Admin approves by entering a one-time 6-digit code the
// operator gives them. The resulting session is time-limited (max 2 hours),
// read-only by default, revocable at any moment by the customer, and every
// step and request is written to a hash-chained support event log.
// ---------------------------------------------------------------------------

enum SupportAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  // Too many wrong codes — dead, a new request is needed.
  LOCKED
}

enum SupportAccessMode {
  READ_ONLY
  READ_WRITE
}

enum SupportWriteRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  LOCKED
}

enum SupportEventActorType {
  PLATFORM_USER
  TENANT_USER
  SYSTEM
}

model SupportAccessRequest {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @map("company_id") @db.Uuid
  platformUserId  String                     @map("platform_user_id") @db.Uuid
  reason          String
  durationMinutes Int                        @map("duration_minutes")
  status          SupportAccessRequestStatus @default(PENDING)
  // HMAC of the 6-digit code (keyed with the app secret, bound to this
  // request) — the code itself is shown once to the operator, never stored.
  codeHash        String                     @map("code_hash")
  codeExpiresAt   DateTime                   @map("code_expires_at")
  failedAttempts  Int                        @default(0) @map("failed_attempts")
  decidedByUserId String?                    @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?                  @map("decided_at")
  rejectionReason String?                    @map("rejection_reason")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id])
  platformUser PlatformUser          @relation(fields: [platformUserId], references: [id])
  decidedBy    User?                 @relation("SupportRequestDecidedBy", fields: [decidedByUserId], references: [id])
  session      SupportAccessSession?
  events       SupportAccessEvent[]

  @@index([companyId, status])
  @@index([platformUserId, createdAt])
  @@map("support_access_requests")
}

model SupportAccessSession {
  id                     String                    @id @default(uuid()) @db.Uuid
  requestId              String                    @unique @map("request_id") @db.Uuid
  companyId              String                    @map("company_id") @db.Uuid
  platformUserId         String                    @map("platform_user_id") @db.Uuid
  // The company-scoped "Support — <operator>" user the operator acts as
  // (users.support_for_platform_user_id), so every record and audit row
  // stays inside this company and is clearly attributable to support.
  proxyUserId            String                    @map("proxy_user_id") @db.Uuid
  mode                   SupportAccessMode         @default(READ_ONLY)
  startedAt              DateTime                  @default(now()) @map("started_at")
  expiresAt              DateTime                  @map("expires_at")
  revokedAt              DateTime?                 @map("revoked_at")
  revokedByUserId        String?                   @map("revoked_by_user_id") @db.Uuid
  endedAt                DateTime?                 @map("ended_at")
  writeStatus            SupportWriteRequestStatus @default(NONE) @map("write_status")
  writeJustification     String?                   @map("write_justification")
  writeCodeHash          String?                   @map("write_code_hash")
  writeCodeExpiresAt     DateTime?                 @map("write_code_expires_at")
  writeFailedAttempts    Int                       @default(0) @map("write_failed_attempts")
  writeRequestedAt       DateTime?                 @map("write_requested_at")
  writeDecidedAt         DateTime?                 @map("write_decided_at")
  writeDecidedByUserId   String?                   @map("write_decided_by_user_id") @db.Uuid
  // Short-lived, single-use token the operator's browser exchanges for a
  // support sign-in (sha256; the raw token is never stored).
  exchangeTokenHash      String?                   @unique @map("exchange_token_hash")
  exchangeTokenExpiresAt DateTime?                 @map("exchange_token_expires_at")
  lastAccessedAt         DateTime?                 @map("last_accessed_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  request        SupportAccessRequest @relation(fields: [requestId], references: [id])
  company        Company              @relation(fields: [companyId], references: [id])
  platformUser   PlatformUser         @relation(fields: [platformUserId], references: [id])
  proxyUser      User                 @relation("SupportSessionProxyUser", fields: [proxyUserId], references: [id])
  revokedBy      User?                @relation("SupportSessionRevokedBy", fields: [revokedByUserId], references: [id])
  writeDecidedBy User?                @relation("SupportSessionWriteDecidedBy", fields: [writeDecidedByUserId], references: [id])

  @@index([proxyUserId, expiresAt])
  @@index([companyId, expiresAt])
  @@map("support_access_sessions")
}

// Append-only, hash-chained per request: each row's hash covers the previous
// row's hash plus its own content, so editing or deleting any row breaks the
// chain (verifySupportEventChain()).
model SupportAccessEvent {
  id        String                @id @default(uuid()) @db.Uuid
  requestId String                @map("request_id") @db.Uuid
  seq       Int
  eventType String                @map("event_type")
  actorType SupportEventActorType @map("actor_type")
  actorId   String?               @map("actor_id") @db.Uuid
  method    String?
  path      String?
  detail    Json?
  prevHash  String?               @map("prev_hash")
  hash      String
  createdAt DateTime              @default(now()) @map("created_at")

  request SupportAccessRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, seq])
  @@map("support_access_events")
}

model User {
  id                       String     @id @default(uuid()) @db.Uuid
  companyId                String     @map("company_id") @db.Uuid
  defaultBranchId          String?    @map("default_branch_id") @db.Uuid
  employeeId               String?    @unique @map("employee_id") @db.Uuid
  // A vendor/external-unit login — this account genuinely IS that
  // Contractor's own portal identity (same 1:1 "this login is that
  // real-world entity" shape as employeeId just above, not a role-style
  // many-to-many). Nullable for every ordinary internal user. Scoped
  // server-side via PermissionService.getAllowedContractorId() in every Job
  // Work Order route — an EXTERNAL_UNIT_USER role sees/acts on only its own

  updatedAt DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("cost_masters")
}

// ─────────────────────────────────────────────────────────────
// Masters — Finance Configuration
// (imported from Inventory + HRMS reference systems; standalone lookups only —
// no ledger/balance wiring yet, that lands with the Phase 7 Accounts domain)
// ─────────────────────────────────────────────────────────────

enum PaymentTypeKind {

model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  branchId           String?          @map("branch_id") @db.Uuid
  departmentId       String?          @map("department_id") @db.Uuid
  reportsToId        String?          @map("reports_to_id") @db.Uuid
  // Nullable — wiring this in is the one deliberate HRMS improvement over
  // the WordPress source, which hardcodes a single 10:15 late-cutoff for
  // every employee company-wide. See CRM_SALES_MARKETING_HRMS_MIGRATION_REPORT.md.
  shiftId            String?          @map("shift_id") @db.Uuid
  // Wired to the real Designation master (HRMS gap-analysis Priority 1 item
  // #1, 2026-08-26) — was a plain free-text string, now a real FK, matching
  // the same string→FK cutover already done once for Product.category/season
  // in Phase 3. The old `designation` string column is intentionally gone
  // (not kept as a shim) — its data was backfilled into `designationId`
  // before the column was dropped, see the migration's own backfill note.
  designationId      String?          @map("designation_id") @db.Uuid
  // A sibling to departmentId/designationId, not nested under either — employment
  // classification (Permanent/Contract/Probation/...) is orthogonal to organizational
  // placement (which department, what title). See the Item 7 analysis, 2026-09-01.
  employeeCategoryId String?          @map("employee_category_id") @db.Uuid
  employeeCode       String           @map("employee_code")
  fullName           String           @map("full_name")
  phone              String?
  email              String?
  joinDate           DateTime?        @map("join_date")
  // Pay-basis data only — stored for reference/reporting, no payroll
  // run/payslip generation exists or is computed from these (deliberate
  // scope decision, 2026-09-02). Nullable: most existing employees have
  // never had this set.
  payType            EmployeePayType? @map("pay_type")
  fixedMonthlySalary Decimal?         @map("fixed_monthly_salary") @db.Decimal(18, 2)
  pieceRatePerUnit   Decimal?         @map("piece_rate_per_unit") @db.Decimal(18, 4)
  travelAllowance    Decimal?         @map("travel_allowance") @db.Decimal(18, 2)
  dearnessAllowance  Decimal?         @map("dearness_allowance") @db.Decimal(18, 2)
  // Per-employee Admin toggle: can this worker submit their OWN production
  // progress (subject to also having a User login linked via
  // User.employeeId), or must a Supervisor always log it for them (today's
  // default behavior for every employee). Defaults false so no existing
  // employee's workflow changes on migration.
  selfEntryEnabled   Boolean          @default(false) @map("self_entry_enabled")
  isActive           Boolean          @default(true) @map("is_active")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  shift            ShiftMaster?      @relation(fields: [shiftId], references: [id])
  designation      Designation?      @relation(fields: [designationId], references: [id])
  employeeCategory EmployeeCategory? @relation(fields: [employeeCategoryId], references: [id])
  reportsTo        Employee?         @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  reports          Employee[]        @relation("EmployeeHierarchy")
  user             User?

  // Production (Phase 5C) — a worker/operator is always tracked here, never
  // via User, so shop-floor staff never need a login just to be assigned
  // work or logged against (see PRODUCTION_MODULE_DESIGN.md §7).
  productionStagesOwned   ProductionStage[]       @relation("ProductionStageDefaultOwner")
  jobOrderAssignments     JobOrderAssignment[]    @relation("JobOrderAssignmentEmployee")
  jobOrderProgressEntries JobOrderProgressEntry[] @relation("JobOrderProgressEntryEmployee")

  // HRMS (migrated from WordPress "EQ HRMS")
  attendanceRecords            AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  leaveRequests                LeaveRequest[]
  leaveBalanceCarryForwards    LeaveBalanceCarryForward[]
  employeeAdvances             EmployeeAdvance[]

  @@unique([companyId, employeeCode])
  @@map("employees")
}


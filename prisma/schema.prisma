  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company               Company                     @relation(fields: [companyId], references: [id])
  rolePermissions       RolePermission[]
  userBranchRoles       UserBranchRole[]
  productionStageAccess RoleProductionStageAccess[]
  branchAccess          RoleBranchAccess[]

  @@unique([companyId, name])
  @@map("roles")
}

/**
 * Restricts a Role to specific ProductionStage(s) for floor-level separation
 * (e.g. a "Cutting Supervisor" role that should never see Stitching's lots) —
 * layered on top of the existing module/action RBAC, not a replacement for
 * it. A Role with ZERO rows here is unrestricted (sees every stage) — this
 * default keeps every pre-existing role (including the seeded
 * PRODUCTION_SUPERVISOR/PRODUCTION_MANAGER) behaving exactly as before with
 * no data migration needed. See PermissionService.getAllowedProductionStageIds()
 * for the read side and job-order.service.ts/lot.service.ts's
 * assertStageAccess() for the write side.
 */
model RoleProductionStageAccess {
  id                String   @id @default(uuid()) @db.Uuid
  roleId            String   @map("role_id") @db.Uuid
  productionStageId String   @map("production_stage_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  productionStage ProductionStage @relation(fields: [productionStageId], references: [id], onDelete: Cascade)

  @@unique([roleId, productionStageId])
  @@map("role_production_stage_access")
}

/**
 * Per-role BRANCH restriction — the exact same "additive, opt-in narrowing"
 * shape as RoleProductionStageAccess just above, reused deliberately rather
 * than invented fresh: a Role with ZERO rows here is unrestricted (sees
 * every branch in the company), so every pre-existing role (including every
 * currently-seeded system role) keeps working exactly as before with no
 * data migration needed — this only starts to matter the moment an admin
 * explicitly restricts a role to specific branches. See
 * PermissionService.getAllowedBranchIds() for the read side (identical
 * union/"any unrestricted role wins" semantics as
 * getAllowedProductionStageIds()) and assertBranchAccess() in
 * src/lib/branch-access.ts for the write side. Deliberately role-scoped,
 * not user-scoped directly -- UserBranchRole already ties a user to one or
 * more (role, branch) pairs for identity/numbering purposes (session.user
 * .defaultBranchId), a separate concern from whether that role's own data
 * visibility is restricted to specific branches at all.
 */
model RoleBranchAccess {
  id        String   @id @default(uuid()) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([roleId, branchId])
  @@map("role_branch_access")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId, roleId])
  @@map("user_branch_roles")
}


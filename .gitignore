# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local file storage (dev attachments) — deliberately NOT under public/, see FileStorage.ts
/storage
/uploads

# AI Designer's generated Product Design reference photos (scripts/generate-ai-designer-reference-images.ts)
# -- a re-generatable cache, not source; DesignOptionImage falls back to the clipart icon when a file is
# missing, so any environment can run the script independently rather than committing generated images.
/public/ai-designer-reference*
*.zip

# typescript
*.tsbuildinfo
next-env.d.ts

# local DB backups (contain password hashes / PII, never commit)
/db_backup_before_wipe

# Local DB safety dumps (pg_dump), never committed
.db-backups/
db_backups/
